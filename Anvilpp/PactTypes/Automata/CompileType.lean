import Anvilpp.PactTypes.Automata.BuildOfferAutomata

/-!
# The constructor compiler: typeCompilationFuel, compileTypeFuel, compileType, and resolved-edge helpers
-/

namespace Pact

noncomputable section

/-!
### Constructor compiler
-/

/-
`compileTypeFuel` also compiles the type generated for a conjunctive offer.
Consequently, a plain recursion-depth calculation on `PactType` is not quite
enough: the generated parallel tree must be accounted for as well.

These three mutually recursive functions calculate exactly the structural
budget needed by the calls below.  Atomic constructors need one unit.  A
compound constructor needs one unit plus the largest budget of any recursive
call that it makes.
-/
mutual
  def typeCompilationFuel : PactType → Nat
    | .message _ _ _ => 1
    | .progress _ _ => 1
    | .tock _ => 1
    | .skip _ => 1
    | .var _ _ => 1
    | .recur _ _ body => 1 + typeCompilationFuel body
    | .choice _ left right =>
        1 + max (typeCompilationFuel left) (typeCompilationFuel right)
    | .fairChoice _ _ left right =>
        1 + max (typeCompilationFuel left) (typeCompilationFuel right)
    | .seq _ left right =>
        1 + max (typeCompilationFuel left) (typeCompilationFuel right)
    | .par _ left right _ =>
        1 + max (typeCompilationFuel left) (typeCompilationFuel right)
    | .xoffer _ elseType branches =>
        1 + max (typeCompilationFuel elseType)
          (typeBranchCompilationFuel branches)
    | .offer _ elseType branches =>
        1 + max (typeCompilationFuel elseType)
          (conjunctiveCompilationFuel branches)
  termination_by processType => sizeOf processType

  /-- Largest compilation budget among all branch continuations. -/
  def typeBranchCompilationFuel :
      List (BareMessage × PactType) → Nat
    | [] => 0
    | (_, processType) :: rest =>
        max (typeCompilationFuel processType)
          (typeBranchCompilationFuel rest)
  termination_by branches => sizeOf branches

  /-- Budget for the parallel singleton offers generated by an `offer`. -/
  def conjunctiveCompilationFuel :
      List (BareMessage × PactType) → Nat
    | [] => 1
    | [(_, processType)] =>
        1 + max 1 (typeCompilationFuel processType)
    | (_, processType) :: next :: rest =>
        1 + max
          (1 + max 1 (typeCompilationFuel processType))
          (conjunctiveCompilationFuel (next :: rest))
  termination_by branches => sizeOf branches
decreasing_by
  all_goals
    simp_wf
    omega
end

theorem typeCompilationFuel_reannotate
    (alphabet : PactTypeAlphabet) (processType : PactType) :
    typeCompilationFuel (processType.reannotate alphabet) =
      typeCompilationFuel processType := by
  induction hSize : sizeOf processType using Nat.strong_induction_on
      generalizing processType alphabet with
  | _ n ih =>
      have hBranch : ∀ branches : List (BareMessage × PactType),
          sizeOf branches < n → ∀ branchAlphabet,
          typeBranchCompilationFuel
              (PactType.reannotateBranches branchAlphabet branches) =
            typeBranchCompilationFuel branches := by
        intro branches hBranches branchAlphabet
        induction branches with
        | nil => simp [PactType.reannotateBranches,
            typeBranchCompilationFuel]
        | cons branch rest restIH =>
            rcases branch with ⟨action, branchType⟩
            have hType : sizeOf branchType < n := by
              have hPair : sizeOf branchType < sizeOf (action, branchType) := by
                simp_wf; omega
              have hHead : sizeOf (action, branchType) <
                  sizeOf ((action, branchType) :: rest) := by
                simp_wf; omega
              omega
            have hRest : sizeOf rest < n := by
              have hTail : sizeOf rest <
                  sizeOf ((action, branchType) :: rest) := by
                simp_wf; omega
              omega
            simp only [PactType.reannotateBranches_cons,
              typeBranchCompilationFuel]
            rw [ih (sizeOf branchType) hType branchAlphabet branchType rfl,
              restIH hRest]
      have hConj : ∀ branches : List (BareMessage × PactType),
          sizeOf branches < n → ∀ branchAlphabet,
          conjunctiveCompilationFuel
              (PactType.reannotateBranches branchAlphabet branches) =
            conjunctiveCompilationFuel branches := by
        intro branches hBranches branchAlphabet
        induction branches with
        | nil => simp [PactType.reannotateBranches,
            conjunctiveCompilationFuel]
        | cons branch rest restIH =>
            rcases branch with ⟨action, branchType⟩
            have hType : sizeOf branchType < n := by
              have hPair : sizeOf branchType < sizeOf (action, branchType) := by
                simp_wf; omega
              have hHead : sizeOf (action, branchType) <
                  sizeOf ((action, branchType) :: rest) := by
                simp_wf; omega
              omega
            have hRest : sizeOf rest < n := by
              have hTail : sizeOf rest <
                  sizeOf ((action, branchType) :: rest) := by
                simp_wf; omega
              omega
            cases rest with
            | nil =>
                simp [PactType.reannotateBranches,
                  conjunctiveCompilationFuel,
                  ih (sizeOf branchType) hType branchAlphabet branchType rfl]
            | cons next tail =>
                rcases next with ⟨nextAction, nextType⟩
                have hRestEq := restIH hRest
                rw [PactType.reannotateBranches_cons] at hRestEq
                rw [PactType.reannotateBranches_cons,
                  PactType.reannotateBranches_cons]
                simp only [conjunctiveCompilationFuel]
                rw [ih (sizeOf branchType) hType branchAlphabet branchType rfl,
                  hRestEq]
      cases processType with
      | message _ _ _ | progress _ _ | tock _ | skip _ | var _ _ =>
          simp [PactType.reannotate, typeCompilationFuel]
      | recur _ _ body =>
          have hBody : sizeOf body < n := by rw [← hSize]; simp_wf; omega
          simp [PactType.reannotate, typeCompilationFuel,
            ih (sizeOf body) hBody alphabet body rfl]
      | choice _ left right =>
          have hLeft : sizeOf left < n := by rw [← hSize]; simp_wf; omega
          have hRight : sizeOf right < n := by rw [← hSize]; simp_wf; omega
          simp [PactType.reannotate, typeCompilationFuel,
            ih (sizeOf left) hLeft alphabet left rfl,
            ih (sizeOf right) hRight alphabet right rfl]
      | seq _ left right =>
          have hLeft : sizeOf left < n := by rw [← hSize]; simp_wf; omega
          have hRight : sizeOf right < n := by rw [← hSize]; simp_wf; omega
          simp [PactType.reannotate, typeCompilationFuel,
            ih (sizeOf left) hLeft alphabet left rfl,
            ih (sizeOf right) hRight alphabet right rfl]
      | fairChoice _ _ left right =>
          have hLeft : sizeOf left < n := by rw [← hSize]; simp_wf; omega
          have hRight : sizeOf right < n := by rw [← hSize]; simp_wf; omega
          simp [PactType.reannotate, typeCompilationFuel,
            ih (sizeOf left) hLeft alphabet left rfl,
            ih (sizeOf right) hRight alphabet right rfl]
      | par _ left right interface =>
          have hLeft : sizeOf left < n := by rw [← hSize]; simp_wf; omega
          have hRight : sizeOf right < n := by rw [← hSize]; simp_wf; omega
          simp [PactType.reannotate, typeCompilationFuel,
            ih (sizeOf left) hLeft
              (PactTypeAlphabet.projectParallelLeft alphabet left.alphabet
                right.alphabet interface) left rfl,
            ih (sizeOf right) hRight
              (PactTypeAlphabet.projectParallelChild alphabet right.alphabet
                interface) right rfl]
      | xoffer _ elseType branches =>
          have hElse : sizeOf elseType < n := by rw [← hSize]; simp_wf; omega
          have hBranches : sizeOf branches < n := by
            rw [← hSize]; simp_wf; omega
          simp [PactType.reannotate, typeCompilationFuel,
            ih (sizeOf elseType) hElse alphabet elseType rfl,
            hBranch branches hBranches alphabet]
      | offer _ elseType branches =>
          have hElse : sizeOf elseType < n := by rw [← hSize]; simp_wf; omega
          have hBranches : sizeOf branches < n := by
            rw [← hSize]; simp_wf; omega
          simp [PactType.reannotate, typeCompilationFuel,
            ih (sizeOf elseType) hElse alphabet elseType rfl,
            hBranch branches hBranches alphabet,
            hConj branches hBranches alphabet]

theorem typeCompilationFuel_parallelTypeBranchesWithin
    (alphabet : PactTypeAlphabet) : ∀ branches,
    typeCompilationFuel (parallelTypeBranchesWithin alphabet branches) =
      conjunctiveCompilationFuel branches
  | [] => by
      simp [parallelTypeBranchesWithin, typeCompilationFuel,
        conjunctiveCompilationFuel]
  | [(_, processType)] => by
      simp [parallelTypeBranchesWithin, singletonTypeXOfferAt,
        typeCompilationFuel, typeBranchCompilationFuel,
        conjunctiveCompilationFuel,
        typeCompilationFuel_reannotate]
  | (action, processType) :: next :: rest => by
      simp [parallelTypeBranchesWithin, singletonTypeXOfferAt,
        typeCompilationFuel, typeBranchCompilationFuel,
        conjunctiveCompilationFuel,
        typeCompilationFuel_reannotate,
        typeCompilationFuel_parallelTypeBranchesWithin]

theorem typeCompilationFuel_parallelTypeBranchesSelectingWithin
    (alphabet : PactTypeAlphabet) (selected : BareMessage × PactType) :
    ∀ branches,
    typeCompilationFuel
        (parallelTypeBranchesSelectingWithin alphabet selected branches) =
      conjunctiveCompilationFuel branches
  | [] => by
      simp [parallelTypeBranchesSelectingWithin, typeCompilationFuel,
        conjunctiveCompilationFuel]
  | [branch] => by
      rcases branch with ⟨action, processType⟩
      by_cases hSelected : (action, processType) = selected
      · subst selected
        simp [parallelTypeBranchesSelectingWithin,
          selectedTypeBranchAt, typeCompilationFuel,
          conjunctiveCompilationFuel, typeCompilationFuel_reannotate]
      · simp [parallelTypeBranchesSelectingWithin, hSelected,
          singletonTypeXOfferAt, typeCompilationFuel,
          typeBranchCompilationFuel,
          conjunctiveCompilationFuel, typeCompilationFuel_reannotate]
  | (action, processType) :: next :: rest => by
      by_cases hSelected : (action, processType) = selected
      · subst selected
        simp [parallelTypeBranchesSelectingWithin,
          selectedTypeBranchAt, typeCompilationFuel,
          conjunctiveCompilationFuel, typeCompilationFuel_reannotate,
          typeCompilationFuel_parallelTypeBranchesWithin]
      · simp [parallelTypeBranchesSelectingWithin, hSelected,
          singletonTypeXOfferAt, typeCompilationFuel,
          typeBranchCompilationFuel,
          conjunctiveCompilationFuel, typeCompilationFuel_reannotate,
          typeCompilationFuel_parallelTypeBranchesSelectingWithin]

/--
The auxiliary budget is exactly the budget of the parallel type generated for
a conjunctive offer.  This is the non-structural recursive call that motivates
the custom fuel calculation.
-/
theorem typeCompilationFuel_parallelTypeBranches
    (branches : List (BareMessage × PactType)) :
    typeCompilationFuel (parallelTypeBranches branches) =
      conjunctiveCompilationFuel branches := by
  cases branches with
  | nil => simp [parallelTypeBranches, typeCompilationFuel,
      conjunctiveCompilationFuel]
  | cons branch rest =>
      exact typeCompilationFuel_parallelTypeBranchesWithin
        branch.2.alphabet (branch :: rest)

/-- Forcing one singleton branch removes only its synthetic else outcome and
does not change the compilation budget of the generated parallel product. -/
theorem typeCompilationFuel_parallelTypeBranchesSelecting
    (selected : BareMessage × PactType)
    (branches : List (BareMessage × PactType)) :
    typeCompilationFuel (parallelTypeBranchesSelecting selected branches) =
      conjunctiveCompilationFuel branches := by
  cases branches with
  | nil => simp [parallelTypeBranchesSelecting, typeCompilationFuel,
      conjunctiveCompilationFuel]
  | cons branch rest =>
      exact typeCompilationFuel_parallelTypeBranchesSelectingWithin
        branch.2.alphabet selected (branch :: rest)

/-- `fuel` covers every recursive call made while compiling `processType`. -/
def TypeCompilationFuelSufficient
    (processType : PactType) (fuel : Nat) : Prop :=
  typeCompilationFuel processType ≤ fuel

/-- The calculated compilation budget is sufficient by construction. -/
theorem typeCompilationFuel_sufficient (processType : PactType) :
    TypeCompilationFuelSufficient processType
      (typeCompilationFuel processType) := by
  exact le_rfl

/-- Every type receives at least the one unit needed to enter its constructor. -/
theorem typeCompilationFuel_positive (processType : PactType) :
    0 < typeCompilationFuel processType := by
  cases processType <;> simp [typeCompilationFuel] <;> omega

/-- Sufficient fuel can never select the defensive zero-fuel case at the root. -/
theorem TypeCompilationFuelSufficient.positive
    {processType : PactType} {fuel : Nat}
    (hFuel : TypeCompilationFuelSufficient processType fuel) :
    0 < fuel :=
  lt_of_lt_of_le (typeCompilationFuel_positive processType) hFuel

theorem typeCompilationFuel_le_typeBranchCompilationFuel
    (branches : List (BareMessage × PactType))
    (entry : BareMessage × PactType) (hEntry : entry ∈ branches) :
    typeCompilationFuel entry.2 ≤ typeBranchCompilationFuel branches := by
  induction branches with
  | nil => simp at hEntry
  | cons head rest ih =>
      rcases head with ⟨action, processType⟩
      simp only [List.mem_cons] at hEntry
      rcases hEntry with rfl | hRest
      · simp [typeBranchCompilationFuel]
      · exact le_trans (ih hRest) (by
          simp [typeBranchCompilationFuel])

/-- Every continuation in a conjunctive offer fits within the compilation
budget of the generated branch product. -/
theorem typeCompilationFuel_le_conjunctiveCompilationFuel
    (branches : List (BareMessage × PactType))
    (entry : BareMessage × PactType) (hEntry : entry ∈ branches) :
    typeCompilationFuel entry.2 ≤ conjunctiveCompilationFuel branches := by
  induction branches with
  | nil => simp at hEntry
  | cons head rest ih =>
      rcases head with ⟨action, processType⟩
      simp only [List.mem_cons] at hEntry
      cases rest with
      | nil =>
          have hEq : entry = (action, processType) := by
            simpa using hEntry
          subst entry
          simp [conjunctiveCompilationFuel]
          omega
      | cons next tail =>
          rcases hEntry with hHead | hRest
          · subst entry
            simp [conjunctiveCompilationFuel]
            omega
          · exact le_trans (ih hRest) (by
              simp [conjunctiveCompilationFuel]
              omega)

/-- Recover the parallel subterm represented by a product-shaped state after
peeling the constructor tags introduced by compilation. -/
def stateProductInfoFuel : Nat → PactType → TypeAutomatonState →
    Option (Interface × PactType × PactType × TypeAutomatonState ×
      TypeAutomatonState)
  | 0, _, _ => none
  | fuel + 1, processType, state =>
      match processType, state with
      | .par _ left right interface, .pair q1 q2 =>
          some (interface, left, right, q1, q2)
      | .choice _ left _, .child 0 q => stateProductInfoFuel fuel left q
      | .choice _ _ right, .child 1 q => stateProductInfoFuel fuel right q
      | .fairChoice _ _ left _, .child 0 q => stateProductInfoFuel fuel left q
      | .fairChoice _ _ _ right, .child 1 q => stateProductInfoFuel fuel right q
      | .seq _ left _, .child 0 q => stateProductInfoFuel fuel left q
      | .seq _ _ right, .child 1 q => stateProductInfoFuel fuel right q
      | .recur _ _ body, .child 0 q => stateProductInfoFuel fuel body q
      | .xoffer _ elseType _, .child 0 q =>
          stateProductInfoFuel fuel elseType q
      | .xoffer _ _ branches, .child (i + 1) q =>
          match branches[i]? with
          | some (_, branchType) => stateProductInfoFuel fuel branchType q
          | none => none
      | .offer _ elseType _, .child 0 q =>
          stateProductInfoFuel fuel elseType q
      | .offer _ _ branches, .child (i + 1) q =>
          match branches[i]? with
          | some selected =>
              stateProductInfoFuel fuel
                (parallelTypeBranchesSelecting selected branches) q
          | none => none
      | _, _ => none

def stateProductInfo (processType : PactType) (state : TypeAutomatonState) :
    Option (Interface × PactType × PactType × TypeAutomatonState ×
      TypeAutomatonState) :=
  stateProductInfoFuel (typeCompilationFuel processType) processType state

mutual
def compileTypeFuel (signature : TypeAlphabet) :
    Nat → PactType → AutomatonFragment
  -- Exhausted fuel is an unreachable defensive case for the public compiler.
  | 0, _ =>
      { states := {.root}
        initial := .root
        accepting := ∅
        edges := ∅ }
  | fuel + 1, processType => by
      classical
      match processType with
      -- skip: Q = {root}, i = root, F = {root}; epsilon self-loops.
      | .skip _ =>
          let idleEnvironments := signature.localEnvironments.filter fun environment =>
            environment.clock = false
          exact finishAutomatonFragment {.root} .root {.root} <|
            idleEnvironments.image fun environment =>
              { source := .root
                environment := environment
                label := .visible TypeLabel.silent
                current := ∅
                future := .explicit ∅
                target := .root }

      -- message: fire to final when its complement is immediate; otherwise wait.
      -- Both action families are gated on the type's own alphabet, exactly as
      -- the semantic `action`/`action_wait` rules are.  The final idle loop
      -- mirrors `skip`, which carries no such gate.
      | .message alphabet msg dir =>
          let action : BareMessage := (msg, dir)
          let firingEdges : Finset PendingAutomatonEdge :=
            (signature.localEnvironments.filter fun environment =>
              environment.hasNeed action ∧
              action ∈ alphabet.actions).image fun environment =>
                { source := TypeAutomatonState.root
                  environment := environment
                  label := .visible (TypeLabel.message msg dir)
                  current := {action}
                  future := .at .final ∅
                  target := .final }
          let waitingEdges : Finset PendingAutomatonEdge :=
            (signature.localEnvironments.filter fun environment =>
              environment.clock = false ∧
              ¬ environment.hasNeed action ∧
              action ∈ alphabet.actions).image fun environment =>
                { source := TypeAutomatonState.root
                  environment := environment
                  label := .visible TypeLabel.silent
                  current := {action}
                  future := .at .root {action}
                  target := .root }
          let finalEdges : Finset PendingAutomatonEdge :=
            let idleEnvironments := signature.localEnvironments.filter fun environment =>
              environment.clock = false
            idleEnvironments.image fun environment =>
              { source := TypeAutomatonState.final
                environment := environment
                label := .visible TypeLabel.silent
                current := ∅
                future := .explicit ∅
                target := .final }
          exact finishAutomatonFragment {.root, .final} .root {.final}
            (firingEdges ∪ waitingEdges ∪ finalEdges)

      -- clock: a clock environment moves root to final; non-clock input waits.
      | .tock _ =>
          let actionEdges : Finset PendingAutomatonEdge :=
            signature.localEnvironments.image fun environment =>
              if environment.clock then
                { source := TypeAutomatonState.root
                  environment := environment
                  label := .visible TypeLabel.tock
                  current := ∅
                  future := .explicit ∅
                  target := .final }
              else
                { source := TypeAutomatonState.root
                  environment := environment
                  label := .visible TypeLabel.silent
                  current := ∅
                  future := .explicit ∅
                  target := .root }
          let finalEdges : Finset PendingAutomatonEdge :=
            let idleEnvironments := signature.localEnvironments.filter fun environment =>
              environment.clock = false
            idleEnvironments.image fun environment =>
              { source := TypeAutomatonState.final
                environment := environment
                label := .visible TypeLabel.silent
                current := ∅
                future := .explicit ∅
                target := .final }
          exact finishAutomatonFragment {.root, .final} .root {.final}
            (actionEdges ∪ finalEdges)

      -- progress: emit the marker and enter final; final then idles silently.
      | .progress _ pid =>
          let actionEdges : Finset PendingAutomatonEdge :=
            (signature.localEnvironments.filter fun environment =>
              environment.clock = false).image fun environment =>
              { source := TypeAutomatonState.root
                environment := environment
                label := .visible (TypeLabel.progress pid)
                current := ∅
                future := .at .final ∅
                target := .final }
          let finalEdges : Finset PendingAutomatonEdge :=
            let idleEnvironments := signature.localEnvironments.filter fun environment =>
              environment.clock = false
            idleEnvironments.image fun environment =>
              { source := TypeAutomatonState.final
                environment := environment
                label := .visible TypeLabel.silent
                current := ∅
                future := .explicit ∅
                target := .final }
          exact finishAutomatonFragment {.root, .final} .root {.final}
            (actionEdges ∪ finalEdges)

      -- variable: create a temporary labelled edge for an enclosing binder.
      -- The enclosing binder rewrites this marker into a silent back-edge,
      -- and the semantic `recur` rule fires only under a non-clock
      -- environment, so a clocked marker would become a back-edge with no
      -- semantic counterpart.  Guard it exactly like every other family.
      | .var _ name =>
          exact finishAutomatonFragment {.root, .final} .root ∅  <|
            (signature.localEnvironments.filter fun environment =>
              environment.clock = false).image fun environment =>
              { source := .root
                environment := environment
                label := .variable name
                current := ∅
                future := .explicit ∅
                target := .final }

      -- recursion: replace matching variable edges by silent back-edges.
      | .recur _ name body =>
          exact buildRecursionAutomaton signature name
            (compileTypeFuel signature fuel body)
      -- ordinary choice: add a fresh root with two silent selection edges.
      | .choice _ left right =>
          exact buildChoiceAutomaton signature
            (compileTypeFuel signature fuel left)
            (compileTypeFuel signature fuel right)
            TypeLabel.silent TypeLabel.silent

      -- fair choice: use the same sum construction with observable outcomes.
      | .fairChoice _ bid left right =>
          exact buildChoiceAutomaton signature
            (compileTypeFuel signature fuel left)
            (compileTypeFuel signature fuel right)
            (TypeLabel.fair bid true) (TypeLabel.fair bid false)

      -- sequence: redirect transitions entering a left final state into right.
      | .seq _ left right =>
          exact buildSequenceAutomaton signature
            (compileTypeFuel signature fuel left)
            (compileTypeFuel signature fuel right)

      -- parallel: form the reachable synchronized product on `interface`.
      | .par alphabet left right interface =>
          exact buildParallelAutomaton signature alphabet left.alphabet
            right.alphabet interface
            (compileTypeFuel signature fuel left)
            (compileTypeFuel signature fuel right)
            (computeFutureOfFuel signature
              (min fuel (typeCompilationFuel left)) left)
            (computeFutureOfFuel signature
              (min fuel (typeCompilationFuel right)) right)

      -- exclusive offer: compile else and every branch independently first.
      | .xoffer alphabet elseType branches =>
          let elseAutomaton := compileTypeFuel signature fuel elseType
          let branchAutomata := branches.map fun branch =>
            (branch.1, compileTypeFuel signature fuel branch.2)
          exact buildExclusiveOfferAutomaton
            signature alphabet branches elseAutomaton branchAutomata

      -- conjunctive offer: compile its singleton-offer parallel product first.
      | .offer alphabet elseType branches =>
          let elseAutomaton := compileTypeFuel signature fuel elseType
          let selectedConjunctions := branches.map fun selected =>
            (selected.1, compileTypeFuel signature fuel
              (parallelTypeBranchesSelecting selected branches))
          exact buildSelectedConjunctiveOfferAutomaton
            signature alphabet branches elseAutomaton selectedConjunctions

termination_by fuel processType => (fuel, 0)

/-- The paper's global future-menu fixed point. The graph closure and every
product-state contribution are computed from the same type-aware compiler. -/
def computeFutureOfFuel (signature : TypeAlphabet) :
    Nat → PactType → TypeAutomatonState → Finset BareMessage
  | 0, _, _ => ∅
  | fuel + 1, processType, state =>
      let fragment := compileTypeFuel signature (fuel + 1) processType
      let pending : PendingAutomaton :=
        { states := fragment.states, edges := fragment.edges }
      (pending.futureReachable state).biUnion fun visited =>
        pending.offersAt visited ∪
          match stateProductInfo processType visited with
          | some (interface, left, right, q1, q2) =>
              hideTypeOffers interface
                (computeFutureOfFuel signature fuel left q1 ∪
                  computeFutureOfFuel signature fuel right q2)
          | none => ∅
termination_by fuel processType state => (fuel, 1)
decreasing_by
  all_goals omega
end

/-- The type-aware future function used when `processType` is compiled as a
child with the parent's remaining fuel. -/
def compiledChildFutureFuel (signature : TypeAlphabet) (fuel : Nat)
    (processType : PactType) : TypeAutomatonState → Finset BareMessage :=
  computeFutureOfFuel signature (min fuel (typeCompilationFuel processType))
    processType

/-- A sufficient parent budget gives a child exactly its public, type-aware
future function. -/
theorem compiledChildFutureFuel_eq_computeFutureOf
    (signature : TypeAlphabet) (fuel : Nat) (processType : PactType)
    (hFuel : typeCompilationFuel processType ≤ fuel) :
    compiledChildFutureFuel signature fuel processType =
      computeFutureOfFuel signature (typeCompilationFuel processType)
        processType := by
  unfold compiledChildFutureFuel
  rw [Nat.min_eq_right hFuel]

/-- Once fuel covers the custom compilation budget, one more unit leaves the
constructor fragment unchanged. -/
private theorem compileTypeFuel_succ_stable (signature : TypeAlphabet) :
    ∀ fuel processType, typeCompilationFuel processType ≤ fuel →
      compileTypeFuel signature (fuel + 1) processType =
        compileTypeFuel signature fuel processType := by
  intro fuel
  induction fuel with
  | zero =>
      intro processType hFuel
      have hPositive := typeCompilationFuel_positive processType
      omega
  | succ fuel ih =>
      intro processType hFuel
      conv_lhs => rw [compileTypeFuel.eq_def]
      conv_rhs => rw [compileTypeFuel.eq_def]
      cases processType with
      | message alphabet msg dir => rfl
      | progress alphabet pid => rfl
      | tock alphabet => rfl
      | skip alphabet => rfl
      | var alphabet name => rfl
      | recur alphabet name body =>
          change buildRecursionAutomaton signature name
              (compileTypeFuel signature (fuel + 1) body) =
            buildRecursionAutomaton signature name
              (compileTypeFuel signature fuel body)
          rw [ih body (by
            simp [typeCompilationFuel] at hFuel
            omega)]
      | choice alphabet left right =>
          change buildChoiceAutomaton signature
              (compileTypeFuel signature (fuel + 1) left)
              (compileTypeFuel signature (fuel + 1) right)
              TypeLabel.silent TypeLabel.silent =
            buildChoiceAutomaton signature
              (compileTypeFuel signature fuel left)
              (compileTypeFuel signature fuel right)
              TypeLabel.silent TypeLabel.silent
          rw [ih left (by
              simp [typeCompilationFuel] at hFuel
              omega),
            ih right (by
              simp [typeCompilationFuel] at hFuel
              omega)]
      | fairChoice alphabet bid left right =>
          change buildChoiceAutomaton signature
              (compileTypeFuel signature (fuel + 1) left)
              (compileTypeFuel signature (fuel + 1) right)
              (TypeLabel.fair bid true) (TypeLabel.fair bid false) =
            buildChoiceAutomaton signature
              (compileTypeFuel signature fuel left)
              (compileTypeFuel signature fuel right)
              (TypeLabel.fair bid true) (TypeLabel.fair bid false)
          rw [ih left (by
              simp [typeCompilationFuel] at hFuel
              omega),
            ih right (by
              simp [typeCompilationFuel] at hFuel
              omega)]
      | seq alphabet left right =>
          change buildSequenceAutomaton signature
              (compileTypeFuel signature (fuel + 1) left)
              (compileTypeFuel signature (fuel + 1) right) =
            buildSequenceAutomaton signature
              (compileTypeFuel signature fuel left)
              (compileTypeFuel signature fuel right)
          rw [ih left (by
              simp [typeCompilationFuel] at hFuel
              omega),
            ih right (by
              simp [typeCompilationFuel] at hFuel
              omega)]
      | par alphabet left right interface =>
          change buildParallelAutomaton signature alphabet left.alphabet
              right.alphabet interface
              (compileTypeFuel signature (fuel + 1) left)
              (compileTypeFuel signature (fuel + 1) right)
              (computeFutureOfFuel signature
                (min (fuel + 1) (typeCompilationFuel left)) left)
              (computeFutureOfFuel signature
                (min (fuel + 1) (typeCompilationFuel right)) right) =
            buildParallelAutomaton signature alphabet left.alphabet
              right.alphabet interface
              (compileTypeFuel signature fuel left)
              (compileTypeFuel signature fuel right)
              (computeFutureOfFuel signature
                (min fuel (typeCompilationFuel left)) left)
              (computeFutureOfFuel signature
                (min fuel (typeCompilationFuel right)) right)
          have hLeft : typeCompilationFuel left ≤ fuel := by
            simp [typeCompilationFuel] at hFuel
            omega
          have hRight : typeCompilationFuel right ≤ fuel := by
            simp [typeCompilationFuel] at hFuel
            omega
          simp only [Nat.min_eq_right hLeft, Nat.min_eq_right (Nat.le.step hLeft),
            Nat.min_eq_right hRight, Nat.min_eq_right (Nat.le.step hRight)]
          rw [ih left (by
              exact hLeft),
            ih right (by
              exact hRight)]
      | xoffer alphabet elseType branches =>
          change buildExclusiveOfferAutomaton signature alphabet branches
              (compileTypeFuel signature (fuel + 1) elseType)
              (branches.map fun branch =>
                (branch.1, compileTypeFuel signature (fuel + 1) branch.2)) =
            buildExclusiveOfferAutomaton signature alphabet branches
              (compileTypeFuel signature fuel elseType)
              (branches.map fun branch =>
                (branch.1, compileTypeFuel signature fuel branch.2))
          have hElse : typeCompilationFuel elseType ≤ fuel := by
            simp [typeCompilationFuel] at hFuel
            omega
          rw [ih elseType hElse]
          congr 1
          have hBranches : typeBranchCompilationFuel branches ≤ fuel := by
            simp [typeCompilationFuel] at hFuel
            omega
          have hMap : ∀ rest,
              typeBranchCompilationFuel rest ≤ fuel →
              (rest.map fun branch =>
                (branch.1, compileTypeFuel signature (fuel + 1) branch.2)) =
              (rest.map fun branch =>
                (branch.1, compileTypeFuel signature fuel branch.2)) := by
            intro rest
            induction rest with
            | nil => simp
            | cons branch tail tailIH =>
                intro hRest
                rcases branch with ⟨action, branchType⟩
                simp only [List.map_cons]
                have hBranch : typeCompilationFuel branchType ≤ fuel := by
                  simp [typeBranchCompilationFuel] at hRest
                  omega
                rw [ih branchType hBranch]
                congr 1
                apply tailIH
                simp [typeBranchCompilationFuel] at hRest ⊢
                omega
          exact hMap branches hBranches
      | offer alphabet elseType branches =>
          change buildSelectedConjunctiveOfferAutomaton signature alphabet
              branches
              (compileTypeFuel signature (fuel + 1) elseType)
              (branches.map fun selected =>
                (selected.1, compileTypeFuel signature (fuel + 1)
                  (parallelTypeBranchesSelecting selected branches))) =
            buildSelectedConjunctiveOfferAutomaton signature alphabet branches
              (compileTypeFuel signature fuel elseType)
              (branches.map fun selected =>
                (selected.1, compileTypeFuel signature fuel
                  (parallelTypeBranchesSelecting selected branches)))
          have hElse : typeCompilationFuel elseType ≤ fuel := by
            simp [typeCompilationFuel] at hFuel
            omega
          rw [ih elseType hElse]
          congr 1
          apply List.map_congr_left
          intro selected hSelected
          congr 1
          apply ih
          rw [typeCompilationFuel_parallelTypeBranchesSelecting]
          simp [typeCompilationFuel] at hFuel
          omega

/-- Any two sufficient parent budgets produce the same constructor fragment. -/
private theorem compileTypeFuel_add_stable
    (signature : TypeAlphabet) (processType : PactType)
    (fuel extra : Nat) (hFuel : typeCompilationFuel processType ≤ fuel) :
    compileTypeFuel signature (fuel + extra) processType =
      compileTypeFuel signature fuel processType := by
  induction extra with
  | zero => simp
  | succ extra ih =>
      rw [Nat.add_succ,
        compileTypeFuel_succ_stable signature (fuel + extra) processType
          (by omega),
        ih]

theorem compileTypeFuel_eq_of_sufficient
    (signature : TypeAlphabet) (processType : PactType)
    {leftFuel rightFuel : Nat}
    (hLeft : TypeCompilationFuelSufficient processType leftFuel)
    (hRight : TypeCompilationFuelSufficient processType rightFuel) :
    compileTypeFuel signature leftFuel processType =
      compileTypeFuel signature rightFuel processType := by
  by_cases hOrder : leftFuel ≤ rightFuel
  · obtain ⟨extra, rfl⟩ := Nat.exists_eq_add_of_le hOrder
    exact (compileTypeFuel_add_stable signature processType leftFuel extra
      hLeft).symm
  · have hReverse : rightFuel ≤ leftFuel := by omega
    obtain ⟨extra, rfl⟩ := Nat.exists_eq_add_of_le hReverse
    exact compileTypeFuel_add_stable signature processType rightFuel extra hRight

/-!
### Native product-aware future resolution (`pactautomatonconstruction.typ`, "Future menus are global")

`OF(q) = μX.Φ(X)` is a single global least fixed point over the whole
compiled automaton.  For a product state, the equation reads the two component
menus directly as `hide_I(X(q₁) ∪ X(q₂))`; this is a clause of the future
equation, not an extra transition.  `stateProductInfo`/`computeFutureOf`
recover, purely from a state's shape and the originating `PactType`, which
`.par` node (if any) a state's core `.pair q₁ q₂` came from, and fold in
`q₁`/`q₂`'s own future menus natively.

Fuel-bounded throughout, matching `compileTypeFuel`'s own convention: a
conjunctive `.offer`'s generated `parallelTypeBranchesSelecting` type is not
structurally smaller than the `.offer` node itself (it duplicates every
branch into a `.par` chain), so plain structural recursion on `PactType` does
not terminate here the way it does for every other constructor.
-/

/-- All same-cycle offers reachable from `state` in `processType`'s own
compiled automaton, computed against the doc-accurate global `OF`. -/
def computeFutureOf (signature : TypeAlphabet) (processType : PactType)
    (state : TypeAutomatonState) : Finset BareMessage :=
  computeFutureOfFuel signature (typeCompilationFuel processType) processType
    state

/-- A decorated automaton edge represented as the tuple `(q, σ, q')`. -/
structure TypeAutomatonEdge : Type where
  source : TypeAutomatonState
  symbol : TypeAutomatonSymbol
  target : TypeAutomatonState
  deriving DecidableEq

/-- Final finite automaton exposed to conformance and compatibility proofs. -/
structure TypeAutomaton : Type where
  signature : TypeAlphabet
  states : Finset TypeAutomatonState
  initial : TypeAutomatonState
  accepting : Finset TypeAutomatonState
  alphabet : Finset TypeAutomatonSymbol
  edges : Finset TypeAutomatonEdge

namespace TypeAutomaton

  /-- Membership of a decorated edge in the finite transition relation. -/
  def HasEdge (automaton : TypeAutomaton)
      (source : TypeAutomatonState) (env : TypeEnvironment) (label : TypeLabel)
      (offers : TypeOfferSummary) (target : TypeAutomatonState) : Prop :=
    { source := source,
      symbol := { environment := env, label := label, offers := offers },
      target := target } ∈ automaton.edges

end TypeAutomaton

/-- States mentioned by a finite decorated edge relation. -/
private def typeAutomatonEdgeStates
    (edges : Finset TypeAutomatonEdge) : Finset TypeAutomatonState :=
  edges.biUnion fun edge => {edge.source, edge.target}

/-- A visible edge in `processType`'s own compiled fragment, resolved
against the doc-accurate global `OF` (`computeFutureOf`) rather than a local,
edge-only closure — this is what makes a product state's future menu include
its two components' own menus natively, with no synthetic edge needed.  This
is the internal edge view used by the structural correspondence proof, before
the public alphabet filter is applied. -/
def AutomatonFragment.HasResolvedEdge (signature : TypeAlphabet)
    (processType : PactType) (fragment : AutomatonFragment)
    (source : TypeAutomatonState) (env : TypeEnvironment) (label : TypeLabel)
    (offers : TypeOfferSummary) (target : TypeAutomatonState) : Prop :=
  ∃ edge ∈ fragment.edges,
    edge.source = source ∧ edge.environment = env ∧
      edge.label = .visible label ∧ edge.current = offers.current ∧
      (match edge.future with
        | .explicit future => future
        | .at state removed => computeFutureOf signature processType state \ removed)
        = offers.future ∧
      edge.target = target

/-- Resolve every symbolic future reference with the paper's global,
product-aware `computeFutureOf` function. -/
def resolvedAutomatonEdges (signature : TypeAlphabet)
    (processType : PactType) (fragment : AutomatonFragment) :
    Finset AutomatonFragmentEdge :=
  resolveAutomatonEdgesWith fragment (computeFutureOf signature processType)

/--
Compile a type by composing its constructor automata,
then remove unresolved variable edges and transitions outside the fixed external alphabet.
-/
def compileType
    (signature : TypeAlphabet)
    (processType : PactType) : TypeAutomaton :=
  let fuel := typeCompilationFuel processType
  let constructed := compileTypeFuel signature fuel processType
  let constructedEdges :=
    resolvedAutomatonEdges signature processType constructed
  let transitionAlphabet :=
    signature.transitionAlphabetFor processType.alphabet
  let edges : Finset TypeAutomatonEdge := constructedEdges.biUnion fun edge =>
    match edge.label with
    | .variable _ => ∅
    | .visible label =>
        let symbol : TypeAutomatonSymbol :=
          { environment := edge.environment
            label := label
            offers := { current := edge.current, future := edge.future } }
        if symbol ∈ transitionAlphabet then
          {{ source := edge.source, symbol := symbol, target := edge.target }}
        else ∅
  { signature := signature
    -- Closing the exported carrier under edge endpoints makes the usual
    -- finite-automaton state invariant explicit even if an intermediate
    -- constructor has retained an otherwise unreachable endpoint.
    states := constructed.states ∪ typeAutomatonEdgeStates edges
    initial := constructed.initial
    accepting := constructed.accepting
    alphabet := transitionAlphabet
    edges := edges }

@[simp] theorem compileType_alphabet
    (signature : TypeAlphabet) (processType : PactType) :
    (compileType signature processType).alphabet =
      signature.transitionAlphabetFor processType.alphabet := by
  rfl

/-- Once a symbol belongs to the fixed alphabet, public edge membership is
exactly resolved membership in the constructor fragment. -/
theorem compileType_hasEdge_iff_hasResolvedEdge
    (signature : TypeAlphabet) (processType : PactType)
    (source target : TypeAutomatonState) (env : TypeEnvironment)
    (label : TypeLabel) (offers : TypeOfferSummary)
    (hSymbol : TypeAutomatonSymbol.mk env label offers ∈
      signature.transitionAlphabetFor processType.alphabet) :
    (compileType signature processType).HasEdge source env label offers target ↔
      AutomatonFragment.HasResolvedEdge signature processType
        (compileTypeFuel signature (typeCompilationFuel processType) processType)
        source env label offers target := by
  classical
  simp [TypeAutomaton.HasEdge, compileType,
    AutomatonFragment.HasResolvedEdge, resolvedAutomatonEdges,
    resolveAutomatonEdgesWith, hSymbol]
  aesop

/-- Once the visible symbol is admitted by the type's fixed alphabet, a
public edge is equivalently the corresponding resolved fragment edge. -/
theorem compileType_hasEdge_iff_resolvedEdge_mem
    (signature : TypeAlphabet) (processType : PactType)
    (source target : TypeAutomatonState) (env : TypeEnvironment)
    (label : TypeLabel) (offers : TypeOfferSummary)
    (hSymbol : TypeAutomatonSymbol.mk env label offers ∈
      signature.transitionAlphabetFor processType.alphabet) :
    (compileType signature processType).HasEdge source env label offers target ↔
      ({ source := source,
          environment := env,
          label := .visible label,
          current := offers.current,
          future := offers.future,
          target := target } : AutomatonFragmentEdge) ∈
        resolveAutomatonEdgesWith
          (compileTypeFuel signature (typeCompilationFuel processType)
            processType)
          (computeFutureOf signature processType) := by
  rw [compileType_hasEdge_iff_hasResolvedEdge signature processType source
    target env label offers hSymbol]
  simp [AutomatonFragment.HasResolvedEdge, resolveAutomatonEdgesWith]
  aesop

/-- The source of every compiled transition belongs to the exported state
carrier. -/
theorem compileType_edge_source_mem
    (signature : TypeAlphabet) (processType : PactType)
    {source target : TypeAutomatonState} {env : TypeEnvironment}
    {label : TypeLabel} {offers : TypeOfferSummary}
    (hEdge : (compileType signature processType).HasEdge
      source env label offers target) :
    source ∈ (compileType signature processType).states := by
  simp only [TypeAutomaton.HasEdge] at hEdge
  simp only [compileType, Finset.mem_union]
  right
  apply Finset.mem_biUnion.mpr
  refine ⟨
    { source := source
      symbol := { environment := env, label := label, offers := offers }
      target := target }, hEdge, ?_⟩
  simp

/-- The target of every compiled transition belongs to the exported state
carrier. -/
theorem compileType_edge_target_mem
    (signature : TypeAlphabet) (processType : PactType)
    {source target : TypeAutomatonState} {env : TypeEnvironment}
    {label : TypeLabel} {offers : TypeOfferSummary}
    (hEdge : (compileType signature processType).HasEdge
      source env label offers target) :
    target ∈ (compileType signature processType).states := by
  simp only [TypeAutomaton.HasEdge] at hEdge
  simp only [compileType, Finset.mem_union]
  right
  apply Finset.mem_biUnion.mpr
  refine ⟨
    { source := source
      symbol := { environment := env, label := label, offers := offers }
      target := target }, hEdge, ?_⟩
  simp

/-- Every sufficiently fuelled fragment contains its distinguished entry state. -/
theorem compileTypeFuel_initial_mem (signature : TypeAlphabet) :
    ∀ fuel processType,
      TypeCompilationFuelSufficient processType fuel →
      (compileTypeFuel signature fuel processType).initial ∈
        (compileTypeFuel signature fuel processType).states := by
  intro fuel
  induction fuel with
  | zero =>
      intro processType hFuel
      exact (Nat.not_lt_zero _
        (TypeCompilationFuelSufficient.positive hFuel)).elim
  | succ fuel ih =>
      intro processType hFuel
      cases processType with
      | message alphabet msg dir =>
          simp [compileTypeFuel, finishAutomatonFragment]
      | progress alphabet pid =>
          simp [compileTypeFuel, finishAutomatonFragment]
      | tock alphabet =>
          simp [compileTypeFuel, finishAutomatonFragment]
      | skip alphabet =>
          simp [compileTypeFuel, finishAutomatonFragment]
      | var alphabet name =>
          simp [compileTypeFuel, finishAutomatonFragment]
      | recur alphabet name body =>
          simp [compileTypeFuel, buildRecursionAutomaton,
            finishAutomatonFragment]
      | choice alphabet left right =>
          simp [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment]
      | fairChoice alphabet bid left right =>
          simp [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment]
      | seq alphabet left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hInitial :
              (compileTypeFuel signature fuel left).initial ∈
                (compileTypeFuel signature fuel left).states := ih left hLeft
          simpa [compileTypeFuel, buildSequenceAutomaton,
            finishAutomatonFragment, childStates, childState,
            initial_not_mem_sequenceDeleted] using hInitial
      | par alphabet left right interface =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hLeftMem := ih left hLeft
          have hRightMem := ih right hRight
          simp only [compileTypeFuel, buildParallelAutomaton,
            finishAutomatonFragment, Finset.mem_insert]
          refine Or.inr (Finset.mem_union_left _ (Finset.mem_union_left _
            (Finset.mem_biUnion.mpr ⟨_, hLeftMem, ?_⟩)))
          exact Finset.mem_image.mpr ⟨_, hRightMem, rfl⟩
      | xoffer alphabet elseType branches =>
          simp [compileTypeFuel, buildExclusiveOfferAutomaton,
            finishAutomatonFragment]
      | offer alphabet elseType branches =>
          simp [compileTypeFuel, buildSelectedConjunctiveOfferAutomaton,
            finishAutomatonFragment]

/-- The initial state exposed by the public compiler belongs to its state set. -/
theorem compileType_initial_mem
    (signature : TypeAlphabet) (processType : PactType) :
    (compileType signature processType).initial ∈
      (compileType signature processType).states := by
  simp only [compileType, Finset.mem_union]
  left
  apply compileTypeFuel_initial_mem signature
  exact typeCompilationFuel_sufficient processType

end

end Pact
