    rcases hShape edge hEdge hSource with ⟨hNotFuture, removed, hFuture⟩
    refine ⟨sequenceExecutionEdge edge, ⟨?_, by simpa⟩, ?_⟩
    · exact Finset.mem_image.mpr ⟨edge, hEdge, rfl⟩
