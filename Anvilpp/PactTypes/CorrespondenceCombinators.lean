private theorem compilationFragmentStepCorrect_choice_leaf
    (signature : TypeAlphabet) (left right : PactType)
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right) :
    CompilationScopedFragmentStepCorrect signature (.choice left right) := by
  intro residual residual' state env label offers hRelated hLocalEnvironment
    hAvoids
  have hAvoidsLeft : env.AvoidsInterface left.ParallelInterfaces :=
    hAvoids.mono (by simp [PactType.ParallelInterfaces])
  have hAvoidsRight : env.AvoidsInterface right.ParallelInterfaces :=
    hAvoids.mono (by simp [PactType.ParallelInterfaces])
  rcases offers with ⟨current, future⟩
  have hWellFormed := TypeAlphabet.localEnvironment_wellFormed hLocalEnvironment
  have hChoiceFuture := choiceFutureCorrect_of_compilation signature left right
    hLeft.future hRight.future
  have hFragmentEq :
      compileTypeFuel signature (typeCompilationFuel (.choice left right))
          (.choice left right) =
        buildChoiceAutomaton signature
          (compileTypeFuel signature
            (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
          (compileTypeFuel signature
            (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
          TypeLabel.silent TypeLabel.silent := by
    simp only [typeCompilationFuel, Nat.one_add, compileTypeFuel]
  cases hRelated with
  | choice_source =>
      constructor
      · rintro ⟨hTransition, hOffers⟩
        cases hTransition with
        | choice_left =>
            obtain ⟨rfl, rfl⟩ := TypeOffers.choice_left_fields hOffers
            refine ⟨.child 0 (compileTypeFuel signature
                (typeCompilationFuel left) left).initial, ?_, ?_⟩
            · show AutomatonFragment.HasResolvedEdge
                (compileTypeFuel signature (typeCompilationFuel (.choice left right))
                  (.choice left right)) .root env TypeLabel.silent
                { current := ∅, future := typeFutureOffers left }
                (.child 0 (compileTypeFuel signature (typeCompilationFuel left)
                  left).initial)
              rw [hFragmentEq]
              apply (buildChoiceAutomaton_root_hasResolvedEdge_iff signature
                (compileTypeFuel signature
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
                (compileTypeFuel signature
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
                TypeLabel.silent TypeLabel.silent env TypeLabel.silent
                { current := ∅, future := typeFutureOffers left }
                (.child 0 (compileTypeFuel signature (typeCompilationFuel left)
                  left).initial)).mpr
              left
              have hFuel : TypeCompilationFuelSufficient left
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
                simp [TypeCompilationFuelSufficient]
              have hStable := compileTypeFuel_eq_of_sufficient signature left
                hFuel (typeCompilationFuel_sufficient left)
              exact ⟨hLocalEnvironment, rfl, rfl, hChoiceFuture.1, by rw [hStable]⟩
            · exact TypeCompilationRelation.choice_left left right left _
                (compileType_initial_relation signature left)
        | choice_right =>
            obtain ⟨rfl, rfl⟩ := TypeOffers.choice_right_fields hOffers
            refine ⟨.child 1 (compileTypeFuel signature
                (typeCompilationFuel right) right).initial, ?_, ?_⟩
            · show AutomatonFragment.HasResolvedEdge
                (compileTypeFuel signature (typeCompilationFuel (.choice left right))
                  (.choice left right)) .root env TypeLabel.silent
                { current := ∅, future := typeFutureOffers right }
                (.child 1 (compileTypeFuel signature (typeCompilationFuel right)
                  right).initial)
              rw [hFragmentEq]
              apply (buildChoiceAutomaton_root_hasResolvedEdge_iff signature
                (compileTypeFuel signature
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
                (compileTypeFuel signature
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
                TypeLabel.silent TypeLabel.silent env TypeLabel.silent
                { current := ∅, future := typeFutureOffers right }
                (.child 1 (compileTypeFuel signature (typeCompilationFuel right)
                  right).initial)).mpr
              right
              have hFuel : TypeCompilationFuelSufficient right
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
                simp [TypeCompilationFuelSufficient]
              have hStable := compileTypeFuel_eq_of_sufficient signature right
                hFuel (typeCompilationFuel_sufficient right)
              exact ⟨hLocalEnvironment, rfl, rfl, hChoiceFuture.2, by rw [hStable]⟩
            · exact TypeCompilationRelation.choice_right left right right _
                (compileType_initial_relation signature right)
      · rintro ⟨target, hEdge, hTarget⟩
        have hEdge' : AutomatonFragment.HasResolvedEdge
            (buildChoiceAutomaton signature
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
              TypeLabel.silent TypeLabel.silent)
            .root env label { current := current, future := future } target := by
          rw [← hFragmentEq]; exact hEdge
        have hFields := (buildChoiceAutomaton_root_hasResolvedEdge_iff signature
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
            TypeLabel.silent TypeLabel.silent env label
            { current := current, future := future } target).mp hEdge'
        rcases hFields with hLeftSel | hRightSel
        · obtain ⟨_, hLabel, hCurrent, hComputed, hTargetEq⟩ := hLeftSel

          subst hLabel
          subst hCurrent
          have hFuel : TypeCompilationFuelSufficient left
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hStable := compileTypeFuel_eq_of_sufficient signature left
            hFuel (typeCompilationFuel_sufficient left)
          rw [hStable] at hTargetEq
          simp only at hComputed
          have hFutureEq : future = typeFutureOffers left := by
            rw [← hComputed]; simpa using hChoiceFuture.1
          subst hFutureEq
          subst hTargetEq
          cases hTarget with
          | choice_left _ _ _ _ hChildTarget =>
              have hResidual := TypeCompilationRelation.residual_unique
                hChildTarget (compileType_initial_relation signature left)
              cases hResidual
              exact ⟨TypeTransition.choice_left env left right hWellFormed,
                TypeOffers.choice_left env left right hWellFormed⟩
        · obtain ⟨_, hLabel, hCurrent, hComputed, hTargetEq⟩ := hRightSel
          subst hLabel
          subst hCurrent
          have hFuel : TypeCompilationFuelSufficient right
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hStable := compileTypeFuel_eq_of_sufficient signature right
            hFuel (typeCompilationFuel_sufficient right)
          rw [hStable] at hTargetEq
          simp only at hComputed
          have hFutureEq : future = typeFutureOffers right := by
            rw [← hComputed]; simpa using hChoiceFuture.2
          subst hFutureEq
          subst hTargetEq
          cases hTarget with
          | choice_right _ _ _ _ hChildTarget =>
              have hResidual := TypeCompilationRelation.residual_unique
                hChildTarget (compileType_initial_relation signature right)
              cases hResidual
              exact ⟨TypeTransition.choice_right env left right hWellFormed,
                TypeOffers.choice_right env left right hWellFormed⟩
  | choice_left _ _ childResidual childState hChildRelated =>
      constructor
      · intro hStep
        rcases (hLeft.scopedStep (residual' := residual') (label := label)
            (offers := { current := current, future := future })
            hChildRelated hLocalEnvironment hAvoidsLeft).mp hStep with
          ⟨childTarget, hChildEdge, hChildTarget⟩
        refine ⟨.child 0 childTarget, ?_, ?_⟩
        · show AutomatonFragment.HasResolvedEdge
            (compileTypeFuel signature (typeCompilationFuel (.choice left right))
              (.choice left right)) (.child 0 childState) env label
            { current := current, future := future } (.child 0 childTarget)
          rw [hFragmentEq]
          have hFuel : TypeCompilationFuelSufficient left
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hTargets := compileTypeFuel_futureTargetsInStates signature
            (max (typeCompilationFuel left) (typeCompilationFuel right)) left hFuel
          apply (buildChoiceAutomaton_hasResolvedEdge_left_iff signature
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
            TypeLabel.silent TypeLabel.silent childState childTarget env label
            { current := current, future := future } hTargets).mpr
          have hStable := compileTypeFuel_eq_of_sufficient signature left
            hFuel (typeCompilationFuel_sufficient left)
          rw [hStable]
          exact hChildEdge
        · exact TypeCompilationRelation.choice_left left right residual'
            childTarget hChildTarget
      · rintro ⟨target, hEdge, hTarget⟩
        have hEdge' : AutomatonFragment.HasResolvedEdge
            (buildChoiceAutomaton signature
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
              TypeLabel.silent TypeLabel.silent)
            (.child 0 childState) env label
            { current := current, future := future } target := by
          rw [← hFragmentEq]; exact hEdge
        obtain ⟨childTarget, rfl, hChildEdge⟩ :=
          compileTypeFuel_choiceLike_left_target_cases signature left right
            TypeLabel.silent TypeLabel.silent hEdge'
        cases hTarget with
        | choice_left _ _ _ _ hChildTarget =>
            exact (hLeft.scopedStep (residual' := residual') (label := label)
              (offers := { current := current, future := future })
              hChildRelated hLocalEnvironment hAvoidsLeft).mpr
              ⟨childTarget, hChildEdge, hChildTarget⟩
  | choice_right _ _ childResidual childState hChildRelated =>
      constructor
      · intro hStep
        rcases (hRight.scopedStep (residual' := residual') (label := label)
            (offers := { current := current, future := future })
            hChildRelated hLocalEnvironment hAvoidsRight).mp hStep with
          ⟨childTarget, hChildEdge, hChildTarget⟩
        refine ⟨.child 1 childTarget, ?_, ?_⟩
        · show AutomatonFragment.HasResolvedEdge
            (compileTypeFuel signature (typeCompilationFuel (.choice left right))
              (.choice left right)) (.child 1 childState) env label
            { current := current, future := future } (.child 1 childTarget)
          rw [hFragmentEq]
          have hFuelR : TypeCompilationFuelSufficient right
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hTargets := compileTypeFuel_futureTargetsInStates signature
            (max (typeCompilationFuel left) (typeCompilationFuel right)) right hFuelR
          apply (buildChoiceAutomaton_hasResolvedEdge_right_iff signature
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
            TypeLabel.silent TypeLabel.silent childState childTarget env label
            { current := current, future := future } hTargets).mpr
          have hFuel : TypeCompilationFuelSufficient right
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hStable := compileTypeFuel_eq_of_sufficient signature right
            hFuel (typeCompilationFuel_sufficient right)
          rw [hStable]
          exact hChildEdge
        · exact TypeCompilationRelation.choice_right left right residual'
            childTarget hChildTarget
      · rintro ⟨target, hEdge, hTarget⟩
        have hEdge' : AutomatonFragment.HasResolvedEdge
            (buildChoiceAutomaton signature
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
              TypeLabel.silent TypeLabel.silent)
            (.child 1 childState) env label
            { current := current, future := future } target := by
          rw [← hFragmentEq]; exact hEdge
        obtain ⟨childTarget, rfl, hChildEdge⟩ :=
          compileTypeFuel_choiceLike_right_target_cases signature left right
            TypeLabel.silent TypeLabel.silent hEdge'
        cases hTarget with
        | choice_right _ _ _ _ hChildTarget =>
            exact (hRight.scopedStep (residual' := residual') (label := label)
              (offers := { current := current, future := future })
              hChildRelated hLocalEnvironment hAvoidsRight).mpr
              ⟨childTarget, hChildEdge, hChildTarget⟩

private theorem compilationFragmentStepCorrect_fairChoice_leaf
    (signature : TypeAlphabet) (bid : BranchId) (left right : PactType)
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right) :
    CompilationScopedFragmentStepCorrect signature
      (.fairChoice bid left right) := by
  intro residual residual' state env label offers hRelated hLocalEnvironment
    hAvoids
  have hAvoidsLeft : env.AvoidsInterface left.ParallelInterfaces :=
    hAvoids.mono (by simp [PactType.ParallelInterfaces])
  have hAvoidsRight : env.AvoidsInterface right.ParallelInterfaces :=
    hAvoids.mono (by simp [PactType.ParallelInterfaces])
  rcases offers with ⟨current, future⟩
  have hWellFormed := TypeAlphabet.localEnvironment_wellFormed hLocalEnvironment
  have hFairFuture := fairChoiceFutureCorrect_of_compilation signature bid left
    right hLeft.future hRight.future
  have hFragmentEq :
      compileTypeFuel signature
          (typeCompilationFuel (.fairChoice bid left right))
          (.fairChoice bid left right) =
        buildChoiceAutomaton signature
          (compileTypeFuel signature
            (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
          (compileTypeFuel signature
            (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
          (TypeLabel.fair bid true) (TypeLabel.fair bid false) := by
    simp only [typeCompilationFuel, Nat.one_add, compileTypeFuel]
  cases hRelated with
  | fair_source =>
      constructor
      · rintro ⟨hTransition, hOffers⟩
        cases hTransition with
        | fair_left =>
            obtain ⟨rfl, rfl⟩ := TypeOffers.fair_left_fields hOffers
            refine ⟨.child 0 (compileTypeFuel signature
                (typeCompilationFuel left) left).initial, ?_, ?_⟩
            · show AutomatonFragment.HasResolvedEdge
                (compileTypeFuel signature
                  (typeCompilationFuel (.fairChoice bid left right))
                  (.fairChoice bid left right)) .root env (TypeLabel.fair bid true)
                { current := ∅, future := typeFutureOffers left }
                (.child 0 (compileTypeFuel signature (typeCompilationFuel left)
                  left).initial)
              rw [hFragmentEq]
              apply (buildChoiceAutomaton_root_hasResolvedEdge_iff signature
                (compileTypeFuel signature
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
                (compileTypeFuel signature
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
                (TypeLabel.fair bid true) (TypeLabel.fair bid false) env
                (TypeLabel.fair bid true)
                { current := ∅, future := typeFutureOffers left }
                (.child 0 (compileTypeFuel signature (typeCompilationFuel left)
                  left).initial)).mpr
              left
              have hFuel : TypeCompilationFuelSufficient left
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
                simp [TypeCompilationFuelSufficient]
              have hStable := compileTypeFuel_eq_of_sufficient signature left
                hFuel (typeCompilationFuel_sufficient left)
              exact ⟨hLocalEnvironment, rfl, rfl, hFairFuture.1, by rw [hStable]⟩
            · exact TypeCompilationRelation.fair_left bid left right left _
                (compileType_initial_relation signature left)
        | fair_right =>
            obtain ⟨rfl, rfl⟩ := TypeOffers.fair_right_fields hOffers
            refine ⟨.child 1 (compileTypeFuel signature
                (typeCompilationFuel right) right).initial, ?_, ?_⟩
            · show AutomatonFragment.HasResolvedEdge
                (compileTypeFuel signature
                  (typeCompilationFuel (.fairChoice bid left right))
                  (.fairChoice bid left right)) .root env
                (TypeLabel.fair bid false)
                { current := ∅, future := typeFutureOffers right }
                (.child 1 (compileTypeFuel signature (typeCompilationFuel right)
                  right).initial)
              rw [hFragmentEq]
              apply (buildChoiceAutomaton_root_hasResolvedEdge_iff signature
                (compileTypeFuel signature
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
                (compileTypeFuel signature
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
                (TypeLabel.fair bid true) (TypeLabel.fair bid false) env
                (TypeLabel.fair bid false)
                { current := ∅, future := typeFutureOffers right }
                (.child 1 (compileTypeFuel signature (typeCompilationFuel right)
                  right).initial)).mpr
              right
              have hFuel : TypeCompilationFuelSufficient right
                  (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
                simp [TypeCompilationFuelSufficient]
              have hStable := compileTypeFuel_eq_of_sufficient signature right
                hFuel (typeCompilationFuel_sufficient right)
              exact ⟨hLocalEnvironment, rfl, rfl, hFairFuture.2, by rw [hStable]⟩
            · exact TypeCompilationRelation.fair_right bid left right right _
                (compileType_initial_relation signature right)
      · rintro ⟨target, hEdge, hTarget⟩
        have hEdge' : AutomatonFragment.HasResolvedEdge
            (buildChoiceAutomaton signature
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
              (TypeLabel.fair bid true) (TypeLabel.fair bid false))
            .root env label { current := current, future := future } target := by
          rw [← hFragmentEq]; exact hEdge
        have hFields := (buildChoiceAutomaton_root_hasResolvedEdge_iff signature
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
            (TypeLabel.fair bid true) (TypeLabel.fair bid false) env label
            { current := current, future := future } target).mp hEdge'
        rcases hFields with hLeftSel | hRightSel
        · obtain ⟨_, hLabel, hCurrent, hComputed, hTargetEq⟩ := hLeftSel
          subst hLabel
          subst hCurrent
          have hFuel : TypeCompilationFuelSufficient left
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hStable := compileTypeFuel_eq_of_sufficient signature left
            hFuel (typeCompilationFuel_sufficient left)
          rw [hStable] at hTargetEq
          simp only at hComputed
          have hFutureEq : future = typeFutureOffers left := by
            rw [← hComputed]; simpa using hFairFuture.1
          subst hFutureEq
          subst hTargetEq
          cases hTarget with
          | fair_left _ _ _ _ _ hChildTarget =>
              have hResidual := TypeCompilationRelation.residual_unique
                hChildTarget (compileType_initial_relation signature left)
              cases hResidual
              exact ⟨TypeTransition.fair_left env bid left right hWellFormed,
                TypeOffers.fair_left env bid left right hWellFormed⟩
        · obtain ⟨_, hLabel, hCurrent, hComputed, hTargetEq⟩ := hRightSel
          subst hLabel
          subst hCurrent
          have hFuel : TypeCompilationFuelSufficient right
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hStable := compileTypeFuel_eq_of_sufficient signature right
            hFuel (typeCompilationFuel_sufficient right)
          rw [hStable] at hTargetEq
          simp only at hComputed
          have hFutureEq : future = typeFutureOffers right := by
            rw [← hComputed]; simpa using hFairFuture.2
          subst hFutureEq
          subst hTargetEq
          cases hTarget with
          | fair_right _ _ _ _ _ hChildTarget =>
              have hResidual := TypeCompilationRelation.residual_unique
                hChildTarget (compileType_initial_relation signature right)
              cases hResidual
              exact ⟨TypeTransition.fair_right env bid left right hWellFormed,
                TypeOffers.fair_right env bid left right hWellFormed⟩
  | fair_left _ _ _ childResidual childState hChildRelated =>
      constructor
      · intro hStep
        rcases (hLeft.scopedStep (residual' := residual') (label := label)
            (offers := { current := current, future := future })
            hChildRelated hLocalEnvironment hAvoidsLeft).mp hStep with
          ⟨childTarget, hChildEdge, hChildTarget⟩
        refine ⟨.child 0 childTarget, ?_, ?_⟩
        · show AutomatonFragment.HasResolvedEdge
            (compileTypeFuel signature
              (typeCompilationFuel (.fairChoice bid left right))
              (.fairChoice bid left right)) (.child 0 childState) env label
            { current := current, future := future } (.child 0 childTarget)
          rw [hFragmentEq]
          have hFuel : TypeCompilationFuelSufficient left
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hTargets := compileTypeFuel_futureTargetsInStates signature
            (max (typeCompilationFuel left) (typeCompilationFuel right)) left hFuel
          apply (buildChoiceAutomaton_hasResolvedEdge_left_iff signature
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
            (TypeLabel.fair bid true) (TypeLabel.fair bid false) childState
            childTarget env label
            { current := current, future := future } hTargets).mpr
          have hStable := compileTypeFuel_eq_of_sufficient signature left
            hFuel (typeCompilationFuel_sufficient left)
          rw [hStable]
          exact hChildEdge
        · exact TypeCompilationRelation.fair_left bid left right residual'
            childTarget hChildTarget
      · rintro ⟨target, hEdge, hTarget⟩
        have hEdge' : AutomatonFragment.HasResolvedEdge
            (buildChoiceAutomaton signature
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
              (TypeLabel.fair bid true) (TypeLabel.fair bid false))
            (.child 0 childState) env label
            { current := current, future := future } target := by
          rw [← hFragmentEq]; exact hEdge
        obtain ⟨childTarget, rfl, hChildEdge⟩ :=
          compileTypeFuel_choiceLike_left_target_cases signature left right
            (TypeLabel.fair bid true) (TypeLabel.fair bid false) hEdge'
        cases hTarget with
        | fair_left _ _ _ _ _ hChildTarget =>
            exact (hLeft.scopedStep (residual' := residual') (label := label)
              (offers := { current := current, future := future })
              hChildRelated hLocalEnvironment hAvoidsLeft).mpr
              ⟨childTarget, hChildEdge, hChildTarget⟩
  | fair_right _ _ _ childResidual childState hChildRelated =>
      constructor
      · intro hStep
        rcases (hRight.scopedStep (residual' := residual') (label := label)
            (offers := { current := current, future := future })
            hChildRelated hLocalEnvironment hAvoidsRight).mp hStep with
          ⟨childTarget, hChildEdge, hChildTarget⟩
        refine ⟨.child 1 childTarget, ?_, ?_⟩
        · show AutomatonFragment.HasResolvedEdge
            (compileTypeFuel signature
              (typeCompilationFuel (.fairChoice bid left right))
              (.fairChoice bid left right)) (.child 1 childState) env label
            { current := current, future := future } (.child 1 childTarget)
          rw [hFragmentEq]
          have hFuelR : TypeCompilationFuelSufficient right
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hTargets := compileTypeFuel_futureTargetsInStates signature
            (max (typeCompilationFuel left) (typeCompilationFuel right)) right hFuelR
          apply (buildChoiceAutomaton_hasResolvedEdge_right_iff signature
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
            (compileTypeFuel signature
              (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
            (TypeLabel.fair bid true) (TypeLabel.fair bid false) childState
            childTarget env label
            { current := current, future := future } hTargets).mpr
          have hFuel : TypeCompilationFuelSufficient right
              (max (typeCompilationFuel left) (typeCompilationFuel right)) := by
            simp [TypeCompilationFuelSufficient]
          have hStable := compileTypeFuel_eq_of_sufficient signature right
            hFuel (typeCompilationFuel_sufficient right)
          rw [hStable]
          exact hChildEdge
        · exact TypeCompilationRelation.fair_right bid left right residual'
            childTarget hChildTarget
      · rintro ⟨target, hEdge, hTarget⟩
        have hEdge' : AutomatonFragment.HasResolvedEdge
            (buildChoiceAutomaton signature
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
              (compileTypeFuel signature
                (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
              (TypeLabel.fair bid true) (TypeLabel.fair bid false))
            (.child 1 childState) env label
            { current := current, future := future } target := by
          rw [← hFragmentEq]; exact hEdge
        obtain ⟨childTarget, rfl, hChildEdge⟩ :=
          compileTypeFuel_choiceLike_right_target_cases signature left right
            (TypeLabel.fair bid true) (TypeLabel.fair bid false) hEdge'
        cases hTarget with
        | fair_right _ _ _ _ _ hChildTarget =>
            exact (hRight.scopedStep (residual' := residual') (label := label)
              (offers := { current := current, future := future })
              hChildRelated hLocalEnvironment hAvoidsRight).mpr
              ⟨childTarget, hChildEdge, hChildTarget⟩

/-- Local graph fold for a tagged left sequence state.  The sequence builder
redecorates every non-construction edge by a reference to its target, so this
lemma is deliberately stated below the constructor theorem: it is the finite
closure calculation, not another semantic correspondence theorem. -/
private theorem buildSequenceAutomaton_computeFuture_left_of_bundle
    (signature : TypeAlphabet) (left right : PactType)
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right)
    (hLeftExecution : CompilationSequenceExecutionCorrect signature left)
    (state : TypeAutomatonState) (residual : PactType)
    (hRelated : TypeCompilationRelation left state residual) :
    let fuel := max (typeCompilationFuel left) (typeCompilationFuel right)
    let leftFragment := compileTypeFuel signature fuel left
    let rightFragment := compileTypeFuel signature fuel right
    let sequence := buildSequenceAutomaton signature leftFragment rightFragment
    let pending : PendingAutomaton :=
      { states := sequence.states, edges := sequence.edges }
    computeFuture pending (.child 0 state) =
      typeFutureOffers (.seq residual right) := by
  let fuel := max (typeCompilationFuel left) (typeCompilationFuel right)
  let leftFragment := compileTypeFuel signature fuel left
  let rightFragment := compileTypeFuel signature fuel right
  let sequence := buildSequenceAutomaton signature leftFragment rightFragment
  let pending : PendingAutomaton :=
    { states := sequence.states, edges := sequence.edges }
  let leftExecution := sequenceExecutionAutomaton leftFragment
  let rightPending : PendingAutomaton :=
    { states := rightFragment.states, edges := rightFragment.edges }
  let leftReach := leftExecution.futureReachable state
  let canBridge := ∃ completed ∈ leftReach,
    completed ∈ leftFragment.skipping ∨
      completed ∈ leftFragment.completing
  have hLeftFuel : TypeCompilationFuelSufficient left fuel := by
    simp [TypeCompilationFuelSufficient, fuel]
  have hRightFuel : TypeCompilationFuelSufficient right fuel := by
    simp [TypeCompilationFuelSufficient, fuel]
  have hLeftStable : leftFragment = compileTypeFuel signature
      (typeCompilationFuel left) left :=
    compileTypeFuel_eq_of_sufficient signature left hLeftFuel
      (typeCompilationFuel_sufficient left)
  have hRightStable : rightFragment = compileTypeFuel signature
      (typeCompilationFuel right) right :=
    compileTypeFuel_eq_of_sufficient signature right hRightFuel
      (typeCompilationFuel_sufficient right)
  have hLeftState : state ∈ leftFragment.states := by
    have hCanonical := compilationStateCorrect_of_compilation signature left
      state residual hRelated
    simpa [leftFragment, hLeftStable] using hCanonical
  have hRightInitial : rightFragment.initial ∈ rightFragment.states :=
    compileTypeFuel_initial_mem signature fuel right hRightFuel
  have hLeftTargets : leftFragment.FutureTargetsInStates :=
    compileTypeFuel_futureTargetsInStates signature fuel left hLeftFuel
  have hRightTargets : rightFragment.FutureTargetsInStates :=
    compileTypeFuel_futureTargetsInStates signature fuel right hRightFuel
  have hFormula := buildSequenceAutomaton_computeFuture_left_formula signature
    leftFragment rightFragment state hLeftState hLeftTargets hRightTargets
      hRightInitial
  have hExecutionCanonical := hLeftExecution state residual hRelated
  have hExecution : computeFuture leftExecution state =
      typeFutureOffers residual := by
    simpa [CompilationSequenceExecutionCorrect, leftExecution, leftFragment,
      hLeftStable] using hExecutionCanonical.1
  have hBridgeIff : canBridge ↔
      residual.CanCompleteBeforeTock = true := by
    simpa [CompilationSequenceExecutionCorrect, canBridge, leftReach,
      leftExecution, leftFragment, hLeftStable] using
        hExecutionCanonical.2
  have hRightFuture : computeFuture rightPending rightFragment.initial =
      typeFutureOffers right := by
    have hInitialRelation := compileTypeFuel_initial_relation signature fuel
      right hRightFuel
    have hCanonical := hRight.future rightFragment.initial right
      hInitialRelation
    simpa [rightPending, rightFragment, hRightStable] using hCanonical
  have hFormula' : computeFuture pending (.child 0 state) =
      computeFuture leftExecution state ∪
        if canBridge then computeFuture rightPending rightFragment.initial
        else ∅ := by
    simpa [pending, sequence, leftExecution, rightPending, leftReach,
      canBridge] using hFormula
  change computeFuture pending (.child 0 state) =
    typeFutureOffers (.seq residual right)
  rw [hFormula', hExecution, hRightFuture, typeFutureOffers_sequence]
  by_cases hComplete : residual.CanCompleteBeforeTock = true
  · have hCanBridge := hBridgeIff.mpr hComplete
    simp [hComplete, hCanBridge]
  · have hCannotBridge : ¬ canBridge := fun h =>
      hComplete (hBridgeIff.mp h)
    simp [hComplete, hCannotBridge]

/-- The remaining sequence-future leaf.  Its lower bound is
`buildSequenceAutomaton_rightFuture_subset_of_completing`; the unfinished
direction is the local upper-bound showing that re-decorated left edges expose
no offers beyond the syntactic residual menu. -/
theorem compilationFutureCorrect_sequence
    (signature : TypeAlphabet) (left right : PactType)
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right)
    (hLeftExecution : CompilationSequenceExecutionCorrect signature left) :
    CompilationFutureCorrect signature (.seq left right) := by
  intro state residual hRelated
  let fuel := max (typeCompilationFuel left) (typeCompilationFuel right)
  let leftFragment := compileTypeFuel signature fuel left
  let rightFragment := compileTypeFuel signature fuel right
  let sequence := buildSequenceAutomaton signature leftFragment rightFragment
  let pending : PendingAutomaton :=
    { states := sequence.states, edges := sequence.edges }
  have hLeftFuel : TypeCompilationFuelSufficient left fuel := by
    simp [TypeCompilationFuelSufficient, fuel]
  have hRightFuel : TypeCompilationFuelSufficient right fuel := by
    simp [TypeCompilationFuelSufficient, fuel]
  have hLeftStable : leftFragment = compileTypeFuel signature
      (typeCompilationFuel left) left :=
    compileTypeFuel_eq_of_sufficient signature left hLeftFuel
      (typeCompilationFuel_sufficient left)
  have hRightStable : rightFragment = compileTypeFuel signature
      (typeCompilationFuel right) right :=
    compileTypeFuel_eq_of_sufficient signature right hRightFuel
      (typeCompilationFuel_sufficient right)
  have hFragment : compileTypeFuel signature
      (typeCompilationFuel (.seq left right)) (.seq left right) = sequence := by
    simp only [typeCompilationFuel, Nat.one_add, compileTypeFuel]
    rfl
  rw [hFragment]
  cases hRelated with
  | sequence_left _ _ childResidual childState hChildRelated =>
      simpa [fuel, leftFragment, rightFragment, sequence, pending] using
        buildSequenceAutomaton_computeFuture_left_of_bundle signature left
          right hLeft hRight hLeftExecution childState childResidual
            hChildRelated
  | sequence_right _ _ _ childState hChildRelated =>
      have hRightState : childState ∈ rightFragment.states := by
        have hCanonical := compilationStateCorrect_of_compilation signature
          right childState residual hChildRelated
        simpa [rightFragment, hRightStable] using hCanonical
      have hRightTargets : rightFragment.FutureTargetsInStates :=
        compileTypeFuel_futureTargetsInStates signature fuel right hRightFuel
      have hRightClosed : ({ states := rightFragment.states, edges :=
          rightFragment.edges } : PendingAutomaton).ReferencesClosed :=
        PendingAutomaton.referencesClosed_of_futureTargetsInStates
          rightFragment hRightTargets
      have hRightCard : rightFragment.states.card ≤ sequence.states.card := by
        have hSubset : childStates 1 rightFragment ⊆ sequence.states := by
          intro child hChild
          simp [sequence, buildSequenceAutomaton, finishAutomatonFragment,
            hChild]
        calc
          rightFragment.states.card = (childStates 1 rightFragment).card := by
            simp only [childStates]
            symm
            apply Finset.card_image_of_injective
            intro first second hEqual
            injection hEqual
          _ ≤ sequence.states.card := Finset.card_le_card hSubset
      have hEmbedded := buildSequenceAutomaton_computeFuture_right signature
        leftFragment rightFragment childState hRightClosed hRightState hRightCard
      have hCanonical := hRight.future childState residual hChildRelated
      rw [hEmbedded]
      simpa [rightFragment, hRightStable, pending, sequence] using hCanonical

theorem compilationResolvedEdgeTargetsRelated_sequence
    (signature : TypeAlphabet) (left right : PactType)
    (hLeftTargets : CompilationResolvedEdgeTargetsRelated signature left)
    (hRightTargets : CompilationResolvedEdgeTargetsRelated signature right) :
    CompilationResolvedEdgeTargetsRelated signature (.seq left right) := by
  intro source residual environment label offers target hRelated hEdge
  cases hRelated with
  | sequence_left _ _ childResidual childState hChildRelated =>
      rcases compileTypeFuel_sequence_left_edge_cases signature left right
          hEdge with hChild | hBridge
      · rcases hChild with
          ⟨childTarget, childFuture, rfl, hChildEdge, _⟩
        obtain ⟨targetResidual, hTargetRelated⟩ :=
          hLeftTargets hChildRelated hChildEdge
        exact ⟨.seq targetResidual right,
          TypeCompilationRelation.sequence_left left right targetResidual
            childTarget hTargetRelated⟩
      · rcases hBridge with ⟨_, _, _, _, _, rfl⟩
        have hInitial : TypeCompilationRelation right
            (compileTypeFuel signature (typeCompilationFuel right) right).initial
            right :=
          compileTypeFuel_initial_relation signature
            (typeCompilationFuel right) right
            (typeCompilationFuel_sufficient right)
        exact ⟨right, TypeCompilationRelation.sequence_right left right
          right _ hInitial⟩
  | sequence_right _ _ childResidual childState hChildRelated =>
      rcases compileTypeFuel_sequence_right_edge_cases signature left right
          hEdge with ⟨childTarget, rfl, hChildEdge⟩
      obtain ⟨targetResidual, hTargetRelated⟩ :=
        hRightTargets hChildRelated hChildEdge
      exact ⟨targetResidual,
        TypeCompilationRelation.sequence_right left right targetResidual
          childTarget hTargetRelated⟩


theorem compilationResolvedEdgeTargetsRelated_choice
    (signature : TypeAlphabet) (left right : PactType)
    (hLeftTargets : CompilationResolvedEdgeTargetsRelated signature left)
    (hRightTargets : CompilationResolvedEdgeTargetsRelated signature right) :
    CompilationResolvedEdgeTargetsRelated signature (.choice left right) := by
  intro source residual environment label offers target hRelated hEdge
  have hParent : AutomatonFragment.HasResolvedEdge
      (buildChoiceAutomaton signature
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
        TypeLabel.silent TypeLabel.silent)
      source environment label offers target := by
    simpa only [typeCompilationFuel, Nat.one_add, compileTypeFuel] using hEdge
  cases hRelated with
  | choice_source =>
      rcases compileTypeFuel_choiceLike_root_target_cases signature left right
          TypeLabel.silent TypeLabel.silent hParent with hSelected | hSelected
      · rw [hSelected]
        have hInitial := compileTypeFuel_initial_relation signature
          (typeCompilationFuel left) left (typeCompilationFuel_sufficient left)
        exact ⟨left, TypeCompilationRelation.choice_left left right left _
          hInitial⟩
      · rw [hSelected]
        have hInitial := compileTypeFuel_initial_relation signature
          (typeCompilationFuel right) right (typeCompilationFuel_sufficient right)
        exact ⟨right, TypeCompilationRelation.choice_right left right right _
          hInitial⟩
  | choice_left _ _ childResidual childState hChildRelated =>
      rcases compileTypeFuel_choiceLike_left_target_cases signature left right
          TypeLabel.silent TypeLabel.silent hParent with
        ⟨childTarget, rfl, hChildEdge⟩
      obtain ⟨targetResidual, hTargetRelated⟩ :=
        hLeftTargets hChildRelated hChildEdge
      exact ⟨targetResidual, TypeCompilationRelation.choice_left left right
        targetResidual childTarget hTargetRelated⟩
  | choice_right _ _ childResidual childState hChildRelated =>
      rcases compileTypeFuel_choiceLike_right_target_cases signature left right
          TypeLabel.silent TypeLabel.silent hParent with
        ⟨childTarget, rfl, hChildEdge⟩
      obtain ⟨targetResidual, hTargetRelated⟩ :=
        hRightTargets hChildRelated hChildEdge
      exact ⟨targetResidual, TypeCompilationRelation.choice_right left right
        targetResidual childTarget hTargetRelated⟩

theorem compilationResolvedEdgeTargetsRelated_fairChoice
    (signature : TypeAlphabet) (bid : BranchId) (left right : PactType)
    (hLeftTargets : CompilationResolvedEdgeTargetsRelated signature left)
    (hRightTargets : CompilationResolvedEdgeTargetsRelated signature right) :
    CompilationResolvedEdgeTargetsRelated signature
      (.fairChoice bid left right) := by
  intro source residual environment label offers target hRelated hEdge
  have hParent : AutomatonFragment.HasResolvedEdge
      (buildChoiceAutomaton signature
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
        (TypeLabel.fair bid true) (TypeLabel.fair bid false))
      source environment label offers target := by
    simpa only [typeCompilationFuel, Nat.one_add, compileTypeFuel] using hEdge
  cases hRelated with
  | fair_source =>
      rcases compileTypeFuel_choiceLike_root_target_cases signature left right
          (TypeLabel.fair bid true) (TypeLabel.fair bid false) hParent with
        hSelected | hSelected
      · rw [hSelected]
        have hInitial := compileTypeFuel_initial_relation signature
          (typeCompilationFuel left) left (typeCompilationFuel_sufficient left)
        exact ⟨left, TypeCompilationRelation.fair_left bid left right left _
          hInitial⟩
      · rw [hSelected]
        have hInitial := compileTypeFuel_initial_relation signature
          (typeCompilationFuel right) right (typeCompilationFuel_sufficient right)
        exact ⟨right, TypeCompilationRelation.fair_right bid left right right _
          hInitial⟩
  | fair_left _ _ _ childResidual childState hChildRelated =>
      rcases compileTypeFuel_choiceLike_left_target_cases signature left right
          (TypeLabel.fair bid true) (TypeLabel.fair bid false) hParent with
        ⟨childTarget, rfl, hChildEdge⟩
      obtain ⟨targetResidual, hTargetRelated⟩ :=
        hLeftTargets hChildRelated hChildEdge
      exact ⟨targetResidual, TypeCompilationRelation.fair_left bid left right
        targetResidual childTarget hTargetRelated⟩
  | fair_right _ _ _ childResidual childState hChildRelated =>
      rcases compileTypeFuel_choiceLike_right_target_cases signature left right
          (TypeLabel.fair bid true) (TypeLabel.fair bid false) hParent with
        ⟨childTarget, rfl, hChildEdge⟩
      obtain ⟨targetResidual, hTargetRelated⟩ :=
        hRightTargets hChildRelated hChildEdge
      exact ⟨targetResidual, TypeCompilationRelation.fair_right bid left right
        targetResidual childTarget hTargetRelated⟩

theorem compilationResolvedEdgeTargetsRelated_recursion
    (signature : TypeAlphabet) (name : String) (body : PactType)
    (hBodyTargets : CompilationResolvedEdgeTargetsRelated signature body) :
    CompilationResolvedEdgeTargetsRelated signature (.recur name body) := by
  intro source residual environment label offers target hRelated hEdge
  let bodyFragment := compileTypeFuel signature (typeCompilationFuel body) body
  let recursion := buildRecursionAutomaton signature name bodyFragment
  have hFragment : compileTypeFuel signature
      (typeCompilationFuel (.recur name body)) (.recur name body) =
        recursion := by
    simp only [typeCompilationFuel, Nat.one_add, compileTypeFuel]
    rfl
  rw [hFragment] at hEdge
  cases hRelated with
  | recur_source =>
      rcases (buildRecursionAutomaton_root_hasResolvedEdge_iff signature name
          bodyFragment environment label offers target).mp hEdge with
        ⟨_, _, _, _, rfl⟩
      have hInitial : TypeCompilationRelation body bodyFragment.initial body :=
        compileTypeFuel_initial_relation signature (typeCompilationFuel body)
          body (typeCompilationFuel_sufficient body)
      exact ⟨body.replaceVar name (.recur name body),
        TypeCompilationRelation.recur_body name body body _ hInitial⟩
  | recur_body _ _ childResidual childState hChildRelated =>
      rcases (buildRecursionAutomaton_body_hasResolvedEdge_iff signature name
          bodyFragment childState environment label offers target).mp hEdge with
        hMarker | hBody
      · rcases hMarker with
          ⟨edge, _, _, _, _, _, _, _, rfl⟩
        have hInitial : TypeCompilationRelation body bodyFragment.initial body :=
          compileTypeFuel_initial_relation signature
            (typeCompilationFuel body) body
            (typeCompilationFuel_sufficient body)
        exact ⟨body.replaceVar name (.recur name body),
          TypeCompilationRelation.recur_body name body body _ hInitial⟩
      · rcases hBody with
          ⟨edge, hPending, hSource, _, hEnvironment, hLabel, _, _, rfl⟩
        let childOffers : TypeOfferSummary :=
          { current := edge.current
            future := match edge.future with
              | .explicit future => future
              | .at state removed =>
                  computeFuture
                    { states := bodyFragment.states,
                      edges := bodyFragment.edges } state \ removed }
        have hChildEdge : bodyFragment.HasResolvedEdge childState environment
            label childOffers edge.target := by
          refine ⟨edge, hPending, hSource, hEnvironment, hLabel, rfl, ?_, rfl⟩
          cases hSpec : edge.future <;> simp [childOffers, hSpec]
        obtain ⟨targetResidual, hTargetRelated⟩ :=
          hBodyTargets hChildRelated (by
            simpa [bodyFragment] using hChildEdge)
        exact ⟨targetResidual.replaceVar name (.recur name body),
          TypeCompilationRelation.recur_body name body targetResidual
            edge.target hTargetRelated⟩

/-- Target-relatedness for the generated conjunction used by `.offer`.
The induction follows the original branch list, avoiding recursion over the
larger generated syntax tree. -/
private theorem compilationResolvedEdgeTargetsRelated_parallelTypeBranches
    (signature : TypeAlphabet) : ∀ branches,
    (∀ entry ∈ branches,
      CompilationResolvedEdgeTargetsRelated signature entry.2) →
    CompilationResolvedEdgeTargetsRelated signature
      (parallelTypeBranches branches) := by
  intro branches
  induction branches with
  | nil =>
      intro _
      change CompilationResolvedEdgeTargetsRelated signature .skip
      exact compilationResolvedEdgeTargetsRelated_skip signature
  | cons branch rest ih =>
      rcases branch with ⟨action, branchType⟩
      intro hBranches
      have hBranchTargets :
          CompilationResolvedEdgeTargetsRelated signature branchType := by
        intro source residual environment label offers target hRelated hEdge
        exact hBranches (action, branchType) (by simp) hRelated hEdge
      have hSingletonTargets : CompilationResolvedEdgeTargetsRelated signature
          (singletonTypeXOffer (action, branchType)) := by
        apply compilationResolvedEdgeTargetsRelated_xoffer signature .skip
          [(action, branchType)]
        · exact compilationResolvedEdgeTargetsRelated_skip signature
        · intro selected selectedType index hEntry
          have hIndex : index = 0 := by
            simpa using (List.getElem?_eq_some_iff.mp hEntry).1
          subst index
          simp only [List.getElem?_cons_zero, Option.some.injEq,
            Prod.mk.injEq] at hEntry
          rcases hEntry with ⟨rfl, rfl⟩
          intro source residual environment label offers target hRelated hEdge
          exact hBranchTargets hRelated hEdge
      have hRestTargets : CompilationResolvedEdgeTargetsRelated signature
          (parallelTypeBranches rest) :=
        ih (by
          intro entry hEntry
          exact hBranches entry (by simp [hEntry]))
      cases rest with
      | nil =>
          change CompilationResolvedEdgeTargetsRelated signature
            (singletonTypeXOffer (action, branchType))
          exact hSingletonTargets
      | cons next tail =>
          change CompilationResolvedEdgeTargetsRelated signature
            (.par (singletonTypeXOffer (action, branchType))
              (parallelTypeBranches (next :: tail)) ∅)
          exact compilationResolvedEdgeTargetsRelated_parallel signature
              (singletonTypeXOffer (action, branchType))
              (parallelTypeBranches (next :: tail)) ∅ hSingletonTargets
              hRestTargets

private theorem compilationResolvedEdgeTargetsRelated_parallelTypeBranchesSelecting
    (signature : TypeAlphabet) (selected : BareMessage × PactType) :
    ∀ branches,
    (∀ entry ∈ branches,
      CompilationResolvedEdgeTargetsRelated signature entry.2) →
    CompilationResolvedEdgeTargetsRelated signature
      (parallelTypeBranchesSelecting selected branches) := by
  intro branches
  induction branches with
  | nil =>
      intro _
      change CompilationResolvedEdgeTargetsRelated signature .skip
      exact compilationResolvedEdgeTargetsRelated_skip signature
  | cons branch rest ih =>
      rcases branch with ⟨action, branchType⟩
      intro hBranches
      have hBranchTargets :
          CompilationResolvedEdgeTargetsRelated signature branchType := by
        intro source residual environment label offers target hRelated hEdge
        exact hBranches (action, branchType) (by simp) hRelated hEdge
      have hMessageTargets : CompilationResolvedEdgeTargetsRelated signature
          (.message action.1 action.2) :=
        compilationResolvedEdgeTargetsRelated_message signature action.1
          action.2
      have hSelectedTargets : CompilationResolvedEdgeTargetsRelated signature
          (selectedTypeBranch (action, branchType)) := by
        change CompilationResolvedEdgeTargetsRelated signature
          (.seq (.message action.1 action.2) branchType)
        exact compilationResolvedEdgeTargetsRelated_sequence signature
          (.message action.1 action.2) branchType hMessageTargets
          hBranchTargets
      have hSingletonTargets : CompilationResolvedEdgeTargetsRelated signature
          (singletonTypeXOffer (action, branchType)) := by
        apply compilationResolvedEdgeTargetsRelated_xoffer signature .skip
          [(action, branchType)]
        · exact compilationResolvedEdgeTargetsRelated_skip signature
        · intro selectedAction selectedType index hEntry
          have hIndex : index = 0 := by
            simpa using (List.getElem?_eq_some_iff.mp hEntry).1
          subst index
          simp only [List.getElem?_cons_zero, Option.some.injEq,
            Prod.mk.injEq] at hEntry
          rcases hEntry with ⟨rfl, rfl⟩
          intro source residual environment label offers target hRelated hEdge
          exact hBranchTargets hRelated hEdge
      have hRestTargets : CompilationResolvedEdgeTargetsRelated signature
          (parallelTypeBranches rest) :=
        compilationResolvedEdgeTargetsRelated_parallelTypeBranches signature
          rest (by
            intro entry hEntry
            exact hBranches entry (by simp [hEntry]))
      have hRestSelectingTargets : CompilationResolvedEdgeTargetsRelated
          signature (parallelTypeBranchesSelecting selected rest) :=
        ih (by
          intro entry hEntry
          exact hBranches entry (by simp [hEntry]))
      show CompilationResolvedEdgeTargetsRelated signature
        (parallelTypeBranchesSelecting selected ((action, branchType) :: rest))
      by_cases hEq : (action, branchType) = selected
      · cases rest with
        | nil =>
            rw [show parallelTypeBranchesSelecting selected
                [(action, branchType)] = selectedTypeBranch (action, branchType)
              by simp [parallelTypeBranchesSelecting, hEq]]
            exact hSelectedTargets
        | cons next tail =>
            have hRestFullTargets : CompilationResolvedEdgeTargetsRelated
                signature (parallelTypeBranches (next :: tail)) :=
              compilationResolvedEdgeTargetsRelated_parallelTypeBranches
                signature (next :: tail) (by
                  intro entry hEntry
                  exact hBranches entry (by simp [hEntry]))
            rw [show parallelTypeBranchesSelecting selected
                ((action, branchType) :: next :: tail) =
                .par (selectedTypeBranch (action, branchType))
                  (parallelTypeBranches (next :: tail)) ∅
              by simp [parallelTypeBranchesSelecting, hEq]]
            exact compilationResolvedEdgeTargetsRelated_parallel signature
              (selectedTypeBranch (action, branchType))
              (parallelTypeBranches (next :: tail)) ∅ hSelectedTargets
              hRestFullTargets
      · cases rest with
        | nil =>
            rw [show parallelTypeBranchesSelecting selected
                [(action, branchType)] = singletonTypeXOffer
                  (action, branchType)
              by simp [parallelTypeBranchesSelecting, hEq]]
            exact hSingletonTargets
        | cons next tail =>
            rw [show parallelTypeBranchesSelecting selected
                ((action, branchType) :: next :: tail) =
                .par (singletonTypeXOffer (action, branchType))
                  (parallelTypeBranchesSelecting selected (next :: tail)) ∅
              by simp [parallelTypeBranchesSelecting, hEq]]
            exact compilationResolvedEdgeTargetsRelated_parallel signature
              (singletonTypeXOffer (action, branchType))
              (parallelTypeBranchesSelecting selected (next :: tail)) ∅
              hSingletonTargets hRestSelectingTargets

/-- Every visible resolved compiler edge from a represented source has a
represented target.  This is proved structurally for all syntax, independently
of the admissibility assumptions used by the final bisimulation theorem. -/
theorem compilationResolvedEdgeTargetsRelated_all
    (signature : TypeAlphabet) : ∀ processType,
    CompilationResolvedEdgeTargetsRelated signature processType := by
  intro processType
  cases processType with
  | message msg dir =>
      exact compilationResolvedEdgeTargetsRelated_message signature msg dir
  | progress pid =>
      exact compilationResolvedEdgeTargetsRelated_progress signature pid
  | tock =>
      exact compilationResolvedEdgeTargetsRelated_tock signature
  | skip =>
      exact compilationResolvedEdgeTargetsRelated_skip signature
  | var name =>
      exact compilationResolvedEdgeTargetsRelated_var signature name
  | recur name body =>
      exact compilationResolvedEdgeTargetsRelated_recursion signature name body
        (compilationResolvedEdgeTargetsRelated_all signature body)
  | choice left right =>
      exact compilationResolvedEdgeTargetsRelated_choice signature left right
        (compilationResolvedEdgeTargetsRelated_all signature left)
        (compilationResolvedEdgeTargetsRelated_all signature right)
  | fairChoice bid left right =>
      exact compilationResolvedEdgeTargetsRelated_fairChoice signature bid left
        right (compilationResolvedEdgeTargetsRelated_all signature left)
          (compilationResolvedEdgeTargetsRelated_all signature right)
  | seq left right =>
      exact compilationResolvedEdgeTargetsRelated_sequence signature left right
        (compilationResolvedEdgeTargetsRelated_all signature left)
        (compilationResolvedEdgeTargetsRelated_all signature right)
  | par left right interface =>
      exact compilationResolvedEdgeTargetsRelated_parallel signature left right
        interface (compilationResolvedEdgeTargetsRelated_all signature left)
          (compilationResolvedEdgeTargetsRelated_all signature right)
  | xoffer elseType branches =>
      apply compilationResolvedEdgeTargetsRelated_xoffer signature elseType
        branches
      · exact compilationResolvedEdgeTargetsRelated_all signature elseType
      · intro action branchType index hEntry
        have hMember : (action, branchType) ∈ branches := by
          rcases List.getElem?_eq_some_iff.mp hEntry with ⟨hBound, hValue⟩
          have hAt := List.getElem_mem hBound
          simpa [hValue] using hAt
        have hBranchSize : sizeOf branchType <
            sizeOf (PactType.xoffer elseType branches) := by
          have hPair := List.sizeOf_lt_of_mem hMember
          have hComponent : sizeOf branchType <
              sizeOf (action, branchType) := by
            simp_wf
            omega
          have hList : sizeOf branches <
              sizeOf (PactType.xoffer elseType branches) := by
            simp_wf
            omega
          omega
        intro source residual environment label offers target hRelated hEdge
        exact compilationResolvedEdgeTargetsRelated_all signature branchType
          hRelated hEdge
  | offer elseType branches =>
      apply compilationResolvedEdgeTargetsRelated_offer signature elseType
        branches
      · intro selected index hEntry
        apply compilationResolvedEdgeTargetsRelated_parallelTypeBranchesSelecting
        intro entry hEntry'
        have hEntrySize : sizeOf entry.2 <
            sizeOf (PactType.offer elseType branches) := by
          have hPair := List.sizeOf_lt_of_mem hEntry'
          have hComponent : sizeOf entry.2 < sizeOf entry := by
            rcases entry
            simp_wf
            omega
          have hList : sizeOf branches <
              sizeOf (PactType.offer elseType branches) := by
            simp_wf
            omega
          omega
        intro source residual environment label offers target hRelated hEdge
        exact compilationResolvedEdgeTargetsRelated_all signature entry.2
          hRelated hEdge
      · exact compilationResolvedEdgeTargetsRelated_all signature elseType
termination_by processType => sizeOf processType
decreasing_by
  all_goals
    first
    | assumption
    | (simp_wf; omega)

private theorem compilationScopedFragmentStepCorrect_sequence_leaf
    (signature : TypeAlphabet) (left right : PactType)
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right)
    (hFuture : CompilationFutureCorrect signature (.seq left right)) :
    CompilationScopedFragmentStepCorrect signature (.seq left right) := by
  intro residual residual' state env label offers hRelated hLocal hAvoids
  have hAvoidsLeft : env.AvoidsInterface left.ParallelInterfaces :=
    hAvoids.mono (by simp [PactType.ParallelInterfaces])
  have hAvoidsRight : env.AvoidsInterface right.ParallelInterfaces :=
    hAvoids.mono (by simp [PactType.ParallelInterfaces])
  have hLeftSkipping := compilationSkippingCorrect_of_compilation signature left
  cases hRelated with
  | sequence_left _ _ childResidual childState hChildRelated =>
      constructor
      · rintro ⟨hTransition, hOffers⟩
        cases hTransition with
        | skip_seq =>
            obtain ⟨hCurrent, hOfferFuture⟩ :=
              TypeOffers.skip_sequence_fields hOffers
            have hSkipping : childState ∈
                (compileTypeFuel signature
                  (typeCompilationFuel left) left).skipping :=
              (hLeftSkipping childState .skip hChildRelated).mpr rfl
            have hRightInitial : TypeCompilationRelation right
                (compileTypeFuel signature
                  (typeCompilationFuel right) right).initial right := by
              simpa [compileType] using
                (compileType_initial_relation signature right)
            have hTarget : TypeCompilationRelation (.seq left right)
                (.child 1 (compileTypeFuel signature
                  (typeCompilationFuel right) right).initial) right :=
              TypeCompilationRelation.sequence_right left right right _
                hRightInitial
            have hComputed := hFuture _ _ hTarget
            refine ⟨.child 1 (compileTypeFuel signature
                (typeCompilationFuel right) right).initial, ?_, hTarget⟩
            apply (compileTypeFuel_sequence_bridge_edge_iff signature left right
              childState env TypeLabel.silent offers).mpr
            exact ⟨hSkipping, hLocal, rfl, hCurrent,
              hComputed.trans hOfferFuture.symm⟩
        | seq _ _ childTarget _ _ hChildTransition =>
            obtain ⟨childFuture, hChildOffers, hOfferFuture⟩ :=
              TypeOffers.sequence_fields hOffers
            rcases (hLeft.scopedStep (residual' := childTarget)
                (label := label)
                (offers := { current := offers.current, future := childFuture })
                hChildRelated hLocal hAvoidsLeft).mp
                ⟨hChildTransition, hChildOffers⟩ with
              ⟨childState', hChildEdge, hChildTarget⟩
            have hTarget : TypeCompilationRelation (.seq left right)
                (.child 0 childState') (.seq childTarget right) :=
              TypeCompilationRelation.sequence_left left right childTarget _
                hChildTarget
            have hComputed := hFuture _ _ hTarget
            refine ⟨.child 0 childState', ?_, hTarget⟩
            apply (compileTypeFuel_sequence_left_child_edge_iff signature left
              right childState childState' env label offers).mpr
            refine ⟨childFuture, hChildEdge, ?_⟩
            rw [hComputed]
            exact hOfferFuture.symm
      · rintro ⟨target, hEdge, hTarget⟩
        rcases compileTypeFuel_sequence_left_edge_cases signature left right
          hEdge with hChild | hBridge
        · rcases hChild with
            ⟨childTarget, childFuture, rfl, hChildEdge, hComputed⟩
          cases hTarget with
          | sequence_left _ _ targetResidual _ hChildTarget =>
              rcases (hLeft.scopedStep hChildRelated hLocal hAvoidsLeft).mpr
                  ⟨childTarget, hChildEdge, hChildTarget⟩ with
                ⟨hChildTransition, hChildOffers⟩
              refine ⟨TypeTransition.seq env childResidual targetResidual right
                  label hChildTransition, ?_⟩
              have hParentTarget : TypeCompilationRelation (.seq left right)
                  (.child 0 childTarget) (.seq targetResidual right) :=
                TypeCompilationRelation.sequence_left left right targetResidual _
                  hChildTarget
              have hTargetFuture := hFuture _ _ hParentTarget
              have hSemanticFuture :
                  typeFutureOffers (.seq targetResidual right) \
                      offers.current = offers.future :=
                (congrArg (fun available => available \ offers.current)
                  hTargetFuture).symm.trans hComputed
              simpa only [hSemanticFuture] using
                (TypeOffers.seq env childResidual targetResidual right label
                  offers.current childFuture hChildOffers)
        · rcases hBridge with
            ⟨hSkipping, _, hLabel, hCurrent, hComputed, rfl⟩
          cases hTarget with
          | sequence_right _ _ targetResidual _ hChildTarget =>
              have hRightInitial : TypeCompilationRelation right
                  (compileTypeFuel signature
                    (typeCompilationFuel right) right).initial right := by
                simpa [compileType] using
                  (compileType_initial_relation signature right)
              have hResidual := TypeCompilationRelation.residual_unique
                hChildTarget hRightInitial
              cases hResidual
              have hChildResidual : childResidual = .skip :=
                (hLeftSkipping childState childResidual hChildRelated).mp
                  hSkipping
              subst childResidual
              have hParentTarget : TypeCompilationRelation (.seq left right)
                  (.child 1 (compileTypeFuel signature
                    (typeCompilationFuel right) right).initial) right :=
                TypeCompilationRelation.sequence_right left right right _
                  hChildTarget
              have hTargetFuture := hFuture _ _ hParentTarget
              have hOfferFuture : offers.future = typeFutureOffers right :=
                hComputed.symm.trans hTargetFuture
              subst label
              refine ⟨TypeTransition.skip_seq env right
                  (TypeAlphabet.localEnvironment_wellFormed hLocal), ?_⟩
              simpa only [hCurrent, hOfferFuture] using
                (TypeOffers.skip_seq env right
                  (TypeAlphabet.localEnvironment_wellFormed hLocal))
  | sequence_right _ _ childResidual childState hChildRelated =>
      constructor
      · intro hStep
        rcases (hRight.scopedStep hChildRelated hLocal hAvoidsRight).mp hStep with
          ⟨childTarget, hChildEdge, hChildTarget⟩
        refine ⟨.child 1 childTarget, ?_, ?_⟩
        · exact (compileTypeFuel_sequence_right_child_edge_iff signature left
              right childState childTarget env label offers).mpr hChildEdge
        · exact TypeCompilationRelation.sequence_right left right residual'
            childTarget hChildTarget
      · rintro ⟨target, hEdge, hTarget⟩
        rcases compileTypeFuel_sequence_right_edge_cases signature left right
          hEdge with ⟨childTarget, rfl, hChildEdge⟩
        cases hTarget with
        | sequence_right _ _ _ _ hChildTarget =>
            exact (hRight.scopedStep hChildRelated hLocal hAvoidsRight).mpr
              ⟨childTarget, hChildEdge, hChildTarget⟩

/-- Parallel raw steps are the remaining synchronization leaf.  Optimistic
future menus and completion metadata for the product are already fully proved. -/
private theorem parallel_semantic_step_to_resolved_edge_leaf
    (signature : TypeAlphabet) (left right : PactType)
    (interface : Interface) (hSignature : signature.WellFormed)
    (hInterface : interface ⊆ signature.interface)
    (hScoped : PactType.InterfaceScoped (.par left right interface))
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right)
    {residual residual' : PactType} {state : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel} {offers : TypeOfferSummary}
    (hRelated : TypeCompilationRelation (.par left right interface) state residual)
    (hLocal : env ∈ signature.localEnvironments)
    (hAvoids : env.AvoidsInterface
      (PactType.par left right interface).ParallelInterfaces)
    (hStep : DecoratedTypeTransition env residual label offers residual') :
    ∃ target,
      (compileTypeFuel signature
        (typeCompilationFuel (.par left right interface))
        (.par left right interface)).HasResolvedEdge state env label offers
          target ∧
      TypeCompilationRelation (.par left right interface) target residual' := by
  exact parallel_semantic_step_to_resolved_edge signature left right interface
    hInterface hScoped hLeft.scopedStep hRight.scopedStep hRelated hLocal
      hAvoids hStep

private theorem parallel_resolved_edge_to_semantic_step_leaf
    (signature : TypeAlphabet) (left right : PactType)
    (interface : Interface) (hSignature : signature.WellFormed)
    (hInterface : interface ⊆ signature.interface)
    (hScoped : PactType.InterfaceScoped (.par left right interface))
    (hLeftClosed : PactType.AllVariablesBound [] left)
    (hRightClosed : PactType.AllVariablesBound [] right)
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right)
    {residual residual' : PactType} {state target : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel} {offers : TypeOfferSummary}
    (hRelated : TypeCompilationRelation (.par left right interface) state residual)
    (hLocal : env ∈ signature.localEnvironments)
    (hAvoids : env.AvoidsInterface
      (PactType.par left right interface).ParallelInterfaces)
    (hEdge : (compileTypeFuel signature
      (typeCompilationFuel (.par left right interface))
      (.par left right interface)).HasResolvedEdge state env label offers target)
    (hTarget : TypeCompilationRelation (.par left right interface)
      target residual') :
    DecoratedTypeTransition env residual label offers residual' := by
  have hLeftTargets : CompilationResolvedEdgeTargetsRelated signature left := by
    intro source residual environment label offers target hRelated hEdge
    exact compilationResolvedEdgeTargetsRelated_all signature left hRelated
      hEdge
  have hRightTargets : CompilationResolvedEdgeTargetsRelated signature right := by
    intro source residual environment label offers target hRelated hEdge
    exact compilationResolvedEdgeTargetsRelated_all signature right hRelated
      hEdge
  have hLeftWitness : CompilationScopedResolvedOfferWitnessCorrect signature
      left := by
    intro residual state environment label actualOffers actualTarget hRelated
      hLocal hAvoids hActual witness hWitness hSemantic hSource hEnvironment
      hLabel
    exact (compilationScopedResolvedOfferWitnessCorrect_of_step_targets_visible
      signature left hLeft.scopedStep hLeftTargets
        (compilationPendingEdgesVisible_of_allVariablesBound signature left
          hLeftClosed)) hRelated hLocal hAvoids hActual witness hWitness
            hSemantic hSource hEnvironment hLabel
  have hRightWitness : CompilationScopedResolvedOfferWitnessCorrect signature
      right := by
    intro residual state environment label actualOffers actualTarget hRelated
      hLocal hAvoids hActual witness hWitness hSemantic hSource hEnvironment
      hLabel
    exact (compilationScopedResolvedOfferWitnessCorrect_of_step_targets_visible
      signature right hRight.scopedStep hRightTargets
        (compilationPendingEdgesVisible_of_allVariablesBound signature right
          hRightClosed)) hRelated hLocal hAvoids hActual witness hWitness
            hSemantic hSource hEnvironment hLabel
  exact parallel_resolved_edge_to_semantic_step signature left right interface
    hInterface hScoped hLeft.scopedStep hRight.scopedStep hLeftWitness
      hRightWitness hRelated hLocal hAvoids hEdge hTarget

private theorem compilationFragmentStepCorrect_parallel_leaf
    (signature : TypeAlphabet) (left right : PactType)
    (interface : Interface) (hSignature : signature.WellFormed)
    (hInterface : interface ⊆ signature.interface)
    (hScoped : PactType.InterfaceScoped (.par left right interface))
    (hClosed : PactType.AllVariablesBound [] (.par left right interface))
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right) :
    CompilationScopedFragmentStepCorrect signature
      (.par left right interface) := by
  intro residual residual' state env label offers hRelated hLocal hAvoids
  constructor
  · exact parallel_semantic_step_to_resolved_edge_leaf signature left right
      interface hSignature hInterface hScoped hLeft hRight hRelated hLocal
        hAvoids
  · rintro ⟨target, hEdge, hTarget⟩
    have hClosedFields := hClosed
    simp only [PactType.AllVariablesBound] at hClosedFields
    exact parallel_resolved_edge_to_semantic_step_leaf signature left right
      interface hSignature hInterface hScoped hClosedFields.1 hClosedFields.2
      hLeft hRight hRelated hLocal hAvoids hEdge hTarget

/-- Same-cycle execution correctness composes through a synchronized product.
The product's explicit observation edges expose both syntax menus immediately;
following an ordinary product transition can only decrease those menus, and a
completion reached after such transitions is transported back through the two
child execution invariants. -/
private theorem compilationSequenceExecutionCorrect_parallel_regular_leaf
    (signature : TypeAlphabet) (left right : PactType)
    (interface : Interface)
    (hLeftClosed : PactType.AllVariablesBound [] left)
    (hRightClosed : PactType.AllVariablesBound [] right)
    (hLeft : CompilationProofBundle signature left)
    (hRight : CompilationProofBundle signature right) :
    CompilationSequenceExecutionCorrect signature
      (.par left right interface) := by
  classical
  let fuel := max (typeCompilationFuel left) (typeCompilationFuel right)
  let leftFragment := compileTypeFuel signature fuel left
  let rightFragment := compileTypeFuel signature fuel right
  let fragment := buildParallelAutomaton interface leftFragment rightFragment
  let execution := sequenceExecutionAutomaton fragment
  have hLeftFuel : TypeCompilationFuelSufficient left fuel := by
    simp [TypeCompilationFuelSufficient, fuel]
  have hRightFuel : TypeCompilationFuelSufficient right fuel := by
    simp [TypeCompilationFuelSufficient, fuel]
  have hLeftStable : leftFragment = compileTypeFuel signature
      (typeCompilationFuel left) left :=
    compileTypeFuel_eq_of_sufficient signature left hLeftFuel
      (typeCompilationFuel_sufficient left)
  have hRightStable : rightFragment = compileTypeFuel signature
      (typeCompilationFuel right) right :=
    compileTypeFuel_eq_of_sufficient signature right hRightFuel
      (typeCompilationFuel_sufficient right)
  have hLeftTargets : leftFragment.FutureTargetsInStates :=
    compileTypeFuel_futureTargetsInStates signature fuel left hLeftFuel
  have hRightTargets : rightFragment.FutureTargetsInStates :=
    compileTypeFuel_futureTargetsInStates signature fuel right hRightFuel
  have hFragmentTargets : fragment.FutureTargetsInStates := by
    exact buildParallelAutomaton_futureTargetsInStates interface leftFragment
      rightFragment
  have hExecutionClosed : execution.ReferencesClosed := by
    exact sequenceExecutionAutomaton_referencesClosed fragment hFragmentTargets
  have hParent : compileTypeFuel signature
      (typeCompilationFuel (.par left right interface))
        (.par left right interface) = fragment := by
    simp only [typeCompilationFuel, Nat.one_add, compileTypeFuel]
    rfl
  intro state residual hRelated
  rw [hParent]
  cases hRelated with
  | parallel _ _ leftResidual rightResidual _ leftState rightState
      hLeftRelated hRightRelated =>
      have hLeftState : leftState ∈ leftFragment.states := by
        have hCanonical := compilationStateCorrect_of_compilation signature
          left leftState leftResidual hLeftRelated
        simpa [leftFragment, hLeftStable] using hCanonical
      have hRightState : rightState ∈ rightFragment.states := by
        have hCanonical := compilationStateCorrect_of_compilation signature
          right rightState rightResidual hRightRelated
        simpa [rightFragment, hRightStable] using hCanonical
      have hSourceState : (.pair leftState rightState : TypeAutomatonState) ∈
          execution.states := by
        apply Finset.mem_union_left
        simp [execution, fragment, buildParallelAutomaton,
          finishAutomatonFragment, hLeftState, hRightState]
      have hLeftAtSource := hLeft.execution leftState leftResidual hLeftRelated
      have hRightAtSource := hRight.execution rightState rightResidual
        hRightRelated
      have hLeftSourceExecution :
          computeFuture (sequenceExecutionAutomaton leftFragment) leftState =
              typeFutureOffers leftResidual ∧
            ((∃ completed ∈
                (sequenceExecutionAutomaton leftFragment).futureReachable
                  leftState,
                completed ∈ leftFragment.skipping ∨
                  completed ∈ leftFragment.completing) ↔
              leftResidual.CanCompleteBeforeTock = true) := by
        simpa [CompilationSequenceExecutionCorrect, leftFragment, hLeftStable]
          using hLeftAtSource
      have hRightSourceExecution :
          computeFuture (sequenceExecutionAutomaton rightFragment) rightState =
              typeFutureOffers rightResidual ∧
            ((∃ completed ∈
                (sequenceExecutionAutomaton rightFragment).futureReachable
                  rightState,
                completed ∈ rightFragment.skipping ∨
                  completed ∈ rightFragment.completing) ↔
              rightResidual.CanCompleteBeforeTock = true) := by
        simpa [CompilationSequenceExecutionCorrect, rightFragment,
          hRightStable] using hRightAtSource
      have hLeftSourceFuture : computeFuture
          { states := leftFragment.states, edges := leftFragment.edges }
          leftState = typeFutureOffers leftResidual := by
        have hCanonical := hLeft.future leftState leftResidual hLeftRelated
        simpa [leftFragment, hLeftStable] using hCanonical
      have hRightSourceFuture : computeFuture
          { states := rightFragment.states, edges := rightFragment.edges }
          rightState = typeFutureOffers rightResidual := by
        have hCanonical := hRight.future rightState rightResidual hRightRelated
        simpa [rightFragment, hRightStable] using hCanonical
      have hSourceOffers : execution.offersAt (.pair leftState rightState) =
          typeFutureOffers (.par leftResidual rightResidual interface) := by
        rw [show execution.offersAt (.pair leftState rightState) =
            hideOffers interface
              (computeFuture
                  { states := leftFragment.states, edges := leftFragment.edges }
                  leftState ∪
                computeFuture
                  { states := rightFragment.states,
                    edges := rightFragment.edges } rightState) by
          exact sequenceExecution_buildParallel_offersAt interface leftFragment
            rightFragment leftState rightState hLeftState hRightState
              hLeftTargets hRightTargets]
        rw [hLeftSourceFuture, hRightSourceFuture,
          typeFutureOffers_parallel]
        rfl
      have hLeftVisible : ∀ edge ∈ leftFragment.edges,
          edge.label ≠ .future → ∃ label, edge.label = .visible label := by
        have hCanonical := compilationPendingEdgesVisible_of_allVariablesBound
          signature left hLeftClosed
        simpa [leftFragment, hLeftStable] using hCanonical
      have hRightVisible : ∀ edge ∈ rightFragment.edges,
          edge.label ≠ .future → ∃ label, edge.label = .visible label := by
        have hCanonical := compilationPendingEdgesVisible_of_allVariablesBound
          signature right hRightClosed
        simpa [rightFragment, hRightStable] using hCanonical
      let represented := fun productState =>
        ∃ childLeft childRight childLeftResidual childRightResidual,
          productState = .pair childLeft childRight ∧
          TypeCompilationRelation left childLeft childLeftResidual ∧
          TypeCompilationRelation right childRight childRightResidual ∧
          (productState ∈ fragment.completing →
            (PactType.par leftResidual rightResidual
              interface).CanCompleteBeforeTock =
              true)
      have hParentCompleting := compilationCompletingCorrect_parallel signature
        left right interface hLeft.completing hRight.completing
      have hSourceRepresented : represented (.pair leftState rightState) := by
        refine ⟨leftState, rightState, leftResidual, rightResidual, rfl,
          hLeftRelated, hRightRelated, ?_⟩
        simpa only [hParent] using
          (hParentCompleting (.pair leftState rightState)
            (.par leftResidual rightResidual interface)
              (TypeCompilationRelation.parallel left right leftResidual
                rightResidual interface leftState rightState hLeftRelated
                  hRightRelated)).mp
      have hReferenceStep : ∀ productState ∈ execution.states,
          represented productState → ∀ target ∈
            execution.referencedStates productState,
            represented target ∧
              execution.offersAt target ⊆
                execution.offersAt productState := by
        intro productState hProductState hRepresented target hReference
        rcases hRepresented with
          ⟨childLeft, childRight, childLeftResidual, childRightResidual,
            rfl, hChildLeftRelated, hChildRightRelated, hCarriesCompletion⟩
        rcases sequenceExecution_buildParallel_reference_cases interface
            leftFragment rightFragment childLeft childRight target hReference
          with ⟨leftEdge, hLeftEdge, rightEdge, hRightEdge, hLeftSource,
            hRightSource, rfl, hLeftSemantic, hRightSemantic, hLeftNonClock,
              hRightNonClock⟩
        subst childLeft
        subst childRight
        have hCurrentLeftState : leftEdge.source ∈ leftFragment.states := by
          have hCanonical := compilationStateCorrect_of_compilation signature
            left leftEdge.source childLeftResidual hChildLeftRelated
          simpa [leftFragment, hLeftStable] using hCanonical
        have hCurrentRightState : rightEdge.source ∈ rightFragment.states := by
          have hCanonical := compilationStateCorrect_of_compilation signature
            right rightEdge.source childRightResidual hChildRightRelated
          simpa [rightFragment, hRightStable] using hCanonical
        have hCurrentLeftExecution := hLeft.execution leftEdge.source
          childLeftResidual hChildLeftRelated
        have hCurrentRightExecution := hRight.execution rightEdge.source
          childRightResidual hChildRightRelated
        have hCurrentLeftExecution' :
            computeFuture (sequenceExecutionAutomaton leftFragment)
                leftEdge.source = typeFutureOffers childLeftResidual ∧
              ((∃ completed ∈
                  (sequenceExecutionAutomaton leftFragment).futureReachable
                    leftEdge.source,
                  completed ∈ leftFragment.skipping ∨
                    completed ∈ leftFragment.completing) ↔
                childLeftResidual.CanCompleteBeforeTock = true) := by
          simpa [CompilationSequenceExecutionCorrect, leftFragment,
            hLeftStable] using hCurrentLeftExecution
        have hCurrentRightExecution' :
            computeFuture (sequenceExecutionAutomaton rightFragment)
                rightEdge.source = typeFutureOffers childRightResidual ∧
              ((∃ completed ∈
                  (sequenceExecutionAutomaton rightFragment).futureReachable
                    rightEdge.source,
                  completed ∈ rightFragment.skipping ∨
                    completed ∈ rightFragment.completing) ↔
                childRightResidual.CanCompleteBeforeTock = true) := by
          simpa [CompilationSequenceExecutionCorrect, rightFragment,
            hRightStable] using hCurrentRightExecution
        rcases resolvedAutomatonEdge_visible_of_pending_visible leftFragment
            hLeftVisible leftEdge hLeftEdge hLeftSemantic with
          ⟨leftLabel, hLeftLabel⟩
        rcases resolvedAutomatonEdge_visible_of_pending_visible rightFragment
            hRightVisible rightEdge hRightEdge hRightSemantic with
          ⟨rightLabel, hRightLabel⟩
        have hLeftResolved := hasResolvedEdge_of_mem_visible_resolved
          leftFragment leftEdge hLeftEdge leftLabel hLeftLabel
        have hRightResolved := hasResolvedEdge_of_mem_visible_resolved
          rightFragment rightEdge hRightEdge rightLabel hRightLabel
        obtain ⟨leftTargetResidual, hLeftTargetRelated⟩ :=
          compilationResolvedEdgeTargetsRelated_all signature left
            hChildLeftRelated (by
              simpa [leftFragment, hLeftStable] using hLeftResolved)
        obtain ⟨rightTargetResidual, hRightTargetRelated⟩ :=
          compilationResolvedEdgeTargetsRelated_all signature right
            hChildRightRelated (by
              simpa [rightFragment, hRightStable] using hRightResolved)
        have hLeftTargetState : leftEdge.target ∈ leftFragment.states := by
          have hCanonical := compilationStateCorrect_of_compilation signature
            left leftEdge.target leftTargetResidual hLeftTargetRelated
          simpa [leftFragment, hLeftStable] using hCanonical
        have hRightTargetState : rightEdge.target ∈ rightFragment.states := by
          have hCanonical := compilationStateCorrect_of_compilation signature
            right rightEdge.target rightTargetResidual hRightTargetRelated
          simpa [rightFragment, hRightStable] using hCanonical
        have hLeftReference :=
          sequenceExecution_resolvedEdge_target_referenced leftFragment
            leftEdge hLeftEdge hLeftSemantic hLeftNonClock
        have hRightReference :=
          sequenceExecution_resolvedEdge_target_referenced rightFragment
            rightEdge hRightEdge hRightSemantic hRightNonClock
        have hLeftExecutionClosed :=
          sequenceExecutionAutomaton_referencesClosed leftFragment hLeftTargets
        have hRightExecutionClosed :=
          sequenceExecutionAutomaton_referencesClosed rightFragment
            hRightTargets
        have hLeftReachable : leftEdge.target ∈
            (sequenceExecutionAutomaton leftFragment).futureReachable
              leftEdge.source :=
          PendingAutomaton.referencedStates_subset_futureReachable
            (sequenceExecutionAutomaton leftFragment) leftEdge.source
              hLeftExecutionClosed
                (Finset.mem_union_left _ hCurrentLeftState) hLeftReference
        have hRightReachable : rightEdge.target ∈
            (sequenceExecutionAutomaton rightFragment).futureReachable
              rightEdge.source :=
          PendingAutomaton.referencedStates_subset_futureReachable
            (sequenceExecutionAutomaton rightFragment) rightEdge.source
              hRightExecutionClosed
                (Finset.mem_union_left _ hCurrentRightState) hRightReference
        have hLeftAtTarget := hLeft.execution leftEdge.target
          leftTargetResidual hLeftTargetRelated
        have hRightAtTarget := hRight.execution rightEdge.target
          rightTargetResidual hRightTargetRelated
        have hLeftTargetExecution :
            computeFuture (sequenceExecutionAutomaton leftFragment)
                leftEdge.target = typeFutureOffers leftTargetResidual ∧
              ((∃ completed ∈
                  (sequenceExecutionAutomaton leftFragment).futureReachable
                    leftEdge.target,
                  completed ∈ leftFragment.skipping ∨
                    completed ∈ leftFragment.completing) ↔
                leftTargetResidual.CanCompleteBeforeTock = true) := by
          simpa [CompilationSequenceExecutionCorrect, leftFragment,
            hLeftStable] using hLeftAtTarget
        have hRightTargetExecution :
            computeFuture (sequenceExecutionAutomaton rightFragment)
                rightEdge.target = typeFutureOffers rightTargetResidual ∧
              ((∃ completed ∈
                  (sequenceExecutionAutomaton rightFragment).futureReachable
                    rightEdge.target,
                  completed ∈ rightFragment.skipping ∨
                    completed ∈ rightFragment.completing) ↔
                rightTargetResidual.CanCompleteBeforeTock = true) := by
          simpa [CompilationSequenceExecutionCorrect, rightFragment,
            hRightStable] using hRightAtTarget
        have hLeftMenuSubset : typeFutureOffers leftTargetResidual ⊆
            typeFutureOffers childLeftResidual := by
          rw [← hLeftTargetExecution.1, ← hCurrentLeftExecution'.1]
          exact computeFuture_subset_of_mem_futureReachable
            (sequenceExecutionAutomaton leftFragment) hLeftExecutionClosed
              (Finset.mem_union_left _ hCurrentLeftState) hLeftReachable
        have hRightMenuSubset : typeFutureOffers rightTargetResidual ⊆
            typeFutureOffers childRightResidual := by
          rw [← hRightTargetExecution.1, ← hCurrentRightExecution'.1]
          exact computeFuture_subset_of_mem_futureReachable
            (sequenceExecutionAutomaton rightFragment) hRightExecutionClosed
              (Finset.mem_union_left _ hCurrentRightState) hRightReachable
        have hTargetOffers : execution.offersAt
            (.pair leftEdge.target rightEdge.target) =
              typeFutureOffers
                (.par leftTargetResidual rightTargetResidual interface) := by
          rw [show execution.offersAt
              (.pair leftEdge.target rightEdge.target) =
              hideOffers interface
                (computeFuture
                    { states := leftFragment.states,
                      edges := leftFragment.edges } leftEdge.target ∪
                  computeFuture
                    { states := rightFragment.states,
                      edges := rightFragment.edges } rightEdge.target) by
            exact sequenceExecution_buildParallel_offersAt interface
              leftFragment rightFragment leftEdge.target rightEdge.target
                hLeftTargetState hRightTargetState hLeftTargets hRightTargets]
          have hLeftFuture := hLeft.future leftEdge.target leftTargetResidual
            hLeftTargetRelated
          have hRightFuture := hRight.future rightEdge.target
            rightTargetResidual hRightTargetRelated
          have hLeftFuture' : computeFuture
              { states := leftFragment.states, edges := leftFragment.edges }
              leftEdge.target = typeFutureOffers leftTargetResidual := by
            simpa [leftFragment, hLeftStable] using hLeftFuture
          have hRightFuture' : computeFuture
              { states := rightFragment.states, edges := rightFragment.edges }
              rightEdge.target = typeFutureOffers rightTargetResidual := by
            simpa [rightFragment, hRightStable] using hRightFuture
          rw [hLeftFuture', hRightFuture', typeFutureOffers_parallel]
          rfl
        have hCurrentOffers : execution.offersAt
            (.pair leftEdge.source rightEdge.source) =
              typeFutureOffers
                (.par childLeftResidual childRightResidual interface) := by
          rw [show execution.offersAt
              (.pair leftEdge.source rightEdge.source) =
              hideOffers interface
                (computeFuture
                    { states := leftFragment.states,
                      edges := leftFragment.edges } leftEdge.source ∪
                  computeFuture
                    { states := rightFragment.states,
                      edges := rightFragment.edges } rightEdge.source) by
            exact sequenceExecution_buildParallel_offersAt interface
              leftFragment rightFragment leftEdge.source rightEdge.source
                hCurrentLeftState hCurrentRightState hLeftTargets hRightTargets]
          have hLeftFuture := hLeft.future leftEdge.source childLeftResidual
            hChildLeftRelated
          have hRightFuture := hRight.future rightEdge.source
            childRightResidual hChildRightRelated
          have hLeftFuture' : computeFuture
              { states := leftFragment.states, edges := leftFragment.edges }
              leftEdge.source = typeFutureOffers childLeftResidual := by
            simpa [leftFragment, hLeftStable] using hLeftFuture
          have hRightFuture' : computeFuture
              { states := rightFragment.states, edges := rightFragment.edges }
              rightEdge.source = typeFutureOffers childRightResidual := by
            simpa [rightFragment, hRightStable] using hRightFuture
          rw [hLeftFuture', hRightFuture', typeFutureOffers_parallel]
          rfl
        have hOffersSubset : execution.offersAt
            (.pair leftEdge.target rightEdge.target) ⊆
              execution.offersAt (.pair leftEdge.source rightEdge.source) := by
          rw [hTargetOffers, hCurrentOffers, typeFutureOffers_parallel,
            typeFutureOffers_parallel]
          intro action hAction
          simp only [hideTypeOffers, Finset.mem_filter, Finset.mem_union]
            at hAction ⊢
          rcases hAction with ⟨hTargetMenu, hOutside⟩
          exact ⟨hTargetMenu.elim (fun h => Or.inl (hLeftMenuSubset h))
            (fun h => Or.inr (hRightMenuSubset h)), hOutside⟩
        refine ⟨?_, hOffersSubset⟩
        refine ⟨leftEdge.target, rightEdge.target, leftTargetResidual,
          rightTargetResidual, rfl, hLeftTargetRelated, hRightTargetRelated, ?_⟩
        intro hTargetCompleting
        have hTargetFields : leftEdge.target ∈ leftFragment.completing ∧
            rightEdge.target ∈ rightFragment.completing := by
          simpa [fragment, buildParallelAutomaton, finishAutomatonFragment]
            using hTargetCompleting
        have hLeftCanComplete :
            childLeftResidual.CanCompleteBeforeTock = true :=
          hCurrentLeftExecution'.2.mp
            ⟨leftEdge.target, hLeftReachable, Or.inr hTargetFields.1⟩
        have hRightCanComplete :
            childRightResidual.CanCompleteBeforeTock = true :=
          hCurrentRightExecution'.2.mp
            ⟨rightEdge.target, hRightReachable, Or.inr hTargetFields.2⟩
        have hCurrentLeftCompleting :
            leftEdge.source ∈ leftFragment.completing := by
          have hCanonical := (hLeft.completing leftEdge.source
            childLeftResidual hChildLeftRelated).mpr hLeftCanComplete
          simpa [leftFragment, hLeftStable] using hCanonical
        have hCurrentRightCompleting :
            rightEdge.source ∈ rightFragment.completing := by
          have hCanonical := (hRight.completing rightEdge.source
            childRightResidual hChildRightRelated).mpr hRightCanComplete
          simpa [rightFragment, hRightStable] using hCanonical
        apply hCarriesCompletion
        simpa [fragment, buildParallelAutomaton, finishAutomatonFragment]
          using And.intro hCurrentLeftCompleting hCurrentRightCompleting
      have hSameFuture : computeFuture execution (.pair leftState rightState) =
          execution.offersAt (.pair leftState rightState) :=
        computeFuture_eq_offersAt_of_references_monotone_on execution
          (.pair leftState rightState) represented hExecutionClosed hSourceState
            hSourceRepresented hReferenceStep
      constructor
      · exact hSameFuture.trans hSourceOffers
      · constructor
        · rintro ⟨completed, hReachable, hSkipping | hCompleting⟩
          · simp [fragment, buildParallelAutomaton,
              finishAutomatonFragment] at hSkipping
          · let allowed := execution.states.filter represented
            have hSourceAllowed :
                (.pair leftState rightState : TypeAutomatonState) ∈ allowed := by
              simp [allowed, hSourceState, hSourceRepresented]
            have hAllowedClosed : ∀ current ∈ allowed,
                execution.referencedStates current ⊆ allowed := by
              intro current hCurrent target hTarget
              have hFields := Finset.mem_filter.mp hCurrent
              have hNext := hReferenceStep current hFields.1 hFields.2 target
                hTarget
              exact Finset.mem_filter.mpr
                ⟨hExecutionClosed current hFields.1 hTarget, hNext.1⟩
            have hCompletedAllowed :=
              execution.futureReachable_subset_of_reference_closed
                (.pair leftState rightState) allowed hSourceAllowed
                  hAllowedClosed hReachable
            rcases (Finset.mem_filter.mp hCompletedAllowed).2 with
              ⟨completedLeft, completedRight, completedLeftResidual,
                completedRightResidual, hCompletedPair, _, _, hCarries⟩
            exact hCarries hCompleting
        · intro hCanComplete
          refine ⟨.pair leftState rightState,
            execution.mem_futureReachable_self _, ?_⟩
          right
          have hCanonical := (hParentCompleting (.pair leftState rightState)
            (.par leftResidual rightResidual interface)
              (TypeCompilationRelation.parallel left right leftResidual
                rightResidual interface leftState rightState hLeftRelated
                  hRightRelated)).mpr hCanComplete
          simpa [fragment, hParent] using hCanonical

/-- The witness satisfies every conjunct of `ClosedGuardedRegular` used by the
recursion leaves: it is closed, clock-guarded, tail-recursive, trivially
same-cycle message linear (no messages occur at all), and trivially
interface-scoped (no parallel composition occurs at all).  None of these
well-formedness clauses excludes the mismatch exhibited above. -/
theorem recursion_choice_backedge_regularity_witness :
    let name : String := "x"
    let body : PactType :=
      .choice .skip (.seq .tock (.choice (.var name) (.var name)))
    let processType : PactType := .recur name body
    PactType.AllVariablesBound [] processType ∧
      PactType.ClockGuarded processType ∧
      PactType.TailRecursive processType ∧
      PactType.SameCycleMessageLinear processType ∧
      PactType.InterfaceScoped processType := by
  intro name body processType
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · simp [processType, body, PactType.AllVariablesBound]
  · simp [processType, body, PactType.ClockGuarded,
      PactType.GuardedOccurrences, PactType.MustTockBeforeCompletion]
  · simp [processType, body, PactType.TailRecursive, PactType.TailOccurrences]
  · simp [processType, body, PactType.SameCycleMessageLinear,
      PactType.SuffixMessageIds, PactType.PrefixMessageIds]
  · simp [processType, body, PactType.InterfaceScoped]

/-- Literal termination is always a same-cycle completion.  This is a
compiler invariant, not a semantic assumption: every constructor transports
child `skipping` states into its `completing` metadata, and recursion includes
the body's completing states in the seed of its non-clock predecessor
closure. -/
private theorem compileTypeFuel_skipping_subset_completing
    (signature : TypeAlphabet) :
    ∀ fuel processType,
      TypeCompilationFuelSufficient processType fuel →
        (compileTypeFuel signature fuel processType).skipping ⊆
          (compileTypeFuel signature fuel processType).completing := by
  classical
  intro fuel
  induction fuel with
  | zero =>
      intro processType hFuel
      exact (Nat.not_lt_zero _
        (TypeCompilationFuelSufficient.positive hFuel)).elim
  | succ fuel ih =>
      intro processType hFuel state hSkipping
      cases processType with
      | message msg dir =>
          simpa [compileTypeFuel, finishAutomatonFragment] using
            (Or.inr hSkipping)
      | progress pid =>
          simpa [compileTypeFuel, finishAutomatonFragment] using
            (Or.inr hSkipping)
      | tock =>
          simpa [compileTypeFuel, finishAutomatonFragment] using hSkipping
      | skip =>
          simpa [compileTypeFuel, finishAutomatonFragment] using hSkipping
      | var name =>
          simp [compileTypeFuel, finishAutomatonFragment] at hSkipping
      | recur name body =>
          have hBodyFuel : TypeCompilationFuelSufficient body fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hBody := ih body hBodyFuel
          let bodyFragment := compileTypeFuel signature fuel body
          have hCompletion := buildRecursionAutomaton_completing_eq signature
            name bodyFragment
          simp only [compileTypeFuel] at hSkipping ⊢
          rw [hCompletion]
          have hChild : ∃ child ∈ bodyFragment.skipping,
              childState 0 child = state := by
            simpa [bodyFragment, buildRecursionAutomaton,
              finishAutomatonFragment, childSkipping] using hSkipping
          rcases hChild with ⟨child, hChildSkipping, rfl⟩
          apply Finset.mem_union_right
          apply Finset.mem_image.mpr
          refine ⟨child, completingBackClosure_superset_seed bodyFragment _ ?_,
            rfl⟩
          exact Finset.mem_union_right _ (hBody hChildSkipping)
      | choice left right =>
          have hLeftFuel : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hRightFuel : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hLeft := ih left hLeftFuel
          have hRight := ih right hRightFuel
          simp only [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hSkipping ⊢
          rcases hSkipping with hLeftSkipping | hRightSkipping
          · simp only [childSkipping, Finset.mem_image] at hLeftSkipping
            rcases hLeftSkipping with ⟨child, hChild, rfl⟩
            exact Or.inl (Or.inr (by
              simp only [childCompleting, Finset.mem_image]
              exact ⟨child, hLeft hChild, rfl⟩))
          · simp only [childSkipping, Finset.mem_image] at hRightSkipping
            rcases hRightSkipping with ⟨child, hChild, rfl⟩
            exact Or.inr (by
              simp only [childCompleting, Finset.mem_image]
              exact ⟨child, hRight hChild, rfl⟩)
      | fairChoice bid left right =>
          have hLeftFuel : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hRightFuel : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hLeft := ih left hLeftFuel
          have hRight := ih right hRightFuel
          simp only [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hSkipping ⊢
          rcases hSkipping with hLeftSkipping | hRightSkipping
          · simp only [childSkipping, Finset.mem_image] at hLeftSkipping
            rcases hLeftSkipping with ⟨child, hChild, rfl⟩
            exact Or.inl (Or.inr (by
              simp only [childCompleting, Finset.mem_image]
              exact ⟨child, hLeft hChild, rfl⟩))
          · simp only [childSkipping, Finset.mem_image] at hRightSkipping
            rcases hRightSkipping with ⟨child, hChild, rfl⟩
            exact Or.inr (by
              simp only [childCompleting, Finset.mem_image]
              exact ⟨child, hRight hChild, rfl⟩)
      | seq left right =>
          have hRightFuel : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hRight := ih right hRightFuel
          simp only [compileTypeFuel, buildSequenceAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hSkipping ⊢
          simp only [childSkipping, Finset.mem_image] at hSkipping
          rcases hSkipping with ⟨child, hChild, rfl⟩
          exact Or.inr (by
            simp only [childCompleting, Finset.mem_image]
            exact ⟨child, hRight hChild, rfl⟩)
      | par left right interface =>
          simp [compileTypeFuel, buildParallelAutomaton,
            finishAutomatonFragment] at hSkipping
      | xoffer elseType branches =>
          let branchAutomata := branches.map fun branch =>
            (branch.1, compileTypeFuel signature fuel branch.2)
          have hElseFuel : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hBranchFuel : typeBranchCompilationFuel branches ≤ fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel
            omega
          let automata := branches.map fun branch =>
            (branch.1, compileTypeFuel signature fuel branch.2)
          have hElse := ih elseType hElseFuel
          simp only [compileTypeFuel, buildExclusiveOfferAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hSkipping ⊢
          rcases hSkipping with hElseSkipping | hIndexedSkipping
          · simp only [childSkipping, Finset.mem_image] at hElseSkipping
            rcases hElseSkipping with ⟨child, hChild, rfl⟩
            exact Or.inl (Or.inr (by
              simp only [childCompleting, Finset.mem_image]
              exact ⟨child, hElse hChild, rfl⟩))
          ·
            rw [indexedFragmentSkipping, mem_foldl_union_iff] at hIndexedSkipping
            rw [indexedFragmentCompleting, mem_foldl_union_iff]
            rcases hIndexedSkipping with hEmpty | ⟨indexed, hIndexed, hChild⟩
            · simp at hEmpty
            · right
              right
              refine ⟨indexed, hIndexed, ?_⟩
              simp only [automata, childSkipping, Finset.mem_image] at hChild
              rcases hChild with ⟨child, hChildSkipping, rfl⟩
              simp only [childCompleting, Finset.mem_image]
              refine ⟨child, ?_, rfl⟩
              have hEntryMem : indexed.1 ∈ branches.map fun branch =>
                  (branch.1, compileTypeFuel signature fuel branch.2) := by
                have hMapped := List.mem_map_of_mem (f := Prod.fst) hIndexed
                simpa using hMapped
              rcases List.mem_map.mp hEntryMem with
                ⟨branch, hBranch, hEntry⟩
              have hFragment : indexed.1.2 =
                  compileTypeFuel signature fuel branch.2 := by
                exact (congrArg Prod.snd hEntry).symm
              rw [hFragment] at hChildSkipping ⊢
              exact ih branch.2
                (le_trans
                  (typeCompilationFuel_le_typeBranchCompilationFuel branches
                    branch hBranch) hBranchFuel) hChildSkipping
      | offer elseType branches =>
          have hElseFuel : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hConjunctionFuel : conjunctiveCompilationFuel branches ≤ fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel
            omega
          let automata := branches.map fun selected =>
            (selected.1, compileTypeFuel signature fuel
              (parallelTypeBranchesSelecting selected branches))
          have hElse := ih elseType hElseFuel
          simp only [compileTypeFuel, buildSelectedConjunctiveOfferAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hSkipping ⊢
          rcases hSkipping with hElseSkipping | hIndexedSkipping
          · simp only [childSkipping, Finset.mem_image] at hElseSkipping
            rcases hElseSkipping with ⟨child, hChild, rfl⟩
            exact Or.inl (Or.inr (by
              simp only [childCompleting, Finset.mem_image]
              exact ⟨child, hElse hChild, rfl⟩))
          ·
            rw [indexedFragmentSkipping, mem_foldl_union_iff] at hIndexedSkipping
            rw [indexedFragmentCompleting, mem_foldl_union_iff]
            rcases hIndexedSkipping with hEmpty | ⟨indexed, hIndexed, hChild⟩
            · simp at hEmpty
            · right
              right
              refine ⟨indexed, hIndexed, ?_⟩
              simp only [automata, childSkipping, Finset.mem_image] at hChild
              rcases hChild with ⟨child, hChildSkipping, rfl⟩
              simp only [childCompleting, Finset.mem_image]
              refine ⟨child, ?_, rfl⟩
              have hEntryMem : indexed.1 ∈ branches.map fun selected =>
                  (selected.1, compileTypeFuel signature fuel
                    (parallelTypeBranchesSelecting selected branches)) := by
                have hMapped := List.mem_map_of_mem (f := Prod.fst) hIndexed
                simpa using hMapped
              rcases List.mem_map.mp hEntryMem with
                ⟨selected, hSelected, hEntry⟩
              have hFragment : indexed.1.2 = compileTypeFuel signature fuel
                  (parallelTypeBranchesSelecting selected branches) := by
                exact (congrArg Prod.snd hEntry).symm
              rw [hFragment] at hChildSkipping ⊢
              apply ih (parallelTypeBranchesSelecting selected branches)
                _ hChildSkipping
              rw [TypeCompilationFuelSufficient,
                typeCompilationFuel_parallelTypeBranchesSelecting]
              exact hConjunctionFuel

/-- Every element of a branch list inherits the ambient tail flag. -/
private theorem tailBranchOccurrences_mem
    (name : String) (tail : Prop) :
    ∀ (branches : List (BareMessage × PactType))
      (entry : BareMessage × PactType),
      PactType.TailBranchOccurrences name tail branches →
      entry ∈ branches →
        PactType.TailOccurrences name tail entry.2 := by
  intro branches
  induction branches with
  | nil => intro entry _ hMem; simp at hMem
  | cons head rest ih =>
      intro entry hTail hMem
      obtain ⟨action, processType⟩ := head
      simp only [PactType.TailBranchOccurrences] at hTail
      rcases List.mem_cons.mp hMem with rfl | hRest
      · exact hTail.1
      · exact ih entry hTail.2 hRest

private theorem tailOccurrences_parallelTypeBranches
    (name : String) :
    ∀ (branches : List (BareMessage × PactType)),
      PactType.TailBranchOccurrences name False branches →
        PactType.TailOccurrences name False
          (parallelTypeBranches branches) := by
  intro branches
  induction branches with
  | nil => intro _; simp [parallelTypeBranches, PactType.TailOccurrences]
  | cons branch rest ih =>
      obtain ⟨action, processType⟩ := branch
      intro hTail
      have hFields : PactType.TailOccurrences name False processType ∧
          PactType.TailBranchOccurrences name False rest := by
        simpa only [PactType.TailBranchOccurrences] using hTail
      cases rest with
      | nil =>
          simp only [parallelTypeBranches, singletonTypeXOffer,
            PactType.TailOccurrences, PactType.TailBranchOccurrences]
          exact ⟨trivial, hFields.1, trivial⟩
      | cons next tailBranches =>
          simp only [parallelTypeBranches, singletonTypeXOffer,
            PactType.TailOccurrences, PactType.TailBranchOccurrences]
          exact ⟨⟨trivial, hFields.1, trivial⟩, ih hFields.2⟩

private theorem tailOccurrences_parallelTypeBranchesSelecting
    (name : String) (selected : BareMessage × PactType) :
    ∀ (branches : List (BareMessage × PactType)),
      PactType.TailBranchOccurrences name False branches →
        PactType.TailOccurrences name False
          (parallelTypeBranchesSelecting selected branches) := by
  intro branches
  induction branches with
  | nil =>
      intro _
      simp [parallelTypeBranchesSelecting, PactType.TailOccurrences]
  | cons branch rest ih =>
      obtain ⟨action, processType⟩ := branch
      intro hTail
      have hFields : PactType.TailOccurrences name False processType ∧
          PactType.TailBranchOccurrences name False rest := by
        simpa only [PactType.TailBranchOccurrences] using hTail
      cases rest with
      | nil =>
          by_cases hSelected : (action, processType) = selected
          · simp only [parallelTypeBranchesSelecting, if_pos hSelected,
              selectedTypeBranch, PactType.TailOccurrences]
            exact ⟨trivial, hFields.1⟩
          · simp only [parallelTypeBranchesSelecting, if_neg hSelected,
              singletonTypeXOffer, PactType.TailOccurrences,
              PactType.TailBranchOccurrences]
            exact ⟨trivial, hFields.1, trivial⟩
      | cons next tailBranches =>
          by_cases hSelected : (action, processType) = selected
          · simp only [parallelTypeBranchesSelecting, if_pos hSelected,
              selectedTypeBranch, PactType.TailOccurrences]
            exact ⟨⟨trivial, hFields.1⟩,
              tailOccurrences_parallelTypeBranches name _ hFields.2⟩
          · simp only [parallelTypeBranchesSelecting, if_neg hSelected,
              singletonTypeXOffer, PactType.TailOccurrences,
              PactType.TailBranchOccurrences]
            exact ⟨⟨trivial, hFields.1, trivial⟩, ih hFields.2⟩

private theorem tailRecursive_parallelTypeBranches :
    ∀ branches : List (BareMessage × PactType),
      PactType.TailRecursiveBranches branches →
        PactType.TailRecursive (parallelTypeBranches branches) := by
  intro branches
  induction branches with
  | nil => simp [parallelTypeBranches, PactType.TailRecursive]
  | cons branch rest ih =>
      rcases branch with ⟨action, branchType⟩
      intro hTail
      have hFields : branchType.TailRecursive ∧
          PactType.TailRecursiveBranches rest := by
        simpa only [PactType.TailRecursiveBranches] using hTail
      cases rest with
      | nil =>
          simpa [parallelTypeBranches, singletonTypeXOffer,
            PactType.TailRecursive, PactType.TailRecursiveBranches] using
              hFields.1
      | cons next tail =>
          simpa [parallelTypeBranches, singletonTypeXOffer,
            PactType.TailRecursive, PactType.TailRecursiveBranches] using
              And.intro hFields.1 (ih hFields.2)

private theorem tailRecursive_parallelTypeBranchesSelecting
    (selected : BareMessage × PactType) :
    ∀ branches : List (BareMessage × PactType),
      PactType.TailRecursiveBranches branches →
        PactType.TailRecursive
          (parallelTypeBranchesSelecting selected branches) := by
  intro branches
  induction branches with
  | nil => simp [parallelTypeBranchesSelecting, PactType.TailRecursive]
  | cons branch rest ih =>
      rcases branch with ⟨action, branchType⟩
      intro hTail
      have hFields : branchType.TailRecursive ∧
          PactType.TailRecursiveBranches rest := by
        simpa only [PactType.TailRecursiveBranches] using hTail
      cases rest with
      | nil =>
          by_cases hSelected : (action, branchType) = selected
          · simp [parallelTypeBranchesSelecting, hSelected,
              selectedTypeBranch, PactType.TailRecursive, hFields.1]
          · simp [parallelTypeBranchesSelecting, hSelected,
              singletonTypeXOffer, PactType.TailRecursive,
              PactType.TailRecursiveBranches, hFields.1]
      | cons next tail =>
          by_cases hSelected : (action, branchType) = selected
          · simp [parallelTypeBranchesSelecting, hSelected,
              selectedTypeBranch, PactType.TailRecursive, hFields.1,
              tailRecursive_parallelTypeBranches (next :: tail) hFields.2]
          · simp [parallelTypeBranchesSelecting, hSelected,
              singletonTypeXOffer, PactType.TailRecursive,
              PactType.TailRecursiveBranches, hFields.1, ih hFields.2]

private theorem binderHygienic_parallelTypeBranches (bound : List String) :
    ∀ branches : List (BareMessage × PactType),
      PactType.BinderHygienicBranches bound branches →
        PactType.BinderHygienic bound (parallelTypeBranches branches) := by
  intro branches
  induction branches with
  | nil => simp [parallelTypeBranches, PactType.BinderHygienic]
  | cons branch rest ih =>
      rcases branch with ⟨action, branchType⟩
      intro hHygienic
      have hFields : branchType.BinderHygienic bound ∧
          PactType.BinderHygienicBranches bound rest := by
        simpa only [PactType.BinderHygienicBranches] using hHygienic
      cases rest with
      | nil =>
          simpa [parallelTypeBranches, singletonTypeXOffer,
            PactType.BinderHygienic, PactType.BinderHygienicBranches] using
              hFields.1
      | cons next tail =>
          simpa [parallelTypeBranches, singletonTypeXOffer,
            PactType.BinderHygienic, PactType.BinderHygienicBranches] using
              And.intro hFields.1 (ih hFields.2)

private theorem binderHygienic_parallelTypeBranchesSelecting
    (bound : List String) (selected : BareMessage × PactType) :
    ∀ branches : List (BareMessage × PactType),
      PactType.BinderHygienicBranches bound branches →
        PactType.BinderHygienic bound
          (parallelTypeBranchesSelecting selected branches) := by
  intro branches
  induction branches with
  | nil => simp [parallelTypeBranchesSelecting, PactType.BinderHygienic]
  | cons branch rest ih =>
      rcases branch with ⟨action, branchType⟩
      intro hHygienic
      have hFields : branchType.BinderHygienic bound ∧
          PactType.BinderHygienicBranches bound rest := by
        simpa only [PactType.BinderHygienicBranches] using hHygienic
      cases rest with
      | nil =>
          by_cases hSelected : (action, branchType) = selected
          · simp [parallelTypeBranchesSelecting, hSelected,
              selectedTypeBranch, PactType.BinderHygienic, hFields.1]
          · simp [parallelTypeBranchesSelecting, hSelected,
              singletonTypeXOffer, PactType.BinderHygienic,
              PactType.BinderHygienicBranches, hFields.1]
      | cons next tail =>
          by_cases hSelected : (action, branchType) = selected
          · simp [parallelTypeBranchesSelecting, hSelected,
              selectedTypeBranch, PactType.BinderHygienic, hFields.1,
              binderHygienic_parallelTypeBranches bound (next :: tail)
                hFields.2]
          · simp [parallelTypeBranchesSelecting, hSelected,
              singletonTypeXOffer, PactType.BinderHygienic,
              PactType.BinderHygienicBranches, hFields.1, ih hFields.2]

/- Binder-context preservation for represented residuals. -/
private theorem compilationRelation_allVariablesBound
    {bound : List String} {original residual : PactType}
    {state : TypeAutomatonState}
    (hRelated : TypeCompilationRelation original state residual) :
    original.AllVariablesBound bound → residual.AllVariablesBound bound := by
  intro hBound
  induction hRelated generalizing bound with
  | skip => simpa [PactType.AllVariablesBound]
  | message_source => simpa
  | message_final => simp [PactType.AllVariablesBound]
  | cycle_source => simpa
  | cycle_final => simp [PactType.AllVariablesBound]
  | progress_source => simpa
  | progress_final => simp [PactType.AllVariablesBound]
  | «variable» => simpa
  | recur_source => simpa
  | recur_body name body childResidual childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      apply PactType.replaceVar_allVariablesBound bound name (.recur name body)
      · simpa [PactType.AllVariablesBound] using hBound
      · exact ih (bound := name :: bound) hBound
  | choice_source => simpa
  | choice_left left right childResidual childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      exact ih hBound.1
  | choice_right left right childResidual childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      exact ih hBound.2
  | fair_source => simpa
  | fair_left bid left right childResidual childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      exact ih hBound.1
  | fair_right bid left right childResidual childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      exact ih hBound.2
  | sequence_left left right childResidual childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound ⊢
      exact ⟨ih hBound.1, hBound.2⟩
  | sequence_right left right childResidual childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      exact ih hBound.2
  | parallel left right leftResidual rightResidual interface leftState
      rightState hLeft hRight ihLeft ihRight =>
      simp only [PactType.AllVariablesBound] at hBound ⊢
      exact ⟨ihLeft hBound.1, ihRight hBound.2⟩
  | xoffer_source => simpa
  | xoffer_else elseType childResidual branches childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      exact ih hBound.1
  | xoffer_branch elseType branchType childResidual branches action index
      childState hEntry hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      have hMember : (action, branchType) ∈ branches :=
        List.mem_of_getElem? hEntry
      exact ih (allVariablesBound_branch_of_mem bound branches
        (action, branchType) hBound.2 hMember)
  | offer_source => simpa
  | offer_branches elseType childResidual branches selected index childState
      hEntry hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      exact ih (allVariablesBound_parallelTypeBranchesSelecting bound selected
        branches hBound.2)
  | offer_else elseType childResidual branches childState hChild ih =>
      simp only [PactType.AllVariablesBound] at hBound
      exact ih hBound.1

/- A represented residual may cease to be hygienic after unfolding (the
replacement can carry binders below a sibling binder), but it remains fresh
for every externally active binder name.  This is exactly what substitution
fusion needs. -/
private theorem compilationRelation_binderFreshFor
    {forbidden : List String} {original residual : PactType}
    {state : TypeAutomatonState}
    (hRelated : TypeCompilationRelation original state residual) :
    original.BinderHygienic forbidden → residual.BinderFreshFor forbidden := by
  intro hHygienic
  induction hRelated generalizing forbidden with
  | skip => simp [PactType.BinderFreshFor]
  | message_source => simp [PactType.BinderFreshFor]
  | message_final => simp [PactType.BinderFreshFor]
  | cycle_source => simp [PactType.BinderFreshFor]
  | cycle_final => simp [PactType.BinderFreshFor]
  | progress_source => simp [PactType.BinderFreshFor]
  | progress_final => simp [PactType.BinderFreshFor]
  | «variable» => simp [PactType.BinderFreshFor]
  | recur_source => exact PactType.binderHygienic_binderFreshFor _ _ hHygienic
  | recur_body name body childResidual childState hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      have hReplacementFresh :
          (PactType.recur name body).BinderFreshFor forbidden := by
        simp only [PactType.BinderFreshFor]
        exact ⟨hHygienic.1,
          PactType.binderHygienic_binderFreshFor forbidden body
            (PactType.binderHygienic_mono
              (by intro x hx; exact List.mem_cons_of_mem name hx)
              body hHygienic.2)⟩
      apply PactType.replaceVar_binderFreshFor forbidden name (.recur name body)
        hReplacementFresh childResidual
      exact ih (forbidden := name :: forbidden) hHygienic.2
  | choice_source => exact PactType.binderHygienic_binderFreshFor _ _ hHygienic
  | choice_left left right childResidual childState hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      exact ih hHygienic.1
  | choice_right left right childResidual childState hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      exact ih hHygienic.2
  | fair_source => exact PactType.binderHygienic_binderFreshFor _ _ hHygienic
  | fair_left bid left right childResidual childState hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      exact ih hHygienic.1
  | fair_right bid left right childResidual childState hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      exact ih hHygienic.2
  | sequence_left left right childResidual childState hChild ih =>
      simp only [PactType.BinderHygienic, PactType.BinderFreshFor]
        at hHygienic ⊢
      exact ⟨ih hHygienic.1,
        PactType.binderHygienic_binderFreshFor forbidden right hHygienic.2⟩
  | sequence_right left right childResidual childState hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      exact ih hHygienic.2
  | parallel left right leftResidual rightResidual interface leftState
      rightState hLeft hRight ihLeft ihRight =>
      simp only [PactType.BinderHygienic, PactType.BinderFreshFor]
        at hHygienic ⊢
      exact ⟨ihLeft hHygienic.1, ihRight hHygienic.2⟩
  | xoffer_source => exact PactType.binderHygienic_binderFreshFor _ _ hHygienic
  | xoffer_else elseType childResidual branches childState hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      exact ih hHygienic.1
  | xoffer_branch elseType branchType childResidual branches action index
      childState hEntry hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      have hMember : (action, branchType) ∈ branches :=
        List.mem_of_getElem? hEntry
      exact ih (binderHygienic_branch_of_mem forbidden branches
        (action, branchType) hHygienic.2 hMember)
  | offer_source => exact PactType.binderHygienic_binderFreshFor _ _ hHygienic
  | offer_branches elseType childResidual branches selected index childState
      hEntry hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      exact ih (binderHygienic_parallelTypeBranchesSelecting forbidden selected
        branches hHygienic.2)
  | offer_else elseType childResidual branches childState hChild ih =>
      simp only [PactType.BinderHygienic] at hHygienic
      exact ih hHygienic.1

/- A forbidden tail occurrence remains forbidden in every residual represented
by a compiler state.  The recursion case is the only non-structural one:
same-name replacement removes the free name, while a different binder uses
the general substitution-preservation theorem. -/
private theorem compilationRelation_tailOccurrences_false
    (name : String) {processType residual : PactType}
    {state : TypeAutomatonState}
    (hRelated : TypeCompilationRelation processType state residual) :
    processType.TailOccurrences name False →
      residual.TailOccurrences name False := by
  induction hRelated with
  | skip => simp [PactType.TailOccurrences]
  | message_source msg dir => intro hTail; exact hTail
  | message_final msg dir => simp [PactType.TailOccurrences]
  | cycle_source => intro hTail; exact hTail
  | cycle_final => simp [PactType.TailOccurrences]
  | progress_source pid => intro hTail; exact hTail
  | progress_final pid => simp [PactType.TailOccurrences]
  | «variable» other => intro hTail; exact hTail
  | recur_source binder body => intro hTail; exact hTail
  | recur_body binder body childResidual childState hChild ih =>
      intro hTail
      by_cases hName : binder = name
      · subst binder
        exact PactType.tailOccurrences_false_replaceVar_self_recur name body
          childResidual
      · have hBodyTail : body.TailOccurrences name False := by
          simpa only [PactType.TailOccurrences, if_neg hName] using hTail
        exact PactType.tailOccurrences_false_replaceVar name binder
          (.recur binder body) hTail childResidual (ih hBodyTail)
  | choice_source left right => intro hTail; exact hTail
  | choice_left left right childResidual childState hChild ih =>
      intro hTail
      have hFields : left.TailOccurrences name False ∧
          right.TailOccurrences name False := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih hFields.1
  | choice_right left right childResidual childState hChild ih =>
      intro hTail
      have hFields : left.TailOccurrences name False ∧
          right.TailOccurrences name False := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih hFields.2
  | fair_source bid left right => intro hTail; exact hTail
  | fair_left bid left right childResidual childState hChild ih =>
      intro hTail
      have hFields : left.TailOccurrences name False ∧
          right.TailOccurrences name False := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih hFields.1
  | fair_right bid left right childResidual childState hChild ih =>
      intro hTail
      have hFields : left.TailOccurrences name False ∧
          right.TailOccurrences name False := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih hFields.2
  | sequence_left left right childResidual childState hChild ih =>
      intro hTail
      have hFields : left.TailOccurrences name False ∧
          right.TailOccurrences name False := by
        simpa only [PactType.TailOccurrences] using hTail
      simpa only [PactType.TailOccurrences] using And.intro
        (ih hFields.1) hFields.2
  | sequence_right left right childResidual childState hChild ih =>
      intro hTail
      have hFields : left.TailOccurrences name False ∧
          right.TailOccurrences name False := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih hFields.2
  | parallel left right leftResidual rightResidual interface leftState
      rightState hLeft hRight ihLeft ihRight =>
      intro hTail
      have hFields : left.TailOccurrences name False ∧
          right.TailOccurrences name False := by
        simpa only [PactType.TailOccurrences] using hTail
      simpa only [PactType.TailOccurrences] using And.intro
        (ihLeft hFields.1) (ihRight hFields.2)
  | xoffer_source elseType branches => intro hTail; exact hTail
  | xoffer_else elseType childResidual branches childState hChild ih =>
      intro hTail
      have hFields : elseType.TailOccurrences name False ∧
          PactType.TailBranchOccurrences name False branches := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih hFields.1
  | xoffer_branch elseType branchType childResidual branches action index
      childState hEntry hChild ih =>
      intro hTail
      have hFields : elseType.TailOccurrences name False ∧
          PactType.TailBranchOccurrences name False branches := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih (tailBranchOccurrences_mem name False branches
        (action, branchType) hFields.2 (List.mem_of_getElem? hEntry))
  | offer_source elseType branches => intro hTail; exact hTail
  | offer_branches elseType childResidual branches selected index childState
      hEntry hChild ih =>
      intro hTail
      have hFields : elseType.TailOccurrences name False ∧
          PactType.TailBranchOccurrences name False branches := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih (tailOccurrences_parallelTypeBranchesSelecting name selected
        branches hFields.2)
  | offer_else elseType childResidual branches childState hChild ih =>
      intro hTail
      have hFields : elseType.TailOccurrences name False ∧
          PactType.TailBranchOccurrences name False branches := by
        simpa only [PactType.TailOccurrences] using hTail
      exact ih hFields.1

/- In a represented non-tail context, parametric recursion completion is
literally ordinary syntax completion. -/
private theorem compilationRelation_canCompleteBeforeTockSubst_eq_of_false
    (name : String) (value : Bool) {processType residual : PactType}
    {state : TypeAutomatonState}
    (hRelated : TypeCompilationRelation processType state residual)
    (hTail : processType.TailOccurrences name False) :
    PactType.canCompleteBeforeTockSubst name value residual =
      residual.CanCompleteBeforeTock :=
  PactType.canCompleteBeforeTockSubst_eq_of_tailOccurrences_false name value
    residual (compilationRelation_tailOccurrences_false name hRelated hTail)

/-- **Recursive-call sources represent bare variables.**

If a compiled fragment still carries an unresolved `.variable name` marker
edge, then — provided `name` occurs only in tail position — the source of that
edge represents exactly the residual `PactType.var name`, and the ambient tail
flag holds.

The `tail` conjunct is what makes the induction go through: a `.variable name`
marker occurring in a non-tail position (the left of a sequence, either side
of a parallel composition, or a conjunctive-offer branch) is impossible,
because there `TailOccurrences name False` holds and the conclusion `tail`
degenerates to `False`.  In the tail positions that remain (choice branches,
the right of a sequence, exclusive-offer continuations, and the body of a
non-shadowing binder) the representative residual is transported unchanged by
the corresponding `TypeCompilationRelation` constructor, so it stays
`PactType.var name`; under a non-shadowing binder `replaceVar` leaves it
alone, which is why `other ≠ name` is extracted first.

Stating the conclusion as the relation itself (rather than as uniqueness of
the represented residual) additionally supplies *existence* of a
representative, which the seed-inclusion step of
`recursionBodyCompletingClosure_subset` needs.

The induction mirrors `compileTypeFuel_futureTargetsInStates`: structural on
the compilation fuel, one case per constructor of the compiler. -/
private theorem compileTypeFuel_variableEdge_source_var
    (signature : TypeAlphabet) (name : String) :
    ∀ (fuel : Nat) (processType : PactType) (tail : Prop),
      TypeCompilationFuelSufficient processType fuel →
      PactType.TailOccurrences name tail processType →
      ∀ edge ∈ (compileTypeFuel signature fuel processType).edges,
        edge.label = AutomatonConstructionLabel.variable name →
          tail ∧ TypeCompilationRelation processType edge.source
            (PactType.var name) := by
  classical
  intro fuel
  induction fuel with
  | zero =>
      intro processType tail hFuel
      exact (Nat.not_lt_zero _ (TypeCompilationFuelSufficient.positive hFuel)).elim
  | succ fuel ih =>
      intro processType tail hFuel hTail edge hEdge hLabel
      cases processType with
      | skip =>
          exfalso
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with ⟨environment, _, hEq⟩
          rw [← hEq] at hLabel
          exact absurd hLabel (by simp)
      | message msg dir =>
          exfalso
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with ((⟨e, _, hEq⟩ | ⟨e, _, hEq⟩) | ⟨e, _, hEq⟩) <;>
            (rw [← hEq] at hLabel; exact absurd hLabel (by simp))
      | tock =>
          exfalso
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with (⟨e, _, hEq⟩ | ⟨e, _, hEq⟩)
          · rw [← hEq] at hLabel
            split at hLabel <;> exact absurd hLabel (by simp)
          · rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
      | progress pid =>
          exfalso
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with (⟨e, _, hEq⟩ | ⟨e, _, hEq⟩) <;>
            (rw [← hEq] at hLabel; exact absurd hLabel (by simp))
      | var other =>
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_image] at hEdge
          rcases hEdge with ⟨environment, _, hEq⟩
          rw [← hEq] at hLabel
          have hName : other = name := by
            simpa using hLabel
          subst hName
          have hSource : edge.source = TypeAutomatonState.root := by
            rw [← hEq]
          refine ⟨?_, ?_⟩
          · simpa [PactType.TailOccurrences] using hTail
          · rw [hSource]
            exact TypeCompilationRelation.variable _
      | recur other body =>
          have hBody : TypeCompilationFuelSufficient body fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          simp only [compileTypeFuel, buildRecursionAutomaton,
            finishAutomatonFragment, Finset.mem_union, Finset.mem_image]
            at hEdge
          rcases hEdge with ⟨environment, _, hEq⟩ | ⟨bodyEdge, hBodyEdge, hEq⟩
          · exfalso
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
          · by_cases hVarOther :
                bodyEdge.label = AutomatonConstructionLabel.variable other
            · exfalso
              rw [if_pos hVarOther] at hEq
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
            · rw [if_neg hVarOther] at hEq
              have hBodyLabel :
                  bodyEdge.label = AutomatonConstructionLabel.variable name := by
                rw [← hEq] at hLabel
                exact hLabel
              have hOther : other ≠ name := by
                intro hEqName
                exact hVarOther (hEqName ▸ hBodyLabel)
              have hTailBody : PactType.TailOccurrences name tail body := by
                have hTail' := hTail
                simp only [PactType.TailOccurrences] at hTail'
                rw [if_neg hOther] at hTail'
                exact hTail'
              have hIH := ih body tail hBody hTailBody bodyEdge hBodyEdge
                hBodyLabel
              refine ⟨hIH.1, ?_⟩
              have hSource :
                  edge.source = TypeAutomatonState.child 0 bodyEdge.source := by
                rw [← hEq]; rfl
              rw [hSource]
              have hRecur := TypeCompilationRelation.recur_body other body
                (PactType.var name) bodyEdge.source hIH.2
              simpa [PactType.replaceVar, hOther] using hRecur
      | choice left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hTailLeft : PactType.TailOccurrences name tail left ∧
              PactType.TailOccurrences name tail right := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment, childPendingEdges, Finset.mem_union,
            Finset.mem_image, Finset.mem_biUnion, Finset.mem_insert,
            Finset.mem_singleton] at hEdge
          rcases hEdge with (⟨childEdge, hChildEdge, hEq⟩ |
            ⟨childEdge, hChildEdge, hEq⟩) | ⟨environment, _, hEq | hEq⟩
          · have hChildLabel :
                childEdge.label = AutomatonConstructionLabel.variable name := by
              rw [← hEq] at hLabel
              exact hLabel
            have hIH := ih left tail hLeft hTailLeft.1 childEdge hChildEdge
              hChildLabel
            refine ⟨hIH.1, ?_⟩
            have hSource : edge.source =
                TypeAutomatonState.child 0 childEdge.source := by
              rw [← hEq]; rfl
            rw [hSource]
            exact TypeCompilationRelation.choice_left left right
              (PactType.var name) childEdge.source hIH.2
          · have hChildLabel :
                childEdge.label = AutomatonConstructionLabel.variable name := by
              rw [← hEq] at hLabel
              exact hLabel
            have hIH := ih right tail hRight hTailLeft.2 childEdge hChildEdge
              hChildLabel
            refine ⟨hIH.1, ?_⟩
            have hSource : edge.source =
                TypeAutomatonState.child 1 childEdge.source := by
              rw [← hEq]; rfl
            rw [hSource]
            exact TypeCompilationRelation.choice_right left right
              (PactType.var name) childEdge.source hIH.2
          · exfalso
            rw [hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            rw [hEq] at hLabel
            exact absurd hLabel (by simp)
      | fairChoice bid left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hTailLeft : PactType.TailOccurrences name tail left ∧
              PactType.TailOccurrences name tail right := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment, childPendingEdges, Finset.mem_union,
            Finset.mem_image, Finset.mem_biUnion, Finset.mem_insert,
            Finset.mem_singleton] at hEdge
          rcases hEdge with (⟨childEdge, hChildEdge, hEq⟩ |
            ⟨childEdge, hChildEdge, hEq⟩) | ⟨environment, _, hEq | hEq⟩
          · have hChildLabel :
                childEdge.label = AutomatonConstructionLabel.variable name := by
              rw [← hEq] at hLabel
              exact hLabel
            have hIH := ih left tail hLeft hTailLeft.1 childEdge hChildEdge
              hChildLabel
            refine ⟨hIH.1, ?_⟩
            have hSource : edge.source =
                TypeAutomatonState.child 0 childEdge.source := by
              rw [← hEq]; rfl
            rw [hSource]
            exact TypeCompilationRelation.fair_left bid left right
              (PactType.var name) childEdge.source hIH.2
          · have hChildLabel :
                childEdge.label = AutomatonConstructionLabel.variable name := by
              rw [← hEq] at hLabel
              exact hLabel
            have hIH := ih right tail hRight hTailLeft.2 childEdge hChildEdge
              hChildLabel
            refine ⟨hIH.1, ?_⟩
            have hSource : edge.source =
                TypeAutomatonState.child 1 childEdge.source := by
              rw [← hEq]; rfl
            rw [hSource]
            exact TypeCompilationRelation.fair_right bid left right
              (PactType.var name) childEdge.source hIH.2
          · exfalso
            rw [hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            rw [hEq] at hLabel
            exact absurd hLabel (by simp)
      | seq left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hTailFields : PactType.TailOccurrences name False left ∧
              PactType.TailOccurrences name tail right := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildSequenceAutomaton,
            finishAutomatonFragment, childPendingEdges, Finset.mem_union,
            Finset.mem_image, Finset.mem_biUnion] at hEdge
          rcases hEdge with ((⟨childEdge, hChildEdge, hEq⟩ |
              ⟨childEdge, hChildEdge, hEq⟩) |
            ⟨skipState, _, environment, _, hEq⟩) | ⟨completeState, _, hEq⟩
          · exact absurd (ih left False hLeft hTailFields.1 childEdge
              hChildEdge (by rw [← hEq] at hLabel; exact hLabel)).1 (by simp)
          · have hChildLabel :
                childEdge.label = AutomatonConstructionLabel.variable name := by
              rw [← hEq] at hLabel
              exact hLabel
            have hIH := ih right tail hRight hTailFields.2 childEdge hChildEdge
              hChildLabel
            refine ⟨hIH.1, ?_⟩
            have hSource : edge.source =
                TypeAutomatonState.child 1 childEdge.source := by
              rw [← hEq]; rfl
            rw [hSource]
            exact TypeCompilationRelation.sequence_right left right
              (PactType.var name) childEdge.source hIH.2
          · exfalso
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
      | par left right interface =>
          exfalso
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hTailFields : PactType.TailOccurrences name False left ∧
              PactType.TailOccurrences name False right := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildParallelAutomaton,
            finishAutomatonFragment, Finset.mem_union, Finset.mem_biUnion,
            Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with hTransition | hObservation
          · rcases hTransition with
              ⟨leftEdge, ⟨hLeftEdge, _⟩, rightEdge, ⟨⟨hRightEdge, _⟩, _⟩, hEq⟩
            rw [← hEq] at hLabel
            simp only at hLabel
            have hComponent :
                leftEdge.label = AutomatonConstructionLabel.variable name ∨
                  rightEdge.label = AutomatonConstructionLabel.variable name := by
              cases hLeftLabel : leftEdge.label <;>
                cases hRightLabel : rightEdge.label <;>
                  simp_all [AutomatonConstructionLabel.combine]
            rcases hComponent with hComponent | hComponent
            · simp only [resolvedAutomatonEdges, Finset.mem_image] at hLeftEdge
              rcases hLeftEdge with ⟨raw, hRaw, hRawEq⟩
              refine (ih left False hLeft hTailFields.1 raw hRaw ?_).1
              rw [← hRawEq] at hComponent
              exact hComponent
            · simp only [resolvedAutomatonEdges, Finset.mem_image] at hRightEdge
              rcases hRightEdge with ⟨raw, hRaw, hRawEq⟩
              refine (ih right False hRight hTailFields.2 raw hRaw ?_).1
              rw [← hRawEq] at hComponent
              exact hComponent
          · rcases hObservation with hLeftFuture | hRightFuture
            · rcases hLeftFuture with ⟨leftState, _, rightState, _, hEq⟩
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
            · rcases hRightFuture with ⟨leftState, _, rightState, _, hEq⟩
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
      | xoffer elseType branches =>
          have hElse : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hBranches : typeBranchCompilationFuel branches ≤ fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel
            omega
          have hTailFields : PactType.TailOccurrences name tail elseType ∧
              PactType.TailBranchOccurrences name tail branches := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildExclusiveOfferAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hEdge
          rcases hEdge with
            ((((hElseEdge | hIndexed) | hBranch) | hWait) | hResolved)
          · simp only [childPendingEdges, Finset.mem_image] at hElseEdge
            rcases hElseEdge with ⟨childEdge, hChildEdge, hEq⟩
            have hChildLabel :
                childEdge.label = AutomatonConstructionLabel.variable name := by
              rw [← hEq] at hLabel
              exact hLabel
            have hIH := ih elseType tail hElse hTailFields.1 childEdge
              hChildEdge hChildLabel
            refine ⟨hIH.1, ?_⟩
            have hSource : edge.source =
                TypeAutomatonState.child 0 childEdge.source := by
              rw [← hEq]; rfl
            rw [hSource]
            exact TypeCompilationRelation.xoffer_else elseType
              (PactType.var name) branches childEdge.source hIH.2
          · rw [indexedFragmentEdges, mem_foldl_union_iff] at hIndexed
            rcases hIndexed with hEmpty | ⟨indexed, hIndexedMem, hChild⟩
            · simp at hEmpty
            · simp only [childPendingEdges, Finset.mem_image] at hChild
              rcases hChild with ⟨childEdge, hChildEdge, hEq⟩
              have hIndexedFields := List.mem_zipIdx hIndexedMem
              simp only [Nat.zero_le, zero_add, Nat.sub_zero, true_and]
                at hIndexedFields
              rcases hIndexedFields with ⟨hBound, hValue⟩
              have hIndexedEntry :
                  (branches.map fun branch =>
                    (branch.1, compileTypeFuel signature fuel
                      branch.2))[indexed.2]? = some indexed.1 := by
                rw [List.getElem?_eq_getElem hBound, ← hValue]
              rw [List.getElem?_map] at hIndexedEntry
              rcases Option.map_eq_some_iff.mp hIndexedEntry with
                ⟨entry, hEntry, hEntryEq⟩
              have hChildLabel :
                  childEdge.label =
                    AutomatonConstructionLabel.variable name := by
                rw [← hEq] at hLabel
                exact hLabel
              have hEntryMem : entry ∈ branches :=
                List.mem_of_getElem? hEntry
              have hEntryFuel :
                  TypeCompilationFuelSufficient entry.2 fuel :=
                le_trans (typeCompilationFuel_le_typeBranchCompilationFuel
                  branches entry hEntryMem) hBranches
              have hFragmentEq :
                  indexed.1.2 = compileTypeFuel signature fuel entry.2 := by
                rw [← hEntryEq]
              rw [hFragmentEq] at hChildEdge
              have hIH := ih entry.2 tail hEntryFuel
                (tailBranchOccurrences_mem name tail branches entry
                  hTailFields.2 hEntryMem) childEdge hChildEdge hChildLabel
              refine ⟨hIH.1, ?_⟩
              have hSource : edge.source =
                  TypeAutomatonState.child (indexed.2 + 1) childEdge.source := by
                rw [← hEq]; rfl
              rw [hSource]
              exact TypeCompilationRelation.xoffer_branch elseType entry.2
                (PactType.var name) branches entry.1 indexed.2
                childEdge.source hEntry hIH.2
          · rw [mem_foldl_union_iff] at hBranch
            rcases hBranch with hEmpty | ⟨indexed, _, hNewEdge⟩
            · simp at hEmpty
            · exfalso
              simp only [Finset.mem_image, Finset.mem_filter] at hNewEdge
              rcases hNewEdge with ⟨environment, _, hEq⟩
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
          · exfalso
            simp only [Finset.mem_image, Finset.mem_filter] at hWait
            rcases hWait with ⟨environment, _, hEq⟩
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            simp only [Finset.mem_image, Finset.mem_filter] at hResolved
            rcases hResolved with ⟨environment, _, hEq⟩
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
      | offer elseType branches =>
          have hElse : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hConjunction : conjunctiveCompilationFuel branches ≤ fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel
            omega
          have hTailFields : PactType.TailOccurrences name tail elseType ∧
              PactType.TailBranchOccurrences name False branches := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildSelectedConjunctiveOfferAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hEdge
          rcases hEdge with
            ((((hElseEdge | hIndexed) | hEnabled) | hWait) | hResolved)
          · simp only [childPendingEdges, Finset.mem_image] at hElseEdge
            rcases hElseEdge with ⟨childEdge, hChildEdge, hEq⟩
            have hChildLabel :
                childEdge.label = AutomatonConstructionLabel.variable name := by
              rw [← hEq] at hLabel
              exact hLabel
            have hIH := ih elseType tail hElse hTailFields.1 childEdge
              hChildEdge hChildLabel
            refine ⟨hIH.1, ?_⟩
            have hSource : edge.source =
                TypeAutomatonState.child 0 childEdge.source := by
              rw [← hEq]; rfl
            rw [hSource]
            exact TypeCompilationRelation.offer_else elseType
              (PactType.var name) branches childEdge.source hIH.2
          · exfalso
            rw [indexedFragmentEdges, mem_foldl_union_iff] at hIndexed
            rcases hIndexed with hEmpty | ⟨indexed, hIndexedMem, hChild⟩
            · simp at hEmpty
            · simp only [childPendingEdges, Finset.mem_image] at hChild
              rcases hChild with ⟨childEdge, hChildEdge, hEq⟩
              have hIndexedFields := List.mem_zipIdx hIndexedMem
              simp only [Nat.zero_le, zero_add, Nat.sub_zero, true_and]
                at hIndexedFields
              rcases hIndexedFields with ⟨hBound, hValue⟩
              have hIndexedEntry :
                  (branches.map fun selected =>
                    (selected.1, compileTypeFuel signature fuel
                      (parallelTypeBranchesSelecting selected
                        branches)))[indexed.2]? = some indexed.1 := by
                rw [List.getElem?_eq_getElem hBound, ← hValue]
              rw [List.getElem?_map] at hIndexedEntry
              rcases Option.map_eq_some_iff.mp hIndexedEntry with
                ⟨entry, hEntry, hEntryEq⟩
              have hChildLabel :
                  childEdge.label =
                    AutomatonConstructionLabel.variable name := by
                rw [← hEq] at hLabel
                exact hLabel
              have hSelectedFuel : TypeCompilationFuelSufficient
                  (parallelTypeBranchesSelecting entry branches) fuel := by
                have := typeCompilationFuel_parallelTypeBranchesSelecting entry
                  branches
                simp only [TypeCompilationFuelSufficient, this]
                exact hConjunction
              have hFragmentEq : indexed.1.2 = compileTypeFuel signature fuel
                  (parallelTypeBranchesSelecting entry branches) := by
                rw [← hEntryEq]
              rw [hFragmentEq] at hChildEdge
              exact (ih (parallelTypeBranchesSelecting entry branches) False
                hSelectedFuel
                (tailOccurrences_parallelTypeBranchesSelecting name entry
                  branches hTailFields.2) childEdge hChildEdge hChildLabel).1
          · exfalso
            rw [mem_foldl_union_iff] at hEnabled
            rcases hEnabled with hEmpty | ⟨indexed, _, hNewEdge⟩
            · simp at hEmpty
            · simp only [Finset.mem_image, Finset.mem_filter] at hNewEdge
              rcases hNewEdge with ⟨environment, _, hEq⟩
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
          · exfalso
            simp only [Finset.mem_image, Finset.mem_filter] at hWait
            rcases hWait with ⟨environment, _, hEq⟩
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            simp only [Finset.mem_image, Finset.mem_filter] at hResolved
            rcases hResolved with ⟨environment, _, hEq⟩
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)

/-- Every `.variable name` marker edge the compiler produces is inert: it
offers nothing in the current cycle and refers to nothing later.  Markers are
therefore invisible to `computeFuture` until an enclosing recursion binder
installs their backedges — which is exactly the `MarkerEdgesInert` hypothesis
of `mem_computeFuture_markerAugmented`.

The `TailOccurrences` premise is genuinely needed rather than bookkeeping:
`AutomatonConstructionLabel.combine` propagates a component `.variable name`
label onto a synchronized product edge, and that edge carries real product
offers.  Tail occurrence rules out a marker below `par` (and below a
conjunctive-offer branch) in the first place, which is why those two cases are
vacuous instead of structural. -/
private theorem compileTypeFuel_markerEdgesInert
    (signature : TypeAlphabet) (name : String) :
    ∀ (fuel : Nat) (processType : PactType) (tail : Prop),
      TypeCompilationFuelSufficient processType fuel →
      PactType.TailOccurrences name tail processType →
        MarkerEdgesInert (compileTypeFuel signature fuel processType) name := by
  classical
  intro fuel
  induction fuel with
  | zero =>
      intro processType tail hFuel hTail edge hEdge _
      simp [compileTypeFuel] at hEdge
  | succ fuel ih =>
      intro processType tail hFuel hTail edge hEdge hLabel
      cases processType with
      | skip =>
          exfalso
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_image] at hEdge
          rcases hEdge with ⟨environment, _, hEq⟩
          rw [← hEq] at hLabel
          exact absurd hLabel (by simp)
      | message msg dir =>
          exfalso
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with ((⟨e, _, hEq⟩ | ⟨e, _, hEq⟩) | ⟨e, _, hEq⟩) <;>
            (rw [← hEq] at hLabel; exact absurd hLabel (by simp))
      | tock =>
          exfalso
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with (⟨e, _, hEq⟩ | ⟨e, _, hEq⟩)
          · rw [← hEq] at hLabel
            split at hLabel <;> exact absurd hLabel (by simp)
          · rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
      | progress pid =>
          exfalso
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with (⟨e, _, hEq⟩ | ⟨e, _, hEq⟩) <;>
            (rw [← hEq] at hLabel; exact absurd hLabel (by simp))
      | var other =>
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_image] at hEdge
          rcases hEdge with ⟨environment, _, hEq⟩
          rw [← hEq]
          exact ⟨rfl, rfl⟩
      | recur other body =>
          have hBody : TypeCompilationFuelSufficient body fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          simp only [compileTypeFuel, buildRecursionAutomaton,
            finishAutomatonFragment, Finset.mem_union, Finset.mem_image]
            at hEdge
          rcases hEdge with ⟨environment, _, hEq⟩ | ⟨bodyEdge, hBodyEdge, hEq⟩
          · exfalso
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
          · by_cases hVarOther :
                bodyEdge.label = AutomatonConstructionLabel.variable other
            · exfalso
              rw [if_pos hVarOther] at hEq
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
            · rw [if_neg hVarOther] at hEq
              have hBodyLabel :
                  bodyEdge.label = AutomatonConstructionLabel.variable name := by
                rw [← hEq] at hLabel
                exact hLabel
              have hOther : other ≠ name := by
                intro hEqName
                exact hVarOther (hEqName ▸ hBodyLabel)
              have hTailBody : PactType.TailOccurrences name tail body := by
                have hTail' := hTail
                simp only [PactType.TailOccurrences] at hTail'
                rw [if_neg hOther] at hTail'
                exact hTail'
              have hIH := ih body tail hBody hTailBody bodyEdge hBodyEdge
                hBodyLabel
              rw [← hEq]
              exact ⟨hIH.1, by simp [hIH.2, childFutureSpec]⟩
      | choice left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hTailFields : PactType.TailOccurrences name tail left ∧
              PactType.TailOccurrences name tail right := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment, childPendingEdges, Finset.mem_union,
            Finset.mem_image, Finset.mem_biUnion, Finset.mem_insert,
            Finset.mem_singleton] at hEdge
          rcases hEdge with (⟨childEdge, hChildEdge, hEq⟩ |
            ⟨childEdge, hChildEdge, hEq⟩) | ⟨environment, _, hEq | hEq⟩
          · have hIH := ih left tail hLeft hTailFields.1 childEdge hChildEdge
              (by rw [← hEq] at hLabel; exact hLabel)
            rw [← hEq]
            exact ⟨hIH.1, by simp [hIH.2, childPendingEdge, childFutureSpec]⟩
          · have hIH := ih right tail hRight hTailFields.2 childEdge hChildEdge
              (by rw [← hEq] at hLabel; exact hLabel)
            rw [← hEq]
            exact ⟨hIH.1, by simp [hIH.2, childPendingEdge, childFutureSpec]⟩
          · exfalso
            rw [hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            rw [hEq] at hLabel
            exact absurd hLabel (by simp)
      | fairChoice bid left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hTailFields : PactType.TailOccurrences name tail left ∧
              PactType.TailOccurrences name tail right := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment, childPendingEdges, Finset.mem_union,
            Finset.mem_image, Finset.mem_biUnion, Finset.mem_insert,
            Finset.mem_singleton] at hEdge
          rcases hEdge with (⟨childEdge, hChildEdge, hEq⟩ |
            ⟨childEdge, hChildEdge, hEq⟩) | ⟨environment, _, hEq | hEq⟩
          · have hIH := ih left tail hLeft hTailFields.1 childEdge hChildEdge
              (by rw [← hEq] at hLabel; exact hLabel)
            rw [← hEq]
            exact ⟨hIH.1, by simp [hIH.2, childPendingEdge, childFutureSpec]⟩
          · have hIH := ih right tail hRight hTailFields.2 childEdge hChildEdge
              (by rw [← hEq] at hLabel; exact hLabel)
            rw [← hEq]
            exact ⟨hIH.1, by simp [hIH.2, childPendingEdge, childFutureSpec]⟩
          · exfalso
            rw [hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            rw [hEq] at hLabel
            exact absurd hLabel (by simp)
      | seq left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hTailFields : PactType.TailOccurrences name False left ∧
              PactType.TailOccurrences name tail right := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildSequenceAutomaton,
            finishAutomatonFragment, childPendingEdges, Finset.mem_union,
            Finset.mem_image, Finset.mem_biUnion] at hEdge
          rcases hEdge with ((⟨childEdge, hChildEdge, hEq⟩ |
              ⟨childEdge, hChildEdge, hEq⟩) |
            ⟨skipState, _, environment, _, hEq⟩) | ⟨completeState, _, hEq⟩
          · -- A lifted *left* sequence edge is re-decorated with a symbolic
            -- `.at` future at its tagged target, so it would not be inert.
            -- `TailOccurrences` forbids `name` in a sequence's left component
            -- outright, so this case is vacuous rather than structural.
            exact (compileTypeFuel_variableEdge_source_var signature name
              fuel left False hLeft hTailFields.1 childEdge hChildEdge
              (by rw [← hEq] at hLabel; exact hLabel)).1.elim
          · have hIH := ih right tail hRight hTailFields.2 childEdge hChildEdge
              (by rw [← hEq] at hLabel; exact hLabel)
            rw [← hEq]
            exact ⟨hIH.1, by simp [hIH.2, childPendingEdge, childFutureSpec]⟩
          · exfalso
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
      | par left right interface =>
          exfalso
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hTailFields : PactType.TailOccurrences name False left ∧
              PactType.TailOccurrences name False right := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildParallelAutomaton,
            finishAutomatonFragment, Finset.mem_union, Finset.mem_biUnion,
            Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with hTransition | hObservation
          · rcases hTransition with
              ⟨leftEdge, ⟨hLeftEdge, _⟩, rightEdge, ⟨⟨hRightEdge, _⟩, _⟩, hEq⟩
            rw [← hEq] at hLabel
            simp only at hLabel
            have hComponent :
                leftEdge.label = AutomatonConstructionLabel.variable name ∨
                  rightEdge.label = AutomatonConstructionLabel.variable name := by
              cases hLeftLabel : leftEdge.label <;>
                cases hRightLabel : rightEdge.label <;>
                  simp_all [AutomatonConstructionLabel.combine]
            rcases hComponent with hComponent | hComponent
            · simp only [resolvedAutomatonEdges, Finset.mem_image] at hLeftEdge
              rcases hLeftEdge with ⟨raw, hRaw, hRawEq⟩
              refine (compileTypeFuel_variableEdge_source_var signature name
                fuel left False hLeft hTailFields.1 raw hRaw ?_).1
              rw [← hRawEq] at hComponent
              exact hComponent
            · simp only [resolvedAutomatonEdges, Finset.mem_image] at hRightEdge
              rcases hRightEdge with ⟨raw, hRaw, hRawEq⟩
              refine (compileTypeFuel_variableEdge_source_var signature name
                fuel right False hRight hTailFields.2 raw hRaw ?_).1
              rw [← hRawEq] at hComponent
              exact hComponent
          · rcases hObservation with hLeftFuture | hRightFuture
            · rcases hLeftFuture with ⟨leftState, _, rightState, _, hEq⟩
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
            · rcases hRightFuture with ⟨leftState, _, rightState, _, hEq⟩
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
      | xoffer elseType branches =>
          have hElse : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hBranches : typeBranchCompilationFuel branches ≤ fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel
            omega
          have hTailFields : PactType.TailOccurrences name tail elseType ∧
              PactType.TailBranchOccurrences name tail branches := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildExclusiveOfferAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hEdge
          rcases hEdge with
            ((((hElseEdge | hIndexed) | hBranch) | hWait) | hResolved)
          · simp only [childPendingEdges, Finset.mem_image] at hElseEdge
            rcases hElseEdge with ⟨childEdge, hChildEdge, hEq⟩
            have hIH := ih elseType tail hElse hTailFields.1 childEdge
              hChildEdge (by rw [← hEq] at hLabel; exact hLabel)
            rw [← hEq]
            exact ⟨hIH.1, by simp [hIH.2, childPendingEdge, childFutureSpec]⟩
          · rw [indexedFragmentEdges, mem_foldl_union_iff] at hIndexed
            rcases hIndexed with hEmpty | ⟨indexed, hIndexedMem, hChild⟩
            · simp at hEmpty
            · simp only [childPendingEdges, Finset.mem_image] at hChild
              rcases hChild with ⟨childEdge, hChildEdge, hEq⟩
              have hIndexedFields := List.mem_zipIdx hIndexedMem
              simp only [Nat.zero_le, zero_add, Nat.sub_zero, true_and]
                at hIndexedFields
              rcases hIndexedFields with ⟨hBound, hValue⟩
              have hIndexedEntry :
                  (branches.map fun branch =>
                    (branch.1, compileTypeFuel signature fuel
                      branch.2))[indexed.2]? = some indexed.1 := by
                rw [List.getElem?_eq_getElem hBound, ← hValue]
              rw [List.getElem?_map] at hIndexedEntry
              rcases Option.map_eq_some_iff.mp hIndexedEntry with
                ⟨entry, hEntry, hEntryEq⟩
              have hEntryMem : entry ∈ branches :=
                List.mem_of_getElem? hEntry
              have hEntryFuel :
                  TypeCompilationFuelSufficient entry.2 fuel :=
                le_trans (typeCompilationFuel_le_typeBranchCompilationFuel
                  branches entry hEntryMem) hBranches
              have hFragmentEq :
                  indexed.1.2 = compileTypeFuel signature fuel entry.2 := by
                rw [← hEntryEq]
              rw [hFragmentEq] at hChildEdge
              have hIH := ih entry.2 tail hEntryFuel
                (tailBranchOccurrences_mem name tail branches entry
                  hTailFields.2 hEntryMem) childEdge hChildEdge
                (by rw [← hEq] at hLabel; exact hLabel)
              rw [← hEq]
              exact ⟨hIH.1, by simp [hIH.2, childPendingEdge, childFutureSpec]⟩
          · exfalso
            rw [mem_foldl_union_iff] at hBranch
            rcases hBranch with hEmpty | ⟨indexed, _, hNewEdge⟩
            · simp at hEmpty
            · simp only [Finset.mem_image, Finset.mem_filter] at hNewEdge
              rcases hNewEdge with ⟨environment, _, hEq⟩
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
          · exfalso
            simp only [Finset.mem_image, Finset.mem_filter] at hWait
            rcases hWait with ⟨environment, _, hEq⟩
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            simp only [Finset.mem_image, Finset.mem_filter] at hResolved
            rcases hResolved with ⟨environment, _, hEq⟩
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
      | offer elseType branches =>
          have hElse : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hConjunction : conjunctiveCompilationFuel branches ≤ fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel
            omega
          have hTailFields : PactType.TailOccurrences name tail elseType ∧
              PactType.TailBranchOccurrences name False branches := by
            simpa only [PactType.TailOccurrences] using hTail
          simp only [compileTypeFuel, buildSelectedConjunctiveOfferAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hEdge
          rcases hEdge with
            ((((hElseEdge | hIndexed) | hEnabled) | hWait) | hResolved)
          · simp only [childPendingEdges, Finset.mem_image] at hElseEdge
            rcases hElseEdge with ⟨childEdge, hChildEdge, hEq⟩
            have hIH := ih elseType tail hElse hTailFields.1 childEdge
              hChildEdge (by rw [← hEq] at hLabel; exact hLabel)
            rw [← hEq]
            exact ⟨hIH.1, by simp [hIH.2, childPendingEdge, childFutureSpec]⟩
          · exfalso
            rw [indexedFragmentEdges, mem_foldl_union_iff] at hIndexed
            rcases hIndexed with hEmpty | ⟨indexed, hIndexedMem, hChild⟩
            · simp at hEmpty
            · simp only [childPendingEdges, Finset.mem_image] at hChild
              rcases hChild with ⟨childEdge, hChildEdge, hEq⟩
              have hIndexedFields := List.mem_zipIdx hIndexedMem
              simp only [Nat.zero_le, zero_add, Nat.sub_zero, true_and]
                at hIndexedFields
              rcases hIndexedFields with ⟨hBound, hValue⟩
              have hIndexedEntry :
                  (branches.map fun selected =>
                    (selected.1, compileTypeFuel signature fuel
                      (parallelTypeBranchesSelecting selected
                        branches)))[indexed.2]? = some indexed.1 := by
                rw [List.getElem?_eq_getElem hBound, ← hValue]
              rw [List.getElem?_map] at hIndexedEntry
              rcases Option.map_eq_some_iff.mp hIndexedEntry with
                ⟨entry, hEntry, hEntryEq⟩
              have hSelectedFuel : TypeCompilationFuelSufficient
                  (parallelTypeBranchesSelecting entry branches) fuel := by
                have := typeCompilationFuel_parallelTypeBranchesSelecting entry
                  branches
                simp only [TypeCompilationFuelSufficient, this]
                exact hConjunction
              have hFragmentEq : indexed.1.2 = compileTypeFuel signature fuel
                  (parallelTypeBranchesSelecting entry branches) := by
                rw [← hEntryEq]
              rw [hFragmentEq] at hChildEdge
              exact (compileTypeFuel_variableEdge_source_var signature name fuel
                (parallelTypeBranchesSelecting entry branches) False
                hSelectedFuel
                (tailOccurrences_parallelTypeBranchesSelecting name entry
                  branches hTailFields.2) childEdge hChildEdge
                (by rw [← hEq] at hLabel; exact hLabel)).1
          · exfalso
            rw [mem_foldl_union_iff] at hEnabled
            rcases hEnabled with hEmpty | ⟨indexed, _, hNewEdge⟩
            · simp at hEmpty
            · simp only [Finset.mem_image, Finset.mem_filter] at hNewEdge
              rcases hNewEdge with ⟨environment, _, hEq⟩
              rw [← hEq] at hLabel
              exact absurd hLabel (by simp)
          · exfalso
            simp only [Finset.mem_image, Finset.mem_filter] at hWait
            rcases hWait with ⟨environment, _, hEq⟩
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)
          · exfalso
            simp only [Finset.mem_image, Finset.mem_filter] at hResolved
            rcases hResolved with ⟨environment, _, hEq⟩
            rw [← hEq] at hLabel
            exact absurd hLabel (by simp)

/-! ### Marker reachability against the syntactic marker analysis

`mem_computeFuture_markerAugmented` and the installed-recursion decompositions
reduce the recursion future leaf to one Boolean side condition: whether the
compiled graph still reaches a `.variable name` marker in the same cycle.
The lemmas below compute that condition constructor by constructor and
identify it with `PactType.markerReachableSubst`. -/

/-- A name that does not occur compiles to a fragment with no marker edges at
all, so no marker is reachable from anywhere in it. -/
private theorem not_markerReachable_of_tailOccurrences_false
    (signature : TypeAlphabet) (name : String) (fuel : Nat)
    (processType : PactType)
    (hFuel : TypeCompilationFuelSufficient processType fuel)
    (hTail : processType.TailOccurrences name False)
    (state : TypeAutomatonState) :
    ¬ MarkerReachable (compileTypeFuel signature fuel processType) name
      state := by
  apply not_markerReachable_of_no_marker_edges
  intro edge hEdge hLabel
  exact (compileTypeFuel_variableEdge_source_var signature name fuel
    processType False hFuel hTail edge hEdge hLabel).1

/-- The immediate references of a choice root are exactly the two tagged child
entries.  Extracted from the corresponding future calculation. -/
private theorem buildChoiceAutomaton_referencedStates_root
    (signature : TypeAlphabet) (left right : AutomatonFragment)
    (selectionLeft selectionRight : TypeLabel)
    (hSelectionLeft : selectionLeft ≠ TypeLabel.tock)
    (hSelectionRight : selectionRight ≠ TypeLabel.tock) :
    let fragment := buildChoiceAutomaton signature left right
      selectionLeft selectionRight
    let pending : PendingAutomaton :=
      { states := fragment.states, edges := fragment.edges }
    pending.referencedStates .root =
      {.child 0 left.initial, .child 1 right.initial} := by
  classical
  let fragment := buildChoiceAutomaton signature left right
    selectionLeft selectionRight
  let pending : PendingAutomaton :=
    { states := fragment.states, edges := fragment.edges }
  show pending.referencedStates .root =
    {.child 0 left.initial, .child 1 right.initial}
  ext state
  constructor
  · intro hState
    simp only [PendingAutomaton.referencedStates, Finset.mem_biUnion,
      Finset.mem_filter] at hState
    rcases hState with ⟨edge, ⟨hEdge, hSource⟩, hReference⟩
    simp only [pending, fragment, buildChoiceAutomaton,
      finishAutomatonFragment, childPendingEdges, Finset.mem_union,
      Finset.mem_image, Finset.mem_biUnion, Finset.mem_insert,
      Finset.mem_singleton] at hEdge
    rcases hEdge with (hLeft | hRight) | hSelection
    · rcases hLeft with ⟨childEdge, _, rfl⟩
      simp [childPendingEdge, childState] at hSource
    · rcases hRight with ⟨childEdge, _, rfl⟩
      simp [childPendingEdge, childState] at hSource
    · rcases hSelection with ⟨environment, _, hEdge | hEdge⟩
      · rw [hEdge] at hReference
        simp [AutomatonConstructionLabel.semantic, hSelectionLeft]
          at hReference
        simp [childState, hReference]
      · rw [hEdge] at hReference
        simp [AutomatonConstructionLabel.semantic, hSelectionRight]
          at hReference
        simp [childState, hReference]
  · intro hState
    simp only [Finset.mem_insert, Finset.mem_singleton] at hState
    rcases hState with rfl | rfl
    · let edge : PendingAutomatonEdge :=
        { source := .root
          environment := TypeEnvironment.tock
          label := .visible selectionLeft
          current := ∅
          future := .at (.child 0 left.initial) ∅
          target := .child 0 left.initial }
      simp only [PendingAutomaton.referencedStates, Finset.mem_biUnion,
        Finset.mem_filter]
      refine ⟨edge, ⟨?_, rfl⟩, ?_⟩
      · simp only [pending, fragment, buildChoiceAutomaton,
          finishAutomatonFragment, childPendingEdges, Finset.mem_union,
          Finset.mem_image, Finset.mem_biUnion, Finset.mem_insert,
          Finset.mem_singleton]
        right
        exact ⟨TypeEnvironment.tock,
          by simp [TypeAlphabet.localEnvironments], Or.inl rfl⟩
      · simp [edge, AutomatonConstructionLabel.semantic, hSelectionLeft]
    · let edge : PendingAutomatonEdge :=
        { source := .root
          environment := TypeEnvironment.tock
          label := .visible selectionRight
          current := ∅
          future := .at (.child 1 right.initial) ∅
          target := .child 1 right.initial }
      simp only [PendingAutomaton.referencedStates, Finset.mem_biUnion,
        Finset.mem_filter]
      refine ⟨edge, ⟨?_, rfl⟩, ?_⟩
      · simp only [pending, fragment, buildChoiceAutomaton,
          finishAutomatonFragment, childPendingEdges, Finset.mem_union,
          Finset.mem_image, Finset.mem_biUnion, Finset.mem_insert,
          Finset.mem_singleton]
        right
        exact ⟨TypeEnvironment.tock,
          by simp [TypeAlphabet.localEnvironments], Or.inr rfl⟩
      · simp [edge, AutomatonConstructionLabel.semantic, hSelectionRight]

/-- A choice root carries no marker of its own; its two selection edges are
visible. -/
private theorem not_buildChoiceAutomaton_markerSource_root
    (signature : TypeAlphabet) (left right : AutomatonFragment)
    (selectionLeft selectionRight : TypeLabel) (name : String) :
    ¬ MarkerSource (buildChoiceAutomaton signature left right
      selectionLeft selectionRight) name .root := by
  classical
  rintro ⟨edge, hEdge, hSource, hLabel⟩
  simp only [buildChoiceAutomaton, finishAutomatonFragment, childPendingEdges,
    Finset.mem_union, Finset.mem_image, Finset.mem_biUnion, Finset.mem_insert,
    Finset.mem_singleton] at hEdge
  rcases hEdge with (hLeft | hRight) | hSelection
  · rcases hLeft with ⟨childEdge, _, rfl⟩
    simp [childPendingEdge, childState] at hSource
  · rcases hRight with ⟨childEdge, _, rfl⟩
    simp [childPendingEdge, childState] at hSource
  · rcases hSelection with ⟨environment, _, hEdge | hEdge⟩ <;>
      (rw [hEdge] at hLabel; exact absurd hLabel (by simp))

/-- Marker reachability from a choice root is the disjunction of the two
tagged child entries. -/
private theorem buildChoiceAutomaton_markerReachable_root
    (signature : TypeAlphabet) (left right : AutomatonFragment)
    (selectionLeft selectionRight : TypeLabel) (name : String)
    (hSelectionLeft : selectionLeft ≠ TypeLabel.tock)
    (hSelectionRight : selectionRight ≠ TypeLabel.tock)
    (hLeftTargets : left.FutureTargetsInStates)
    (hRightTargets : right.FutureTargetsInStates)
    (hLeftInitial : left.initial ∈ left.states)
    (hRightInitial : right.initial ∈ right.states) :
    let fragment := buildChoiceAutomaton signature left right
      selectionLeft selectionRight
    (MarkerReachable fragment name .root ↔
      (MarkerReachable fragment name (.child 0 left.initial) ∨
        MarkerReachable fragment name (.child 1 right.initial))) := by
  classical
  let fragment := buildChoiceAutomaton signature left right
    selectionLeft selectionRight
  show MarkerReachable fragment name .root ↔
    (MarkerReachable fragment name (.child 0 left.initial) ∨
      MarkerReachable fragment name (.child 1 right.initial))
  have hClosed : ({ states := fragment.states, edges := fragment.edges } :
      PendingAutomaton).ReferencesClosed := by
    apply PendingAutomaton.referencesClosed_of_futureTargetsInStates fragment
    exact buildChoiceAutomaton_futureTargetsInStates signature left right
      selectionLeft selectionRight hLeftTargets hRightTargets hLeftInitial
      hRightInitial
  have hRoot : (.root : TypeAutomatonState) ∈ fragment.states := by
    simp [fragment, buildChoiceAutomaton, finishAutomatonFragment]
  have hReferences : ({ states := fragment.states, edges := fragment.edges } :
      PendingAutomaton).referencedStates .root =
      {.child 0 left.initial, .child 1 right.initial} :=
    buildChoiceAutomaton_referencedStates_root signature left right
      selectionLeft selectionRight hSelectionLeft hSelectionRight
  rw [markerReachable_root_of_entries fragment name .root
    {.child 0 left.initial, .child 1 right.initial} hClosed hRoot
      (by rw [hReferences]; exact Finset.subset_insert _ _)
      (by rw [hReferences])]
  constructor
  · rintro (hMarker | ⟨entry, hEntry, hInner⟩)
    · exact absurd hMarker (not_buildChoiceAutomaton_markerSource_root
        signature left right selectionLeft selectionRight name)
    · simp only [Finset.mem_insert, Finset.mem_singleton] at hEntry
      rcases hEntry with rfl | rfl
      · exact Or.inl hInner
      · exact Or.inr hInner
  · rintro (hLeft | hRight)
    · exact Or.inr ⟨_, by simp, hLeft⟩
    · exact Or.inr ⟨_, by simp, hRight⟩

/-- Every state placed in the compiler's literal-termination set represents
`skip`.  This is the target-total half of `compileTypeFuel_skipping_iff`; it
is needed for the administrative bridge of sequence. -/
private theorem compiledFragmentSkipping_represented
    (signature : TypeAlphabet) :
    ∀ (fuel : Nat) (processType : PactType),
      TypeCompilationFuelSufficient processType fuel →
      ∀ state ∈ (compileTypeFuel signature fuel processType).skipping,
        TypeCompilationRelation processType state .skip := by
  intro fuel
  induction fuel with
  | zero =>
      intro processType hFuel
      exact (Nat.not_lt_zero _
        (TypeCompilationFuelSufficient.positive hFuel)).elim
  | succ fuel ih =>
      intro processType hFuel state hSkipping
      cases processType with
      | skip =>
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_singleton] at hSkipping
          subst state
          exact .skip
      | message msg dir =>
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_singleton] at hSkipping
          subst state
          exact .message_final msg dir
      | tock =>
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_singleton] at hSkipping
          subst state
          exact .cycle_final
      | progress pid =>
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_singleton] at hSkipping
          subst state
          exact .progress_final pid
      | var other =>
          simp [compileTypeFuel, finishAutomatonFragment] at hSkipping
      | recur binder body =>
          have hBodyFuel : TypeCompilationFuelSufficient body fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          simp only [compileTypeFuel, buildRecursionAutomaton,
            finishAutomatonFragment, childSkipping, Finset.mem_image]
              at hSkipping
          rcases hSkipping with ⟨child, hChildSkipping, rfl⟩
          have hChild := ih body hBodyFuel child hChildSkipping
          convert TypeCompilationRelation.recur_body binder body .skip
            child hChild using 1 <;>
              simp [PactType.replaceVar, childState]
      | choice left right =>
          have hLeftFuel : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hRightFuel : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          simp only [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment, Finset.mem_union, childSkipping,
            Finset.mem_image] at hSkipping
          rcases hSkipping with ⟨child, hChildSkipping, rfl⟩ |
            ⟨child, hChildSkipping, rfl⟩
          · exact TypeCompilationRelation.choice_left left right .skip child
              (ih left hLeftFuel child hChildSkipping)
          · exact TypeCompilationRelation.choice_right left right .skip child
              (ih right hRightFuel child hChildSkipping)
      | fairChoice bid left right =>
          have hLeftFuel : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          have hRightFuel : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          simp only [compileTypeFuel, buildChoiceAutomaton,
            finishAutomatonFragment, Finset.mem_union, childSkipping,
            Finset.mem_image] at hSkipping
          rcases hSkipping with ⟨child, hChildSkipping, rfl⟩ |
            ⟨child, hChildSkipping, rfl⟩
          · exact TypeCompilationRelation.fair_left bid left right .skip child
              (ih left hLeftFuel child hChildSkipping)
          · exact TypeCompilationRelation.fair_right bid left right .skip child
              (ih right hRightFuel child hChildSkipping)
      | seq left right =>
          have hRightFuel : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          simp only [compileTypeFuel, buildSequenceAutomaton,
            finishAutomatonFragment, childSkipping, Finset.mem_image]
              at hSkipping
          rcases hSkipping with ⟨child, hChildSkipping, rfl⟩
          exact TypeCompilationRelation.sequence_right left right .skip child
            (ih right hRightFuel child hChildSkipping)
      | par left right interface =>
          simp [compileTypeFuel, buildParallelAutomaton,
            finishAutomatonFragment] at hSkipping
      | xoffer elseType branches =>
          let branchAutomata := branches.map fun branch =>
            (branch.1, compileTypeFuel signature fuel branch.2)
          have hElseFuel : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          simp only [compileTypeFuel, buildExclusiveOfferAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hSkipping
          rcases hSkipping with hElse | hBranch
          · simp only [childSkipping, Finset.mem_image] at hElse
            rcases hElse with ⟨child, hChildSkipping, rfl⟩
            exact TypeCompilationRelation.xoffer_else elseType .skip branches
              child (ih elseType hElseFuel child hChildSkipping)
          · rw [indexedFragmentSkipping, mem_foldl_union_iff] at hBranch
            rcases hBranch with hEmpty | ⟨indexed, hIndexed, hChild⟩
            · simp at hEmpty
            · simp only [childSkipping, Finset.mem_image] at hChild
              rcases hChild with ⟨child, hChildSkipping, rfl⟩
              have hFields := List.mem_zipIdx hIndexed
              simp only [Nat.zero_le, zero_add, Nat.sub_zero, true_and]
                at hFields
              rcases hFields with ⟨hBound, hValue⟩
              have hAt : branchAutomata[indexed.2]? = some indexed.1 := by
                rw [List.getElem?_eq_getElem hBound, ← hValue]
              simp only [branchAutomata, List.getElem?_map] at hAt
              cases hOriginal : branches[indexed.2]? with
              | none => simp [hOriginal] at hAt
              | some branch =>
                rcases branch with ⟨action, branchType⟩
                simp only [hOriginal, Option.map_some, Option.some.injEq]
                  at hAt
                have hBranchMem : (action, branchType) ∈ branches :=
                  List.mem_of_getElem? hOriginal
                have hBranchesFuel :
                    typeBranchCompilationFuel branches ≤ fuel := by
                  simp [TypeCompilationFuelSufficient, typeCompilationFuel]
                    at hFuel
                  omega
                have hBranchFuel :
                    TypeCompilationFuelSufficient branchType fuel :=
                  le_trans
                    (typeCompilationFuel_le_typeBranchCompilationFuel branches
                      (action, branchType) hBranchMem) hBranchesFuel
                have hFragment : indexed.1.2 =
                    compileTypeFuel signature fuel branchType := by
                  simpa using (congrArg Prod.snd hAt).symm
                rw [hFragment] at hChildSkipping
                have hChildRelated := ih branchType hBranchFuel child
                  hChildSkipping
                exact TypeCompilationRelation.xoffer_branch elseType
                  branchType .skip branches action indexed.2 child hOriginal
                    hChildRelated
      | offer elseType branches =>
          let selectedConjunctions := branches.map fun selected =>
            (selected.1, compileTypeFuel signature fuel
              (parallelTypeBranchesSelecting selected branches))
          have hElseFuel : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel]
              at hFuel ⊢
            omega
          simp only [compileTypeFuel, buildSelectedConjunctiveOfferAutomaton,
            finishAutomatonFragment, Finset.mem_union] at hSkipping
          rcases hSkipping with hElse | hSelected
          · simp only [childSkipping, Finset.mem_image] at hElse
            rcases hElse with ⟨child, hChildSkipping, rfl⟩
            exact TypeCompilationRelation.offer_else elseType .skip branches
              child (ih elseType hElseFuel child hChildSkipping)
          · rw [indexedFragmentSkipping, mem_foldl_union_iff] at hSelected
            rcases hSelected with hEmpty | ⟨indexed, hIndexed, hChild⟩
            · simp at hEmpty
            · simp only [childSkipping, Finset.mem_image] at hChild
              rcases hChild with ⟨child, hChildSkipping, rfl⟩
              have hFields := List.mem_zipIdx hIndexed
              simp only [Nat.zero_le, zero_add, Nat.sub_zero, true_and]
                at hFields
              rcases hFields with ⟨hBound, hValue⟩
              have hAt : selectedConjunctions[indexed.2]? =
                  some indexed.1 := by
                rw [List.getElem?_eq_getElem hBound, ← hValue]
              simp only [selectedConjunctions, List.getElem?_map] at hAt
              cases hOriginal : branches[indexed.2]? with
              | none => simp [hOriginal] at hAt
              | some selected =>
                simp only [hOriginal, Option.map_some, Option.some.injEq]
                  at hAt
                have hChildFuel : TypeCompilationFuelSufficient
                    (parallelTypeBranchesSelecting selected branches) fuel := by
                  rw [TypeCompilationFuelSufficient,
                    typeCompilationFuel_parallelTypeBranchesSelecting]
                  simp [TypeCompilationFuelSufficient, typeCompilationFuel]
                    at hFuel
                  omega
                have hFragment : indexed.1.2 = compileTypeFuel signature fuel
                    (parallelTypeBranchesSelecting selected branches) := by
                  simpa using (congrArg Prod.snd hAt).symm
                rw [hFragment] at hChildSkipping
                have hChildRelated := ih
                  (parallelTypeBranchesSelecting selected branches) hChildFuel
                    child hChildSkipping
                exact TypeCompilationRelation.offer_branches elseType .skip
                  branches selected indexed.2 child hOriginal hChildRelated

private theorem branchCanCompleteBeforeTockSubst_of_getElem
    (name : String) (value : Bool) :
    ∀ (branches : List (BareMessage × PactType)) (index : Nat)
      (action : BareMessage) (branchType : PactType),
      branches[index]? = some (action, branchType) →
      PactType.canCompleteBeforeTockSubst name value branchType = true →
      PactType.branchCanCompleteBeforeTockSubst name value branches = true := by
  intro branches
  induction branches with
  | nil => intro index action branchType hEntry; simp at hEntry
  | cons head rest ih =>
      intro index action branchType hEntry hComplete
      rcases head with ⟨headAction, headType⟩
      cases index with
      | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq,
            Prod.mk.injEq] at hEntry
          rcases hEntry with ⟨rfl, rfl⟩
          simp [PactType.branchCanCompleteBeforeTockSubst, hComplete]
      | succ index =>
          simp only [List.getElem?_cons_succ] at hEntry
          simp [PactType.branchCanCompleteBeforeTockSubst,
            ih index action branchType hEntry hComplete]

private theorem canCompleteBeforeTockSubst_parallelTypeBranches
    (name : String) (value : Bool)
    (branches : List (BareMessage × PactType)) :
    PactType.canCompleteBeforeTockSubst name value
      (parallelTypeBranches branches) = true := by
  induction branches with
  | nil =>
      simp [parallelTypeBranches, PactType.canCompleteBeforeTockSubst]
  | cons branch rest ih =>
      cases rest with
      | nil =>
          simp [parallelTypeBranches, singletonTypeXOffer,
            PactType.canCompleteBeforeTockSubst,
            PactType.branchCanCompleteBeforeTockSubst]
      | cons next tail =>
          simp [parallelTypeBranches, singletonTypeXOffer,
            PactType.canCompleteBeforeTockSubst,
            PactType.branchCanCompleteBeforeTockSubst] at ih ⊢
          exact ih

private theorem canCompleteBeforeTockSubst_parallelTypeBranchesSelecting_of_mem
    (name : String) (value : Bool) (selected : BareMessage × PactType) :
    ∀ branches : List (BareMessage × PactType), selected ∈ branches →
      PactType.canCompleteBeforeTockSubst name value
          (parallelTypeBranchesSelecting selected branches) =
        PactType.canCompleteBeforeTockSubst name value selected.2 := by
  intro branches
  induction branches with
  | nil => intro hMem; simp at hMem
  | cons branch rest ih =>
      intro hMem
      cases rest with
      | nil =>
          have hEqual : branch = selected := by
            simpa [eq_comm] using hMem
          subst branch
          simp [parallelTypeBranchesSelecting, selectedTypeBranch,
            PactType.canCompleteBeforeTockSubst]
      | cons next tail =>
          by_cases hSelected : branch = selected
          · subst branch
            simp [parallelTypeBranchesSelecting, selectedTypeBranch,
              PactType.canCompleteBeforeTockSubst,
              canCompleteBeforeTockSubst_parallelTypeBranches]
          · have hRest : selected ∈ next :: tail := by
              rcases List.mem_cons.mp hMem with hHead | hTail
              · exact absurd hHead.symm hSelected
              · exact hTail
            simp only [parallelTypeBranchesSelecting, if_neg hSelected]
            simp [PactType.canCompleteBeforeTockSubst, singletonTypeXOffer,
              PactType.branchCanCompleteBeforeTockSubst, ih hRest]

/- Valuation forms of the three branch-completion facts above.  These are the
exact list equations needed by the binder-context predecessor induction; the
old scalar facts remain useful at its singleton wrapper. -/
private theorem branchCompletionEval_of_getElem
    (valuation : String → Bool) :
    ∀ (branches : List (BareMessage × PactType)) (index : Nat)
      (action : BareMessage) (branchType : PactType),
      branches[index]? = some (action, branchType) →
      PactType.completionEval valuation branchType = true →
      PactType.branchCompletionEval valuation branches = true := by
  intro branches
  induction branches with
  | nil => intro index action branchType hEntry; simp at hEntry
  | cons head rest ih =>
      intro index action branchType hEntry hComplete
      rcases head with ⟨headAction, headType⟩
      cases index with
      | zero =>
          simp only [List.getElem?_cons_zero, Option.some.injEq,
            Prod.mk.injEq] at hEntry
          rcases hEntry with ⟨rfl, rfl⟩
          simp [PactType.branchCompletionEval, hComplete]
      | succ index =>
          simp only [List.getElem?_cons_succ] at hEntry
          simp [PactType.branchCompletionEval,
            ih index action branchType hEntry hComplete]

private theorem completionEval_parallelTypeBranches
    (valuation : String → Bool)
    (branches : List (BareMessage × PactType)) :
    PactType.completionEval valuation (parallelTypeBranches branches) = true := by
  induction branches with
  | nil =>
      simp [parallelTypeBranches, PactType.completionEval]
  | cons branch rest ih =>
      cases rest with
      | nil =>
          simp [parallelTypeBranches, singletonTypeXOffer,
            PactType.completionEval, PactType.branchCompletionEval]
      | cons next tail =>
          simp [parallelTypeBranches, singletonTypeXOffer,
            PactType.completionEval, PactType.branchCompletionEval] at ih ⊢
          exact ih

private theorem completionEval_parallelTypeBranchesSelecting_of_mem
    (valuation : String → Bool) (selected : BareMessage × PactType) :
    ∀ branches : List (BareMessage × PactType), selected ∈ branches →
      PactType.completionEval valuation
          (parallelTypeBranchesSelecting selected branches) =
        PactType.completionEval valuation selected.2 := by
  intro branches
  induction branches with
  | nil => intro hMem; simp at hMem
  | cons branch rest ih =>
      intro hMem
      cases rest with
      | nil =>
          have hEqual : branch = selected := by
            simpa [eq_comm] using hMem
          subst branch
          simp [parallelTypeBranchesSelecting, selectedTypeBranch,
            PactType.completionEval]
      | cons next tail =>
          by_cases hSelected : branch = selected
          · subst branch
            simp [parallelTypeBranchesSelecting, selectedTypeBranch,
              PactType.completionEval,
              completionEval_parallelTypeBranches]
          · have hRest : selected ∈ next :: tail := by
              rcases List.mem_cons.mp hMem with hHead | hTail
              · exact absurd hHead.symm hSelected
              · exact hTail
            simp only [parallelTypeBranchesSelecting, if_neg hSelected]
            simp [PactType.completionEval, singletonTypeXOffer,
              PactType.branchCompletionEval, ih hRest]

/- The syntax equation represented by a recursion header/backedge in an
ambient binder valuation.  Hygiene prevents the inserted binder from being
captured, and `completionEval_update_self` supplies the Boolean fixed point. -/
private theorem completionEval_unfold_recur_of_hygienic
    (active : List String) (valuation : String → Bool)
    (binder : String) (body : PactType)
    (hSupported : ∀ name, name ∉ active → valuation name = false)
    (hFresh : body.BinderFreshFor (binder :: active)) :
    PactType.completionEval valuation
        (body.replaceVar binder (.recur binder body)) =
      PactType.completionEval valuation (.recur binder body) := by
  rw [PactType.completionEval_replaceVar_of_hygienic active valuation binder
    (.recur binder body) hSupported body hFresh]
  simpa only [PactType.completionEval] using
    PactType.completionEval_update_self valuation binder body

/- **Non-clock predecessor step for substituted completion.**

If the target of a non-clock edge of a compiled fragment represents a residual
that completes before the next tock — scoring a bare `.var name` as `value`
rather than `false` — then the edge's source also represents such a residual.
This is the graph obligation of the forward (`⊆`) half of
`recursionBodyCompletingClosure_iff`.

Two features of this statement were forced by counterexamples found while
assembling the forward half, and must not be weakened back:

* The conclusion is **existential** (`∃ sourceResidual, related ∧ complete`),
  not the seemingly more convenient universal form `∀ r, related → complete`.
  The universal form cannot be discharged, and a parallel product refutes it
  up to the existence of one synchronised edge.  Take
  `body = .par (.var "y") .skip ∅` inside a binder for `"x"`.  The product
  edge synchronising the left fragment's `.variable "y"` marker
  (`.root → .final`, silent) with the right fragment's silent self-loop is
  itself silent; its source `.pair .root .root` represents
  `.par (.var "y") .skip ∅`, whose substituted completion for `"x"` is
  `false`; and its target `.pair .final .root` represents *nothing at all*,
  since the `.var` fragment's `.final` is unrelated.  So the universal
  premise holds vacuously while the universal conclusion fails.  (This was
  not turned into a kernel-checked regression lemma: whether that product
  edge is actually emitted depends on `syncAutomatonEdges` at a concrete
  signature, and the point stands regardless — the universal form is not
  provable by this induction.)  Crucially, filtering the ambient set by the
  universal predicate does *not* rescue it either: `buildParallelAutomaton`
  emits a `.future` self-loop at *every* product state, so the unrepresented
  target is an edge source and therefore does lie in the ambient set.  The
  existential form is immune, because the vacuous premise becomes an
  unsatisfiable one.
* The hypothesis is `≠ TypeLabel.tock`, not `= TypeLabel.silent`.  Silent
  implies non-clock, so this is only a strengthening at the use site, but the
  induction *requires* it: `buildParallelAutomaton` can hide two visible
  message edges inside one silent product edge, and the induction hypothesis
  has to be applied to those non-silent components.  `≠ tock` survives that
  decomposition by `AutomatonConstructionLabel.component_nonclock_of_sync`,
  whereas `= silent` does not.  It is also exactly the right condition
  semantically: the only compiled edge that legitimately destroys completion
  is the clock edge of `.tock`.

Intended proof: induction on the compilation fuel, one case per constructor.
Atomic constructors are direct (the clock edge of `.tock` is excluded by the
hypothesis, every other atomic edge is a silent self-loop or lands in
`.skip`); the `.var` case is vacuous because its `.final` target represents
nothing.  Child edges of `.choice`/`.fairChoice`/`.seq`/`.xoffer`/`.offer`
transport through the matching relation constructor and the corresponding
`canCompleteBeforeTockSubst` clause.  Fresh administrative edges are handled
by `compileTypeFuel_initial_relation` (their targets are child entries).  The
`.seq` bridge edges additionally need that a `skipping` state represents
`.skip` — a further mechanical induction that does not exist yet.  The `.par`
case decomposes through `resolvedAutomatonEdges` and
`component_nonclock_of_sync`.  The `.recur` case relates the header edge and
the installed backedges to `PactType.replaceVar_canCompleteBeforeTock`. -/
mutual

private theorem compiledFragmentNonClockPredecessor_eval
    (signature : TypeAlphabet) (active : List String)
    (valuation : String → Bool) (fuel : Nat) :
    ∀ (processType : PactType),
      (∀ name, name ∉ active → valuation name = false) →
      TypeCompilationFuelSufficient processType fuel →
      PactType.TailRecursive processType →
      PactType.BinderHygienic active processType →
      ∀ edge ∈ (compileTypeFuel signature fuel processType).edges,
        edge.label.semantic ≠ TypeLabel.tock →
        ∀ targetResidual,
          TypeCompilationRelation processType edge.target targetResidual →
          PactType.completionEval valuation targetResidual = true →
            ∃ sourceResidual,
              TypeCompilationRelation processType edge.source sourceResidual ∧
              PactType.completionEval valuation sourceResidual = true := by
  classical
  cases fuel with
  | zero =>
      intro processType _ hFuel
      exact (Nat.not_lt_zero _
        (TypeCompilationFuelSufficient.positive hFuel)).elim
  | succ fuel =>
      have ih := fun (active : List String) (valuation : String → Bool) =>
        compiledFragmentNonClockPredecessor_eval signature active valuation fuel
      intro processType hSupported hFuel hTail hHygienic edge hEdge
        hNonClock targetResidual hTargetRelated hTargetComplete
      generalize hTargetState : edge.target = targetState at hTargetRelated
      cases processType with
      | skip =>
          cases hTargetRelated
          refine ⟨.skip, ?_, by simp [PactType.completionEval]⟩
          simp only [compileTypeFuel, finishAutomatonFragment,
            Finset.mem_image, Finset.mem_filter] at hEdge
          rcases hEdge with ⟨environment, _, hEq⟩
          simpa [← hEq] using TypeCompilationRelation.skip
      | message msg dir =>
          cases hTargetRelated with
          | message_source =>
              simp only [compileTypeFuel, finishAutomatonFragment,
                Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
              rcases hEdge with ((⟨environment, _, hEq⟩ |
                  ⟨environment, _, hEq⟩) | ⟨environment, _, hEq⟩)
              · rw [← hEq] at hTargetState
                simp at hTargetState
              · refine ⟨.message msg dir, ?_, by simp
                    [PactType.completionEval]⟩
                simpa [← hEq] using
                  TypeCompilationRelation.message_source msg dir
              · rw [← hEq] at hTargetState
                simp at hTargetState
          | message_final =>
              simp only [compileTypeFuel, finishAutomatonFragment,
                Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
              rcases hEdge with ((⟨environment, _, hEq⟩ |
                  ⟨environment, _, hEq⟩) | ⟨environment, _, hEq⟩)
              · refine ⟨.message msg dir, ?_, by simp
                    [PactType.completionEval]⟩
                simpa [← hEq] using
                  TypeCompilationRelation.message_source msg dir
              · rw [← hEq] at hTargetState
                simp at hTargetState
              · refine ⟨.skip, ?_, by simp
                    [PactType.completionEval]⟩
                simpa [← hEq] using
                  TypeCompilationRelation.message_final msg dir
      | tock =>
          cases hTargetRelated with
          | cycle_source =>
              simp [PactType.completionEval] at hTargetComplete
          | cycle_final =>
              simp only [compileTypeFuel, finishAutomatonFragment,
                Finset.mem_union, Finset.mem_image] at hEdge
              rcases hEdge with ⟨environment, _, hEq⟩ | ⟨environment, _, hEq⟩
              · rw [← hEq] at hTargetState hNonClock
                by_cases hClock : environment.clock = true
                · apply (hNonClock (by simp [hClock,
                    AutomatonConstructionLabel.semantic])).elim
                · simp [hClock] at hTargetState
              · refine ⟨.skip, ?_, by simp
                    [PactType.completionEval]⟩
                simpa [← hEq] using TypeCompilationRelation.cycle_final
      | progress pid =>
          cases hTargetRelated with
          | progress_source =>
              simp only [compileTypeFuel, finishAutomatonFragment,
                Finset.mem_union, Finset.mem_image, Finset.mem_filter] at hEdge
