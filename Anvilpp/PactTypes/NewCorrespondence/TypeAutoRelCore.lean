import Anvilpp.PactTypes.Automata.CompileType

namespace Pact

open Classical

noncomputable section

/-- Defines the one-step relation successors generated by matching semantic steps with automaton edges. -/
def relationSuccessors
    (auto : TypeAutomaton)
    (entry : PactType × TypeAutomatonState) :
    Finset (PactType × TypeAutomatonState) :=
  auto.edges.biUnion fun edge =>
    if edge.source = entry.2 then
      if hStep : ∃ residual',
          DecoratedTypeTransition
            edge.symbol.environment entry.1 edge.symbol.label edge.symbol.offers
            residual' then
        {(Classical.choose hStep, edge.target)}
      else
        ∅
    else
      ∅

/-- Defines the fuel-bounded worklist saturation procedure for type/automaton relation sets. -/
def auxRelBuilderFuel (auto : TypeAutomaton) :
    Nat → Finset (PactType × TypeAutomatonState) →
      Finset (PactType × TypeAutomatonState) →
      Finset (PactType × TypeAutomatonState)
  | 0, rel_set, _ => rel_set
  | fuel + 1, rel_set, worklist =>
      match worklist.toList with
      | [] => rel_set
      | entry :: _ =>
          let worklist' := worklist.erase entry
          let newEntries := relationSuccessors auto entry \ rel_set
          auxRelBuilderFuel auto fuel
            (rel_set ∪ newEntries)
            (worklist' ∪ newEntries)


/-- Defines the finite fuel budget used by the executable relation builder. -/
def relationBuilderFuelBound (auto : TypeAutomaton)
    (rel_set worklist : Finset (PactType × TypeAutomatonState)) : Nat :=
  auto.states.card + auto.edges.card + rel_set.card + worklist.card + 1


/-- Defines the public worklist builder by running `auxRelBuilderFuel` with its chosen fuel. -/
def auxRelBuilder (_residual_ty : PactType) (auto : TypeAutomaton)
    (rel_set : Finset (PactType × TypeAutomatonState))
    (worklist : Finset (PactType × TypeAutomatonState)) :
    Finset (PactType × TypeAutomatonState) :=
  let fuel := relationBuilderFuelBound auto rel_set worklist
  auxRelBuilderFuel auto fuel rel_set worklist

/-- Defines the generated correspondence relation seeded by the initial type/automaton pair. -/
def buildRelationSet (ty : PactType) (auto : TypeAutomaton) :
    Finset (PactType × TypeAutomatonState) :=
  let relation_set : Finset (PactType × TypeAutomatonState) := {(ty, auto.initial)}
  auxRelBuilder ty auto relation_set relation_set

/-- Defines relation membership as occurrence of the residual/state pair in the relation set. -/
def relationMembership
    (relation_set : Finset (PactType × TypeAutomatonState))
    (processType : PactType) (state : TypeAutomatonState) : Prop :=
  (processType, state) ∈ relation_set






-- Some Trivial Theorems for construction of relation

/-- Defines saturation as closure under all generated one-step relation successors. -/
def RelationBuilderSaturated (auto : TypeAutomaton)
    (rel_set : Finset (PactType × TypeAutomatonState)) : Prop :=
  ∀ entry ∈ rel_set, relationSuccessors auto entry ⊆ rel_set

/-- Proves every generated successor comes from a matching automaton edge and semantic step. -/
theorem relationSuccessors_mem_cases
    (auto : TypeAutomaton)
    (entry successor : PactType × TypeAutomatonState)
    (hSuccessor : successor ∈ relationSuccessors auto entry) :
    ∃ edge ∈ auto.edges,
      edge.source = entry.2 ∧ successor.2 = edge.target ∧
        DecoratedTypeTransition edge.symbol.environment entry.1
          edge.symbol.label edge.symbol.offers successor.1 := by
  classical
  unfold relationSuccessors at hSuccessor
  rw [Finset.mem_biUnion] at hSuccessor
  rcases hSuccessor with ⟨edge, hEdge, hMem⟩
  by_cases hSource : edge.source = entry.2
  · simp [hSource] at hMem
    by_cases hStepExists :
        ∃ residual,
          DecoratedTypeTransition edge.symbol.environment entry.1
            edge.symbol.label edge.symbol.offers residual
    · simp [hStepExists] at hMem
      subst successor
      exact ⟨edge, hEdge, hSource, rfl, Classical.choose_spec hStepExists⟩
    · simp [hStepExists] at hMem
  · simp [hSource] at hMem

/-- Proves a matched edge and target-unique semantic step generate the corresponding target pair. -/
theorem relationSuccessors_mem_of_edge_step_unique
    (auto : TypeAutomaton)
    (entry : PactType × TypeAutomatonState)
    {stateTarget : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel} {offers : TypeOfferSummary}
    {residualTarget : PactType}
    (hEdge : auto.HasEdge entry.2 env label offers stateTarget)
    (hStep : DecoratedTypeTransition env entry.1 label offers residualTarget)
    (hUnique :
      ∀ target,
        DecoratedTypeTransition env entry.1 label offers target →
          target = residualTarget) :
    (residualTarget, stateTarget) ∈ relationSuccessors auto entry := by
  classical
  unfold relationSuccessors
  apply Finset.mem_biUnion.mpr
  refine ⟨
    { source := entry.2
      symbol := { environment := env, label := label, offers := offers }
      target := stateTarget }, hEdge, ?_⟩
  simp only [if_true]
  by_cases hExists :
      ∃ target, DecoratedTypeTransition env entry.1 label offers target
  · have hChoose : Classical.choose hExists = residualTarget := by
      exact hUnique _ (Classical.choose_spec hExists)
    simp [hExists, hChoose]
  · exact (hExists ⟨residualTarget, hStep⟩).elim

/-- Proves the fuel-bounded builder preserves predicates closed under generated successors. -/
theorem auxRelBuilderFuel_preserves
    (auto : TypeAutomaton)
    (property : PactType × TypeAutomatonState → Prop)
    (hSuccessor :
      ∀ entry,
        property entry →
          ∀ successor ∈ relationSuccessors auto entry, property successor) :
    ∀ fuel rel_set worklist,
      (∀ entry ∈ rel_set, property entry) →
      (∀ entry ∈ worklist, property entry) →
      ∀ entry ∈ auxRelBuilderFuel auto fuel rel_set worklist,
        property entry := by
  intro fuel
  induction fuel with
  | zero =>
      intro rel_set worklist hRel _ entry hEntry
      simpa [auxRelBuilderFuel] using hRel entry hEntry
  | succ fuel ih =>
      intro rel_set worklist hRel hWork entry hEntry
      simp only [auxRelBuilderFuel] at hEntry
      cases hWorklist : worklist.toList with
      | nil =>
          exact hRel entry (by simpa [hWorklist] using hEntry)
      | cons selected _ =>
          have hSelected : selected ∈ worklist := by
            rw [← Finset.mem_toList]
            rw [hWorklist]
            simp
          apply ih
            (rel_set ∪ (relationSuccessors auto selected \ rel_set))
            (worklist.erase selected ∪
              (relationSuccessors auto selected \ rel_set))
          · intro candidate hCandidate
            rcases Finset.mem_union.mp hCandidate with hOld | hNew
            · exact hRel candidate hOld
            · exact hSuccessor selected (hWork selected hSelected)
                candidate (Finset.mem_sdiff.mp hNew).1
          · intro candidate hCandidate
            rcases Finset.mem_union.mp hCandidate with hOld | hNew
            · exact hWork candidate (Finset.mem_of_mem_erase hOld)
            · exact hSuccessor selected (hWork selected hSelected)
                candidate (Finset.mem_sdiff.mp hNew).1
          · simpa [hWorklist] using hEntry

/-- Proves the generated relation preserves any successor-closed predicate true at the seed. -/
theorem buildRelationSet_preserves
    (ty : PactType) (auto : TypeAutomaton)
    (property : PactType × TypeAutomatonState → Prop)
    (hInitial : property (ty, auto.initial))
    (hSuccessor :
      ∀ entry,
        property entry →
          ∀ successor ∈ relationSuccessors auto entry, property successor) :
    ∀ entry ∈ buildRelationSet ty auto, property entry := by
  intro entry hEntry
  simp [buildRelationSet, auxRelBuilder] at hEntry
  exact auxRelBuilderFuel_preserves auto property hSuccessor
    (relationBuilderFuelBound auto {(ty, auto.initial)} {(ty, auto.initial)})
    {(ty, auto.initial)} {(ty, auto.initial)}
    (by
      intro candidate hCandidate
      have hEq : candidate = (ty, auto.initial) := by
        simpa using hCandidate
      subst candidate
      exact hInitial)
    (by
      intro candidate hCandidate
      have hEq : candidate = (ty, auto.initial) := by
        simpa using hCandidate
      subst candidate
      exact hInitial)
    entry hEntry

/-- Proves the fuel-bounded builder keeps every entry already in the accumulated relation. -/
theorem rel_set_subset_auxRelBuilderFuel (auto : TypeAutomaton) :
    ∀ fuel (rel_set worklist : Finset (PactType × TypeAutomatonState)),
      rel_set ⊆ auxRelBuilderFuel auto fuel rel_set worklist := by
  intro fuel
  induction fuel with
  | zero =>
      intro rel_set worklist
      simp [auxRelBuilderFuel]
  | succ fuel ih =>
      intro rel_set worklist
      simp only [auxRelBuilderFuel]
      cases hWorklist : worklist.toList with
      | nil =>
          simp
      | cons entry rest =>
          intro pair hPair
          apply ih
          exact Finset.mem_union_left _ hPair

/-- Proves the generated relation contains its initial residual/state seed pair. -/
theorem buildRelationSet_initial (ty : PactType) (auto : TypeAutomaton)  :
    relationMembership (buildRelationSet ty auto) ty auto.initial := by
  simp [relationMembership, buildRelationSet, auxRelBuilder]
  apply rel_set_subset_auxRelBuilderFuel
  simp
end

/-- States the intended fuel-bound theorem: the chosen fuel yields a saturated relation. -/
theorem auxRelBuilderFuel_bound_saturated
    (auto : TypeAutomaton)
    (rel_set worklist : Finset (PactType × TypeAutomatonState)) :
    RelationBuilderSaturated auto
      (auxRelBuilderFuel auto
        (relationBuilderFuelBound auto rel_set worklist) rel_set worklist) := by
  sorry

/-- States that the public generated relation is saturated under relation successors. -/
theorem buildRelationSet_saturated (ty : PactType) (auto : TypeAutomaton) :
    RelationBuilderSaturated auto (buildRelationSet ty auto) := by
  sorry

/-- Proves saturation adds the target of any matched target-unique semantic step and edge. -/
theorem relationMembership_of_step_edge_unique
    (ty : PactType) (auto : TypeAutomaton)
    {residual residual' : PactType} {state state' : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel} {offers : TypeOfferSummary}
    (hRelated : relationMembership (buildRelationSet ty auto) residual state)
    (hEdge : auto.HasEdge state env label offers state')
    (hStep : DecoratedTypeTransition env residual label offers residual')
    (hUnique :
      ∀ target,
        DecoratedTypeTransition env residual label offers target →
          target = residual') :
    relationMembership (buildRelationSet ty auto) residual' state' := by
  exact buildRelationSet_saturated ty auto
    (residual, state) hRelated
    (relationSuccessors_mem_of_edge_step_unique auto (residual, state)
      hEdge hStep hUnique)
end Pact
