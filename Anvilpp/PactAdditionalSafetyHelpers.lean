namespace Pact

noncomputable section

open Classical
open Pact.NewCorrespondence

/-- Proves every local environment generated by a type alphabet is well-formed. -/
theorem localEnvironment_wellFormed
    (signature : TypeAlphabet) {environment : TypeEnvironment}
    (hEnvironment : environment ∈ signature.localEnvironments) :
    environment.WellFormed := by
  simp only [TypeAlphabet.localEnvironments, Finset.mem_union,
    Finset.mem_singleton, Finset.mem_biUnion, Finset.mem_powerset,
    Finset.mem_image] at hEnvironment
  rcases hEnvironment with rfl | ⟨immediate, _hImmediate, future, hFuture, rfl⟩
  · simp [TypeEnvironment.WellFormed, TypeEnvironment.tock]
  · constructor
    · simp
    · intro _hClock
      change immediate ∩ future = ∅
      rw [← Finset.disjoint_iff_inter_eq_empty]
      apply Finset.disjoint_left.mpr
      intro action hImmediate hFutureMember
      have hAvailable := hFuture hFutureMember
      simp only [Finset.mem_sdiff] at hAvailable
      exact hAvailable.2 hImmediate

/-- States that a decorated type step's target residual is uniquely determined by its environment, source, label, and offers. -/
theorem decoratedTypeTransition_target_unique
    {env : TypeEnvironment} {source : PactType} {label : TypeLabel}
    {offers : TypeOfferSummary} {target target' : PactType}
    (hStep : DecoratedTypeTransition env source label offers target)
    (hStep' : DecoratedTypeTransition env source label offers target') :
    target = target' := by
  sorry

/-- Proves a built relation set relates each automaton state to at most one residual. -/
lemma relationMembership_functional
    (ty : PactType) (auto : TypeAutomaton)
    {residual residual' : PactType} {state : TypeAutomatonState}
    (hRelated : relationMembership (buildRelationSet ty auto) residual state)
    (hRelated' : relationMembership (buildRelationSet ty auto) residual' state) :
    residual = residual' := by
  sorry


/-- Proves a step's future offer is contained in the target menu together with its current offer. -/
theorem typeOffers_future_subset_target_union_current
    {env : TypeEnvironment} {source target : PactType} {label : TypeLabel}
    {current future : Finset BareMessage}
    (hOffers : TypeOffers env source label target current future) :
    future ⊆ typeFutureOffers target ∪ current := by
  induction hOffers using TypeOffers.rec
    (motive_2 := fun _ _ _ _ _ _ _ => True) with
  | action =>
      simp
  | action_wait =>
      intro action hAction
      simp at hAction ⊢
      exact Or.inr hAction.1
  | choice_left =>
      simp
  | choice_right =>
      simp
  | fair_left =>
      simp
  | fair_right =>
      simp
  | cycle =>
      simp
  | cycle_wait =>
      simp
  | skip =>
      simp
  | progress =>
      simp
  | recur =>
      simp
  | seq =>
      intro action hAction
      simp at hAction ⊢
      exact Or.inl hAction.1
  | seq_fuse =>
      intro action hAction
      simp at hAction ⊢
      exact Or.inl hAction.1
  | xoffer_branch =>
      simp
  | xoffer_else =>
      simp
  | xoffer_wait =>
      intro action hAction
      simp at hAction ⊢
      exact Or.inl hAction.1
  | offer_some =>
      simp
  | offer_else =>
      simp
  | offer_wait =>
      intro action hAction
      simp at hAction ⊢
      exact Or.inl hAction.1
  | par =>
      intro action hAction
      rw [typeFutureOffers_parallel]
      simp only [Finset.mem_union]
      simp only [hideTypeOffers, Finset.mem_filter] at hAction ⊢
      obtain ⟨hAction, hInterface⟩ := hAction
      simp only [Finset.mem_union] at hAction
      rcases hAction with hLeft | hRight
      · rename_i hLeftOffers hRightOffers _ _ _ _ hLeftIH _ _ _
        have hLeft' := hLeftIH hLeft
        simp only [Finset.mem_union] at hLeft'
        rcases hLeft' with hFuture | hCurrent
        · exact Or.inl ⟨Finset.mem_union.mpr (Or.inl hFuture), hInterface⟩
        · exact Or.inr ⟨Finset.mem_union.mpr (Or.inl hCurrent), hInterface⟩
      · rename_i hLeftOffers hRightOffers _ _ _ _ _ hRightIH _ _
        have hRight' := hRightIH hRight
        simp only [Finset.mem_union] at hRight'
        rcases hRight' with hFuture | hCurrent
        · exact Or.inl ⟨Finset.mem_union.mpr (Or.inr hFuture), hInterface⟩
        · exact Or.inr ⟨Finset.mem_union.mpr (Or.inr hCurrent), hInterface⟩
  | par_fuse =>
      intro action hAction
      simp only [typeFutureOffers, typeFutureOffersFuel, Finset.empty_union]
      simp only [hideTypeOffers, Finset.mem_filter] at hAction ⊢
      obtain ⟨hAction, hInterface⟩ := hAction
      simp only [Finset.mem_union] at hAction
      rcases hAction with hLeft | hRight
      · rename_i hLeftOffers hRightOffers _ _ _ hLeftIH _ _ _
        have hLeft' := hLeftIH hLeft
        simp only [typeFutureOffers, typeFutureOffersFuel, Finset.empty_union]
          at hLeft'
        exact ⟨Finset.mem_union.mpr (Or.inl hLeft'), hInterface⟩
      · rename_i hLeftOffers hRightOffers _ _ _ _ hRightIH _ _
        have hRight' := hRightIH hRight
        simp only [typeFutureOffers, typeFutureOffersFuel, Finset.empty_union]
          at hRight'
        exact ⟨Finset.mem_union.mpr (Or.inr hRight'), hInterface⟩
  | clock =>
      trivial
  | ordinary =>
      trivial

/-- Proves that a transition-alphabet symbol carries an offer summary from the signature. -/
theorem transitionAlphabet_offerSummary_mem
    (signature : TypeAlphabet) {env : TypeEnvironment} {label : TypeLabel}
    {offers : TypeOfferSummary}
    (hSymbol : TypeAutomatonSymbol.mk env label offers ∈
      signature.transitionAlphabet) :
    offers ∈ signature.offerSummaries := by
  classical
  unfold TypeAlphabet.transitionAlphabet at hSymbol
  rw [Finset.mem_biUnion] at hSymbol
  obtain ⟨environment, _hEnvironment, hSymbol⟩ := hSymbol
  rw [Finset.mem_biUnion] at hSymbol
  obtain ⟨label', _hLabel, hOffers⟩ := hSymbol
  rw [Finset.mem_image] at hOffers
  obtain ⟨offers', hOffers', hEq⟩ := hOffers
  cases hEq
  exact hOffers'

/-- Proves that a transition-alphabet symbol remains in the alphabet when only its offer summary is replaced by another signature offer summary. -/
theorem transitionAlphabet_change_offers
    (signature : TypeAlphabet) {env : TypeEnvironment} {label : TypeLabel}
    {offers offers' : TypeOfferSummary}
    (hSymbol : TypeAutomatonSymbol.mk env label offers ∈
      signature.transitionAlphabet)
    (hOffers' : offers' ∈ signature.offerSummaries) :
    TypeAutomatonSymbol.mk env label offers' ∈ signature.transitionAlphabet := by
  classical
  unfold TypeAlphabet.transitionAlphabet at hSymbol ⊢
  rw [Finset.mem_biUnion] at hSymbol
  obtain ⟨environment, hEnvironment, hSymbol⟩ := hSymbol
  rw [Finset.mem_biUnion] at hSymbol
  obtain ⟨label', hLabel, hOffers⟩ := hSymbol
  rw [Finset.mem_image] at hOffers
  obtain ⟨offers0, _hOffers0, hEq⟩ := hOffers
  cases hEq
  rw [Finset.mem_biUnion]
  refine ⟨env, hEnvironment, ?_⟩
  rw [Finset.mem_biUnion]
  refine ⟨label, hLabel, ?_⟩
  rw [Finset.mem_image]
  exact ⟨offers', hOffers', rfl⟩

/-- Proves that an offer summary stays supported when its future part is drawn from the old future and current parts. -/
theorem offerSummary_mem_of_future_subset_union
    (signature : TypeAlphabet) {current future future' : Finset BareMessage}
    (hOffers : TypeOfferSummary.mk current future ∈ signature.offerSummaries)
    (hFuture' : future' ⊆ future ∪ current) :
    TypeOfferSummary.mk current future' ∈ signature.offerSummaries := by
  classical
  unfold TypeAlphabet.offerSummaries at hOffers ⊢
  rw [Finset.mem_biUnion] at hOffers
  obtain ⟨current0, hCurrent0, hImage⟩ := hOffers
  rw [Finset.mem_image] at hImage
  obtain ⟨future0, hFuture0, hEq⟩ := hImage
  cases hEq
  rw [Finset.mem_biUnion]
  refine ⟨current, hCurrent0, ?_⟩
  rw [Finset.mem_image]
  refine ⟨future', ?_, rfl⟩
  unfold TypeAlphabet.offerSets at hCurrent0 hFuture0 ⊢
  rw [Finset.mem_powerset] at hCurrent0 hFuture0 ⊢
  intro action hAction
  have hUnion := hFuture' hAction
  rw [Finset.mem_union] at hUnion
  exact hUnion.elim (fun hFuture => hFuture0 hFuture)
    (fun hCurrent => hCurrent0 hCurrent)

/-- Proves transition-alphabet closure when the new future offer is drawn from the old future and current offers. -/
theorem transitionAlphabet_change_future_of_subset_union
    (signature : TypeAlphabet) {env : TypeEnvironment} {label : TypeLabel}
    {current future future' : Finset BareMessage}
    (hSymbol :
      TypeAutomatonSymbol.mk env label (TypeOfferSummary.mk current future) ∈
        signature.transitionAlphabet)
    (hFuture' : future' ⊆ future ∪ current) :
    TypeAutomatonSymbol.mk env label (TypeOfferSummary.mk current future') ∈
      signature.transitionAlphabet := by
  exact transitionAlphabet_change_offers signature hSymbol
    (offerSummary_mem_of_future_subset_union signature
      (transitionAlphabet_offerSummary_mem signature hSymbol) hFuture')

/-- Proves that a child offer pair remains in the transition alphabet when its target menu is covered by the parent future and current offers. -/
theorem transitionAlphabet_of_typeOffers_target_subset
    (signature : TypeAlphabet) {env : TypeEnvironment} {source target : PactType}
    {label : TypeLabel} {current parentFuture childFuture : Finset BareMessage}
    (hSymbol :
      TypeAutomatonSymbol.mk env label
        (TypeOfferSummary.mk current parentFuture) ∈
          signature.transitionAlphabet)
    (hOffers : TypeOffers env source label target current childFuture)
    (hTarget :
      typeFutureOffers target ⊆ parentFuture ∪ current) :
    TypeAutomatonSymbol.mk env label
      (TypeOfferSummary.mk current childFuture) ∈ signature.transitionAlphabet := by
  apply transitionAlphabet_change_future_of_subset_union signature hSymbol
  intro action hAction
  have hStepFuture :=
    typeOffers_future_subset_target_union_current hOffers hAction
  rw [Finset.mem_union] at hStepFuture ⊢
  rcases hStepFuture with hFuture | hCurrent
  · simpa [Finset.mem_union] using hTarget hFuture
  · exact Or.inr hCurrent

/-- Proves that a finite set is contained in itself with a current-offer set restored after subtraction. -/
theorem subset_sdiff_union_self {α : Type} [DecidableEq α]
    (future current : Finset α) :
    future ⊆ (future \ current) ∪ current := by
  intro action hAction
  by_cases hCurrent : action ∈ current
  · exact Finset.mem_union.mpr (Or.inr hCurrent)
  · exact Finset.mem_union.mpr
      (Or.inl (Finset.mem_sdiff.mpr ⟨hAction, hCurrent⟩))

/-- Proves that the left residual's future menu is contained in the enclosing sequence menu. -/
theorem typeFutureOffers_subset_sequence_left
    (left right : PactType) :
    typeFutureOffers left ⊆ typeFutureOffers (.seq left right) := by
  intro action hAction
  rw [typeFutureOffers_sequence]
  by_cases hComplete : left.CanCompleteBeforeTock
  · simp [hComplete, hAction]
  · simp [hComplete, hAction]

/-- Proves that a child sequence target menu is covered by the parent sequence offer envelope. -/
theorem typeFutureOffers_subset_sequence_left_sdiff_union
    (left right : PactType) (current : Finset BareMessage) :
    typeFutureOffers left ⊆
      (typeFutureOffers (.seq left right) \ current) ∪ current :=
  (typeFutureOffers_subset_sequence_left left right).trans
    (subset_sdiff_union_self (typeFutureOffers (.seq left right)) current)

/-- Proves every sufficiently fuelled fragment is closed under its own future references. -/
theorem compileTypeFuel_futureTargetsInStates (signature : TypeAlphabet) :
    ∀ fuel processType,
      TypeCompilationFuelSufficient processType fuel →
      (compileTypeFuel signature fuel processType).FutureTargetsInStates := by
  intro fuel
  induction fuel with
  | zero =>
      intro processType hFuel
      exact (Nat.not_lt_zero _
        (TypeCompilationFuelSufficient.positive hFuel)).elim
  | succ fuel ih =>
      intro processType hFuel
      cases processType with
      | message msg dir =>
          intro edge hEdge target removed hFuture
          simp only [compileTypeFuel, finishAutomatonFragment, Finset.mem_union,
            Finset.mem_image] at hEdge
          rcases hEdge with (⟨environment, _, rfl⟩ | ⟨environment, _, rfl⟩) |
            ⟨environment, _, rfl⟩ <;> simp at hFuture
      | progress pid =>
          intro edge hEdge target removed hFuture
          simp only [compileTypeFuel, finishAutomatonFragment, Finset.mem_union,
            Finset.mem_image] at hEdge
          rcases hEdge with ⟨environment, _, rfl⟩ | ⟨environment, _, rfl⟩ <;>
            simp at hFuture
      | tock =>
          intro edge hEdge target removed hFuture
          simp only [compileTypeFuel, finishAutomatonFragment, Finset.mem_union,
            Finset.mem_image] at hEdge
          rcases hEdge with ⟨environment, _, rfl⟩ | ⟨environment, _, rfl⟩
          · split at hFuture <;> simp at hFuture
          · simp at hFuture
      | skip =>
          intro edge hEdge target removed hFuture
          simp only [compileTypeFuel, finishAutomatonFragment, Finset.mem_image]
            at hEdge
          obtain ⟨environment, _, rfl⟩ := hEdge
          simp at hFuture
      | var name =>
          intro edge hEdge target removed hFuture
          simp only [compileTypeFuel, finishAutomatonFragment, Finset.mem_image]
            at hEdge
          obtain ⟨environment, _, rfl⟩ := hEdge
          simp at hFuture
      | recur name body =>
          have hBody : TypeCompilationFuelSufficient body fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          exact buildRecursionAutomaton_futureTargetsInStates signature name
            (compileTypeFuel signature fuel body) (ih body hBody)
            (compileTypeFuel_initial_mem signature fuel body hBody)
      | choice left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          exact buildChoiceAutomaton_futureTargetsInStates signature
            (compileTypeFuel signature fuel left)
            (compileTypeFuel signature fuel right) TypeLabel.silent
            TypeLabel.silent (ih left hLeft) (ih right hRight)
            (compileTypeFuel_initial_mem signature fuel left hLeft)
            (compileTypeFuel_initial_mem signature fuel right hRight)
      | fairChoice bid left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          exact buildChoiceAutomaton_futureTargetsInStates signature
            (compileTypeFuel signature fuel left)
            (compileTypeFuel signature fuel right) (TypeLabel.fair bid true)
            (TypeLabel.fair bid false) (ih left hLeft) (ih right hRight)
            (compileTypeFuel_initial_mem signature fuel left hLeft)
            (compileTypeFuel_initial_mem signature fuel right hRight)
      | seq left right =>
          have hLeft : TypeCompilationFuelSufficient left fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hRight : TypeCompilationFuelSufficient right fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          exact buildSequenceAutomaton_futureTargetsInStates signature
            (compileTypeFuel signature fuel left)
            (compileTypeFuel signature fuel right) (ih left hLeft)
            (ih right hRight)
            (compileTypeFuel_initial_mem signature fuel right hRight)
      | par left right interface =>
          exact buildParallelAutomaton_futureTargetsInStates signature interface
            (compileTypeFuel signature fuel left)
            (compileTypeFuel signature fuel right)
      | xoffer elseType branches =>
          have hElse : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hBranches : ∀ entry ∈ branches,
              TypeCompilationFuelSufficient entry.2 fuel := by
            intro entry hEntry
            have hBound := typeCompilationFuel_le_typeBranchCompilationFuel
              branches entry hEntry
            simp only [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel
            simp only [TypeCompilationFuelSufficient]
            omega
          have hResult := buildExclusiveOfferAutomaton_futureTargetsInStates
            signature branches (compileTypeFuel signature fuel elseType)
            (branches.map fun branch =>
              (branch.1, compileTypeFuel signature fuel branch.2))
            (ih elseType hElse)
            (by
              intro entry hEntry
              simp only [List.mem_map] at hEntry
              obtain ⟨original, hOriginal, rfl⟩ := hEntry
              exact ih original.2 (hBranches original hOriginal))
            (compileTypeFuel_initial_mem signature fuel elseType hElse)
            (by
              intro entry hEntry
              simp only [List.mem_map] at hEntry
              obtain ⟨original, hOriginal, rfl⟩ := hEntry
              exact compileTypeFuel_initial_mem signature fuel original.2
                (hBranches original hOriginal))
          simpa [compileTypeFuel] using hResult
      | offer elseType branches =>
          have hElse : TypeCompilationFuelSufficient elseType fuel := by
            simp [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel ⊢
            omega
          have hSelected : ∀ selected ∈ branches,
              TypeCompilationFuelSufficient
                (parallelTypeBranchesSelecting selected branches) fuel := by
            intro selected hSelected
            simp only [TypeCompilationFuelSufficient,
              typeCompilationFuel_parallelTypeBranchesSelecting]
            simp only [TypeCompilationFuelSufficient, typeCompilationFuel] at hFuel
            omega
          have hResult :=
            buildSelectedConjunctiveOfferAutomaton_futureTargetsInStates
              signature branches (compileTypeFuel signature fuel elseType)
              (branches.map fun selected =>
                (selected.1, compileTypeFuel signature fuel
                  (parallelTypeBranchesSelecting selected branches)))
              (ih elseType hElse)
              (by
                intro entry hEntry
                simp only [List.mem_map] at hEntry
                obtain ⟨original, hOriginal, rfl⟩ := hEntry
                exact ih (parallelTypeBranchesSelecting original branches)
                  (hSelected original hOriginal))
              (compileTypeFuel_initial_mem signature fuel elseType hElse)
              (by
                intro entry hEntry
                simp only [List.mem_map] at hEntry
                obtain ⟨original, hOriginal, rfl⟩ := hEntry
                exact compileTypeFuel_initial_mem signature fuel
                  (parallelTypeBranchesSelecting original branches)
                  (hSelected original hOriginal))
          simpa [compileTypeFuel] using hResult

/-- Proves every sufficiently fuelled fragment's pending automaton is closed under its own future references. -/
theorem compileTypeFuel_referencesClosed (signature : TypeAlphabet)
    (fuel : Nat) (processType : PactType)
    (hFuel : TypeCompilationFuelSufficient processType fuel) :
    ({ states := (compileTypeFuel signature fuel processType).states
       edges := (compileTypeFuel signature fuel processType).edges } :
      PendingAutomaton).ReferencesClosed :=
  PendingAutomaton.referencesClosed_of_futureTargetsInStates
    (compileTypeFuel signature fuel processType)
    (compileTypeFuel_futureTargetsInStates signature fuel processType hFuel)

/-- States that `stateProductInfoFuel` stabilizes once its fuel is sufficient, mirroring `compileTypeFuel_eq_of_sufficient`. -/
theorem stateProductInfoFuel_eq_of_sufficient
    (processType : PactType) (state : TypeAutomatonState)
    {leftFuel rightFuel : Nat}
    (hLeft : TypeCompilationFuelSufficient processType leftFuel)
    (hRight : TypeCompilationFuelSufficient processType rightFuel) :
    stateProductInfoFuel leftFuel processType state =
      stateProductInfoFuel rightFuel processType state := by
  sorry

/-- States that `computeFutureOfFuel` stabilizes once its fuel is sufficient, mirroring `compileTypeFuel_eq_of_sufficient`. -/
theorem computeFutureOfFuel_eq_of_sufficient
    (signature : TypeAlphabet) (processType : PactType) (state : TypeAutomatonState)
    {leftFuel rightFuel : Nat}
    (hLeft : TypeCompilationFuelSufficient processType leftFuel)
    (hRight : TypeCompilationFuelSufficient processType rightFuel) :
    computeFutureOfFuel signature leftFuel processType state =
      computeFutureOfFuel signature rightFuel processType state := by
  sorry

/-- Proves a `.child 0`-tagged state's future menu, in a compiled binary choice, agrees with the left child's own. -/
theorem computeFutureOf_binaryChoice_left
    (signature : TypeAlphabet) (left right : PactType)
    (selectionLeft selectionRight : TypeLabel)
    (whole : PactType)
    (hWhole :
      compileTypeFuel signature (typeCompilationFuel whole) whole =
        buildChoiceAutomaton signature
          (compileTypeFuel signature (typeCompilationFuel left) left)
          (compileTypeFuel signature (typeCompilationFuel right) right)
          selectionLeft selectionRight)
    (hFuel : typeCompilationFuel left + 1 ≤ typeCompilationFuel whole)
    (state : TypeAutomatonState)
    (hState : state ∈ (compileTypeFuel signature (typeCompilationFuel left)
      left).states) :
    computeFutureOf signature whole (.child 0 state) =
      computeFutureOf signature left state := by
  sorry

/-- Proves a `.child 1`-tagged state's future menu, in a compiled binary choice, agrees with the right child's own. -/
theorem computeFutureOf_binaryChoice_right
    (signature : TypeAlphabet) (left right : PactType)
    (selectionLeft selectionRight : TypeLabel)
    (whole : PactType)
    (hWhole :
      compileTypeFuel signature (typeCompilationFuel whole) whole =
        buildChoiceAutomaton signature
          (compileTypeFuel signature (typeCompilationFuel left) left)
          (compileTypeFuel signature (typeCompilationFuel right) right)
          selectionLeft selectionRight)
    (hFuel : typeCompilationFuel right + 1 ≤ typeCompilationFuel whole)
    (state : TypeAutomatonState)
    (hState : state ∈ (compileTypeFuel signature (typeCompilationFuel right)
      right).states) :
    computeFutureOf signature whole (.child 1 state) =
      computeFutureOf signature right state := by
  sorry

/-- Proves a `.child 0`-tagged state's future menu, in a compiled exclusive offer, agrees with the else child's own. -/
theorem computeFutureOf_exclusiveOffer_else
    (signature : TypeAlphabet) (elseType : PactType)
    (branches : List (BareMessage × PactType)) (whole : PactType)
    (hWhole :
      compileTypeFuel signature (typeCompilationFuel whole) whole =
        buildExclusiveOfferAutomaton signature branches
          (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
          (branches.map fun branch => (branch.1, compileTypeFuel signature
            (typeCompilationFuel branch.2) branch.2)))
    (hFuel : typeCompilationFuel elseType + 1 ≤ typeCompilationFuel whole)
    (state : TypeAutomatonState)
    (hState : state ∈ (compileTypeFuel signature (typeCompilationFuel elseType)
      elseType).states) :
    computeFutureOf signature whole (.child 0 state) =
      computeFutureOf signature elseType state := by
  sorry

/-- Proves a `.child (i+1)`-tagged state's future menu, in a compiled exclusive offer, agrees with branch `i`'s own. -/
theorem computeFutureOf_exclusiveOffer_branch
    (signature : TypeAlphabet) (elseType : PactType)
    (branches : List (BareMessage × PactType)) (whole : PactType)
    (hWhole :
      compileTypeFuel signature (typeCompilationFuel whole) whole =
        buildExclusiveOfferAutomaton signature branches
          (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
          (branches.map fun branch => (branch.1, compileTypeFuel signature
            (typeCompilationFuel branch.2) branch.2)))
    (i : Nat) (action : BareMessage) (branchType : PactType)
    (hBranch : branches[i]? = some (action, branchType))
    (hFuel : typeCompilationFuel branchType + 1 ≤ typeCompilationFuel whole)
    (state : TypeAutomatonState)
    (hState : state ∈ (compileTypeFuel signature (typeCompilationFuel branchType)
      branchType).states) :
    computeFutureOf signature whole (.child (i + 1) state) =
      computeFutureOf signature branchType state := by
  sorry

/-- Characterizes a public exclusive-offer edge leaving a tagged else-child state as a copy of the else automaton's own outgoing edge. -/
theorem buildExclusiveOfferAutomaton_outgoing_else
    (signature : TypeAlphabet) (branches : List (BareMessage × PactType))
    (elseAutomaton : AutomatonFragment)
    (branchAutomata : List (BareMessage × AutomatonFragment))
    (state : TypeAutomatonState) (edge : PendingAutomatonEdge) :
    let offer := buildExclusiveOfferAutomaton signature branches elseAutomaton
      branchAutomata
    edge ∈ offer.edges ∧ edge.source = .child 0 state ↔
      ∃ childEdge ∈ elseAutomaton.edges,
        childEdge.source = state ∧ edge = childPendingEdge 0 childEdge := by
  sorry

/-- Characterizes a public exclusive-offer edge leaving a tagged branch-`i`-child state as a copy of that branch's own outgoing edge. -/
theorem buildExclusiveOfferAutomaton_outgoing_branch
    (signature : TypeAlphabet) (branches : List (BareMessage × PactType))
    (elseAutomaton : AutomatonFragment)
    (branchAutomata : List (BareMessage × AutomatonFragment))
    (i : Nat) (action : BareMessage) (automaton : AutomatonFragment)
    (hBranch : branchAutomata[i]? = some (action, automaton))
    (state : TypeAutomatonState) (edge : PendingAutomatonEdge) :
    let offer := buildExclusiveOfferAutomaton signature branches elseAutomaton
      branchAutomata
    edge ∈ offer.edges ∧ edge.source = .child (i + 1) state ↔
      ∃ childEdge ∈ automaton.edges,
        childEdge.source = state ∧ edge = childPendingEdge (i + 1) childEdge := by
  sorry

/-- Relates a branch found by index after mapping compiled fragments in to the same branch found by index in the original list. -/
theorem branches_map_getElem?_eq_some_iff
    (signature : TypeAlphabet) (branches : List (BareMessage × PactType))
    (i : Nat) (action : BareMessage) (automaton : AutomatonFragment) :
    (branches.map fun branch =>
        (branch.1, compileTypeFuel signature (typeCompilationFuel branch.2)
          branch.2))[i]? = some (action, automaton) ↔
      ∃ branchType, branches[i]? = some (action, branchType) ∧
        compileTypeFuel signature (typeCompilationFuel branchType) branchType =
          automaton := by
  rw [List.getElem?_map, Option.map_eq_some_iff]
  constructor
  · rintro ⟨⟨branchAction, branchType⟩, hGet, hEq⟩
    simp only [Prod.mk.injEq] at hEq
    obtain ⟨hAction, hAut⟩ := hEq
    subst hAction
    exact ⟨branchType, hGet, hAut⟩
  · rintro ⟨branchType, hGet, hAut⟩
    exact ⟨(action, branchType), hGet, by simp [hAut]⟩

/-- States that substituting `μX.body` for `X` preserves and reflects a decorated step of a non-marker body residual. -/
theorem decoratedTypeTransition_replaceVar_iff
    (name : String) (body : PactType) (residual : PactType)
    {env : TypeEnvironment} {label : TypeLabel} {offers : TypeOfferSummary}
    {target : PactType} :
    DecoratedTypeTransition env (residual.replaceVar name (.recur name body)) label
      offers target ↔
      ∃ residual', target = residual'.replaceVar name (.recur name body) ∧
        DecoratedTypeTransition env residual label offers residual' := by
  sorry

/-- States that a marker-labelled body edge is always sourced at a state representing the open variable it marks. -/
theorem compileTypeFuel_marker_represents_var
    (signature : TypeAlphabet) (name : String) (body : PactType)
    {q : TypeAutomatonState} {residual : PactType}
    (hMem :
      relationMembership (buildRelationSet body (compileType signature body))
        residual q)
    {bodyEdge : PendingAutomatonEdge}
    (hBodyEdge : bodyEdge ∈
      (compileTypeFuel signature (typeCompilationFuel body) body).edges)
    (hSource : bodyEdge.source = q)
    (hMarkerLabel : bodyEdge.label = .variable name) :
    residual = .var name := by
  sorry

/-- Proves a `.child 0`-tagged state's future menu, in a compiled recursion, agrees with the body's own. -/
theorem computeFutureOf_recursion_child
    (signature : TypeAlphabet) (name : String) (body : PactType) (whole : PactType)
    (hWhole :
      compileTypeFuel signature (typeCompilationFuel whole) whole =
        buildRecursionAutomaton signature name
          (compileTypeFuel signature (typeCompilationFuel body) body))
    (hFuelBody : typeCompilationFuel body + 1 ≤ typeCompilationFuel whole)
    (state : TypeAutomatonState)
    (hState : state ∈ (compileTypeFuel signature (typeCompilationFuel body)
      body).states) :
    computeFutureOf signature whole (.child 0 state) =
      computeFutureOf signature body state := by
  sorry

/-- Proves H15's future agreement for a recursion-tagged state, substituted for the open variable. -/
lemma helper_h15_recursion_future_offers_agree
    (signature : TypeAlphabet) (name : String) (body : PactType)
    {residual : PactType} {q : TypeAutomatonState}
    (hRelated :
      relationMembership (buildRelationSet body (compileType signature body))
        residual q) :
    computeFutureOf signature (.recur name body) (.child 0 q) =
      typeFutureOffers (residual.replaceVar name (.recur name body)) := by
  sorry

/-- Defines the related-state shape for a compiled binary choice: the root represents `whole`, a tagged child state represents its own relation's residual. -/
def binaryChoiceRelationShape
    (signature : TypeAlphabet) (whole left right : PactType)
    (entry : PactType × TypeAutomatonState) : Prop :=
  entry = (whole, TypeAutomatonState.root) ∨
    (∃ q, entry.2 = .child 0 q ∧
      relationMembership (buildRelationSet left (compileType signature left))
        entry.1 q) ∨
    (∃ q, entry.2 = .child 1 q ∧
      relationMembership (buildRelationSet right (compileType signature right))
        entry.1 q)

/-- Proves every related pair for a type compiled through `buildChoiceAutomaton` has the binary-choice shape, given that the root's two semantic rules are each uniquely determined by their label. -/
lemma relationMembership_binaryChoice_cases
    (signature : TypeAlphabet) (whole left right : PactType)
    (selectionLeft selectionRight : TypeLabel)
    (hWhole :
      compileTypeFuel signature (typeCompilationFuel whole) whole =
        buildChoiceAutomaton signature
          (compileTypeFuel signature (typeCompilationFuel left) left)
          (compileTypeFuel signature (typeCompilationFuel right) right)
          selectionLeft selectionRight)
    (hFuelLeft : typeCompilationFuel left + 1 ≤ typeCompilationFuel whole)
    (hFuelRight : typeCompilationFuel right + 1 ≤ typeCompilationFuel whole)
    (hRootLeft : ∀ env offers target,
      DecoratedTypeTransition env whole selectionLeft offers target → target = left)
    (hRootRight : ∀ env offers target,
      DecoratedTypeTransition env whole selectionRight offers target → target = right)
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership (buildRelationSet whole (compileType signature whole))
        residual state) :
    binaryChoiceRelationShape signature whole left right (residual, state) := by
  have hInit : (compileType signature whole).initial = TypeAutomatonState.root := by
    show (compileTypeFuel signature (typeCompilationFuel whole) whole).initial =
      TypeAutomatonState.root
    rw [hWhole]
    simp [buildChoiceAutomaton, finishAutomatonFragment]
  refine buildRelationSet_preserves whole (compileType signature whole)
    (binaryChoiceRelationShape signature whole left right)
    (by
      show binaryChoiceRelationShape signature whole left right
        (whole, (compileType signature whole).initial)
      rw [hInit]; exact Or.inl rfl)
    (by
      intro entry hEntry successor hSuccessor
      rcases relationSuccessors_mem_cases (compileType signature whole) entry successor
        hSuccessor with ⟨edge, hEdgeMem, hSource, hTarget, hStep⟩
      have hSymbolMem := compileType_hasEdge_symbol_mem signature whole
        (show (compileType signature whole).HasEdge edge.source edge.symbol.environment
          edge.symbol.label edge.symbol.offers edge.target from hEdgeMem)
      have hResolved := (compileType_hasEdge_iff_hasResolvedEdge signature whole
        edge.source edge.target edge.symbol.environment edge.symbol.label
        edge.symbol.offers hSymbolMem).mp hEdgeMem
      rw [hWhole] at hResolved
      obtain ⟨pendingEdge, hPendingMem, hPSource, hPEnv, hPLabel, hPCurrent, hPFuture,
        hPTarget⟩ := hResolved
      rcases hEntry with hRoot | ⟨q, hStateEq, hMem⟩ | ⟨q, hStateEq, hMem⟩
      · -- root case: entry represents `whole` itself
        have hRootSource : pendingEdge.source = TypeAutomatonState.root := by
          rw [hPSource, hSource, hRoot]
        simp only [buildChoiceAutomaton, finishAutomatonFragment, Finset.mem_union,
          Finset.mem_biUnion, Finset.mem_insert, Finset.mem_singleton,
          childPendingEdges, Finset.mem_image] at hPendingMem
        rcases hPendingMem with (⟨childEdge, _, hEq⟩ | ⟨childEdge, _, hEq⟩) |
          ⟨environment, _, hEq | hEq⟩
        · exfalso; rw [← hEq] at hRootSource
          simp [childPendingEdge, childState] at hRootSource
        · exfalso; rw [← hEq] at hRootSource
          simp [childPendingEdge, childState] at hRootSource
        · subst hEq
          simp only [childState] at hPLabel hPTarget
          have hLabelEq : edge.symbol.label = selectionLeft := by
            injection hPLabel.symm
          have hEntry1 : entry.1 = whole := by rw [hRoot]
          have hResidualEq : successor.1 = left := by
            apply hRootLeft edge.symbol.environment edge.symbol.offers
            rw [← hEntry1, ← hLabelEq]; exact hStep
          have hTargetEq : successor.2 = .child 0
              (compileTypeFuel signature (typeCompilationFuel left) left).initial := by
            rw [hTarget, ← hPTarget]
          exact Or.inr (Or.inl ⟨(compileTypeFuel signature (typeCompilationFuel left)
            left).initial, hTargetEq, hResidualEq ▸
              buildRelationSet_initial left (compileType signature left)⟩)
        · subst hEq
          simp only [childState] at hPLabel hPTarget
          have hLabelEq : edge.symbol.label = selectionRight := by
            injection hPLabel.symm
          have hEntry1 : entry.1 = whole := by rw [hRoot]
          have hResidualEq : successor.1 = right := by
            apply hRootRight edge.symbol.environment edge.symbol.offers
            rw [← hEntry1, ← hLabelEq]; exact hStep
          have hTargetEq : successor.2 = .child 1
              (compileTypeFuel signature (typeCompilationFuel right) right).initial := by
            rw [hTarget, ← hPTarget]
          exact Or.inr (Or.inr ⟨(compileTypeFuel signature (typeCompilationFuel right)
            right).initial, hTargetEq, hResidualEq ▸
              buildRelationSet_initial right (compileType signature right)⟩)
      · -- left-child case: entry is already related to `q` inside `left`'s own relation
        have hChildSource : pendingEdge.source = .child 0 q := by
          rw [hPSource, hSource, hStateEq]
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildChoiceAutomaton_outgoing_left signature
            (compileTypeFuel signature (typeCompilationFuel left) left)
            (compileTypeFuel signature (typeCompilationFuel right) right)
            selectionLeft selectionRight q pendingEdge).mp ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature left).HasEdge q
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature left q childEdge.target
            edge.symbol.environment edge.symbol.label edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel left) left le_rfl childEdge hChildEdgeMem t r hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_binaryChoice_left signature left right
                  selectionLeft selectionRight whole hWhole hFuelLeft t hStateMem]
        have hTargetEq : successor.2 = .child 0 childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique left (compileType signature left)
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr (Or.inl ⟨childEdge.target, hTargetEq, hInnerMem⟩)
      · -- right-child case: symmetric to the left-child case
        have hChildSource : pendingEdge.source = .child 1 q := by
          rw [hPSource, hSource, hStateEq]
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildChoiceAutomaton_outgoing_right signature
            (compileTypeFuel signature (typeCompilationFuel left) left)
            (compileTypeFuel signature (typeCompilationFuel right) right)
            selectionLeft selectionRight q pendingEdge).mp ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature right).HasEdge q
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature right q childEdge.target
            edge.symbol.environment edge.symbol.label edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel right) right le_rfl childEdge hChildEdgeMem t r
                  hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_binaryChoice_right signature left right
                  selectionLeft selectionRight whole hWhole hFuelRight t hStateMem]
        have hTargetEq : successor.2 = .child 1 childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique right (compileType signature right)
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr (Or.inr ⟨childEdge.target, hTargetEq, hInnerMem⟩))
    (residual, state) hRelated

/-- Proves every related choice pair has the binary-choice shape. -/
lemma relationMembership_choice_cases
    (signature : TypeAlphabet) (left right : PactType)
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership
        (buildRelationSet (.choice left right)
          (compileType signature (.choice left right)))
        residual state) :
    binaryChoiceRelationShape signature (.choice left right) left right
      (residual, state) := by
  have hFuelEq : typeCompilationFuel (.choice left right) =
      max (typeCompilationFuel left) (typeCompilationFuel right) + 1 := by
    simp only [typeCompilationFuel]; omega
  have hWhole :
      compileTypeFuel signature (typeCompilationFuel (.choice left right))
        (.choice left right) =
        buildChoiceAutomaton signature
          (compileTypeFuel signature (typeCompilationFuel left) left)
          (compileTypeFuel signature (typeCompilationFuel right) right)
          TypeLabel.silent TypeLabel.silent := by
    rw [hFuelEq]
    show buildChoiceAutomaton signature
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
        TypeLabel.silent TypeLabel.silent =
      buildChoiceAutomaton signature (compileTypeFuel signature
        (typeCompilationFuel left) left) (compileTypeFuel signature
        (typeCompilationFuel right) right) TypeLabel.silent TypeLabel.silent
    rw [compileTypeFuel_eq_of_sufficient signature left (le_max_left _ _) le_rfl,
      compileTypeFuel_eq_of_sufficient signature right (le_max_right _ _) le_rfl]
  have hFuelLeft :
      typeCompilationFuel left + 1 ≤ typeCompilationFuel (.choice left right) := by
    simp only [typeCompilationFuel]; omega
  have hFuelRight :
      typeCompilationFuel right + 1 ≤ typeCompilationFuel (.choice left right) := by
    simp only [typeCompilationFuel]; omega
  have hInit : (compileType signature (.choice left right)).initial =
      TypeAutomatonState.root := by
    show (compileTypeFuel signature (typeCompilationFuel (.choice left right))
      (.choice left right)).initial = TypeAutomatonState.root
    rw [hWhole]
    simp [buildChoiceAutomaton, finishAutomatonFragment]
  refine buildRelationSet_preserves (.choice left right)
    (compileType signature (.choice left right))
    (binaryChoiceRelationShape signature (.choice left right) left right)
    (by
      show binaryChoiceRelationShape signature (.choice left right) left right
        (.choice left right, (compileType signature (.choice left right)).initial)
      rw [hInit]; exact Or.inl rfl)
    (by
      intro entry hEntry successor hSuccessor
      rcases relationSuccessors_mem_cases (compileType signature (.choice left right))
        entry successor hSuccessor with ⟨edge, hEdgeMem, hSource, hTarget, hStep⟩
      have hSymbolMem := compileType_hasEdge_symbol_mem signature (.choice left right)
        (show (compileType signature (.choice left right)).HasEdge edge.source
          edge.symbol.environment edge.symbol.label edge.symbol.offers edge.target
          from hEdgeMem)
      have hResolved := (compileType_hasEdge_iff_hasResolvedEdge signature
        (.choice left right) edge.source edge.target edge.symbol.environment
        edge.symbol.label edge.symbol.offers hSymbolMem).mp hEdgeMem
      rw [hWhole] at hResolved
      obtain ⟨pendingEdge, hPendingMem, hPSource, hPEnv, hPLabel, hPCurrent, hPFuture,
        hPTarget⟩ := hResolved
      rcases hEntry with hRoot | ⟨q, hStateEq, hMem⟩ | ⟨q, hStateEq, hMem⟩
      · -- root case: entry represents `τ1 + τ2` itself, and H15 pins each
        -- root edge's own future offers to the child it actually selects.
        have hRootSource : pendingEdge.source = TypeAutomatonState.root := by
          rw [hPSource, hSource, hRoot]
        simp only [buildChoiceAutomaton, finishAutomatonFragment, Finset.mem_union,
          Finset.mem_biUnion, Finset.mem_insert, Finset.mem_singleton,
          childPendingEdges, Finset.mem_image] at hPendingMem
        rcases hPendingMem with (⟨childEdge, _, hEq⟩ | ⟨childEdge, _, hEq⟩) |
          ⟨environment, hEnvironment, hEq | hEq⟩
        · exfalso; rw [← hEq] at hRootSource
          simp [childPendingEdge, childState] at hRootSource
        · exfalso; rw [← hEq] at hRootSource
          simp [childPendingEdge, childState] at hRootSource
        · subst hEq
          simp only [childState] at hPLabel hPCurrent hPFuture hPTarget
          have hLabelEq : edge.symbol.label = TypeLabel.silent := by
            injection hPLabel.symm
          have hCurrentEq : edge.symbol.offers.current = ∅ := hPCurrent.symm
          have hFutureEq : edge.symbol.offers.future = typeFutureOffers left := by
            rw [← hPFuture, computeFutureOf_binaryChoice_left signature left right
              TypeLabel.silent TypeLabel.silent (.choice left right) hWhole hFuelLeft
              (compileTypeFuel signature (typeCompilationFuel left) left).initial
              (compileTypeFuel_initial_mem signature (typeCompilationFuel left) left le_rfl),
              Finset.sdiff_empty]
            show computeFutureOf signature left (compileType signature left).initial =
              typeFutureOffers left
            exact helper_h15_future_offers_agree signature
              (buildRelationSet_initial left (compileType signature left))
          have hOffersEq : edge.symbol.offers = TypeOfferSummary.mk ∅
              (typeFutureOffers left) := by
            rw [show edge.symbol.offers = TypeOfferSummary.mk
              edge.symbol.offers.current edge.symbol.offers.future from rfl,
              hCurrentEq, hFutureEq]
          have hWF : edge.symbol.environment.WellFormed :=
            localEnvironment_wellFormed signature (hPEnv ▸ hEnvironment)
          have hEntry1 : entry.1 = .choice left right := by rw [hRoot]
          have hResidualEq : successor.1 = left := by
            rw [hEntry1] at hStep
            rw [hLabelEq, hOffersEq] at hStep
            exact decoratedTypeTransition_target_unique hStep
              ⟨TypeTransition.choice_left edge.symbol.environment left right hWF,
                TypeOffers.choice_left edge.symbol.environment left right hWF⟩
          have hTargetEq : successor.2 = .child 0
              (compileTypeFuel signature (typeCompilationFuel left) left).initial := by
            rw [hTarget, ← hPTarget]
          exact Or.inr (Or.inl ⟨(compileTypeFuel signature (typeCompilationFuel left)
            left).initial, hTargetEq, hResidualEq ▸
              buildRelationSet_initial left (compileType signature left)⟩)
        · subst hEq
          simp only [childState] at hPLabel hPCurrent hPFuture hPTarget
          have hLabelEq : edge.symbol.label = TypeLabel.silent := by
            injection hPLabel.symm
          have hCurrentEq : edge.symbol.offers.current = ∅ := hPCurrent.symm
          have hFutureEq : edge.symbol.offers.future = typeFutureOffers right := by
            rw [← hPFuture, computeFutureOf_binaryChoice_right signature left right
              TypeLabel.silent TypeLabel.silent (.choice left right) hWhole hFuelRight
              (compileTypeFuel signature (typeCompilationFuel right) right).initial
              (compileTypeFuel_initial_mem signature (typeCompilationFuel right) right le_rfl),
              Finset.sdiff_empty]
            show computeFutureOf signature right (compileType signature right).initial =
              typeFutureOffers right
            exact helper_h15_future_offers_agree signature
              (buildRelationSet_initial right (compileType signature right))
          have hOffersEq : edge.symbol.offers = TypeOfferSummary.mk ∅
              (typeFutureOffers right) := by
            rw [show edge.symbol.offers = TypeOfferSummary.mk
              edge.symbol.offers.current edge.symbol.offers.future from rfl,
              hCurrentEq, hFutureEq]
          have hWF : edge.symbol.environment.WellFormed :=
            localEnvironment_wellFormed signature (hPEnv ▸ hEnvironment)
          have hEntry1 : entry.1 = .choice left right := by rw [hRoot]
          have hResidualEq : successor.1 = right := by
            rw [hEntry1] at hStep
            rw [hLabelEq, hOffersEq] at hStep
            exact decoratedTypeTransition_target_unique hStep
              ⟨TypeTransition.choice_right edge.symbol.environment left right hWF,
                TypeOffers.choice_right edge.symbol.environment left right hWF⟩
          have hTargetEq : successor.2 = .child 1
              (compileTypeFuel signature (typeCompilationFuel right) right).initial := by
            rw [hTarget, ← hPTarget]
          exact Or.inr (Or.inr ⟨(compileTypeFuel signature (typeCompilationFuel right)
            right).initial, hTargetEq, hResidualEq ▸
              buildRelationSet_initial right (compileType signature right)⟩)
      · -- left-child case: entry is already related to `q` inside `left`'s own relation
        have hChildSource : pendingEdge.source = .child 0 q := by
          rw [hPSource, hSource, hStateEq]
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildChoiceAutomaton_outgoing_left signature
            (compileTypeFuel signature (typeCompilationFuel left) left)
            (compileTypeFuel signature (typeCompilationFuel right) right)
            TypeLabel.silent TypeLabel.silent q pendingEdge).mp ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature left).HasEdge q
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature left q childEdge.target
            edge.symbol.environment edge.symbol.label edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel left) left le_rfl childEdge hChildEdgeMem t r hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_binaryChoice_left signature left right
                  TypeLabel.silent TypeLabel.silent (.choice left right) hWhole hFuelLeft
                  t hStateMem]
        have hTargetEq : successor.2 = .child 0 childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique left (compileType signature left)
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr (Or.inl ⟨childEdge.target, hTargetEq, hInnerMem⟩)
      · -- right-child case: symmetric to the left-child case
        have hChildSource : pendingEdge.source = .child 1 q := by
          rw [hPSource, hSource, hStateEq]
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildChoiceAutomaton_outgoing_right signature
            (compileTypeFuel signature (typeCompilationFuel left) left)
            (compileTypeFuel signature (typeCompilationFuel right) right)
            TypeLabel.silent TypeLabel.silent q pendingEdge).mp ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature right).HasEdge q
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature right q childEdge.target
            edge.symbol.environment edge.symbol.label edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel right) right le_rfl childEdge hChildEdgeMem t r
                  hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_binaryChoice_right signature left right
                  TypeLabel.silent TypeLabel.silent (.choice left right) hWhole hFuelRight
                  t hStateMem]
        have hTargetEq : successor.2 = .child 1 childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique right (compileType signature right)
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr (Or.inr ⟨childEdge.target, hTargetEq, hInnerMem⟩))
    (residual, state) hRelated

/-- Proves every related fair-choice pair has the binary-choice shape. -/
lemma relationMembership_fairChoice_cases
    (signature : TypeAlphabet) (bid : BranchId) (left right : PactType)
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership
        (buildRelationSet (.fairChoice bid left right)
          (compileType signature (.fairChoice bid left right)))
        residual state) :
    binaryChoiceRelationShape signature (.fairChoice bid left right) left
      right (residual, state) := by
  have hFuelEq : typeCompilationFuel (.fairChoice bid left right) =
      max (typeCompilationFuel left) (typeCompilationFuel right) + 1 := by
    simp only [typeCompilationFuel]; omega
  have hWhole :
      compileTypeFuel signature (typeCompilationFuel (.fairChoice bid left right))
        (.fairChoice bid left right) =
        buildChoiceAutomaton signature
          (compileTypeFuel signature (typeCompilationFuel left) left)
          (compileTypeFuel signature (typeCompilationFuel right) right)
          (TypeLabel.fair bid true) (TypeLabel.fair bid false) := by
    rw [hFuelEq]
    show buildChoiceAutomaton signature
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) right)
        (TypeLabel.fair bid true) (TypeLabel.fair bid false) =
      buildChoiceAutomaton signature (compileTypeFuel signature
        (typeCompilationFuel left) left) (compileTypeFuel signature
        (typeCompilationFuel right) right) (TypeLabel.fair bid true)
        (TypeLabel.fair bid false)
    rw [compileTypeFuel_eq_of_sufficient signature left (le_max_left _ _) le_rfl,
      compileTypeFuel_eq_of_sufficient signature right (le_max_right _ _) le_rfl]
  refine relationMembership_binaryChoice_cases signature (.fairChoice bid left right)
    left right (TypeLabel.fair bid true) (TypeLabel.fair bid false) hWhole
    (by simp only [typeCompilationFuel]; omega)
    (by simp only [typeCompilationFuel]; omega)
    (by
      rintro env offers target ⟨hTrans, -⟩
      generalize hLabelEq : TypeLabel.fair bid true = actualLabel at hTrans
      cases hTrans <;> simp_all [TypeLabel.fair, Finset.ext_iff])
    (by
      rintro env offers target ⟨hTrans, -⟩
      generalize hLabelEq : TypeLabel.fair bid false = actualLabel at hTrans
      cases hTrans <;> simp_all [TypeLabel.fair, Finset.ext_iff])
    hRelated

/-- Defines the related-state shape for a compiled sequence: a retained left state represents `ρ1 ; τ2`, a right state represents its own relation's residual. -/
def seqRelationShape
    (signature : TypeAlphabet) (left right : PactType)
    (entry : PactType × TypeAutomatonState) : Prop :=
  (∃ q1 residualLeft, entry = (.seq residualLeft right, .child 0 q1) ∧
      relationMembership (buildRelationSet left (compileType signature left))
        residualLeft q1) ∨
    (∃ q2, entry.2 = .child 1 q2 ∧
      relationMembership (buildRelationSet right (compileType signature right))
        entry.1 q2)

/-- Proves the sufficient-fuel sequence fragment is the sequence builder applied to the sufficient child fragments. -/
theorem compileTypeFuel_sequence_eq_build
    (signature : TypeAlphabet) (left right : PactType) :
    compileTypeFuel signature (typeCompilationFuel (.seq left right))
        (.seq left right) =
      buildSequenceAutomaton signature
        (compileTypeFuel signature (typeCompilationFuel left) left)
        (compileTypeFuel signature (typeCompilationFuel right) right) := by
  have hFuelEq : typeCompilationFuel (.seq left right) =
      max (typeCompilationFuel left) (typeCompilationFuel right) + 1 := by
    simp only [typeCompilationFuel]; omega
  rw [hFuelEq]
  show buildSequenceAutomaton signature
      (compileTypeFuel signature
        (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
      (compileTypeFuel signature
        (max (typeCompilationFuel left) (typeCompilationFuel right)) right) =
    buildSequenceAutomaton signature
      (compileTypeFuel signature (typeCompilationFuel left) left)
      (compileTypeFuel signature (typeCompilationFuel right) right)
  rw [compileTypeFuel_eq_of_sufficient signature left (le_max_left _ _) le_rfl,
    compileTypeFuel_eq_of_sufficient signature right (le_max_right _ _) le_rfl]

/-- Proves a `.child 1`-tagged state's future menu, in a compiled sequence, agrees with the right child's own. -/
theorem computeFutureOf_sequence_right
    (signature : TypeAlphabet) (left right : PactType)
    (state : TypeAutomatonState)
    (hState : state ∈ (compileTypeFuel signature (typeCompilationFuel right)
      right).states) :
    computeFutureOf signature (.seq left right) (.child 1 state) =
      computeFutureOf signature right state := by
  sorry

/-- Proves sequence edges leaving a right-child state are exactly copied right-child edges. -/
theorem buildSequenceAutomaton_outgoing_right
    (signature : TypeAlphabet) (left right : AutomatonFragment)
    (state : TypeAutomatonState) (edge : PendingAutomatonEdge) :
    edge ∈ (buildSequenceAutomaton signature left right).edges ∧
        edge.source = .child 1 state ↔
      ∃ childEdge ∈ right.edges,
        childEdge.source = state ∧ edge = childPendingEdge 1 childEdge := by
  classical
  constructor
  · rintro ⟨hEdge, hSource⟩
    simp only [buildSequenceAutomaton, finishAutomatonFragment,
      childPendingEdges, sequenceEntryBridgeEdges,
      sequenceCompletingBridgeEdges, Finset.mem_union, Finset.mem_image] at hEdge
    rcases hEdge with ((hLeft | hRight) | hEntry) | hCompleting
    · rcases hLeft with ⟨childEdge, _hChildEdge, hEdgeEq⟩
      rw [← hEdgeEq] at hSource
      simp [sequenceLeftEdge, childState] at hSource
    · rcases hRight with ⟨childEdge, hChildEdge, hEdgeEq⟩
      have hChildSource := hSource
      rw [← hEdgeEq] at hChildSource
      simp [childPendingEdge, childState] at hChildSource
      exact ⟨childEdge, hChildEdge, hChildSource, hEdgeEq.symm⟩
    · split at hEntry
      · simp only [Finset.mem_image] at hEntry
        rcases hEntry with ⟨environment, _hEnvironment, hEdgeEq⟩
        rw [← hEdgeEq] at hSource
        simp [childState] at hSource
      · simp at hEntry
    · rcases hCompleting with ⟨source, _hSource, hEdgeEq⟩
      rw [← hEdgeEq] at hSource
      simp [childState] at hSource
  · rintro ⟨childEdge, hChildEdge, hChildSource, rfl⟩
    constructor
    · simp only [buildSequenceAutomaton, finishAutomatonFragment,
        childPendingEdges, Finset.mem_union, Finset.mem_image]
      exact Or.inl (Or.inl (Or.inr ⟨childEdge, hChildEdge, rfl⟩))
    · simp [childPendingEdge, childState, hChildSource]

/-- Proves visible sequence edges leaving a left-child state are either rewritten left edges or the entry bridge. -/
theorem buildSequenceAutomaton_outgoing_left_visible
    (signature : TypeAlphabet) (left right : AutomatonFragment)
    (state : TypeAutomatonState) (edge : PendingAutomatonEdge)
    {label : TypeLabel}
    (hVisible : edge.label = .visible label)
    (hOutgoing :
      edge ∈ (buildSequenceAutomaton signature left right).edges ∧
        edge.source = .child 0 state) :
    (∃ childEdge ∈ left.edges,
        childEdge.source = state ∧
          edge = sequenceLeftEdge left right childEdge) ∨
      (state = left.initial ∧ left.initial ∈ left.accepting ∧
        ∃ environment ∈ signature.localEnvironments,
          environment.clock = false ∧
            edge =
              { source := childState 0 left.initial
                environment := environment
                label := .visible TypeLabel.silent
                current := ∅
                future := .at (childState 1 right.initial) ∅
                target := childState 1 right.initial }) := by
  classical
  rcases hOutgoing with ⟨hEdge, hSource⟩
  simp only [buildSequenceAutomaton, finishAutomatonFragment,
    childPendingEdges, sequenceCompletingBridgeEdges, Finset.mem_union,
    Finset.mem_image] at hEdge
  rcases hEdge with ((hLeft | hRight) | hEntry) | hCompleting
  · rcases hLeft with ⟨childEdge, hChildEdge, hEdgeEq⟩
    have hChildSource := hSource
    rw [← hEdgeEq] at hChildSource
    simp [sequenceLeftEdge, childState] at hChildSource
    exact Or.inl ⟨childEdge, hChildEdge, hChildSource, hEdgeEq.symm⟩
  · rcases hRight with ⟨childEdge, _hChildEdge, hEdgeEq⟩
    rw [← hEdgeEq] at hSource
    simp [childPendingEdge, childState] at hSource
  · by_cases hAccepting : left.initial ∈ left.accepting
    · simp [sequenceEntryBridgeEdges, hAccepting, Finset.mem_image,
        Finset.mem_filter] at hEntry
      rcases hEntry with ⟨environment, hEnvironment, hEdgeEq⟩
      have hStateEq := hSource
      rw [← hEdgeEq] at hStateEq
      simp [childState] at hStateEq
      exact Or.inr ⟨hStateEq.symm, hAccepting, environment, hEnvironment.1,
        hEnvironment.2, hEdgeEq.symm⟩
    · simp [sequenceEntryBridgeEdges, hAccepting] at hEntry
  · rcases hCompleting with ⟨source, _hSource, hEdgeEq⟩
    have hLabel := hVisible
    rw [← hEdgeEq] at hLabel
    simp at hLabel

/-- Proves H15's future agreement for a retained left target of a sequence step. -/
lemma helper_h15_sequence_left_step_future_offers_agree
    (signature : TypeAlphabet) (left right : PactType)
    {leftTarget : PactType} {q' : TypeAutomatonState}
    (hTarget :
      relationMembership (buildRelationSet left (compileType signature left))
        leftTarget q')
    (hNonFinal : leftTarget ≠ .skip) :
    computeFutureOf signature (.seq left right) (.child 0 q') =
      typeFutureOffers (.seq leftTarget right) := by
  sorry

/-- Proves H15's future agreement for the right entry reached by a fused sequence step. -/
lemma helper_h15_sequence_left_fuse_future_offers_agree
    (signature : TypeAlphabet) (left right : PactType)
    {q' : TypeAutomatonState}
    (hTarget :
      relationMembership (buildRelationSet left (compileType signature left))
        .skip q') :
    computeFutureOf signature (.seq left right)
        (.child 1 (compileType signature right).initial) =
      typeFutureOffers right := by
  sorry

/-- Proves H15's future agreement for a right-child target of a sequence step. -/
lemma helper_h15_sequence_right_future_offers_agree
    (signature : TypeAlphabet) (left right : PactType)
    {rightTarget : PactType} {q' : TypeAutomatonState}
    (hTarget :
      relationMembership (buildRelationSet right (compileType signature right))
        rightTarget q') :
    computeFutureOf signature (.seq left right) (.child 1 q') =
      typeFutureOffers rightTarget := by
  sorry

/-- Describes the two semantic forms of a decorated sequence step. -/
inductive SeqDecoratedStepCase
    (right : PactType) (source target : PactType)
    (env : TypeEnvironment) (label : TypeLabel)
    (current future : Finset BareMessage) : Prop where
  | step (leftTarget : PactType) (childFuture : Finset BareMessage) :
      target = .seq leftTarget right →
      leftTarget ≠ .skip →
      DecoratedTypeTransition env source label
        (TypeOfferSummary.mk current childFuture) leftTarget →
      future = typeFutureOffers (.seq leftTarget right) \ current →
      SeqDecoratedStepCase right source target env label current future
  | fuse (childFuture : Finset BareMessage) :
      target = right →
      DecoratedTypeTransition env source label
        (TypeOfferSummary.mk current childFuture) .skip →
      future = typeFutureOffers right \ current →
      SeqDecoratedStepCase right source target env label current future

/-- Proves that every decorated sequence step is either retained on the left or fused into the right operand. -/
theorem decoratedTypeTransition_seq_cases
    {env : TypeEnvironment} {label : TypeLabel}
    {left right target : PactType}
    {current future : Finset BareMessage}
    (hStep :
      DecoratedTypeTransition env (.seq left right) label
        (TypeOfferSummary.mk current future) target) :
    SeqDecoratedStepCase right left target env label current future := by
  rcases hStep with ⟨hTransition, hOffers⟩
  cases hTransition with
  | seq_fuse env left right label hChildTransition =>
      have hChildOffers :
          ∃ childFuture,
            TypeOffers env left label .skip current childFuture ∧
              future = typeFutureOffers right \ current := by
        change TypeOffers env (.seq left right) label right current future at hOffers
        cases hOffers
        aesop
      rcases hChildOffers with ⟨childFuture, hChildOffers, hFuture⟩
      exact SeqDecoratedStepCase.fuse childFuture rfl
        ⟨hChildTransition, hChildOffers⟩ hFuture
  | seq env left leftTarget right label hChildTransition hNonFinal =>
      have hChildOffers :
          ∃ childFuture,
            TypeOffers env left label leftTarget current childFuture ∧
              future = typeFutureOffers (.seq leftTarget right) \ current := by
        change TypeOffers env (.seq left right) label (.seq leftTarget right)
          current future at hOffers
        cases hOffers
        aesop
      rcases hChildOffers with ⟨childFuture, hChildOffers, hFuture⟩
      exact SeqDecoratedStepCase.step leftTarget childFuture rfl hNonFinal
        ⟨hChildTransition, hChildOffers⟩ hFuture

/-- Describes the public edge families leaving a related compiled sequence state. -/
inductive SeqCompiledEdgeCase
    (signature : TypeAlphabet) (left right : PactType)
    (residual residual' : PactType)
    (state state' : TypeAutomatonState)
    (env : TypeEnvironment) (label : TypeLabel)
    (current future : Finset BareMessage) : Prop where
  | leftStep (leftResidual leftTarget : PactType)
      (q q' : TypeAutomatonState) (childFuture : Finset BareMessage) :
      residual = .seq leftResidual right →
      residual' = .seq leftTarget right →
      state = .child 0 q →
      state' = .child 0 q' →
      leftTarget ≠ .skip →
      relationMembership (buildRelationSet left (compileType signature left))
        leftResidual q →
      relationMembership (buildRelationSet left (compileType signature left))
        leftTarget q' →
      (compileType signature left).HasEdge q env label
        (TypeOfferSummary.mk current childFuture) q' →
      future = typeFutureOffers (.seq leftTarget right) \ current →
      SeqCompiledEdgeCase signature left right residual residual' state state'
        env label current future
  | leftFuse (leftResidual : PactType)
      (q q' : TypeAutomatonState) (childFuture : Finset BareMessage) :
      residual = .seq leftResidual right →
      residual' = right →
      state = .child 0 q →
      relationMembership (buildRelationSet left (compileType signature left))
        leftResidual q →
      relationMembership (buildRelationSet left (compileType signature left))
        .skip q' →
      (compileType signature left).HasEdge q env label
        (TypeOfferSummary.mk current childFuture) q' →
      future = typeFutureOffers right \ current →
      SeqCompiledEdgeCase signature left right residual residual' state state'
        env label current future
  | entryFuse :
      residual = .seq .skip right →
      residual' = right →
      state = .child 0 (compileType signature left).initial →
      state' = .child 1 (compileType signature right).initial →
      label = TypeLabel.silent →
      current = ∅ →
      future = typeFutureOffers right →
      env.WellFormed →
      env.clock = false →
      SeqCompiledEdgeCase signature left right residual residual' state state'
        env label current future
  | rightStep (q q' : TypeAutomatonState) :
      state = .child 1 q →
      state' = .child 1 q' →
      relationMembership (buildRelationSet right (compileType signature right))
        residual q →
      relationMembership (buildRelationSet right (compileType signature right))
        residual' q' →
      (compileType signature right).HasEdge q env label
        (TypeOfferSummary.mk current future) q' →
      SeqCompiledEdgeCase signature left right residual residual' state state'
        env label current future

/-- Proves a public edge from the left side of a sequence is retained or fused according to the child target. -/
lemma helper_h15_sequence_left_public_edge_cases
    (signature : TypeAlphabet) (left right : PactType)
    {leftResidual residual' : PactType}
    {q state' : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel}
    {current future : Finset BareMessage}
    (hParentSource :
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        (.seq leftResidual right) (.child 0 q))
    (hLeftSource :
      relationMembership (buildRelationSet left (compileType signature left))
        leftResidual q)
    (hEdge :
      (compileType signature (.seq left right)).HasEdge (.child 0 q) env label
        (TypeOfferSummary.mk current future) state')
    (hTarget :
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        residual' state') :
    SeqCompiledEdgeCase signature left right (.seq leftResidual right) residual'
      (.child 0 q) state' env label current future := by
  have hFutureEq :
      future = typeFutureOffers residual' \ current :=
    helper_h15_edge_future_offers_agree signature hParentSource hTarget hEdge
  sorry

/-- Lifts a non-final left-child edge to a retained public sequence edge. -/
theorem compileType_seq_lift_left_step
    (signature : TypeAlphabet) (left right : PactType)
    {leftResidual leftTarget : PactType}
    {q q' : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel}
    {current childFuture : Finset BareMessage}
    (hParentSource :
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        (.seq leftResidual right) (.child 0 q))
    (_hSource :
      relationMembership (buildRelationSet left (compileType signature left))
        leftResidual q)
    (hTarget :
      relationMembership (buildRelationSet left (compileType signature left))
        leftTarget q')
    (hNonFinal : leftTarget ≠ .skip)
    (hChildStep :
      DecoratedTypeTransition env leftResidual label
        (TypeOfferSummary.mk current childFuture) leftTarget)
    (hParentSymbol :
      TypeAutomatonSymbol.mk env label
        (TypeOfferSummary.mk current
          (typeFutureOffers (.seq leftTarget right) \ current)) ∈
        signature.transitionAlphabet)
    (hChildEdge :
      (compileType signature left).HasEdge q env label
        (TypeOfferSummary.mk current childFuture) q') :
    (compileType signature (.seq left right)).HasEdge (.child 0 q) env label
        (TypeOfferSummary.mk current
          (typeFutureOffers (.seq leftTarget right) \ current)) (.child 0 q') ∧
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        (.seq leftTarget right) (.child 0 q') := by
  have hChildSymbol := compileType_hasEdge_symbol_mem signature left hChildEdge
  have hChildResolved :=
    (compileType_hasEdge_iff_hasResolvedEdge signature left q q' env label
      (TypeOfferSummary.mk current childFuture) hChildSymbol).mp hChildEdge
  rcases hChildResolved with ⟨pendingEdge, hPendingMem, hPendingSource,
    hPendingEnv, hPendingLabel, hPendingCurrent, _hPendingFuture,
    hPendingTarget⟩
  have hNotAccepting :
      q' ∉ (compileTypeFuel signature (typeCompilationFuel left) left).accepting := by
    intro hAccepting
    have hAccepting' : q' ∈ (compileType signature left).accepting := by
      simpa [compileType] using hAccepting
    exact hNonFinal
      ((helper_h13_final_states_represent_completion signature hTarget).mp
        hAccepting')
  have hSeqFuture :=
    helper_h15_sequence_left_step_future_offers_agree signature left right
      hTarget hNonFinal
  have hParentEdge :
      (compileType signature (.seq left right)).HasEdge (.child 0 q) env label
        (TypeOfferSummary.mk current
          (typeFutureOffers (.seq leftTarget right) \ current))
        (.child 0 q') := by
    rw [compileType_hasEdge_iff_hasResolvedEdge signature (.seq left right)
      (.child 0 q) (.child 0 q') env label
      (TypeOfferSummary.mk current
        (typeFutureOffers (.seq leftTarget right) \ current)) hParentSymbol]
    rw [compileTypeFuel_sequence_eq_build signature left right]
    refine ⟨sequenceLeftEdge
      (compileTypeFuel signature (typeCompilationFuel left) left)
      (compileTypeFuel signature (typeCompilationFuel right) right)
      pendingEdge, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp only [buildSequenceAutomaton, finishAutomatonFragment,
        Finset.mem_union, Finset.mem_image]
      exact Or.inl (Or.inl (Or.inl ⟨pendingEdge, hPendingMem, rfl⟩))
    · simp [sequenceLeftEdge, childState, hPendingSource]
    · simp [sequenceLeftEdge, hPendingEnv]
    · simp [sequenceLeftEdge, hPendingLabel]
    · simp [sequenceLeftEdge, hPendingCurrent]
    · have hSeqFuture' :
          computeFutureOf signature (.seq left right) (childState 0 q') =
            typeFutureOffers (.seq leftTarget right) := by
        simpa [childState] using hSeqFuture
      simp [sequenceLeftEdge, hPendingLabel, hPendingCurrent,
        hPendingTarget, sequenceRedirect_of_not_accepting hNotAccepting,
        hSeqFuture']
    · simp [sequenceLeftEdge, childState, hPendingTarget,
        sequenceRedirect_of_not_accepting hNotAccepting]
  have hParentStep :
      DecoratedTypeTransition env (.seq leftResidual right) label
        (TypeOfferSummary.mk current
          (typeFutureOffers (.seq leftTarget right) \ current))
        (.seq leftTarget right) :=
    ⟨TypeTransition.seq env leftResidual leftTarget right label hChildStep.1
        hNonFinal,
      TypeOffers.seq env leftResidual leftTarget right label current childFuture
        hChildStep.2 hNonFinal⟩
  refine ⟨hParentEdge, ?_⟩
  exact relationMembership_of_step_edge_unique (.seq left right)
    (compileType signature (.seq left right)) hParentSource hParentEdge
    hParentStep
    (fun target hTargetStep =>
      decoratedTypeTransition_target_unique hTargetStep hParentStep)

/-- Lifts a final left-child edge to the redirected public sequence edge. -/
theorem compileType_seq_lift_left_fuse
    (signature : TypeAlphabet) (left right : PactType)
    {leftResidual : PactType}
    {q q' : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel}
    {current childFuture : Finset BareMessage}
    (hParentSource :
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        (.seq leftResidual right) (.child 0 q))
    (_hSource :
      relationMembership (buildRelationSet left (compileType signature left))
        leftResidual q)
    (hTarget :
      relationMembership (buildRelationSet left (compileType signature left))
        .skip q')
    (hChildStep :
      DecoratedTypeTransition env leftResidual label
        (TypeOfferSummary.mk current childFuture) .skip)
    (hParentSymbol :
      TypeAutomatonSymbol.mk env label
        (TypeOfferSummary.mk current (typeFutureOffers right \ current)) ∈
        signature.transitionAlphabet)
    (hChildEdge :
      (compileType signature left).HasEdge q env label
        (TypeOfferSummary.mk current childFuture) q') :
    (compileType signature (.seq left right)).HasEdge (.child 0 q) env label
        (TypeOfferSummary.mk current (typeFutureOffers right \ current))
        (.child 1 (compileType signature right).initial) ∧
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        right (.child 1 (compileType signature right).initial) := by
  have hChildSymbol := compileType_hasEdge_symbol_mem signature left hChildEdge
  have hChildResolved :=
    (compileType_hasEdge_iff_hasResolvedEdge signature left q q' env label
      (TypeOfferSummary.mk current childFuture) hChildSymbol).mp hChildEdge
  rcases hChildResolved with ⟨pendingEdge, hPendingMem, hPendingSource,
    hPendingEnv, hPendingLabel, hPendingCurrent, _hPendingFuture,
    hPendingTarget⟩
  have hAccepting :
      q' ∈ (compileTypeFuel signature (typeCompilationFuel left) left).accepting := by
    have hAccepting' : q' ∈ (compileType signature left).accepting :=
      (helper_h13_final_states_represent_completion signature hTarget).mpr rfl
    simpa [compileType] using hAccepting'
  have hSeqFuture :=
    helper_h15_sequence_left_fuse_future_offers_agree signature left right hTarget
  have hParentEdge :
      (compileType signature (.seq left right)).HasEdge (.child 0 q) env label
        (TypeOfferSummary.mk current (typeFutureOffers right \ current))
        (.child 1 (compileType signature right).initial) := by
    rw [compileType_hasEdge_iff_hasResolvedEdge signature (.seq left right)
      (.child 0 q) (.child 1 (compileType signature right).initial) env label
      (TypeOfferSummary.mk current (typeFutureOffers right \ current))
      hParentSymbol]
    rw [compileTypeFuel_sequence_eq_build signature left right]
    refine ⟨sequenceLeftEdge
      (compileTypeFuel signature (typeCompilationFuel left) left)
      (compileTypeFuel signature (typeCompilationFuel right) right)
      pendingEdge, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp only [buildSequenceAutomaton, finishAutomatonFragment,
        Finset.mem_union, Finset.mem_image]
      exact Or.inl (Or.inl (Or.inl ⟨pendingEdge, hPendingMem, rfl⟩))
    · simp [sequenceLeftEdge, childState, hPendingSource]
    · simp [sequenceLeftEdge, hPendingEnv]
    · simp [sequenceLeftEdge, hPendingLabel]
    · simp [sequenceLeftEdge, hPendingCurrent]
    · have hSeqFuture' :
          computeFutureOf signature (.seq left right)
              (childState 1
                (compileTypeFuel signature (typeCompilationFuel right) right).initial) =
            typeFutureOffers right := by
        simpa [compileType, childState] using hSeqFuture
      simp [sequenceLeftEdge, hPendingLabel, hPendingCurrent,
        hPendingTarget, sequenceRedirect_of_accepting hAccepting,
        hSeqFuture']
    · simp [sequenceLeftEdge, compileType, childState, hPendingTarget,
        sequenceRedirect_of_accepting hAccepting]
  have hParentStep :
      DecoratedTypeTransition env (.seq leftResidual right) label
        (TypeOfferSummary.mk current (typeFutureOffers right \ current))
        right :=
    ⟨TypeTransition.seq_fuse env leftResidual right label hChildStep.1,
      TypeOffers.seq_fuse env leftResidual right label current childFuture
        hChildStep.2⟩
  refine ⟨hParentEdge, ?_⟩
  exact relationMembership_of_step_edge_unique (.seq left right)
    (compileType signature (.seq left right)) hParentSource hParentEdge
    hParentStep
    (fun target hTargetStep =>
      decoratedTypeTransition_target_unique hTargetStep hParentStep)

/-- Lifts a right-child edge to a copied public sequence edge. -/
theorem compileType_seq_lift_right_step
    (signature : TypeAlphabet) (left right : PactType)
    {rightResidual rightTarget : PactType}
    {q q' : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel}
    {offers : TypeOfferSummary}
    (hParentSource :
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        rightResidual (.child 1 q))
    (_hSource :
      relationMembership (buildRelationSet right (compileType signature right))
        rightResidual q)
    (_hTarget :
      relationMembership (buildRelationSet right (compileType signature right))
        rightTarget q')
    (hChildStep :
      DecoratedTypeTransition env rightResidual label offers rightTarget)
    (hChildEdge :
      (compileType signature right).HasEdge q env label offers q') :
    ∃ state',
      (compileType signature (.seq left right)).HasEdge (.child 1 q) env label
        offers state' ∧
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        rightTarget state' := by
  have hChildSymbol := compileType_hasEdge_symbol_mem signature right hChildEdge
  have hChildResolved :=
    (compileType_hasEdge_iff_hasResolvedEdge signature right q q' env label
      offers hChildSymbol).mp hChildEdge
  rcases hChildResolved with ⟨pendingEdge, hPendingMem, hPendingSource,
    hPendingEnv, hPendingLabel, hPendingCurrent, hPendingFuture,
    hPendingTarget⟩
  have hParentEdge :
      (compileType signature (.seq left right)).HasEdge (.child 1 q) env label
        offers (.child 1 q') := by
    rw [compileType_hasEdge_iff_hasResolvedEdge signature (.seq left right)
      (.child 1 q) (.child 1 q') env label offers hChildSymbol]
    rw [compileTypeFuel_sequence_eq_build signature left right]
    refine ⟨childPendingEdge 1 pendingEdge, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp only [buildSequenceAutomaton, finishAutomatonFragment,
        childPendingEdges, Finset.mem_union, Finset.mem_image]
      exact Or.inl (Or.inl (Or.inr ⟨pendingEdge, hPendingMem, rfl⟩))
    · simp [childPendingEdge, childState, hPendingSource]
    · simp [childPendingEdge, hPendingEnv]
    · simp [childPendingEdge, hPendingLabel]
    · simp [childPendingEdge, hPendingCurrent]
    · cases hSpec : pendingEdge.future with
      | explicit future =>
          simpa [childPendingEdge, childFutureSpec, hSpec] using
            hPendingFuture
      | «at» futureTarget removed =>
          have hStateMem := compileTypeFuel_futureTargetsInStates signature
            (typeCompilationFuel right) right le_rfl pendingEdge hPendingMem
            futureTarget removed hSpec
          have hSeqFuture :=
            computeFutureOf_sequence_right signature left right futureTarget
              hStateMem
          have hSeqFuture' :
              computeFutureOf signature (.seq left right)
                  (childState 1 futureTarget) =
                computeFutureOf signature right futureTarget := by
            simpa [childState] using hSeqFuture
          simpa [childPendingEdge, childFutureSpec, hSpec, hSeqFuture'] using
            hPendingFuture
    · simp [childPendingEdge, childState, hPendingTarget]
  refine ⟨.child 1 q', hParentEdge, ?_⟩
  exact relationMembership_of_step_edge_unique (.seq left right)
    (compileType signature (.seq left right)) hParentSource hParentEdge
    hChildStep
    (fun target hTargetStep =>
      decoratedTypeTransition_target_unique hTargetStep hChildStep)

/-- Proves an automaton edge's target is uniquely determined by its full decorated symbol. -/
lemma compileType_hasEdge_target_unique
    (signature : TypeAlphabet) (processType : PactType)
    {source target target' : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel} {offers : TypeOfferSummary}
    (hEdge : (compileType signature processType).HasEdge source env label offers
      target)
    (hEdge' : (compileType signature processType).HasEdge source env label offers
      target') :
    target = target' := by
  sorry

/-- Proves every related sequence pair has the sequence shape, given the forward direction of the left child's own step correspondence. -/
lemma relationMembership_seq_cases
    (signature : TypeAlphabet) (left right : PactType)
    (hLeftForward :
      ∀ {residual' : PactType} {q1 : TypeAutomatonState} {env : TypeEnvironment}
        {label : TypeLabel} {offers : TypeOfferSummary} {target : PactType},
        relationMembership (buildRelationSet left (compileType signature left))
          residual' q1 →
        (TypeAutomatonSymbol.mk env label offers ∈
          (compileType signature left).alphabet) →
        DecoratedTypeTransition env residual' label offers target →
        ∃ q1', (compileType signature left).HasEdge q1 env label offers q1' ∧
          relationMembership (buildRelationSet left (compileType signature left))
            target q1')
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        residual state) :
    seqRelationShape signature left right (residual, state) := by
  have hWhole :
      compileTypeFuel signature (typeCompilationFuel (.seq left right))
        (.seq left right) =
        buildSequenceAutomaton signature
          (compileTypeFuel signature (typeCompilationFuel left) left)
          (compileTypeFuel signature (typeCompilationFuel right) right) :=
    compileTypeFuel_sequence_eq_build signature left right
  have hInit : (compileType signature (.seq left right)).initial =
      .child 0 (compileType signature left).initial := by
    show (compileTypeFuel signature (typeCompilationFuel (.seq left right))
      (.seq left right)).initial = .child 0 (compileTypeFuel signature
        (typeCompilationFuel left) left).initial
    rw [hWhole]
    simp [buildSequenceAutomaton, finishAutomatonFragment, childState]
  have hResult :=
    buildRelationSet_preserves (.seq left right)
    (compileType signature (.seq left right))
    (fun entry =>
      relationMembership
        (buildRelationSet (.seq left right) (compileType signature (.seq left right)))
        entry.1 entry.2 ∧
      seqRelationShape signature left right entry)
    (by
      refine ⟨buildRelationSet_initial (.seq left right)
        (compileType signature (.seq left right)), ?_⟩
      show seqRelationShape signature left right
        (.seq left right, (compileType signature (.seq left right)).initial)
      rw [hInit]
      exact Or.inl ⟨(compileType signature left).initial, left, rfl,
        buildRelationSet_initial left (compileType signature left)⟩)
    (by
      intro entry hEntryAnd successor hSuccessor
      obtain ⟨hEntryMem, hEntry⟩ := hEntryAnd
      have hSuccessorMem :
          relationMembership
            (buildRelationSet (.seq left right)
              (compileType signature (.seq left right))) successor.1 successor.2 :=
        buildRelationSet_saturated (.seq left right)
          (compileType signature (.seq left right)) entry hEntryMem hSuccessor
      refine ⟨hSuccessorMem, ?_⟩
      rcases relationSuccessors_mem_cases (compileType signature (.seq left right))
        entry successor hSuccessor with ⟨edge, hEdgeMem, hSource, hTarget, hStep⟩
      have hSymbolMem := compileType_hasEdge_symbol_mem signature (.seq left right)
        (show (compileType signature (.seq left right)).HasEdge edge.source
          edge.symbol.environment edge.symbol.label edge.symbol.offers edge.target
          from hEdgeMem)
      have hResolved := (compileType_hasEdge_iff_hasResolvedEdge signature
        (.seq left right) edge.source edge.target edge.symbol.environment
        edge.symbol.label edge.symbol.offers hSymbolMem).mp hEdgeMem
      rw [hWhole] at hResolved
      obtain ⟨pendingEdge, hPendingMem, hPSource, hPEnv, hPLabel, hPCurrent, hPFuture,
        hPTarget⟩ := hResolved
      rcases hEntry with ⟨q1, residualLeft, hEntryEq, hMem⟩ | ⟨q2, hStateEq, hMem⟩
      · -- entry retains a left state, representing `residualLeft ; right`
        have hEntry1 : entry.1 = .seq residualLeft right := by rw [hEntryEq]
        have hEntry2 : entry.2 = .child 0 q1 := by rw [hEntryEq]
        have hParentSource :
            relationMembership
              (buildRelationSet (.seq left right)
                (compileType signature (.seq left right)))
              (.seq residualLeft right) (.child 0 q1) := by
          rw [← hEntry1, ← hEntry2]; exact hEntryMem
        rw [hEntry1] at hStep
        cases decoratedTypeTransition_seq_cases hStep with
        | step leftTarget childFuture hTargetEq' hNonFinal hChildStep hFutureEq =>
            -- Given a genuine left-child step, we need the left forward
            -- direction to find the matching left edge and target relation.
            have hOuterMem :
                TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
                    edge.symbol.offers ∈ signature.transitionAlphabet := by
              simpa [compileType] using hSymbolMem
            have hParentSymbol :
                TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
                    (TypeOfferSummary.mk edge.symbol.offers.current
                      (typeFutureOffers (.seq leftTarget right) \
                        edge.symbol.offers.current)) ∈
                  signature.transitionAlphabet := by
              rw [← hFutureEq]; exact hOuterMem
            have hChildSymbol :
                TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
                    (TypeOfferSummary.mk edge.symbol.offers.current childFuture) ∈
                  (compileType signature left).alphabet := by
              change TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
                  (TypeOfferSummary.mk edge.symbol.offers.current childFuture) ∈
                signature.transitionAlphabet
              refine transitionAlphabet_of_typeOffers_target_subset signature
                hOuterMem hChildStep.2 ?_
              rw [hFutureEq]
              exact typeFutureOffers_subset_sequence_left_sdiff_union
                leftTarget right edge.symbol.offers.current
            obtain ⟨q1', hChildEdge, hChildTargetRelated⟩ :=
              hLeftForward hMem hChildSymbol hChildStep
            obtain ⟨hParentEdge, -⟩ :=
              compileType_seq_lift_left_step signature left right hParentSource hMem
                hChildTargetRelated hNonFinal hChildStep hParentSymbol hChildEdge
            have hOuterEdge :
                (compileType signature (.seq left right)).HasEdge entry.2
                  edge.symbol.environment edge.symbol.label edge.symbol.offers
                  successor.2 := by
              rw [← hSource, hTarget]; exact hEdgeMem
            have hSuccessorEq : successor.2 = .child 0 q1' := by
              apply compileType_hasEdge_target_unique signature (.seq left right)
                hOuterEdge
              rw [hEntry2, show edge.symbol.offers = TypeOfferSummary.mk
                edge.symbol.offers.current edge.symbol.offers.future from rfl, hFutureEq]
              exact hParentEdge
            exact Or.inl ⟨q1', leftTarget, Prod.ext hTargetEq' hSuccessorEq,
              hChildTargetRelated⟩
        | fuse childFuture hTargetEq' hChildStep hFutureEq =>
            -- Given a fused left-child step, we need the left forward
            -- direction to find the matching left edge into `skip`.
            have hOuterMem :
                TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
                    edge.symbol.offers ∈ signature.transitionAlphabet := by
              simpa [compileType] using hSymbolMem
            have hChildSymbol :
                TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
                    (TypeOfferSummary.mk edge.symbol.offers.current childFuture) ∈
                  (compileType signature left).alphabet := by
              change TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
                  (TypeOfferSummary.mk edge.symbol.offers.current childFuture) ∈
                signature.transitionAlphabet
              exact transitionAlphabet_of_typeOffers_target_subset signature
                hOuterMem hChildStep.2
                (by simp [typeFutureOffers, typeFutureOffersFuel])
            obtain ⟨q1', hChildEdge, hChildTargetRelated⟩ :=
              hLeftForward hMem hChildSymbol hChildStep
            have hParentSymbol :
                TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
                    (TypeOfferSummary.mk edge.symbol.offers.current
                      (typeFutureOffers right \ edge.symbol.offers.current)) ∈
                  signature.transitionAlphabet := by
              rw [← hFutureEq]; exact hOuterMem
            obtain ⟨hParentEdge, -⟩ :=
              compileType_seq_lift_left_fuse signature left right hParentSource hMem
                hChildTargetRelated hChildStep hParentSymbol hChildEdge
            have hOuterEdge :
                (compileType signature (.seq left right)).HasEdge entry.2
                  edge.symbol.environment edge.symbol.label edge.symbol.offers
                  successor.2 := by
              rw [← hSource, hTarget]; exact hEdgeMem
            have hSuccessorEq : successor.2 = .child 1
                (compileType signature right).initial := by
              apply compileType_hasEdge_target_unique signature (.seq left right)
                hOuterEdge
              rw [hEntry2, show edge.symbol.offers = TypeOfferSummary.mk
                edge.symbol.offers.current edge.symbol.offers.future from rfl, hFutureEq]
              exact hParentEdge
            exact Or.inr ⟨(compileType signature right).initial, hSuccessorEq,
              hTargetEq' ▸ buildRelationSet_initial right (compileType signature right)⟩
      · -- entry is a right state, representing its own relation's residual
        have hEntry2 : entry.2 = .child 1 q2 := by rw [hStateEq]
        have hChildSource : pendingEdge.source = .child 1 q2 := by
          rw [hPSource, hSource, hEntry2]
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildSequenceAutomaton_outgoing_right signature
            (compileTypeFuel signature (typeCompilationFuel left) left)
            (compileTypeFuel signature (typeCompilationFuel right) right)
            q2 pendingEdge).mp ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature right).HasEdge q2
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature right q2
            childEdge.target edge.symbol.environment edge.symbol.label
            edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel right) right le_rfl childEdge hChildEdgeMem t r
                  hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_sequence_right signature left right t hStateMem]
        have hTargetEq : successor.2 = .child 1 childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique right (compileType signature right)
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr ⟨childEdge.target, hTargetEq, hInnerMem⟩)
  exact (hResult (residual, state) hRelated).2

/-- Proves every public sequence edge leaving a related state belongs to one of the sequence edge families. -/
theorem compileType_seq_edge_cases
    (signature : TypeAlphabet) (left right : PactType)
    (hLeftForward :
      ∀ {residual' : PactType} {q1 : TypeAutomatonState} {env : TypeEnvironment}
        {label : TypeLabel} {offers : TypeOfferSummary} {target : PactType},
        relationMembership (buildRelationSet left (compileType signature left))
          residual' q1 →
        (TypeAutomatonSymbol.mk env label offers ∈
          (compileType signature left).alphabet) →
        DecoratedTypeTransition env residual' label offers target →
        ∃ q1', (compileType signature left).HasEdge q1 env label offers q1' ∧
          relationMembership (buildRelationSet left (compileType signature left))
            target q1')
    {residual residual' : PactType}
    {state state' : TypeAutomatonState}
    {env : TypeEnvironment} {label : TypeLabel}
    {current future : Finset BareMessage}
    (hRelated :
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        residual state)
    (hEdge :
      (compileType signature (.seq left right)).HasEdge state env label
        (TypeOfferSummary.mk current future) state')
    (hTarget :
      relationMembership
        (buildRelationSet (.seq left right)
          (compileType signature (.seq left right)))
        residual' state') :
    SeqCompiledEdgeCase signature left right residual residual' state state'
      env label current future := by
  rcases relationMembership_seq_cases signature left right hLeftForward hRelated with
    hLeft | hRight
  · rcases hLeft with ⟨q, leftResidual, hEntry, hLeftRelated⟩
    cases hEntry
    exact helper_h15_sequence_left_public_edge_cases signature left right
      hRelated hLeftRelated hEdge hTarget
  · rcases hRight with ⟨q, hState, hRightRelated⟩
    simp only at hState hRightRelated
    subst state
    have hSymbol := compileType_hasEdge_symbol_mem signature (.seq left right)
      hEdge
    have hResolved :=
      (compileType_hasEdge_iff_hasResolvedEdge signature (.seq left right)
        (.child 1 q) state' env label (TypeOfferSummary.mk current future)
        hSymbol).mp hEdge
    rw [compileTypeFuel_sequence_eq_build signature left right] at hResolved
    rcases hResolved with ⟨pendingEdge, hPendingMem, hPendingSource,
      hPendingEnv, hPendingLabel, hPendingCurrent, hPendingFuture,
      hPendingTarget⟩
    obtain ⟨childEdge, hChildEdgeMem, hChildSource, hChildEdgeEq⟩ :=
      (buildSequenceAutomaton_outgoing_right signature
        (compileTypeFuel signature (typeCompilationFuel left) left)
        (compileTypeFuel signature (typeCompilationFuel right) right)
        q pendingEdge).mp ⟨hPendingMem, hPendingSource⟩
    have hTargetState : state' = .child 1 childEdge.target := by
      rw [← hPendingTarget, hChildEdgeEq]
      rfl
    have hRightTargetRelated :
        relationMembership (buildRelationSet right (compileType signature right))
          residual' childEdge.target := by
      rcases relationMembership_seq_cases signature left right hLeftForward hTarget with
        hTargetLeft | hTargetRight
      · rcases hTargetLeft with ⟨qLeft, leftResidual, hEntry, _hLeftTarget⟩
        have hStateEq := congrArg Prod.snd hEntry
        exfalso
        rw [hTargetState] at hStateEq
        cases hStateEq
      · rcases hTargetRight with ⟨qTarget, hTargetEq, hRightTarget⟩
        have hQ : qTarget = childEdge.target := by
          rw [hTargetState] at hTargetEq
          cases hTargetEq
          rfl
        subst qTarget
        exact hRightTarget
    have hChildEdge :
        (compileType signature right).HasEdge q env label
          (TypeOfferSummary.mk current future) childEdge.target := by
      rw [compileType_hasEdge_iff_hasResolvedEdge signature right q
        childEdge.target env label (TypeOfferSummary.mk current future)
        hSymbol]
      refine ⟨childEdge, hChildEdgeMem, hChildSource, ?_, ?_, ?_, ?_, rfl⟩
      · rw [← hPendingEnv, hChildEdgeEq]
        rfl
      · rw [← hPendingLabel, hChildEdgeEq]
        rfl
      · rw [← hPendingCurrent, hChildEdgeEq]
        rfl
      · cases hSpec : childEdge.future with
        | explicit offers =>
            simpa [hChildEdgeEq, childPendingEdge, childFutureSpec, hSpec]
              using hPendingFuture
        | «at» futureTarget removed =>
            have hStateMem := compileTypeFuel_futureTargetsInStates signature
              (typeCompilationFuel right) right le_rfl childEdge hChildEdgeMem
              futureTarget removed hSpec
            have hSeqFuture :=
              computeFutureOf_sequence_right signature left right futureTarget
                hStateMem
            have hSeqFuture' :
                computeFutureOf signature (.seq left right)
                    (childState 1 futureTarget) =
                  computeFutureOf signature right futureTarget := by
              simpa [childState] using hSeqFuture
            simpa [hChildEdgeEq, childPendingEdge, childFutureSpec, hSpec,
              hSeqFuture'] using hPendingFuture
    exact SeqCompiledEdgeCase.rightStep q childEdge.target rfl hTargetState
      hRightRelated hRightTargetRelated hChildEdge

/-- Describes the two semantic forms of a decorated parallel step. -/
inductive ParDecoratedStepCase
    (left right : PactType) (interface : Interface) (target : PactType)
    (env : TypeEnvironment) (label : TypeLabel)
    (current future : Finset BareMessage) : Prop where
  | step (leftEnv rightEnv : TypeEnvironment) (leftLabel rightLabel : TypeLabel)
      (leftTarget rightTarget : PactType)
      (leftCurrent leftFuture rightCurrent rightFuture : Finset BareMessage) :
      target = .par leftTarget rightTarget interface →
      ¬ (leftTarget = .skip ∧ rightTarget = .skip) →
      DecoratedTypeTransition leftEnv left leftLabel
        (TypeOfferSummary.mk leftCurrent leftFuture) leftTarget →
      DecoratedTypeTransition rightEnv right rightLabel
        (TypeOfferSummary.mk rightCurrent rightFuture) rightTarget →
      env.WellFormed →
      LocalTypeEnvironment env interface rightEnv right rightLabel leftEnv →
      LocalTypeEnvironment env interface leftEnv left leftLabel rightEnv →
      TypeLabel.Sync interface leftLabel rightLabel →
      label = TypeLabel.combine interface leftLabel rightLabel →
      current = hideTypeOffers interface (leftCurrent ∪ rightCurrent) →
      future = hideTypeOffers interface (leftFuture ∪ rightFuture) →
      ParDecoratedStepCase left right interface target env label current future
  | fuse (leftEnv rightEnv : TypeEnvironment) (leftLabel rightLabel : TypeLabel)
      (leftCurrent leftFuture rightCurrent rightFuture : Finset BareMessage) :
      target = .skip →
      DecoratedTypeTransition leftEnv left leftLabel
        (TypeOfferSummary.mk leftCurrent leftFuture) .skip →
      DecoratedTypeTransition rightEnv right rightLabel
        (TypeOfferSummary.mk rightCurrent rightFuture) .skip →
      env.WellFormed →
      LocalTypeEnvironment env interface rightEnv right rightLabel leftEnv →
      LocalTypeEnvironment env interface leftEnv left leftLabel rightEnv →
      TypeLabel.Sync interface leftLabel rightLabel →
      label = TypeLabel.combine interface leftLabel rightLabel →
      current = hideTypeOffers interface (leftCurrent ∪ rightCurrent) →
      future = hideTypeOffers interface (leftFuture ∪ rightFuture) →
      ParDecoratedStepCase left right interface target env label current future

/-- The witness environments and labels `TypeTransition.par`/`TypeTransition.par_fuse`
and `TypeOffers.par`/`TypeOffers.par_fuse` each independently choose for the
same decorated parallel step agree. The paper's own `T-Par` rule never faces
this ambiguity: it derives one step together with its offer pair `Off(ρ,α,ρ')`
from a single derivation, choosing `E1`/`E2` once. Splitting that single
judgment into two separate Lean inductives (as done uniformly throughout,
matching every other constructor, where it is harmless since their shared
`env` argument is never independently re-derived) leaves `.par` as the one
constructor whose *nested* per-side environments are genuinely re-quantified
by each inductive, so recovering the paper's "chosen once" reading needs
this explicit bridge. -/
theorem par_witnesses_agree
    {env : TypeEnvironment} {left right leftTarget rightTarget : PactType}
    {interface : Interface} {leftEnv rightEnv leftEnv' rightEnv' : TypeEnvironment}
    {leftLabel rightLabel leftLabel' rightLabel' : TypeLabel}
    {leftCurrent leftFuture rightCurrent rightFuture : Finset BareMessage}
    (hLeftTrans : TypeTransition leftEnv left leftLabel leftTarget)
    (hRightTrans : TypeTransition rightEnv right rightLabel rightTarget)
    (hWF : env.WellFormed)
    (hLocal1 : LocalTypeEnvironment env interface rightEnv right rightLabel leftEnv)
    (hLocal2 : LocalTypeEnvironment env interface leftEnv left leftLabel rightEnv)
    (hSync : TypeLabel.Sync interface leftLabel rightLabel)
    (hLeftOffers : TypeOffers leftEnv' left leftLabel' leftTarget leftCurrent leftFuture)
    (hRightOffers : TypeOffers rightEnv' right rightLabel' rightTarget rightCurrent rightFuture)
    (hWF' : env.WellFormed)
    (hLocal1' : LocalTypeEnvironment env interface rightEnv' right rightLabel' leftEnv')
    (hLocal2' : LocalTypeEnvironment env interface leftEnv' left leftLabel' rightEnv')
    (hSync' : TypeLabel.Sync interface leftLabel' rightLabel')
    (hCombineEq :
      TypeLabel.combine interface leftLabel rightLabel =
        TypeLabel.combine interface leftLabel' rightLabel') :
    leftEnv = leftEnv' ∧ rightEnv = rightEnv' ∧ leftLabel = leftLabel' ∧
      rightLabel = rightLabel' := by
  sorry

/-- Proves that every decorated parallel step either retains both components or fuses them once both complete. -/
theorem decoratedTypeTransition_par_cases
    {env : TypeEnvironment} {label : TypeLabel}
    {left right target : PactType} {interface : Interface}
    {current future : Finset BareMessage}
    (hStep :
      DecoratedTypeTransition env (.par left right interface) label
        (TypeOfferSummary.mk current future) target) :
    ParDecoratedStepCase left right interface target env label current future := by
  rcases hStep with ⟨hTransition, hOffers⟩
  cases hTransition with
  | par _ leftEnv rightEnv _ _ leftTarget _ rightTarget leftLabel rightLabel
      hLeftTrans hRightTrans hNonFinal hSide =>
      obtain ⟨hWF, hLocal1, hLocal2, hSync⟩ := hSide
      change TypeOffers env (.par left right interface)
        (TypeLabel.combine interface leftLabel rightLabel)
        (.par leftTarget rightTarget interface) current future at hOffers
      generalize hCombineEq :
        TypeLabel.combine interface leftLabel rightLabel = actualLabel at hOffers
      cases hOffers with
      | par _ leftEnv' rightEnv' _ _ _ _ _ leftLabel' rightLabel'
          leftCurrent leftFuture rightCurrent rightFuture
          hLeftOffers hRightOffers _hNonFinal' hLocal1' hLocal2' hWFSync' =>
          obtain ⟨hWF', hSync'⟩ := hWFSync'
          obtain ⟨hEnvEq1, hEnvEq2, hLabelEq1, hLabelEq2⟩ :=
            par_witnesses_agree hLeftTrans hRightTrans hWF hLocal1 hLocal2 hSync
              hLeftOffers hRightOffers hWF' hLocal1' hLocal2' hSync' hCombineEq
          subst hEnvEq1; subst hEnvEq2; subst hLabelEq1; subst hLabelEq2
          exact ParDecoratedStepCase.step leftEnv rightEnv leftLabel rightLabel leftTarget
            rightTarget leftCurrent leftFuture rightCurrent rightFuture rfl hNonFinal
            ⟨hLeftTrans, hLeftOffers⟩ ⟨hRightTrans, hRightOffers⟩ hWF hLocal1 hLocal2 hSync
            hCombineEq rfl rfl
  | par_fuse _ leftEnv rightEnv _ _ _ leftLabel rightLabel
      hLeftTrans hRightTrans hSide =>
      obtain ⟨hWF, hLocal1, hLocal2, hSync⟩ := hSide
      change TypeOffers env (.par left right interface)
        (TypeLabel.combine interface leftLabel rightLabel) .skip current future at hOffers
      generalize hCombineEq :
        TypeLabel.combine interface leftLabel rightLabel = actualLabel at hOffers
      cases hOffers with
      | par_fuse _ leftEnv' rightEnv' _ _ _ leftLabel' rightLabel'
          leftCurrent leftFuture rightCurrent rightFuture
          hLeftOffers hRightOffers hLocal1' hLocal2' hWFSync' =>
          obtain ⟨hWF', hSync'⟩ := hWFSync'
          obtain ⟨hEnvEq1, hEnvEq2, hLabelEq1, hLabelEq2⟩ :=
            par_witnesses_agree hLeftTrans hRightTrans hWF hLocal1 hLocal2 hSync
              hLeftOffers hRightOffers hWF' hLocal1' hLocal2' hSync' hCombineEq
          subst hEnvEq1; subst hEnvEq2; subst hLabelEq1; subst hLabelEq2
          exact ParDecoratedStepCase.fuse leftEnv rightEnv leftLabel rightLabel leftCurrent
            leftFuture rightCurrent rightFuture rfl ⟨hLeftTrans, hLeftOffers⟩
            ⟨hRightTrans, hRightOffers⟩ hWF hLocal1 hLocal2 hSync hCombineEq rfl rfl

/-- Automaton-level counterpart of `T-Par`/`T-Par-Fuse`: a compiled edge out
of a product state exists exactly when the two components admit synchronized
decorated steps under the shared interface, using the semantic rule's own
`LocalTypeEnvironment`/`Sync` side conditions verbatim. Packages the whole
gap between `buildParallelAutomaton`'s locally-resolved synchronized-edge
construction and the native (`computeFutureOf`-based) `HasEdge` view
`StepIffStatement`'s goals are stated in, mirroring `T-Par` directly rather
than exposing `syncAutomatonEdges`'s internal witness machinery. Note that the `LocalTypeEnvironment` side conditions are stated over
whatever sibling `PactType` (`childLeft`/`childRight`) the caller's
residuals happen to be, not over the outer, fixed `left`/`right` the
automaton was compiled for — `T-Par` is a rule about the *current* residual
at every step, not only the initial one, and the compiled child automata
`compileType signature left`/`compileType signature right` are shared
across every residual reachable inside them. `childLeft`/`childRight` come
bundled with a relation-membership witness at `q1`/`q2` precisely so a
caller who already knows some other residual relates to `q1`/`q2` can pin
`childLeft`/`childRight` down via `relationMembership_functional`, rather
than being stuck comparing two independently-existentially-chosen
`PactType`s. -/
theorem buildParallelAutomaton_pair_hasEdge_iff
    (signature : TypeAlphabet) (left right : PactType) (interface : Interface)
    (q1 q2 target : TypeAutomatonState) (env : TypeEnvironment)
    (label : TypeLabel) (offers : TypeOfferSummary) :
    (compileType signature (.par left right interface)).HasEdge
        (.pair q1 q2) env label offers target ↔
      ∃ (childLeft childRight : PactType)
        (leftEnv rightEnv : TypeEnvironment) (leftLabel rightLabel : TypeLabel)
        (leftOffers rightOffers : TypeOfferSummary) (q1' q2' : TypeAutomatonState),
        (compileType signature left).HasEdge q1 leftEnv leftLabel leftOffers q1' ∧
        (compileType signature right).HasEdge q2 rightEnv rightLabel rightOffers q2' ∧
        relationMembership (buildRelationSet left (compileType signature left))
          childLeft q1 ∧
        relationMembership (buildRelationSet right (compileType signature right))
          childRight q2 ∧
        env.WellFormed ∧
        LocalTypeEnvironment env interface rightEnv childRight rightLabel leftEnv ∧
        LocalTypeEnvironment env interface leftEnv childLeft leftLabel rightEnv ∧
        TypeLabel.Sync interface leftLabel rightLabel ∧
        label = TypeLabel.combine interface leftLabel rightLabel ∧
        offers.current =
          hideTypeOffers interface (leftOffers.current ∪ rightOffers.current) ∧
        offers.future =
          hideTypeOffers interface (leftOffers.future ∪ rightOffers.future) ∧
        -- Mirrors the compiler's own redirect: a raw target whose both sides
        -- are accepting (H13: exactly when both children finish) is placed
        -- in `q_done`, never left as its own separate `.pair` state.
        (if q1' ∈ (compileType signature left).accepting ∧
            q2' ∈ (compileType signature right).accepting then
          target = TypeAutomatonState.final
        else target = .pair q1' q2') := by
  sorry

/-- The `q_done` state's own outgoing edges are exactly the non-clock silent
idle self-loop, mirroring `.final`'s identical role in every atomic base
case (`.message`, `.tock`, `.progress`). -/
theorem buildParallelAutomaton_final_hasEdge_iff
    (signature : TypeAlphabet) (left right : PactType) (interface : Interface)
    (env : TypeEnvironment) (label : TypeLabel) (offers : TypeOfferSummary)
    (target : TypeAutomatonState) :
    (compileType signature (.par left right interface)).HasEdge
        TypeAutomatonState.final env label offers target ↔
      env.WellFormed ∧ env.clock = false ∧ label = TypeLabel.silent ∧
      offers = TypeOfferSummary.mk ∅ ∅ ∧ target = TypeAutomatonState.final := by
  sorry

/-- Proves each parallel component's own offer pair remains in its own
transition alphabet whenever the combined, interface-hidden parent symbol
is in the fixed alphabet, mirroring `transitionAlphabet_of_typeOffers_target_subset`
for `.par`'s two-sided hiding pattern (which changes both the current and
future components, unlike `.seq`'s future-only pattern that lemma covers). -/
theorem transitionAlphabet_of_par_component
    (signature : TypeAlphabet) (left right : PactType) (interface : Interface)
    {leftEnv rightEnv : TypeEnvironment} {leftLabel rightLabel : TypeLabel}
    {leftCurrent leftFuture rightCurrent rightFuture : Finset BareMessage}
    {env : TypeEnvironment} {label : TypeLabel}
    (hWF : env.WellFormed)
    (hLocal1 : LocalTypeEnvironment env interface rightEnv right rightLabel leftEnv)
    (hLocal2 : LocalTypeEnvironment env interface leftEnv left leftLabel rightEnv)
    (hSync : TypeLabel.Sync interface leftLabel rightLabel)
    (hLabelEq : label = TypeLabel.combine interface leftLabel rightLabel)
    (hSymbol :
      TypeAutomatonSymbol.mk env label
        (TypeOfferSummary.mk (hideTypeOffers interface (leftCurrent ∪ rightCurrent))
          (hideTypeOffers interface (leftFuture ∪ rightFuture))) ∈
        signature.transitionAlphabet) :
    TypeAutomatonSymbol.mk leftEnv leftLabel
        (TypeOfferSummary.mk leftCurrent leftFuture) ∈
      signature.transitionAlphabet ∧
    TypeAutomatonSymbol.mk rightEnv rightLabel
        (TypeOfferSummary.mk rightCurrent rightFuture) ∈
      signature.transitionAlphabet := by
  sorry

/-- Every accepting state of a compiled fragment is related to `skip` — the
converse direction of H13's characterization. Needed when a `.par` redirect
edge's target is already pinned (by the compiler's own construction) to a
pair of accepting states, without any pre-existing `relationMembership`
witness at that specific pair to read H13 off of directly. -/
theorem relationMembership_of_accepting
    (signature : TypeAlphabet) (processType : PactType) {state : TypeAutomatonState}
    (hAccept : state ∈ (compileType signature processType).accepting) :
    relationMembership (buildRelationSet processType (compileType signature processType))
      PactType.skip state := by
  sorry

/-- Defines the related-state shape for a compiled parallel product,
mirroring `pactproofs.typ`'s own "Related states" bullets verbatim: a
product state represents the pointwise composition, or the dedicated
`q_done` state (`.final`) represents `skip` once both components finish. -/
def parRelationShape
    (signature : TypeAlphabet) (left right : PactType) (interface : Interface)
    (entry : PactType × TypeAutomatonState) : Prop :=
  (∃ q1 q2 residualLeft residualRight,
      entry = (.par residualLeft residualRight interface, .pair q1 q2) ∧
      relationMembership (buildRelationSet left (compileType signature left))
        residualLeft q1 ∧
      relationMembership (buildRelationSet right (compileType signature right))
        residualRight q2) ∨
    entry = (PactType.skip, TypeAutomatonState.final)

/-- Proves every related parallel pair has the parallel shape. -/
lemma relationMembership_par_cases
    (signature : TypeAlphabet) (left right : PactType) (interface : Interface)
    (hLeftForward :
      ∀ {residual' : PactType} {q1 : TypeAutomatonState} {env : TypeEnvironment}
        {label : TypeLabel} {offers : TypeOfferSummary} {target : PactType},
        relationMembership (buildRelationSet left (compileType signature left))
          residual' q1 →
        (TypeAutomatonSymbol.mk env label offers ∈
          (compileType signature left).alphabet) →
        DecoratedTypeTransition env residual' label offers target →
        ∃ q1', (compileType signature left).HasEdge q1 env label offers q1' ∧
          relationMembership (buildRelationSet left (compileType signature left))
            target q1')
    (hRightForward :
      ∀ {residual' : PactType} {q2 : TypeAutomatonState} {env : TypeEnvironment}
        {label : TypeLabel} {offers : TypeOfferSummary} {target : PactType},
        relationMembership (buildRelationSet right (compileType signature right))
          residual' q2 →
        (TypeAutomatonSymbol.mk env label offers ∈
          (compileType signature right).alphabet) →
        DecoratedTypeTransition env residual' label offers target →
        ∃ q2', (compileType signature right).HasEdge q2 env label offers q2' ∧
          relationMembership (buildRelationSet right (compileType signature right))
            target q2')
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership
        (buildRelationSet (.par left right interface)
          (compileType signature (.par left right interface)))
        residual state) :
    parRelationShape signature left right interface (residual, state) := by
  have hFuelEq : typeCompilationFuel (.par left right interface) =
      max (typeCompilationFuel left) (typeCompilationFuel right) + 1 := by
    simp only [typeCompilationFuel]; omega
  have hWhole :
      compileTypeFuel signature (typeCompilationFuel (.par left right interface))
        (.par left right interface) =
        buildParallelAutomaton signature interface
          (compileTypeFuel signature (typeCompilationFuel left) left)
          (compileTypeFuel signature (typeCompilationFuel right) right) := by
    rw [hFuelEq]
    show buildParallelAutomaton signature interface
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) left)
        (compileTypeFuel signature
          (max (typeCompilationFuel left) (typeCompilationFuel right)) right) =
      buildParallelAutomaton signature interface
        (compileTypeFuel signature (typeCompilationFuel left) left)
        (compileTypeFuel signature (typeCompilationFuel right) right)
    congr 1
    · exact compileTypeFuel_eq_of_sufficient signature left (le_max_left _ _) le_rfl
    · exact compileTypeFuel_eq_of_sufficient signature right (le_max_right _ _) le_rfl
  have hInit : (compileType signature (.par left right interface)).initial =
      .pair (compileType signature left).initial (compileType signature right).initial := by
    show (compileTypeFuel signature (typeCompilationFuel (.par left right interface))
      (.par left right interface)).initial = _
    rw [hWhole]
    simp only [buildParallelAutomaton, finishAutomatonFragment]
    rfl
  have hResult :=
    buildRelationSet_preserves (.par left right interface)
    (compileType signature (.par left right interface))
    (fun entry =>
      relationMembership
        (buildRelationSet (.par left right interface)
          (compileType signature (.par left right interface)))
        entry.1 entry.2 ∧
      parRelationShape signature left right interface entry)
    (by
      refine ⟨buildRelationSet_initial (.par left right interface)
        (compileType signature (.par left right interface)), ?_⟩
      show parRelationShape signature left right interface
        (.par left right interface,
          (compileType signature (.par left right interface)).initial)
      rw [hInit]
      exact Or.inl ⟨(compileType signature left).initial,
        (compileType signature right).initial, left, right, rfl,
        buildRelationSet_initial left (compileType signature left),
        buildRelationSet_initial right (compileType signature right)⟩)
    (by
      intro entry hEntryAnd successor hSuccessor
      obtain ⟨hEntryMem, hEntry⟩ := hEntryAnd
      have hSuccessorMem :
          relationMembership
            (buildRelationSet (.par left right interface)
              (compileType signature (.par left right interface)))
            successor.1 successor.2 :=
        buildRelationSet_saturated (.par left right interface)
          (compileType signature (.par left right interface)) entry hEntryMem hSuccessor
      refine ⟨hSuccessorMem, ?_⟩
      rcases relationSuccessors_mem_cases (compileType signature (.par left right interface))
        entry successor hSuccessor with ⟨edge, hEdgeMem, hSource, hTarget, hStep⟩
      have hSymbolMem := compileType_hasEdge_symbol_mem signature (.par left right interface)
        (show (compileType signature (.par left right interface)).HasEdge edge.source
          edge.symbol.environment edge.symbol.label edge.symbol.offers edge.target
          from hEdgeMem)
      have hOuterMem :
          TypeAutomatonSymbol.mk edge.symbol.environment edge.symbol.label
              edge.symbol.offers ∈ signature.transitionAlphabet := by
        simpa [compileType] using hSymbolMem
      have hOuterEdge :
          (compileType signature (.par left right interface)).HasEdge entry.2
            edge.symbol.environment edge.symbol.label edge.symbol.offers successor.2 := by
        rw [← hSource, hTarget]; exact hEdgeMem
      rw [show edge.symbol.offers = TypeOfferSummary.mk edge.symbol.offers.current
        edge.symbol.offers.future from rfl] at hStep hOuterMem hOuterEdge
      rcases hEntry with
        ⟨q1, q2, residualLeft, residualRight, hEntryEq, hLeftRelated, hRightRelated⟩ | hEntryEq
      · -- general product case: `entry` represents `.par residualLeft residualRight interface`
        have hEntry1 : entry.1 = .par residualLeft residualRight interface := by rw [hEntryEq]
        have hEntry2 : entry.2 = .pair q1 q2 := by rw [hEntryEq]
        rw [hEntry1] at hStep
        rw [hEntry2] at hOuterEdge
        cases decoratedTypeTransition_par_cases hStep with
        | step leftEnv rightEnv leftLabel rightLabel leftTarget rightTarget
            leftCurrent leftFuture rightCurrent rightFuture hTargetEq hNonFinal
            hLeftStep hRightStep hWF hLocal1 hLocal2 hSync hLabelEq hCurrentEq hFutureEq =>
            obtain ⟨hLeftSymbolMem0, hRightSymbolMem0⟩ :=
              transitionAlphabet_of_par_component signature residualLeft residualRight
                interface hWF hLocal1 hLocal2 hSync hLabelEq
                (hCurrentEq ▸ hFutureEq ▸ hOuterMem)
            have hLeftSymbolMem :
                TypeAutomatonSymbol.mk leftEnv leftLabel
                  (TypeOfferSummary.mk leftCurrent leftFuture) ∈
                  (compileType signature left).alphabet := by
              simpa [compileType] using hLeftSymbolMem0
            have hRightSymbolMem :
                TypeAutomatonSymbol.mk rightEnv rightLabel
                  (TypeOfferSummary.mk rightCurrent rightFuture) ∈
                  (compileType signature right).alphabet := by
              simpa [compileType] using hRightSymbolMem0
            obtain ⟨q1', hLeftEdge, hLeftTargetRelated⟩ :=
              hLeftForward hLeftRelated hLeftSymbolMem hLeftStep
            obtain ⟨q2', hRightEdge, hRightTargetRelated⟩ :=
              hRightForward hRightRelated hRightSymbolMem hRightStep
            -- H13: at least one of `q1'`/`q2'` is not accepting, since a
            -- child remains (`hNonFinal`), so the compiler does not redirect.
            have hNotBothAccept :
                ¬ (q1' ∈ (compileType signature left).accepting ∧
                   q2' ∈ (compileType signature right).accepting) := by
              rintro ⟨hAccept1, hAccept2⟩
              exact hNonFinal
                ⟨(helper_h13_final_states_represent_completion signature
                    hLeftTargetRelated).mp hAccept1,
                  (helper_h13_final_states_represent_completion signature
                    hRightTargetRelated).mp hAccept2⟩
            have hConstructedEdge :
                (compileType signature (.par left right interface)).HasEdge
                  (.pair q1 q2) edge.symbol.environment edge.symbol.label
                  (TypeOfferSummary.mk edge.symbol.offers.current
                    edge.symbol.offers.future) (.pair q1' q2') := by
              rw [buildParallelAutomaton_pair_hasEdge_iff]
              refine ⟨residualLeft, residualRight, leftEnv, rightEnv, leftLabel, rightLabel,
                TypeOfferSummary.mk leftCurrent leftFuture,
                TypeOfferSummary.mk rightCurrent rightFuture, q1', q2',
                hLeftEdge, hRightEdge, hLeftRelated, hRightRelated, hWF, hLocal1, hLocal2,
                hSync, hLabelEq, hCurrentEq, hFutureEq, ?_⟩
              simp [hNotBothAccept]
            have hSuccessorEq : successor.2 = .pair q1' q2' :=
              compileType_hasEdge_target_unique signature (.par left right interface)
                hOuterEdge hConstructedEdge
            exact Or.inl ⟨q1', q2', leftTarget, rightTarget, Prod.ext hTargetEq hSuccessorEq,
              hLeftTargetRelated, hRightTargetRelated⟩
        | fuse leftEnv rightEnv leftLabel rightLabel leftCurrent leftFuture rightCurrent
            rightFuture hTargetEq hLeftStep hRightStep hWF hLocal1 hLocal2 hSync hLabelEq
            hCurrentEq hFutureEq =>
            obtain ⟨hLeftSymbolMem0, hRightSymbolMem0⟩ :=
              transitionAlphabet_of_par_component signature residualLeft residualRight
                interface hWF hLocal1 hLocal2 hSync hLabelEq
                (hCurrentEq ▸ hFutureEq ▸ hOuterMem)
            have hLeftSymbolMem :
                TypeAutomatonSymbol.mk leftEnv leftLabel
                  (TypeOfferSummary.mk leftCurrent leftFuture) ∈
                  (compileType signature left).alphabet := by
              simpa [compileType] using hLeftSymbolMem0
            have hRightSymbolMem :
                TypeAutomatonSymbol.mk rightEnv rightLabel
                  (TypeOfferSummary.mk rightCurrent rightFuture) ∈
                  (compileType signature right).alphabet := by
              simpa [compileType] using hRightSymbolMem0
            obtain ⟨q1', hLeftEdge, hLeftTargetRelated⟩ :=
              hLeftForward hLeftRelated hLeftSymbolMem hLeftStep
            obtain ⟨q2', hRightEdge, hRightTargetRelated⟩ :=
              hRightForward hRightRelated hRightSymbolMem hRightStep
            -- H13: both children finish here, so the compiler redirects to `q_done`.
            have hBothAccept :
                q1' ∈ (compileType signature left).accepting ∧
                q2' ∈ (compileType signature right).accepting :=
              ⟨(helper_h13_final_states_represent_completion signature
                  hLeftTargetRelated).mpr rfl,
                (helper_h13_final_states_represent_completion signature
                  hRightTargetRelated).mpr rfl⟩
            have hConstructedEdge :
                (compileType signature (.par left right interface)).HasEdge
                  (.pair q1 q2) edge.symbol.environment edge.symbol.label
                  (TypeOfferSummary.mk edge.symbol.offers.current
                    edge.symbol.offers.future) TypeAutomatonState.final := by
              rw [buildParallelAutomaton_pair_hasEdge_iff]
              refine ⟨residualLeft, residualRight, leftEnv, rightEnv, leftLabel, rightLabel,
                TypeOfferSummary.mk leftCurrent leftFuture,
                TypeOfferSummary.mk rightCurrent rightFuture, q1', q2',
                hLeftEdge, hRightEdge, hLeftRelated, hRightRelated, hWF, hLocal1, hLocal2,
                hSync, hLabelEq, hCurrentEq, hFutureEq, ?_⟩
              simp [hBothAccept]
            have hSuccessorEq : successor.2 = TypeAutomatonState.final :=
              compileType_hasEdge_target_unique signature (.par left right interface)
                hOuterEdge hConstructedEdge
            exact Or.inr (Prod.ext hTargetEq hSuccessorEq)
      · -- `q_done` case: `entry` already represents `skip` at the dedicated
        -- done state; its only public edge is the non-clock silent idle
        -- self-loop, which the atomic `skip` step matches directly
        -- (paper's "Forward direction at the done state").
        have hEntry1 : entry.1 = PactType.skip := by rw [hEntryEq]
        have hEntry2 : entry.2 = TypeAutomatonState.final := by rw [hEntryEq]
        rw [hEntry1] at hStep
        rw [hEntry2] at hOuterEdge
        rw [buildParallelAutomaton_final_hasEdge_iff] at hOuterEdge
        obtain ⟨hWF, hClock, hLabelEqDone, hOffersEqDone, hSuccessorEq⟩ := hOuterEdge
        rw [hLabelEqDone, hOffersEqDone] at hStep
        have hSkipStep : DecoratedTypeTransition edge.symbol.environment .skip
            TypeLabel.silent (TypeOfferSummary.mk ∅ ∅) PactType.skip :=
          ⟨TypeTransition.skip edge.symbol.environment ⟨hWF, hClock⟩,
            TypeOffers.skip edge.symbol.environment ⟨hWF, hClock⟩⟩
        have hSuccessor1Eq : successor.1 = PactType.skip :=
          decoratedTypeTransition_target_unique hStep hSkipStep
        exact Or.inr (Prod.ext hSuccessor1Eq hSuccessorEq))
    (residual, state) hRelated
  exact hResult.2

/-- Defines the related-state shape for a compiled recursion: the root represents `μX.body`, a copied body state represents its residual substituted for `X`. -/
def recurRelationShape
    (signature : TypeAlphabet) (name : String) (body : PactType)
    (entry : PactType × TypeAutomatonState) : Prop :=
  entry = (.recur name body, TypeAutomatonState.root) ∨
    (∃ q residual,
      entry = (residual.replaceVar name (.recur name body), .child 0 q) ∧
      relationMembership (buildRelationSet body (compileType signature body))
        residual q)

/-- Proves every related recursion pair has the recursion shape. -/
lemma relationMembership_recur_cases
    (signature : TypeAlphabet) (name : String) (body : PactType)
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership
        (buildRelationSet (.recur name body)
          (compileType signature (.recur name body)))
        residual state) :
    recurRelationShape signature name body (residual, state) := by
  have hFuelEq : typeCompilationFuel (.recur name body) = typeCompilationFuel body + 1 := by
    simp only [typeCompilationFuel]; omega
  have hWhole :
      compileTypeFuel signature (typeCompilationFuel (.recur name body))
        (.recur name body) =
        buildRecursionAutomaton signature name
          (compileTypeFuel signature (typeCompilationFuel body) body) := by
    rw [hFuelEq]
    show buildRecursionAutomaton signature name
        (compileTypeFuel signature (typeCompilationFuel body) body) =
      buildRecursionAutomaton signature name
        (compileTypeFuel signature (typeCompilationFuel body) body)
    rfl
  have hInit : (compileType signature (.recur name body)).initial =
      TypeAutomatonState.root := by
    show (compileTypeFuel signature (typeCompilationFuel (.recur name body))
      (.recur name body)).initial = TypeAutomatonState.root
    rw [hWhole]
    simp [buildRecursionAutomaton, finishAutomatonFragment]
  refine buildRelationSet_preserves (.recur name body)
    (compileType signature (.recur name body))
    (recurRelationShape signature name body)
    (by
      show recurRelationShape signature name body
        (.recur name body, (compileType signature (.recur name body)).initial)
      rw [hInit]; exact Or.inl rfl)
    (by
      intro entry hEntry successor hSuccessor
      rcases relationSuccessors_mem_cases (compileType signature (.recur name body))
        entry successor hSuccessor with ⟨edge, hEdgeMem, hSource, hTarget, hStep⟩
      have hSymbolMem := compileType_hasEdge_symbol_mem signature (.recur name body)
        (show (compileType signature (.recur name body)).HasEdge edge.source
          edge.symbol.environment edge.symbol.label edge.symbol.offers edge.target
          from hEdgeMem)
      have hResolved := (compileType_hasEdge_iff_hasResolvedEdge signature
        (.recur name body) edge.source edge.target edge.symbol.environment
        edge.symbol.label edge.symbol.offers hSymbolMem).mp hEdgeMem
      rw [hWhole] at hResolved
      obtain ⟨pendingEdge, hPendingMem, hPSource, hPEnv, hPLabel, hPCurrent, hPFuture,
        hPTarget⟩ := hResolved
      rcases hEntry with hRoot | ⟨q, bodyResidual, hEntryEq, hMem⟩
      · -- root case: entry represents `μX.body` itself
        have hRootSource : pendingEdge.source = TypeAutomatonState.root := by
          rw [hPSource, hSource, hRoot]
        simp only [buildRecursionAutomaton, finishAutomatonFragment, Finset.mem_union,
          Finset.mem_image] at hPendingMem
        rcases hPendingMem with ⟨environment, _, hEq⟩ | ⟨bodyEdge, _, hEq⟩
        · subst hEq
          simp only [childState] at hPTarget
          have hEntry1 : entry.1 = .recur name body := by rw [hRoot]
          rw [hEntry1] at hStep
          obtain ⟨hTrans, -⟩ := hStep
          generalize hTargetEq : successor.1 = actualTarget at hTrans
          generalize hLabelEq2 : edge.symbol.label = actualLabel at hTrans
          cases hTrans
          have hTargetEq2 : successor.2 = .child 0
              (compileTypeFuel signature (typeCompilationFuel body) body).initial := by
            rw [hTarget, ← hPTarget]
          refine Or.inr ⟨(compileTypeFuel signature (typeCompilationFuel body)
            body).initial, body, ?_,
            buildRelationSet_initial body (compileType signature body)⟩
          rw [← hTargetEq, ← hTargetEq2]
        · exfalso
          rw [← hEq] at hRootSource
          split at hRootSource <;> simp [childState] at hRootSource
      · -- child case: entry is already related to `q` inside `body`'s own relation
        have hEntry2 : entry.2 = .child 0 q := by rw [hEntryEq]
        have hChildSource : pendingEdge.source = .child 0 q := by
          rw [hPSource, hSource, hEntry2]
        simp only [buildRecursionAutomaton, finishAutomatonFragment, Finset.mem_union,
          Finset.mem_image] at hPendingMem
        rcases hPendingMem with ⟨environment, _, hEq⟩ | ⟨bodyEdge, hBodyEdgeMem, hEq⟩
        · exfalso
          rw [← hEq] at hChildSource
          simp at hChildSource
        · have hEntry1 : entry.1 = bodyResidual.replaceVar name (.recur name body) := by
            rw [hEntryEq]
          by_cases hMarker : bodyEdge.label = .variable name
          · -- marker edge: reduces to the same unfolding step as the root
            simp only [hMarker, if_true] at hEq
            subst hEq
            simp only [childState] at hPSource hPTarget
            have hSourceEq : bodyEdge.source = q := by
              simpa [childState] using hChildSource
            have hResidualEq : bodyResidual = .var name :=
              compileTypeFuel_marker_represents_var signature name body hMem
                hBodyEdgeMem hSourceEq hMarker
            rw [hEntry1, hResidualEq] at hStep
            simp only [PactType.replaceVar] at hStep
            obtain ⟨hTrans, -⟩ := hStep
            generalize hTargetEq : successor.1 = actualTarget at hTrans
            generalize hLabelEq2 : edge.symbol.label = actualLabel at hTrans
            cases hTrans
            have hTargetEq2 : successor.2 = .child 0
                (compileTypeFuel signature (typeCompilationFuel body) body).initial := by
              rw [hTarget, ← hPTarget]
            refine Or.inr ⟨(compileTypeFuel signature (typeCompilationFuel body)
              body).initial, body, ?_,
              buildRelationSet_initial body (compileType signature body)⟩
            rw [← hTargetEq, ← hTargetEq2]
          · -- copied non-marker edge: bridges to body's own relation
            simp only [hMarker, if_false] at hEq
            subst hEq
            simp only [childState] at hPSource hPTarget
            have hSourceEq : bodyEdge.source = q := by
              simpa [childState] using hChildSource
            have hInnerEdgeMem : (compileType signature body).HasEdge q
                edge.symbol.environment edge.symbol.label edge.symbol.offers
                bodyEdge.target := by
              rw [compileType_hasEdge_iff_hasResolvedEdge signature body q
                bodyEdge.target edge.symbol.environment edge.symbol.label
                edge.symbol.offers hSymbolMem]
              refine ⟨bodyEdge, hBodyEdgeMem, hSourceEq, ?_, ?_, ?_, ?_, rfl⟩
              · rw [← hPEnv]
              · rw [← hPLabel]
              · rw [← hPCurrent]
              · rw [← hPFuture]
                cases hSpec : bodyEdge.future with
                | explicit offers => simp [childFutureSpec, hSpec]
                | «at» t r =>
                    have hStateMem := compileTypeFuel_futureTargetsInStates signature
                      (typeCompilationFuel body) body le_rfl bodyEdge hBodyEdgeMem t r
                      hSpec
                    simp only [childFutureSpec, hSpec, childState]
                    rw [computeFutureOf_recursion_child signature name body
                      (.recur name body) hWhole (by omega) t hStateMem]
            rw [hEntry1] at hStep
            obtain ⟨bodyResidual', hSuccessorEq, hStep'⟩ :=
              (decoratedTypeTransition_replaceVar_iff name body bodyResidual).mp hStep
            have hTargetEq : successor.2 = .child 0 bodyEdge.target := by
              rw [hTarget, ← hPTarget]
            have hInnerMem :=
              relationMembership_of_step_edge_unique body (compileType signature body)
                hMem hInnerEdgeMem hStep'
                (fun target hTargetStep =>
                  decoratedTypeTransition_target_unique hTargetStep hStep')
            exact Or.inr ⟨bodyEdge.target, bodyResidual', by
              rw [← hSuccessorEq, ← hTargetEq], hInnerMem⟩)
    (residual, state) hRelated

/-- Defines the related-state shape for a compiled exclusive offer: the root represents the whole offer, a tagged child represents its own relation's residual, else or branch. -/
def xofferRelationShape
    (signature : TypeAlphabet) (elseType : PactType)
    (branches : List (BareMessage × PactType))
    (entry : PactType × TypeAutomatonState) : Prop :=
  entry = (.xoffer elseType branches, TypeAutomatonState.root) ∨
    (∃ q, entry.2 = .child 0 q ∧
      relationMembership
        (buildRelationSet elseType (compileType signature elseType))
        entry.1 q) ∨
    (∃ i action branchType q,
      branches[i]? = some (action, branchType) ∧
      entry.2 = .child (i + 1) q ∧
      relationMembership
        (buildRelationSet branchType (compileType signature branchType))
        entry.1 q)

set_option maxHeartbeats 4000000 in
/-- Proves every related exclusive-offer pair has the exclusive-offer shape. -/
lemma relationMembership_xoffer_cases
    (signature : TypeAlphabet) (elseType : PactType)
    (branches : List (BareMessage × PactType))
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership
        (buildRelationSet (.xoffer elseType branches)
          (compileType signature (.xoffer elseType branches)))
        residual state) :
    xofferRelationShape signature elseType branches (residual, state) := by
  have hElseFuel : typeCompilationFuel elseType ≤
      typeCompilationFuel (.xoffer elseType branches) := by
    simp only [typeCompilationFuel]; omega
  have hElseFuelStrict : typeCompilationFuel elseType + 1 ≤
      typeCompilationFuel (.xoffer elseType branches) := by
    simp only [typeCompilationFuel]; omega
  have hBranchFuel : ∀ branch ∈ branches,
      typeCompilationFuel branch.2 ≤ typeCompilationFuel (.xoffer elseType branches) := by
    intro branch hBranch
    have h1 := typeCompilationFuel_le_typeBranchCompilationFuel branches branch hBranch
    simp only [typeCompilationFuel]; omega
  have hBranchFuelStrict : ∀ branch ∈ branches,
      typeCompilationFuel branch.2 + 1 ≤
        typeCompilationFuel (.xoffer elseType branches) := by
    intro branch hBranch
    have h1 := typeCompilationFuel_le_typeBranchCompilationFuel branches branch hBranch
    simp only [typeCompilationFuel]; omega
  have hFuelEq : typeCompilationFuel (.xoffer elseType branches) =
      max (typeCompilationFuel elseType) (typeBranchCompilationFuel branches) + 1 := by
    simp only [typeCompilationFuel]; omega
  have hWhole :
      compileTypeFuel signature (typeCompilationFuel (.xoffer elseType branches))
        (.xoffer elseType branches) =
        buildExclusiveOfferAutomaton signature branches
          (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
          (branches.map fun branch => (branch.1, compileTypeFuel signature
            (typeCompilationFuel branch.2) branch.2)) := by
    rw [hFuelEq]
    show buildExclusiveOfferAutomaton signature branches
        (compileTypeFuel signature
          (max (typeCompilationFuel elseType) (typeBranchCompilationFuel branches)) elseType)
        (branches.map fun branch => (branch.1, compileTypeFuel signature
          (max (typeCompilationFuel elseType) (typeBranchCompilationFuel branches))
          branch.2)) =
      buildExclusiveOfferAutomaton signature branches
        (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
        (branches.map fun branch => (branch.1, compileTypeFuel signature
          (typeCompilationFuel branch.2) branch.2))
    congr 1
    · exact compileTypeFuel_eq_of_sufficient signature elseType (le_max_left _ _) le_rfl
    · apply List.map_congr_left
      intro branch hBranch
      congr 1
      exact compileTypeFuel_eq_of_sufficient signature branch.2
        (le_trans (typeCompilationFuel_le_typeBranchCompilationFuel branches branch hBranch)
          (le_max_right _ _)) le_rfl
  have hInit : (compileType signature (.xoffer elseType branches)).initial =
      TypeAutomatonState.root := by
    show (compileTypeFuel signature (typeCompilationFuel (.xoffer elseType branches))
      (.xoffer elseType branches)).initial = TypeAutomatonState.root
    rw [hWhole]
    simp [buildExclusiveOfferAutomaton, finishAutomatonFragment]
  have hRootRelated : relationMembership
      (buildRelationSet (.xoffer elseType branches)
        (compileType signature (.xoffer elseType branches)))
      (.xoffer elseType branches) TypeAutomatonState.root := by
    rw [← hInit]
    exact buildRelationSet_initial (.xoffer elseType branches)
      (compileType signature (.xoffer elseType branches))
  have hRootFuture : computeFutureOf signature (.xoffer elseType branches)
      TypeAutomatonState.root = typeFutureOffers (.xoffer elseType branches) :=
    helper_h15_future_offers_agree signature hRootRelated
  refine buildRelationSet_preserves (.xoffer elseType branches)
    (compileType signature (.xoffer elseType branches))
    (xofferRelationShape signature elseType branches)
    (by
      show xofferRelationShape signature elseType branches
        (.xoffer elseType branches,
          (compileType signature (.xoffer elseType branches)).initial)
      rw [hInit]; exact Or.inl rfl)
    (by
      intro entry hEntry successor hSuccessor
      rcases relationSuccessors_mem_cases (compileType signature (.xoffer elseType branches))
        entry successor hSuccessor with ⟨edge, hEdgeMem, hSource, hTarget, hStep⟩
      have hSymbolMem := compileType_hasEdge_symbol_mem signature (.xoffer elseType branches)
        (show (compileType signature (.xoffer elseType branches)).HasEdge edge.source
          edge.symbol.environment edge.symbol.label edge.symbol.offers edge.target
          from hEdgeMem)
      have hResolved := (compileType_hasEdge_iff_hasResolvedEdge signature
        (.xoffer elseType branches) edge.source edge.target edge.symbol.environment
        edge.symbol.label edge.symbol.offers hSymbolMem).mp hEdgeMem
      rw [hWhole] at hResolved
      obtain ⟨pendingEdge, hPendingMem, hPSource, hPEnv, hPLabel, hPCurrent, hPFuture,
        hPTarget⟩ := hResolved
      rcases hEntry with hRoot |
        ⟨q, hStateEq, hMem⟩ |
        ⟨i, action, branchType, q, hBranchesEq, hStateEq, hMem⟩
      · -- root case: entry represents the whole exclusive offer; the three
        -- root-edge families reconstruct the matching semantic offer rule.
        have hEntry1 : entry.1 = .xoffer elseType branches := by rw [hRoot]
        have hRootSource : pendingEdge.source = TypeAutomatonState.root := by
          rw [hPSource, hSource, hRoot]
        simp only [buildExclusiveOfferAutomaton, finishAutomatonFragment, Finset.mem_union]
          at hPendingMem
        rcases hPendingMem with ((((hElse | hIndexed) | hBranch) | hWait) | hResolved2)
        · exfalso
          simp only [childPendingEdges, Finset.mem_image] at hElse
          obtain ⟨childEdge, _, hEq⟩ := hElse
          rw [← hEq] at hRootSource
          simp [childPendingEdge, childState] at hRootSource
        · exfalso
          rw [indexedFragmentEdges, mem_foldl_union_iff] at hIndexed
          rcases hIndexed with hEmpty | ⟨indexed, _, hNewEdge⟩
          · simp at hEmpty
          · simp only [childPendingEdges, Finset.mem_image] at hNewEdge
            obtain ⟨childEdge, _, hEq⟩ := hNewEdge
            rw [← hEq] at hRootSource
            simp [childPendingEdge, childState] at hRootSource
        · -- fire family: reconstructs `xoffer_branch`
          rw [mem_foldl_union_iff] at hBranch
          rcases hBranch with hEmpty | ⟨indexed, hIndexedEntry, hNewEdge⟩
          · simp at hEmpty
          · simp only [Finset.mem_image, Finset.mem_filter] at hNewEdge
            obtain ⟨⟨branchAction, automaton⟩, index⟩ := indexed
            rcases hNewEdge with ⟨environment, ⟨hEnvMem, hEnabled, hResolvedNeeds⟩, rfl⟩
            have hIndexedGet :
                (branches.map fun branch => (branch.1, compileTypeFuel signature
                  (typeCompilationFuel branch.2) branch.2))[index]? =
                  some (branchAction, automaton) :=
              List.mk_mem_zipIdx_iff_getElem?.mp hIndexedEntry
            obtain ⟨branchType', hBranchGet, hAutEq⟩ :=
              (branches_map_getElem?_eq_some_iff signature branches index branchAction
                automaton).mp hIndexedGet
            have hWF : environment.WellFormed :=
              localEnvironment_wellFormed signature hEnvMem
            have hBranchMem : (branchAction, branchType') ∈ branches :=
              List.mem_iff_getElem?.mpr ⟨index, hBranchGet⟩
            simp only [childState] at hPLabel hPCurrent hPFuture hPTarget
            have hLabelEq : edge.symbol.label = TypeLabel.message branchAction.1
                branchAction.2 := by injection hPLabel.symm
            have hCurrentEq : edge.symbol.offers.current = {branchAction} := hPCurrent.symm
            have hFutureEq : edge.symbol.offers.future = typeFutureOffers branchType' := by
              rw [← hPFuture, ← hAutEq, computeFutureOf_exclusiveOffer_branch signature
                elseType branches (.xoffer elseType branches) hWhole index branchAction
                branchType' hBranchGet (hBranchFuelStrict (branchAction, branchType')
                  hBranchMem) (compileTypeFuel signature (typeCompilationFuel branchType')
                  branchType').initial (compileTypeFuel_initial_mem signature
                  (typeCompilationFuel branchType') branchType' le_rfl), Finset.sdiff_empty]
              show computeFutureOf signature branchType' (compileType signature
                branchType').initial = typeFutureOffers branchType'
              exact helper_h15_future_offers_agree signature
                (buildRelationSet_initial branchType' (compileType signature branchType'))
            have hOffersEq : edge.symbol.offers = TypeOfferSummary.mk {branchAction}
                (typeFutureOffers branchType') := by
              rw [show edge.symbol.offers = TypeOfferSummary.mk
                edge.symbol.offers.current edge.symbol.offers.future from rfl,
                hCurrentEq, hFutureEq]
            have hResidualEq : successor.1 = branchType' := by
              rw [hEntry1] at hStep
              rw [hLabelEq, hOffersEq] at hStep
              exact decoratedTypeTransition_target_unique hStep
                (hPEnv ▸ ⟨TypeTransition.xoffer_branch environment elseType branches
                  branchAction branchType'
                  ⟨hWF, hBranchMem, hEnabled, hResolvedNeeds⟩,
                  TypeOffers.xoffer_branch environment elseType branches
                    branchAction branchType'
                    ⟨hWF, hBranchMem, hEnabled, hResolvedNeeds⟩⟩)
            have hTargetEq : successor.2 = .child (index + 1)
                (compileTypeFuel signature (typeCompilationFuel branchType')
                  branchType').initial := by
              rw [hTarget, ← hPTarget, ← hAutEq]
            exact Or.inr (Or.inr ⟨index, branchAction, branchType',
              (compileTypeFuel signature (typeCompilationFuel branchType') branchType').initial,
              hBranchGet, hTargetEq, hResidualEq ▸
                buildRelationSet_initial branchType' (compileType signature branchType')⟩)
        · -- wait family: a silent self-loop, reconstructs `xoffer_wait`
          simp only [Finset.mem_image, Finset.mem_filter] at hWait
          rcases hWait with ⟨environment, ⟨hEnvMem, hClock, hUnresolved⟩, rfl⟩
          have hWF : environment.WellFormed := localEnvironment_wellFormed signature hEnvMem
          simp only [childState] at hPLabel hPCurrent hPFuture hPTarget
          have hLabelEq : edge.symbol.label = TypeLabel.silent := by injection hPLabel.symm
          have hCurrentEq : edge.symbol.offers.current =
              typeWaitingOffers environment branches := hPCurrent.symm
          have hFutureEq : edge.symbol.offers.future =
              typeFutureOffers (.xoffer elseType branches) \
                typeWaitingOffers environment branches := by
            rw [← hPFuture, hRootFuture]
            rfl
          have hOffersEq : edge.symbol.offers = TypeOfferSummary.mk
              (typeWaitingOffers environment branches)
              (typeFutureOffers (.xoffer elseType branches) \
                typeWaitingOffers environment branches) := by
            rw [show edge.symbol.offers = TypeOfferSummary.mk
              edge.symbol.offers.current edge.symbol.offers.future from rfl,
              hCurrentEq, hFutureEq]
          have hResidualEq : successor.1 = .xoffer elseType branches := by
            rw [hEntry1] at hStep
            rw [hLabelEq, hOffersEq] at hStep
            exact decoratedTypeTransition_target_unique hStep
              (hPEnv ▸ ⟨TypeTransition.xoffer_wait environment elseType branches
                ⟨hWF, hUnresolved, hClock⟩,
                TypeOffers.xoffer_wait environment elseType branches
                  ⟨hWF, hUnresolved, hClock⟩⟩)
          have hTargetEq : successor.2 = TypeAutomatonState.root := by
            rw [hTarget, ← hPTarget]
          exact Or.inl (by rw [show successor = (successor.1, successor.2) from rfl,
            hResidualEq, hTargetEq])
        · -- else family: reconstructs `xoffer_else`
          simp only [Finset.mem_image, Finset.mem_filter] at hResolved2
          rcases hResolved2 with ⟨environment, ⟨hEnvMem, hNoImmediate, hResolvedNeeds⟩, rfl⟩
          have hWF : environment.WellFormed := localEnvironment_wellFormed signature hEnvMem
          simp only [childState] at hPLabel hPCurrent hPFuture hPTarget
          have hLabelEq : edge.symbol.label = TypeLabel.silent := by injection hPLabel.symm
          have hCurrentEq : edge.symbol.offers.current = ∅ := hPCurrent.symm
          have hFutureEq : edge.symbol.offers.future = typeFutureOffers elseType := by
            rw [← hPFuture, computeFutureOf_exclusiveOffer_else signature elseType branches
              (.xoffer elseType branches) hWhole hElseFuelStrict
              (compileTypeFuel signature (typeCompilationFuel elseType) elseType).initial
              (compileTypeFuel_initial_mem signature (typeCompilationFuel elseType) elseType
                le_rfl), Finset.sdiff_empty]
            show computeFutureOf signature elseType (compileType signature elseType).initial =
              typeFutureOffers elseType
            exact helper_h15_future_offers_agree signature
              (buildRelationSet_initial elseType (compileType signature elseType))
          have hOffersEq : edge.symbol.offers = TypeOfferSummary.mk ∅
              (typeFutureOffers elseType) := by
            rw [show edge.symbol.offers = TypeOfferSummary.mk
              edge.symbol.offers.current edge.symbol.offers.future from rfl,
              hCurrentEq, hFutureEq]
          have hResidualEq : successor.1 = elseType := by
            rw [hEntry1] at hStep
            rw [hLabelEq, hOffersEq] at hStep
            exact decoratedTypeTransition_target_unique hStep
              (hPEnv ▸ ⟨TypeTransition.xoffer_else environment elseType branches
                ⟨hWF, hNoImmediate, hResolvedNeeds⟩,
                TypeOffers.xoffer_else environment elseType branches
                  ⟨hWF, hNoImmediate, hResolvedNeeds⟩⟩)
          have hTargetEq : successor.2 = .child 0
              (compileTypeFuel signature (typeCompilationFuel elseType) elseType).initial := by
            rw [hTarget, ← hPTarget]
          exact Or.inr (Or.inl ⟨(compileTypeFuel signature (typeCompilationFuel elseType)
            elseType).initial, hTargetEq, hResidualEq ▸
              buildRelationSet_initial elseType (compileType signature elseType)⟩)
      · -- else-child case: entry is already related to `q` inside `elseType`'s own relation
        have hChildSource : pendingEdge.source = .child 0 q := by
          rw [hPSource, hSource, hStateEq]
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildExclusiveOfferAutomaton_outgoing_else signature branches
            (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
            (branches.map fun branch => (branch.1, compileTypeFuel signature
              (typeCompilationFuel branch.2) branch.2)) q pendingEdge).mp
            ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature elseType).HasEdge q
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature elseType q childEdge.target
            edge.symbol.environment edge.symbol.label edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel elseType) elseType le_rfl childEdge hChildEdgeMem t r
                  hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_exclusiveOffer_else signature elseType branches
                  (.xoffer elseType branches) hWhole hElseFuelStrict t hStateMem]
        have hTargetEq : successor.2 = .child 0 childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique elseType (compileType signature elseType)
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr (Or.inl ⟨childEdge.target, hTargetEq, hInnerMem⟩)
      · -- branch-child case: entry is already related to `q` inside branch `i`'s own relation
        have hChildSource : pendingEdge.source = .child (i + 1) q := by
          rw [hPSource, hSource, hStateEq]
        have hAutomataGet :
            (branches.map fun branch => (branch.1, compileTypeFuel signature
              (typeCompilationFuel branch.2) branch.2))[i]? =
              some (action, compileTypeFuel signature (typeCompilationFuel branchType)
                branchType) :=
          (branches_map_getElem?_eq_some_iff signature branches i action
            (compileTypeFuel signature (typeCompilationFuel branchType) branchType)).mpr
            ⟨branchType, hBranchesEq, rfl⟩
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildExclusiveOfferAutomaton_outgoing_branch signature branches
            (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
            (branches.map fun branch => (branch.1, compileTypeFuel signature
              (typeCompilationFuel branch.2) branch.2))
            i action (compileTypeFuel signature (typeCompilationFuel branchType) branchType)
            hAutomataGet q pendingEdge).mp ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature branchType).HasEdge q
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature branchType q childEdge.target
            edge.symbol.environment edge.symbol.label edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hBranchMem : (action, branchType) ∈ branches :=
                  List.mem_iff_getElem?.mpr ⟨i, hBranchesEq⟩
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel branchType) branchType le_rfl childEdge hChildEdgeMem
                  t r hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_exclusiveOffer_branch signature elseType branches
                  (.xoffer elseType branches) hWhole i action branchType hBranchesEq
                  (hBranchFuelStrict (action, branchType) hBranchMem) t hStateMem]
        have hTargetEq : successor.2 = .child (i + 1) childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique branchType (compileType signature branchType)
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr (Or.inr ⟨i, action, branchType, childEdge.target, hBranchesEq, hTargetEq,
          hInnerMem⟩))
    (residual, state) hRelated

/-- Proves a `.child 0`-tagged state's future menu, in a compiled conjunctive offer, agrees with the else child's own. -/
theorem computeFutureOf_selectedConjunctiveOffer_else
    (signature : TypeAlphabet) (elseType : PactType)
    (branches : List (BareMessage × PactType)) (whole : PactType)
    (hWhole :
      compileTypeFuel signature (typeCompilationFuel whole) whole =
        buildSelectedConjunctiveOfferAutomaton signature branches
          (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
          (branches.map fun selected => (selected.1, compileTypeFuel signature
            (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
            (parallelTypeBranchesSelecting selected branches))))
    (hFuel : typeCompilationFuel elseType + 1 ≤ typeCompilationFuel whole)
    (state : TypeAutomatonState)
    (hState : state ∈ (compileTypeFuel signature (typeCompilationFuel elseType)
      elseType).states) :
    computeFutureOf signature whole (.child 0 state) =
      computeFutureOf signature elseType state := by
  sorry

/-- Proves a `.child (i+1)`-tagged state's future menu, in a compiled conjunctive offer, agrees with branch `i`'s generated commit type's own. -/
theorem computeFutureOf_selectedConjunctiveOffer_branch
    (signature : TypeAlphabet) (elseType : PactType)
    (branches : List (BareMessage × PactType)) (whole : PactType)
    (hWhole :
      compileTypeFuel signature (typeCompilationFuel whole) whole =
        buildSelectedConjunctiveOfferAutomaton signature branches
          (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
          (branches.map fun selected => (selected.1, compileTypeFuel signature
            (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
            (parallelTypeBranchesSelecting selected branches))))
    (i : Nat) (selected : BareMessage × PactType)
    (hSelected : branches[i]? = some selected)
    (hFuel : typeCompilationFuel (parallelTypeBranchesSelecting selected branches) +
      1 ≤ typeCompilationFuel whole)
    (state : TypeAutomatonState)
    (hState : state ∈ (compileTypeFuel signature
      (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
      (parallelTypeBranchesSelecting selected branches)).states) :
    computeFutureOf signature whole (.child (i + 1) state) =
      computeFutureOf signature (parallelTypeBranchesSelecting selected branches)
        state := by
  sorry

/-- Characterizes a public conjunctive-offer edge leaving a tagged else-child state as a copy of the else automaton's own outgoing edge. -/
theorem buildSelectedConjunctiveOfferAutomaton_outgoing_else
    (signature : TypeAlphabet) (branches : List (BareMessage × PactType))
    (elseAutomaton : AutomatonFragment)
    (selectedConjunctions : List (BareMessage × AutomatonFragment))
    (state : TypeAutomatonState) (edge : PendingAutomatonEdge) :
    let offer := buildSelectedConjunctiveOfferAutomaton signature branches
      elseAutomaton selectedConjunctions
    edge ∈ offer.edges ∧ edge.source = .child 0 state ↔
      ∃ childEdge ∈ elseAutomaton.edges,
        childEdge.source = state ∧ edge = childPendingEdge 0 childEdge := by
  sorry

/-- Characterizes a public conjunctive-offer edge leaving a tagged branch-`i`-child state as a copy of that branch's generated commit type's own outgoing edge. -/
theorem buildSelectedConjunctiveOfferAutomaton_outgoing_branch
    (signature : TypeAlphabet) (branches : List (BareMessage × PactType))
    (elseAutomaton : AutomatonFragment)
    (selectedConjunctions : List (BareMessage × AutomatonFragment))
    (i : Nat) (action : BareMessage) (automaton : AutomatonFragment)
    (hBranch : selectedConjunctions[i]? = some (action, automaton))
    (state : TypeAutomatonState) (edge : PendingAutomatonEdge) :
    let offer := buildSelectedConjunctiveOfferAutomaton signature branches
      elseAutomaton selectedConjunctions
    edge ∈ offer.edges ∧ edge.source = .child (i + 1) state ↔
      ∃ childEdge ∈ automaton.edges,
        childEdge.source = state ∧ edge = childPendingEdge (i + 1) childEdge := by
  sorry

/-- Relates a branch's generated commit type found by index after mapping compiled fragments in to the same branch found by index in the original list. -/
theorem branches_map_selecting_getElem?_eq_some_iff
    (signature : TypeAlphabet) (branches : List (BareMessage × PactType))
    (i : Nat) (action : BareMessage) (automaton : AutomatonFragment) :
    (branches.map fun selected => (selected.1, compileTypeFuel signature
        (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
        (parallelTypeBranchesSelecting selected branches)))[i]? =
        some (action, automaton) ↔
      ∃ branchType, branches[i]? = some (action, branchType) ∧
        compileTypeFuel signature
          (typeCompilationFuel
            (parallelTypeBranchesSelecting (action, branchType) branches))
          (parallelTypeBranchesSelecting (action, branchType) branches) =
          automaton := by
  rw [List.getElem?_map, Option.map_eq_some_iff]
  constructor
  · rintro ⟨⟨branchAction, branchType⟩, hGet, hEq⟩
    simp only [Prod.mk.injEq] at hEq
    obtain ⟨hAction, hAut⟩ := hEq
    subst hAction
    exact ⟨branchType, hGet, hAut⟩
  · rintro ⟨branchType, hGet, hAut⟩
    exact ⟨(action, branchType), hGet, by simp [hAut]⟩

/-- Defines the related-state shape for a compiled conjunctive offer: the root represents the whole offer, a tagged child represents a residual of `τ0` or a generated branch commit. -/
def offerRelationShape
    (signature : TypeAlphabet) (elseType : PactType)
    (branches : List (BareMessage × PactType))
    (entry : PactType × TypeAutomatonState) : Prop :=
  entry = (.offer elseType branches, TypeAutomatonState.root) ∨
    (∃ q, entry.2 = .child 0 q ∧
      relationMembership
        (buildRelationSet elseType (compileType signature elseType))
        entry.1 q) ∨
    (∃ i selected q,
      branches[i]? = some selected ∧
      entry.2 = .child (i + 1) q ∧
      relationMembership
        (buildRelationSet (parallelTypeBranchesSelecting selected branches)
          (compileType signature
            (parallelTypeBranchesSelecting selected branches)))
        entry.1 q)

set_option maxHeartbeats 4000000 in
/-- Proves every related conjunctive-offer pair has the conjunctive-offer shape. -/
lemma relationMembership_offer_cases
    (signature : TypeAlphabet) (elseType : PactType)
    (branches : List (BareMessage × PactType))
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership
        (buildRelationSet (.offer elseType branches)
          (compileType signature (.offer elseType branches)))
        residual state) :
    offerRelationShape signature elseType branches (residual, state) := by
  have hElseFuelStrict : typeCompilationFuel elseType + 1 ≤
      typeCompilationFuel (.offer elseType branches) := by
    simp only [typeCompilationFuel]; omega
  have hBranchFuelStrict : ∀ selected : BareMessage × PactType,
      typeCompilationFuel (parallelTypeBranchesSelecting selected branches) + 1 ≤
        typeCompilationFuel (.offer elseType branches) := by
    intro selected
    rw [typeCompilationFuel_parallelTypeBranchesSelecting]
    simp only [typeCompilationFuel]; omega
  have hFuelEq : typeCompilationFuel (.offer elseType branches) =
      max (typeCompilationFuel elseType) (conjunctiveCompilationFuel branches) + 1 := by
    simp only [typeCompilationFuel]; omega
  have hWhole :
      compileTypeFuel signature (typeCompilationFuel (.offer elseType branches))
        (.offer elseType branches) =
        buildSelectedConjunctiveOfferAutomaton signature branches
          (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
          (branches.map fun selected => (selected.1, compileTypeFuel signature
            (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
            (parallelTypeBranchesSelecting selected branches))) := by
    rw [hFuelEq]
    show buildSelectedConjunctiveOfferAutomaton signature branches
        (compileTypeFuel signature
          (max (typeCompilationFuel elseType) (conjunctiveCompilationFuel branches))
          elseType)
        (branches.map fun selected => (selected.1, compileTypeFuel signature
          (max (typeCompilationFuel elseType) (conjunctiveCompilationFuel branches))
          (parallelTypeBranchesSelecting selected branches))) =
      buildSelectedConjunctiveOfferAutomaton signature branches
        (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
        (branches.map fun selected => (selected.1, compileTypeFuel signature
          (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
          (parallelTypeBranchesSelecting selected branches)))
    congr 1
    · exact compileTypeFuel_eq_of_sufficient signature elseType (le_max_left _ _) le_rfl
    · apply List.map_congr_left
      intro selected _
      congr 1
      exact compileTypeFuel_eq_of_sufficient signature
        (parallelTypeBranchesSelecting selected branches)
        (by
          show typeCompilationFuel (parallelTypeBranchesSelecting selected branches) ≤
            max (typeCompilationFuel elseType) (conjunctiveCompilationFuel branches)
          rw [typeCompilationFuel_parallelTypeBranchesSelecting]
          exact le_max_right _ _)
        le_rfl
  have hInit : (compileType signature (.offer elseType branches)).initial =
      TypeAutomatonState.root := by
    show (compileTypeFuel signature (typeCompilationFuel (.offer elseType branches))
      (.offer elseType branches)).initial = TypeAutomatonState.root
    rw [hWhole]
    simp [buildSelectedConjunctiveOfferAutomaton, finishAutomatonFragment]
  have hRootRelated : relationMembership
      (buildRelationSet (.offer elseType branches)
        (compileType signature (.offer elseType branches)))
      (.offer elseType branches) TypeAutomatonState.root := by
    rw [← hInit]
    exact buildRelationSet_initial (.offer elseType branches)
      (compileType signature (.offer elseType branches))
  have hRootFuture : computeFutureOf signature (.offer elseType branches)
      TypeAutomatonState.root = typeFutureOffers (.offer elseType branches) :=
    helper_h15_future_offers_agree signature hRootRelated
  refine buildRelationSet_preserves (.offer elseType branches)
    (compileType signature (.offer elseType branches))
    (offerRelationShape signature elseType branches)
    (by
      show offerRelationShape signature elseType branches
        (.offer elseType branches,
          (compileType signature (.offer elseType branches)).initial)
      rw [hInit]; exact Or.inl rfl)
    (by
      intro entry hEntry successor hSuccessor
      rcases relationSuccessors_mem_cases (compileType signature (.offer elseType branches))
        entry successor hSuccessor with ⟨edge, hEdgeMem, hSource, hTarget, hStep⟩
      have hSymbolMem := compileType_hasEdge_symbol_mem signature (.offer elseType branches)
        (show (compileType signature (.offer elseType branches)).HasEdge edge.source
          edge.symbol.environment edge.symbol.label edge.symbol.offers edge.target
          from hEdgeMem)
      have hResolved := (compileType_hasEdge_iff_hasResolvedEdge signature
        (.offer elseType branches) edge.source edge.target edge.symbol.environment
        edge.symbol.label edge.symbol.offers hSymbolMem).mp hEdgeMem
      rw [hWhole] at hResolved
      obtain ⟨pendingEdge, hPendingMem, hPSource, hPEnv, hPLabel, hPCurrent, hPFuture,
        hPTarget⟩ := hResolved
      rcases hEntry with hRoot |
        ⟨q, hStateEq, hMem⟩ |
        ⟨i, selected, q, hBranchesEq, hStateEq, hMem⟩
      · -- root case: entry represents the whole conjunctive offer; the three
        -- root-edge families reconstruct the matching semantic offer rule.
        have hEntry1 : entry.1 = .offer elseType branches := by rw [hRoot]
        have hRootSource : pendingEdge.source = TypeAutomatonState.root := by
          rw [hPSource, hSource, hRoot]
        simp only [buildSelectedConjunctiveOfferAutomaton, finishAutomatonFragment,
          Finset.mem_union] at hPendingMem
        rcases hPendingMem with ((((hElse | hIndexed) | hEnabledFamily) | hWait) | hResolved2)
        · exfalso
          simp only [childPendingEdges, Finset.mem_image] at hElse
          obtain ⟨childEdge, _, hEq⟩ := hElse
          rw [← hEq] at hRootSource
          simp [childPendingEdge, childState] at hRootSource
        · exfalso
          rw [indexedFragmentEdges, mem_foldl_union_iff] at hIndexed
          rcases hIndexed with hEmpty | ⟨indexed, _, hNewEdge⟩
          · simp at hEmpty
          · simp only [childPendingEdges, Finset.mem_image] at hNewEdge
            obtain ⟨childEdge, _, hEq⟩ := hNewEdge
            rw [← hEq] at hRootSource
            simp [childPendingEdge, childState] at hRootSource
        · -- fire family: reconstructs `offer_some`
          rw [mem_foldl_union_iff] at hEnabledFamily
          rcases hEnabledFamily with hEmpty | ⟨indexed, hIndexedEntry, hNewEdge⟩
          · simp at hEmpty
          · simp only [Finset.mem_image, Finset.mem_filter] at hNewEdge
            obtain ⟨⟨branchAction, automaton⟩, index⟩ := indexed
            rcases hNewEdge with ⟨environment, ⟨hEnvMem, hEnabled⟩, rfl⟩
            have hIndexedGet :
                (branches.map fun selected => (selected.1, compileTypeFuel signature
                  (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
                  (parallelTypeBranchesSelecting selected branches)))[index]? =
                  some (branchAction, automaton) :=
              List.mk_mem_zipIdx_iff_getElem?.mp hIndexedEntry
            obtain ⟨branchType', hBranchGet, hAutEq⟩ :=
              (branches_map_selecting_getElem?_eq_some_iff signature branches index
                branchAction automaton).mp hIndexedGet
            have hWF : environment.WellFormed :=
              localEnvironment_wellFormed signature hEnvMem
            have hSelectedMem : (branchAction, branchType') ∈ branches :=
              List.mem_iff_getElem?.mpr ⟨index, hBranchGet⟩
            simp only [childState] at hPLabel hPCurrent hPFuture hPTarget
            have hLabelEq : edge.symbol.label = TypeLabel.silent := by
              injection hPLabel.symm
            have hCurrentEq : edge.symbol.offers.current = ∅ := hPCurrent.symm
            have hFutureEq : edge.symbol.offers.future =
                typeFutureOffers (parallelTypeBranchesSelecting
                  (branchAction, branchType') branches) := by
              rw [← hPFuture, ← hAutEq, computeFutureOf_selectedConjunctiveOffer_branch
                signature elseType branches (.offer elseType branches) hWhole index
                (branchAction, branchType') hBranchGet
                (hBranchFuelStrict (branchAction, branchType'))
                (compileTypeFuel signature (typeCompilationFuel
                  (parallelTypeBranchesSelecting (branchAction, branchType') branches))
                  (parallelTypeBranchesSelecting (branchAction, branchType') branches)).initial
                (compileTypeFuel_initial_mem signature (typeCompilationFuel
                  (parallelTypeBranchesSelecting (branchAction, branchType') branches))
                  (parallelTypeBranchesSelecting (branchAction, branchType') branches)
                  le_rfl), Finset.sdiff_empty]
              show computeFutureOf signature
                (parallelTypeBranchesSelecting (branchAction, branchType') branches)
                (compileType signature
                  (parallelTypeBranchesSelecting (branchAction, branchType')
                    branches)).initial =
                typeFutureOffers (parallelTypeBranchesSelecting
                  (branchAction, branchType') branches)
              exact helper_h15_future_offers_agree signature
                (buildRelationSet_initial
                  (parallelTypeBranchesSelecting (branchAction, branchType') branches)
                  (compileType signature
                    (parallelTypeBranchesSelecting (branchAction, branchType') branches)))
            have hOffersEq : edge.symbol.offers = TypeOfferSummary.mk ∅
                (typeFutureOffers (parallelTypeBranchesSelecting
                  (branchAction, branchType') branches)) := by
              rw [show edge.symbol.offers = TypeOfferSummary.mk
                edge.symbol.offers.current edge.symbol.offers.future from rfl,
                hCurrentEq, hFutureEq]
            have hResidualEq : successor.1 =
                parallelTypeBranchesSelecting (branchAction, branchType') branches := by
              rw [hEntry1] at hStep
              rw [hLabelEq, hOffersEq] at hStep
              exact decoratedTypeTransition_target_unique hStep
                (hPEnv ▸ ⟨TypeTransition.offer_some environment elseType branches
                  (branchAction, branchType')
                  ⟨hWF, hSelectedMem, hEnabled⟩,
                  TypeOffers.offer_some environment elseType branches
                    (branchAction, branchType')
                    ⟨hWF, hSelectedMem, hEnabled⟩⟩)
            have hTargetEq : successor.2 = .child (index + 1)
                (compileTypeFuel signature (typeCompilationFuel
                  (parallelTypeBranchesSelecting (branchAction, branchType') branches))
                  (parallelTypeBranchesSelecting
                    (branchAction, branchType') branches)).initial := by
              rw [hTarget, ← hPTarget, ← hAutEq]
            exact Or.inr (Or.inr ⟨index, (branchAction, branchType'),
              (compileTypeFuel signature (typeCompilationFuel
                (parallelTypeBranchesSelecting (branchAction, branchType') branches))
                (parallelTypeBranchesSelecting (branchAction, branchType') branches)).initial,
              hBranchGet, hTargetEq, hResidualEq ▸
                buildRelationSet_initial
                  (parallelTypeBranchesSelecting (branchAction, branchType') branches)
                  (compileType signature
                    (parallelTypeBranchesSelecting (branchAction, branchType')
                      branches))⟩)
        · -- wait family: a silent self-loop, reconstructs `offer_wait`
          simp only [Finset.mem_image, Finset.mem_filter] at hWait
          rcases hWait with ⟨environment, ⟨hEnvMem, hClock, hNoImmediate, hUnresolved⟩, rfl⟩
          have hWF : environment.WellFormed := localEnvironment_wellFormed signature hEnvMem
          simp only [childState] at hPLabel hPCurrent hPFuture hPTarget
          have hLabelEq : edge.symbol.label = TypeLabel.silent := by injection hPLabel.symm
          have hCurrentEq : edge.symbol.offers.current =
              typeWaitingOffers environment branches := hPCurrent.symm
          have hFutureEq : edge.symbol.offers.future =
              typeFutureOffers (.offer elseType branches) \
                typeWaitingOffers environment branches := by
            rw [← hPFuture, hRootFuture]
            rfl
          have hOffersEq : edge.symbol.offers = TypeOfferSummary.mk
              (typeWaitingOffers environment branches)
              (typeFutureOffers (.offer elseType branches) \
                typeWaitingOffers environment branches) := by
            rw [show edge.symbol.offers = TypeOfferSummary.mk
              edge.symbol.offers.current edge.symbol.offers.future from rfl,
              hCurrentEq, hFutureEq]
          have hResidualEq : successor.1 = .offer elseType branches := by
            rw [hEntry1] at hStep
            rw [hLabelEq, hOffersEq] at hStep
            exact decoratedTypeTransition_target_unique hStep
              (hPEnv ▸ ⟨TypeTransition.offer_wait environment elseType branches
                ⟨hWF, hNoImmediate, hUnresolved, hClock⟩,
                TypeOffers.offer_wait environment elseType branches
                  ⟨hWF, hNoImmediate, hUnresolved, hClock⟩⟩)
          have hTargetEq : successor.2 = TypeAutomatonState.root := by
            rw [hTarget, ← hPTarget]
          exact Or.inl (by rw [show successor = (successor.1, successor.2) from rfl,
            hResidualEq, hTargetEq])
        · -- else family: reconstructs `offer_else`
          simp only [Finset.mem_image, Finset.mem_filter] at hResolved2
          rcases hResolved2 with ⟨environment, ⟨hEnvMem, hNoImmediate, hResolvedNeeds⟩, rfl⟩
          have hWF : environment.WellFormed := localEnvironment_wellFormed signature hEnvMem
          simp only [childState] at hPLabel hPCurrent hPFuture hPTarget
          have hLabelEq : edge.symbol.label = TypeLabel.silent := by injection hPLabel.symm
          have hCurrentEq : edge.symbol.offers.current = typeBranchActions branches :=
            hPCurrent.symm
          have hFutureEq : edge.symbol.offers.future = typeFutureOffers elseType := by
            rw [← hPFuture, computeFutureOf_selectedConjunctiveOffer_else signature elseType
              branches (.offer elseType branches) hWhole hElseFuelStrict
              (compileTypeFuel signature (typeCompilationFuel elseType) elseType).initial
              (compileTypeFuel_initial_mem signature (typeCompilationFuel elseType) elseType
                le_rfl), Finset.sdiff_empty]
            show computeFutureOf signature elseType (compileType signature elseType).initial =
              typeFutureOffers elseType
            exact helper_h15_future_offers_agree signature
              (buildRelationSet_initial elseType (compileType signature elseType))
          have hOffersEq : edge.symbol.offers = TypeOfferSummary.mk (typeBranchActions branches)
              (typeFutureOffers elseType) := by
            rw [show edge.symbol.offers = TypeOfferSummary.mk
              edge.symbol.offers.current edge.symbol.offers.future from rfl,
              hCurrentEq, hFutureEq]
          have hResidualEq : successor.1 = elseType := by
            rw [hEntry1] at hStep
            rw [hLabelEq, hOffersEq] at hStep
            exact decoratedTypeTransition_target_unique hStep
              (hPEnv ▸ ⟨TypeTransition.offer_else environment elseType branches
                ⟨hWF, hNoImmediate, hResolvedNeeds⟩,
                TypeOffers.offer_else environment elseType branches
                  ⟨hWF, hNoImmediate, hResolvedNeeds⟩⟩)
          have hTargetEq : successor.2 = .child 0
              (compileTypeFuel signature (typeCompilationFuel elseType) elseType).initial := by
            rw [hTarget, ← hPTarget]
          exact Or.inr (Or.inl ⟨(compileTypeFuel signature (typeCompilationFuel elseType)
            elseType).initial, hTargetEq, hResidualEq ▸
              buildRelationSet_initial elseType (compileType signature elseType)⟩)
      · -- else-child case: entry is already related to `q` inside `elseType`'s own relation
        have hChildSource : pendingEdge.source = .child 0 q := by
          rw [hPSource, hSource, hStateEq]
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildSelectedConjunctiveOfferAutomaton_outgoing_else signature branches
            (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
            (branches.map fun selected => (selected.1, compileTypeFuel signature
              (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
              (parallelTypeBranchesSelecting selected branches))) q pendingEdge).mp
            ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature elseType).HasEdge q
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature elseType q childEdge.target
            edge.symbol.environment edge.symbol.label edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel elseType) elseType le_rfl childEdge hChildEdgeMem t r
                  hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_selectedConjunctiveOffer_else signature elseType branches
                  (.offer elseType branches) hWhole hElseFuelStrict t hStateMem]
        have hTargetEq : successor.2 = .child 0 childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique elseType (compileType signature elseType)
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr (Or.inl ⟨childEdge.target, hTargetEq, hInnerMem⟩)
      · -- branch-child case: entry is already related to `q` inside branch `i`'s
        -- generated commit type's own relation
        have hChildSource : pendingEdge.source = .child (i + 1) q := by
          rw [hPSource, hSource, hStateEq]
        have hAutomataGet :
            (branches.map fun selected' => (selected'.1, compileTypeFuel signature
              (typeCompilationFuel (parallelTypeBranchesSelecting selected' branches))
              (parallelTypeBranchesSelecting selected' branches)))[i]? =
              some (selected.1, compileTypeFuel signature (typeCompilationFuel
                (parallelTypeBranchesSelecting selected branches))
                (parallelTypeBranchesSelecting selected branches)) := by
          rw [List.getElem?_map, hBranchesEq]
          rfl
        obtain ⟨childEdge, hChildEdgeMem, hChildEdgeSource, hChildEdgeEq⟩ :=
          (buildSelectedConjunctiveOfferAutomaton_outgoing_branch signature branches
            (compileTypeFuel signature (typeCompilationFuel elseType) elseType)
            (branches.map fun selected' => (selected'.1, compileTypeFuel signature
              (typeCompilationFuel (parallelTypeBranchesSelecting selected' branches))
              (parallelTypeBranchesSelecting selected' branches)))
            i selected.1 (compileTypeFuel signature (typeCompilationFuel
              (parallelTypeBranchesSelecting selected branches))
              (parallelTypeBranchesSelecting selected branches))
            hAutomataGet q pendingEdge).mp ⟨hPendingMem, hChildSource⟩
        have hInnerEdgeMem : (compileType signature
            (parallelTypeBranchesSelecting selected branches)).HasEdge q
            edge.symbol.environment edge.symbol.label edge.symbol.offers
            childEdge.target := by
          rw [compileType_hasEdge_iff_hasResolvedEdge signature
            (parallelTypeBranchesSelecting selected branches) q childEdge.target
            edge.symbol.environment edge.symbol.label edge.symbol.offers hSymbolMem]
          refine ⟨childEdge, hChildEdgeMem, hChildEdgeSource, ?_, ?_, ?_, ?_, rfl⟩
          · rw [← hPEnv, hChildEdgeEq]; rfl
          · rw [← hPLabel, hChildEdgeEq]; rfl
          · rw [← hPCurrent, hChildEdgeEq]; rfl
          · rw [← hPFuture, hChildEdgeEq]
            cases hSpec : childEdge.future with
            | explicit offers => simp [childPendingEdge, childFutureSpec, hSpec]
            | «at» t r =>
                have hStateMem := compileTypeFuel_futureTargetsInStates signature
                  (typeCompilationFuel (parallelTypeBranchesSelecting selected branches))
                  (parallelTypeBranchesSelecting selected branches) le_rfl childEdge
                  hChildEdgeMem t r hSpec
                simp only [childPendingEdge, childFutureSpec, hSpec, childState]
                rw [computeFutureOf_selectedConjunctiveOffer_branch signature elseType branches
                  (.offer elseType branches) hWhole i selected hBranchesEq
                  (hBranchFuelStrict selected) t hStateMem]
        have hTargetEq : successor.2 = .child (i + 1) childEdge.target := by
          rw [hTarget, ← hPTarget, hChildEdgeEq]; rfl
        have hInnerMem :=
          relationMembership_of_step_edge_unique
            (parallelTypeBranchesSelecting selected branches)
            (compileType signature (parallelTypeBranchesSelecting selected branches))
            hMem hInnerEdgeMem hStep
            (fun target hTargetStep =>
              decoratedTypeTransition_target_unique hTargetStep hStep)
        exact Or.inr (Or.inr ⟨i, selected, childEdge.target, hBranchesEq, hTargetEq,
          hInnerMem⟩))
    (residual, state) hRelated

/-- Defines the only related pair for a variable marker as its own seed. -/
def varRelationShape
    (name : String) (entry : PactType × TypeAutomatonState) : Prop :=
  entry = (.var name, TypeAutomatonState.root)

/-- Proves no decorated step is ever available at a variable marker. -/
lemma var_not_decoratedTypeTransition
    (name : String) {env : TypeEnvironment} {label : TypeLabel}
    {offers : TypeOfferSummary} {target : PactType} :
    ¬ DecoratedTypeTransition env (.var name) label offers target := by
  rintro ⟨hTrans, -⟩
  cases hTrans

/-- Proves the relation builder never grows past a variable-marker entry. -/
lemma relationSuccessors_var_eq_empty
    (signature : TypeAlphabet) (name : String)
    (entry : PactType × TypeAutomatonState) (hEntry : entry.1 = .var name) :
    relationSuccessors (compileType signature (.var name)) entry = ∅ := by
  rw [Finset.eq_empty_iff_forall_notMem]
  intro pair hPair
  simp only [relationSuccessors, Finset.mem_biUnion] at hPair
  obtain ⟨edge, -, hPair⟩ := hPair
  split at hPair
  · split at hPair
    · rename_i hStep
      obtain ⟨residual', hStep'⟩ := hStep
      rw [hEntry] at hStep'
      exact var_not_decoratedTypeTransition name hStep'
    · simp at hPair
  · simp at hPair

/-- Proves every related variable-marker pair is the seed pair. -/
lemma relationMembership_var_cases
    (signature : TypeAlphabet) (name : String)
    {residual : PactType} {state : TypeAutomatonState}
    (hRelated :
      relationMembership
        (buildRelationSet (.var name) (compileType signature (.var name)))
        residual state) :
    residual = .var name ∧ state = TypeAutomatonState.root := by
  have hShape :=
    buildRelationSet_preserves (.var name) (compileType signature (.var name))
      (varRelationShape name)
      (by
        simp [varRelationShape, compileType, typeCompilationFuel,
          compileTypeFuel, finishAutomatonFragment])
      (by
        intro entry hEntry successor hSuccessor
        rw [relationSuccessors_var_eq_empty signature name entry
          (by rw [hEntry])] at hSuccessor
        exact absurd hSuccessor (by simp))
      (residual, state) hRelated
  simpa [varRelationShape, Prod.ext_iff] using hShape

end

end Pact
