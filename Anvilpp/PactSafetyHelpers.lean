/-! ## Process strategies, safety, and liveness (`procSem.typ`, "Safety and
compatibility") -/

/-- A valid finite execution prefix beginning at `initial`, i.e. `Pref(Q_0)`. -/
inductive PrefixValid (initial : Proc) :
    List (Environment × Label) → Proc → Prop where
  | root : PrefixValid initial [] initial
  | step {entries : List (Environment × Label)} {current next : Proc}
      {env : Environment} {label : Label} :
      PrefixValid initial entries current →
      ProcessTransition env current label next →
      PrefixValid initial (entries ++ [(env, label)]) next

structure ProcessPrefix (initial : Proc) : Type where
  entries : List (Environment × Label)
  residual : Proc
  valid : PrefixValid initial entries residual

/-- A history-sensitive open-system environment strategy, `S_Q`. -/
abbrev ProcessStrategy (initial : Proc) := ProcessPrefix initial → Environment

/-- The prefix is built by always taking the strategy-selected environment:
`S_Q ⊢ ρ_k →^{α_k} ρ_{k+1} iff S_Q(ρ_k) ⊢ Q_k →^{α_k} Q_{k+1}`. -/
inductive FollowsProcessStrategy {initial : Proc}
    (strategy : ProcessStrategy initial) : ProcessPrefix initial → Prop where
  | root : FollowsProcessStrategy strategy ⟨[], initial, .root⟩
  | step {history : ProcessPrefix initial} {label : Label} {next : Proc}
      (follows : FollowsProcessStrategy strategy history)
      (transition :
        ProcessTransition (strategy history) history.residual label next) :
      FollowsProcessStrategy strategy
        ⟨history.entries ++ [(strategy history, label)], next,
          history.valid.step transition⟩

/-- A completed infinite process log, including the failure completion. -/
abbrev ProcessLog := ℕ → Environment × Label

/-- Definition A.2: no transition is available under `env`. -/
def Stuck (env : Environment) (process : Proc) : Prop :=
  ¬ ∃ label target, ProcessTransition env process label target

/--
Ordinary infinite runs and absorbing failure completions under a strategy.
`log` is generated by iterating the strategy from the root prefix: at each
step it either takes the strategy-selected environment's genuine transition,
or (once that environment is stuck) contributes one `<E,ε>` entry and then
repeats the absorbing failure entry `(∅,ε)` forever.
-/
def CompletedProcessLog {initial : Proc}
    (strategy : ProcessStrategy initial) (log : ProcessLog) : Prop :=
  ∃ prefixAt : ℕ → ProcessPrefix initial,
    prefixAt 0 = ⟨[], initial, .root⟩ ∧
    (∀ n, FollowsProcessStrategy strategy (prefixAt n)) ∧
    ∀ n,
      ((log n).1 = strategy (prefixAt n) ∧
        (prefixAt n).entries ++ [log n] = (prefixAt (n + 1)).entries ∧
        ProcessTransition (strategy (prefixAt n)) (prefixAt n).residual
          (log n).2 (prefixAt (n + 1)).residual) ∨
      (Stuck (strategy (prefixAt n)) (prefixAt n).residual ∧
        log n = (strategy (prefixAt n), Label.silent) ∧
        prefixAt (n + 1) = prefixAt n ∧
        ∀ m, n < m → log m = (Environment.empty, Label.silent))

/-- `Honest(ℓ)`: an environment cannot introduce a new action after
withdrawing it during the same cycle. -/
def HonestProcessLog (log : ProcessLog) : Prop :=
  ∀ index,
    (log index).2.isTock ∨
    (log (index + 1)).1.available ⊆ (log index).1.future

def HonestProcessStrategy {initial : Proc}
    (strategy : ProcessStrategy initial) : Prop :=
  ∀ log, CompletedProcessLog strategy log → HonestProcessLog log

/-- Definition A.3: no strategy-reachable residual is stuck. -/
def SyncCompatible {initial : Proc} (strategy : ProcessStrategy initial) : Prop :=
  ∀ historyPrefix,
    FollowsProcessStrategy strategy historyPrefix →
    ¬ Stuck (strategy historyPrefix) historyPrefix.residual

mutual
  /-- Fair-choice identifiers occurring in a process, `cal(Eta)(P)`. -/
  def processFairIds : Proc → Finset BranchId
    | .send _ _ p => processFairIds p
    | .recv _ _ p => processFairIds p
    | .var _ => ∅
    | .skip => ∅
    | .endp _ => ∅
    | .cycle => ∅
    | .par left right _ => processFairIds left ∪ processFairIds right
    | .seq left right => processFairIds left ∪ processFairIds right
    | .letp _ _ p => processFairIds p
    | .ifunfair _ left right => processFairIds left ∪ processFairIds right
    | .iffair bid _ left right =>
        {bid} ∪ processFairIds left ∪ processFairIds right
    | .xoffer elseProcess branches =>
        processFairIds elseProcess ∪ processBranchFairIds branches
    | .offer elseProcess branches =>
        processFairIds elseProcess ∪ processBranchFairIds branches
    | .recur _ body => processFairIds body
  termination_by process => sizeOf process

  /-- Fair-choice identifiers occurring in a branch list. -/
  def processBranchFairIds : List ChoiceBranch → Finset BranchId
    | [] => ∅
    | branch :: rest =>
        processFairIds (ChoiceBranch.continuation branch) ∪
          processBranchFairIds rest
  termination_by branches => sizeOf branches
decreasing_by
  all_goals
    first
    | (simp_wf; omega)
    | (have := ChoiceBranch.continuation_sizeOf_lt branch; simp_wf; omega)
end

mutual
  /-- Progress identifiers occurring in a process, `cal(T)(P)`. -/
  def processProgressIds : Proc → Finset ProcId
    | .send _ _ p => processProgressIds p
    | .recv _ _ p => processProgressIds p
    | .var _ => ∅
    | .skip => ∅
    | .endp pid => {pid}
    | .cycle => ∅
    | .par left right _ => processProgressIds left ∪ processProgressIds right
    | .seq left right => processProgressIds left ∪ processProgressIds right
    | .letp _ _ p => processProgressIds p
    | .ifunfair _ left right =>
        processProgressIds left ∪ processProgressIds right
    | .iffair _ _ left right =>
        processProgressIds left ∪ processProgressIds right
    | .xoffer elseProcess branches =>
        processProgressIds elseProcess ∪ processBranchProgressIds branches
    | .offer elseProcess branches =>
        processProgressIds elseProcess ∪ processBranchProgressIds branches
    | .recur _ body => processProgressIds body
  termination_by process => sizeOf process

  /-- Progress identifiers occurring in a branch list. -/
  def processBranchProgressIds : List ChoiceBranch → Finset ProcId
    | [] => ∅
    | branch :: rest =>
        processProgressIds (ChoiceBranch.continuation branch) ∪
          processBranchProgressIds rest
  termination_by branches => sizeOf branches
decreasing_by
  all_goals
    first
    | (simp_wf; omega)
    | (have := ChoiceBranch.continuation_sizeOf_lt branch; simp_wf; omega)
end

def ObservationOccursInfinitely
    (observation : Observation) (log : ProcessLog) : Prop :=
  Set.Infinite {index | (log index).2.contains observation}

def TockOccursInfinitely (log : ProcessLog) : Prop :=
  Set.Infinite {index | (log index).2 = Label.tock}

/-- Definition A.5: each fair branch takes both outcomes infinitely often together. -/
def FairProcessLog (initial : Proc) (log : ProcessLog) : Prop :=
  ∀ bid ∈ processFairIds initial,
    (ObservationOccursInfinitely (.fair bid true) log ↔
      ObservationOccursInfinitely (.fair bid false) log)

/-- Definition A.6: clock progress, plus marker progress on fair logs. -/
def Live {initial : Proc} (strategy : ProcessStrategy initial)
    (progress : Finset ProcId) : Prop :=
  ∀ log,
    CompletedProcessLog strategy log →
    TockOccursInfinitely log ∧
      (FairProcessLog initial log →
        ∀ pid ∈ progress,
          ObservationOccursInfinitely (.progress pid) log)

/-- `ProcJoin_{S,T}`: synchronization safety together with liveness. -/
def ProcJoin {initial : Proc} (strategy : ProcessStrategy initial)
    (progress : Finset ProcId) : Prop :=
  SyncCompatible strategy ∧ Live strategy progress

/-- `Compatible(Q_0,T)` (Definition 3.6/A.4): communication safety of a fixed
composition. -/
def ProcessCompatible (initial : Proc) (progress : Finset ProcId) : Prop :=
  ∃ strategy : ProcessStrategy initial,
    HonestProcessStrategy strategy ∧
    ProcJoin strategy progress

/-! ## Type logs, honesty, and the semantic compatibility objective
(`pacttypes.typ`, `pactcompat.typ`) -/

abbrev TypeLog := ℕ → TypeEnvironment × TypeLabel
abbrev TypeHistory := List (TypeEnvironment × TypeLabel × PactType)
abbrev TypeStrategy := TypeHistory → TypeEnvironment

/-- A valid finite type-execution prefix, mirroring `PrefixValid`. -/
inductive TypePrefixValid (initial : PactType) :
    List (TypeEnvironment × TypeLabel) → PactType → Prop where
  | root : TypePrefixValid initial [] initial
  | step {entries : List (TypeEnvironment × TypeLabel)} {current next : PactType}
      {env : TypeEnvironment} {label : TypeLabel} :
      TypePrefixValid initial entries current →
      TypeTransition env current label next →
      TypePrefixValid initial (entries ++ [(env, label)]) next

structure TypePrefix (initial : PactType) : Type where
  entries : List (TypeEnvironment × TypeLabel)
  residual : PactType
  valid : TypePrefixValid initial entries residual

/-- Ordinary infinite runs and absorbing failure completions under a type
strategy, mirroring `CompletedProcessLog`. The strategy consumes the flat
history `TypeHistory`, not the dependent prefix, so we track both alongside
each other. -/
def CompletedTypeLog
    (initial : PactType) (strategy : TypeStrategy) (log : TypeLog) : Prop :=
  ∃ prefixAt : ℕ → TypePrefix initial,
    prefixAt 0 = ⟨[], initial, .root⟩ ∧
    ∀ n,
      (((log n).1 = strategy
          ((prefixAt n).entries.map fun entry => (entry.1, entry.2, initial)) ∧
        (prefixAt n).entries ++ [log n] = (prefixAt (n + 1)).entries ∧
        TypeTransition (log n).1 (prefixAt n).residual (log n).2
          (prefixAt (n + 1)).residual)) ∨
      ((¬ ∃ label target, TypeTransition
          (strategy ((prefixAt n).entries.map
            fun entry => (entry.1, entry.2, initial)))
          (prefixAt n).residual label target) ∧
        log n =
          (strategy ((prefixAt n).entries.map
            fun entry => (entry.1, entry.2, initial)), TypeLabel.silent) ∧
        prefixAt (n + 1) = prefixAt n ∧
        ∀ m, n < m → log m = (TypeEnvironment.empty, TypeLabel.silent))

def typeAvailable (env : TypeEnvironment) : Finset BareMessage :=
  env.immediate ∪ env.future

def HonestTypeLog (log : TypeLog) : Prop :=
  ∀ index,
    (log index).2.isTock ∨
    typeAvailable (log (index + 1)).1 ⊆ (log index).1.future

def HonestTypeStrategy (initial : PactType) (strategy : TypeStrategy) : Prop :=
  ∀ log, CompletedTypeLog initial strategy log → HonestTypeLog log

mutual
  /-- Fair-choice identifiers occurring in a type, `cal(Eta)(τ)`. -/
  def typeFairIds : PactType → Finset BranchId
    | .message _ _ => ∅
    | .progress _ => ∅
    | .tock => ∅
    | .skip => ∅
    | .var _ => ∅
    | .choice left right => typeFairIds left ∪ typeFairIds right
    | .seq left right => typeFairIds left ∪ typeFairIds right
    | .par left right _ => typeFairIds left ∪ typeFairIds right
    | .recur _ body => typeFairIds body
    | .fairChoice bid left right =>
        {bid} ∪ typeFairIds left ∪ typeFairIds right
    | .xoffer elseType branches =>
        typeFairIds elseType ∪ typeBranchFairIds branches
    | .offer elseType branches =>
        typeFairIds elseType ∪ typeBranchFairIds branches
  termination_by processType => sizeOf processType

  /-- Fair-choice identifiers occurring in a type branch list. -/
  def typeBranchFairIds : List (BareMessage × PactType) → Finset BranchId
    | [] => ∅
    | branch :: rest => typeFairIds branch.2 ∪ typeBranchFairIds rest
  termination_by branches => sizeOf branches
decreasing_by
  all_goals
    first
    | (simp_wf; omega)
    | (have : sizeOf branch.2 < sizeOf branch := by rcases branch; simp_wf; omega
       simp_wf; omega)
end

def TypeObservationOccursInfinitely
    (observation : TypeObservation) (log : TypeLog) : Prop :=
  Set.Infinite {index | (log index).2.contains observation}

def TypeTockOccursInfinitely (log : TypeLog) : Prop :=
  Set.Infinite {index | (log index).2 = TypeLabel.tock}

def FairTypeLog (initial : PactType) (log : TypeLog) : Prop :=
  ∀ bid ∈ typeFairIds initial,
    (TypeObservationOccursInfinitely (.fair bid true) log ↔
      TypeObservationOccursInfinitely (.fair bid false) log)

/-- The completed-log objective `Ω_T`. -/
def TypeWinningObjective
    (initial : PactType) (progress : Finset ProcId) (log : TypeLog) : Prop :=
  HonestTypeLog log ∧
  TypeTockOccursInfinitely log ∧
  (FairTypeLog initial log →
    ∀ pid ∈ progress,
      TypeObservationOccursInfinitely (.progress pid) log)

/-- Semantic compatibility (Theorem 4.2's right-hand side): some strategy
forces `Ω_T` on every completed log. -/
def SemanticTypeCompatible (initial : PactType) (progress : Finset ProcId) : Prop :=
  ∃ strategy : TypeStrategy,
    ∀ log, CompletedTypeLog initial strategy log →
      TypeWinningObjective initial progress log

/-! ## The honesty-aware compatibility game (`pactcompat.typ`)

This is a genuinely concrete rendering of `pactcompat.typ`'s arena: the
honesty memory `H_I`, the two-player vertex sets `V_0`/`V_1` (plus the
absorbing failure sink), and the environment-choice/resolve/fail edges. What
is *not* rendered concretely is the finite round-robin monitor product used
to turn the Rabin objective into a finite-state acceptance condition
(`pactformalappendix.typ`, "Common monitor product"): that is bookkeeping
needed only for the effective decision procedure (Theorem 4.4), so the Rabin
winning condition below is stated directly against the infinite play's
label/environment sequence instead. -/

/-- `H_I = {star} ∪ {E_F | (E_C,E_F) ∈ cal(Env)_I}`. -/
inductive HonestyMemory : Type where
  | star : HonestyMemory
  | future : Finset BareMessage → HonestyMemory
  deriving DecidableEq

/-- `Adm(F,e)`. -/
def HonestyMemory.Admissible : HonestyMemory → TypeEnvironment → Prop
  | .star, _ => True
  | .future allowed, env => typeAvailable env ⊆ allowed

/-- `Next(e,α)`. -/
def honestyNext (env : TypeEnvironment) (label : TypeLabel) : HonestyMemory :=
  match label with
  | .tock => .star
  | .actions _ => .future env.future

/-- A resolved product edge under a fixed compiled automaton: `q →^α_e q'`. -/
def compiledTypeEdge (automaton : TypeAutomaton) (state : TypeAutomatonState)
    (env : TypeEnvironment) (label : TypeLabel) (state' : TypeAutomatonState) :
    Prop :=
  ∃ offers, automaton.HasEdge state env label offers state'

/-- Vertices of the honesty-aware arena, `V_0 ∪ V_1 ∪ {⊥}`: a Player-0
"about to choose an environment" position, a Player-1 "about to resolve"
position carrying the chosen environment, or the absorbing failure sink. -/
inductive CompatibilityVertex : Type where
  | choice (state : TypeAutomatonState) (memory : HonestyMemory) :
      CompatibilityVertex
  | resolve (state : TypeAutomatonState) (memory : HonestyMemory)
      (env : TypeEnvironment) : CompatibilityVertex
  | fail : CompatibilityVertex
  deriving DecidableEq

def CompatibilityVertex.isPlayerZero : CompatibilityVertex → Prop
  | .choice _ _ => True
  | .resolve _ _ _ => False
  | .fail => False

/-- `E_choice ∪ E_resolve ∪ E_fail`. -/
def compatibilityEdge (automaton : TypeAutomaton) :
    CompatibilityVertex → CompatibilityVertex → Prop
  | .choice state memory, .resolve state' memory' env =>
      state' = state ∧ memory' = memory ∧ env.WellFormed
  | .resolve state memory env, .choice state' memory' =>
      memory.Admissible env ∧
      ∃ label, compiledTypeEdge automaton state env label state' ∧
        memory' = honestyNext env label
  | .resolve state memory env, .fail =>
      ¬ memory.Admissible env ∨
        ¬ ∃ label state', compiledTypeEdge automaton state env label state'
  | .fail, .fail => True
  | _, _ => False

/-- The label taken by a `resolve → choice` step, for reading off the log of
a play (`E_choice`/bookkeeping half-edges contribute no log entry). -/
def compatibilityStepLabel (automaton : TypeAutomaton)
    (source target : CompatibilityVertex) : Option (TypeEnvironment × TypeLabel) :=
  match source, target with
  | .resolve state _ env, .choice state' _ =>
      if h : ∃ label, compiledTypeEdge automaton state env label state' then
        some (env, h.choose)
      else none
  | .resolve state memory env, .fail =>
      if ¬ memory.Admissible env ∨
          ¬ ∃ label state', compiledTypeEdge automaton state env label state' then
        some (env, TypeLabel.silent)
      else none
  | _, _ => none

/-- A finite Rabin game: the accepting condition is stated abstractly as
`List (Set Vertex × Set Vertex)` rather than requiring a `Fintype` instance
for `Vertex`, since establishing finiteness of the compiled arena is exactly
the content of Theorem 4.4 and is not needed to *state* the game. -/
structure RabinGame : Type 1 where
  Vertex : Type
  initial : Vertex
  isPlayerZero : Vertex → Prop
  edge : Vertex → Vertex → Prop
  rabinPairs : List (Set Vertex × Set Vertex)

/-- `(G,B)` accepts `π` iff `Inf(π) ∩ G ≠ ∅` and `Inf(π) ∩ B = ∅`; rendered
via recurrence of the visited-vertex sequence, which agrees with the
set-intersection reading on a finite graph. -/
def RabinGame.Accepts (game : RabinGame) (play : ℕ → game.Vertex) : Prop :=
  ∀ pair ∈ game.rabinPairs,
    Set.Infinite {n | play n ∈ pair.1} ∧ ¬ Set.Infinite {n | play n ∈ pair.2}

/-- The (positional-strategy) semantic winning region: `v` is winning for
Player 0 when some choice function, followed at every Player-0 vertex, wins
against every Player-1 response. General Rabin objectives can require finite
memory beyond a positional strategy; this scaffold definition is deliberately
the simplest faithful semantic notion; sharpening it (or proving it agrees
with a memory-based one) is part of Theorem 4.2/4.4's remaining content. -/
def RabinGame.WinRegion (game : RabinGame) : Set game.Vertex :=
  {v | ∃ strategy : game.Vertex → game.Vertex,
    (∀ u, game.isPlayerZero u → game.edge u (strategy u)) ∧
    ∀ play : ℕ → game.Vertex, play 0 = v →
      (∀ n, (if game.isPlayerZero (play n) then play (n + 1) = strategy (play n)
        else game.edge (play n) (play (n + 1)))) →
      game.Accepts play}

/-- `D_T = {live} ∪ (cal(Eta)(Θ_0) × {true,false})`. -/
inductive ObjectiveDisjunct (initial : PactType) : Type where
  | live : ObjectiveDisjunct initial
  | fair (bid : BranchId) (outcome : Bool) (mem : bid ∈ typeFairIds initial) :
      ObjectiveDisjunct initial

/-- `Req(d)`, as the set of observations whose recurrence the disjunct
demands. -/
def ObjectiveDisjunct.req {initial : PactType} (progress : Finset ProcId) :
    ObjectiveDisjunct initial → Finset TypeObservation
  | .live => progress.image .progress
  | .fair bid outcome _ => {.fair bid outcome}

/-- `Forbid(d)`. -/
def ObjectiveDisjunct.forbid {initial : PactType} :
    ObjectiveDisjunct initial → Finset TypeObservation
  | .live => ∅
  | .fair bid outcome _ => {.fair bid (!outcome)}

/-- The full list of Rabin pairs `R_T`, over the honesty-aware arena for a
fixed compiled automaton, one pair per disjunct in `D_T`. Left as `sorry`
pending the play/log correspondence needed to state each `(F_d,B_d)`
concretely against `CompatibilityVertex` plays; see `agent2.md`. -/
def objectiveRabinPairs (automaton : TypeAutomaton) (initial : PactType)
    (progress : Finset ProcId) :
    List (Set (ℕ → CompatibilityVertex) × Set (ℕ → CompatibilityVertex)) := by
  sorry

/-- The honesty-aware compatibility game `hat(G)_{I,T}` for a fixed compiled
automaton. -/
def compatibilityGame (signature : TypeAlphabet) (initial : PactType)
    (progress : Finset ProcId) : RabinGame where
  Vertex := CompatibilityVertex
  initial := .choice (compileType signature initial).initial .star
  isPlayerZero := CompatibilityVertex.isPlayerZero
  edge := compatibilityEdge (compileType signature initial)
  rabinPairs := by
    sorry -- TODO(redevelopment): needs the play/log correspondence from
    -- `objectiveRabinPairs`; see agent2.md.

/-- Definition 4.5/`pactcompat.typ`: the compatibility query for a fixed
composition `initial` (itself an already-`||_I`-composed `PactType`) and
progress set. -/
def TypeCompatible (signature : TypeAlphabet) (initial : PactType)
    (progress : Finset ProcId) : Prop :=
  let game := compatibilityGame signature initial progress
  game.initial ∈ game.WinRegion

/-! ## Fixed component compositions -/

/-- Right-associated composition with explicit interfaces. -/
def composeTypes : List PactType → List Interface → Option PactType
  | [], _ => none
  | [processType], [] => some processType
  | processType :: next :: rest, interface :: interfaces =>
      match composeTypes (next :: rest) interfaces with
      | some suffix => some (.par processType suffix interface)
      | none => none
  | _, _ => none

def composeProcesses : List Proc → List Interface → Option Proc
  | [], _ => none
  | [process], [] => some process
  | process :: next :: rest, interface :: interfaces =>
      match composeProcesses (next :: rest) interfaces with
      | some suffix => some (.par process suffix interface)
      | none => none
  | _, _ => none

def TypeTupleCompatible (signature : TypeAlphabet)
    (types : List PactType) (interfaces : List Interface)
    (progress : Finset ProcId) : Prop :=
  ∃ composition,
    composeTypes types interfaces = some composition ∧
    TypeCompatible signature composition progress

def ComponentwiseRefines (precise abstract : List PactType) : Prop :=
  List.Forall₂ Refines precise abstract

/-! ## Objectives and strategy transfer -/

def eraseProcessLog (log : ProcessLog) : TypeLog :=
  fun index =>
    (eraseEnvironment (log index).1, eraseLabel (log index).2)

abbrev ProcessObjective := Set ProcessLog

def ValueOblivious (objective : ProcessObjective) : Prop :=
  ∀ left right,
    eraseProcessLog left = eraseProcessLog right →
    (left ∈ objective ↔ right ∈ objective)

def ErasedObjective (objective : ProcessObjective) (log : TypeLog) : Prop :=
  ∃ processLog,
    eraseProcessLog processLog = log ∧ processLog ∈ objective

/-! ## Regularity, checking, and complexity helpers -/

/--
The paper's admissible recursive types: variables are closed, every recursive
backedge is preceded by at least one synchronized clock step, recursive calls
are tail terminating, a message is exchanged at most once per cycle, and
nested parallel binders have lexically disjoint interfaces
(`pactautomatonconstruction.typ`, "Regularity"; unchanged by this
redevelopment).

Tail termination is the finite-control part of regularity.  It ensures that a
shared backedge never has to retain a newly generated sequence, parallel, or
conjunctive-offer context.
-/
def ClosedGuardedRegular (processType : PactType) : Prop :=
  PactType.AllVariablesBound [] processType ∧
    PactType.BinderHygienic [] processType ∧
    PactType.ClockGuarded processType ∧
    PactType.TailRecursive processType ∧
    PactType.SameCycleMessageLinear processType ∧
    PactType.InterfaceScoped processType

/-- Types admitted by the canonical construction relative to a fixed alphabet. -/
def AdmissibleType (signature : TypeAlphabet) (processType : PactType) : Prop :=
  signature.WellFormed ∧ signature.Supports processType ∧
    ClosedGuardedRegular processType

/-- `skip` cannot take its silent operational step in a clock environment. -/
theorem skip_has_no_clock_transition :
    ¬ ∃ target,
      TypeTransition TypeEnvironment.tock .skip TypeLabel.silent target := by
  rintro ⟨target, transition⟩
  cases transition with
  | skip _ conditions =>
      simp [TypeEnvironment.tock] at conditions

/-- Proposition 4.1's underlying notion of omega-regularity. -/
def OmegaRegular (initial : PactType) (progress : Finset ProcId) : Prop := by
  sorry

/-- Effective refinement checker used by the decidability theorem. -/
def refinementChecker (precise abstract : PactType) : Bool := by
  sorry

/-- A decision procedure packaged as a Lean `Decidable` instance. -/
noncomputable def dataObliviousCheckingDecidable
    (process : Proc) (claimed : PactType) :
    Decidable (DataObliviousChecks process claimed) := by
  sorry

